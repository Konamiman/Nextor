; Message tables for XCOPY (xcopy.c), in both languages.
;
; This file is assembled with Nestor80 in SDCC relocatable mode
; (--build-type sdcc) and linked with the C program, which sees the two
; tables as "extern const unsigned char msgs_en[] / msgs_ja[]".  Each
; table is a sequence of zero-terminated strings; the C side finds
; message N by skipping N zeros, so THE ORDER AND COUNT OF THE MESSAGES
; MUST MATCH THE MESSAGE NUMBER ENUM IN xcopy.c EXACTLY, in both tables
; (the count parity between the two tables is checked at the bottom of
; this file; the parity with the C enum is by discipline).
;
; The file is UTF-8; the Japanese table is converted to Shift-JIS at
; assembly time by the .strenc directive (same technique as the other
; bilingual tools).  The texts come from the original
; source/command/xcopy text.mac and jtext.mac (except the usage text,
; new in this port).  The two "file(s)" entries are EMPTY in Japanese:
; the word order there puts everything in the "copied" message
; ("N個のファイルをコピーしました"), so what must match between the
; tables is the count and the ordinal meaning, not the layout.
;
; No string may contain a backslash: this keeps the generated bytes
; independent of Nestor80's string escape setting.

CR	equ	13
LF	equ	10

	area	_CODE

	public	_msgs_en
	public	_msgs_ja

encnt	defl	0
jacnt	defl	0

msge	macro	text
	db	text,0
encnt	defl	encnt+1
	endm

msgj	macro	text
	db	text,0
jacnt	defl	jacnt+1
	endm

msgp	macro	text	;A non-final line of a multi-line message
	db	text	; (no terminator: the message continues in
	endm		; the next msgp/msge/msgj line)

;------------------------------------------------------------------------------
;	The English messages.
;
_msgs_en:
	msge	<"Press any key to continue... ">		;M_WAIT
	msge	<" file">					;M_FIL1
	msge	<" files">					;M_FIL2
	msge	<" copied",CR,LF>				;M_COP
	msge	<"hidden">					;M_HID
	msge	<"read only">					;M_RD_ONLY
	msge	<"Cannot copy onto sub-directory">		;M_T_DE
	msge	<"Cannot copy onto system file">		;M_T_SE
	msge	<"Cannot copy onto read only file">		;M_T_RO
	msge	<"Invalid destination filename">		;M_T_IN
	msge	<"Duplicate destination filename">		;M_T_FO
	msge	<" - Cannot create destination sub-directory",CR,LF>  ;M_CCSD
	msge	<"Warning: Option selected more than once">	;M_OPT
	msge	<" - Copy (Y/N)? ">				;M_PROMPT
	msge	<CR,LF,"*** Wrong version of MSX-DOS">		;M_WVER

	;M_USAG (one message, built from continuation lines):
	msgp	<"Usage: XCOPY src [tgt] [/S][/E][/P][/W][/V][/H][/T][/A][/M]",CR,LF,CR,LF>
	msgp	<"Copies the files matching src (a file, a directory or a pattern)",CR,LF>
	msgp	<"to tgt (by default the current directory).",CR,LF,CR,LF>
	msgp	<"/S: copy subdirectories too   /E: keep created empty subdirectories",CR,LF>
	msgp	<"/P: confirm each file         /W: wait for a key before starting",CR,LF>
	msgp	<"/V: verify the writes         /H: copy hidden files too",CR,LF>
	msgp	<"/T: give the copies the current date and time",CR,LF>
	msgp	<"/A: only copy files with the archive attribute set",CR,LF>
	msgp	<"/M: as /A, clearing the attribute on the copied source files",CR,LF>
	msgp	<"System files are never copied.",CR,LF>
	msge	<"TYPE XCOPY.COM for more details",CR,LF>	;M_USAG

;------------------------------------------------------------------------------
;	The Japanese messages: one entry per entry of the English table
;	above, in the same order.
;
_msgs_ja:
	.strenc	shift_jis

	msgj	<"何かキーを押して下さい ">			;M_WAIT
	msgj	<"">						;M_FIL1
	msgj	<"">						;M_FIL2
	msgj	<"個のファイルをコピーしました",CR,LF>		;M_COP
	msgj	<"不可視">					;M_HID
	msgj	<"読みだし専用">				;M_RD_ONLY
	msgj	<"サブディレクトリにはコピーできません">	;M_T_DE
	msgj	<"システムファイルにはコピーできません">	;M_T_SE
	msgj	<"読みだし専用ファイルにはコピーできません">	;M_T_RO
	msgj	<"コピー先のファイル名が不正です">		;M_T_IN
	msgj	<"コピー先のファイル名が重複しています">	;M_T_FO
	msgj	<" - コピー先のサブディレクトリを作成できません",CR,LF>  ;M_CCSD
	msgj	<"警告: オプションが2回以上指定されています">	;M_OPT
	msgj	<" - コピーしますか (Y/N)? ">			;M_PROMPT
	msgj	<CR,LF,"*** MSX-DOSのバージョンが違います">	;M_WVER

	;M_USAG (one message, built from continuation lines):
	msgp	<"使い方: XCOPY src [tgt] [/S][/E][/P][/W][/V][/H][/T][/A][/M]",CR,LF,CR,LF>
	msgp	<"srcに一致するファイル (ファイル、ディレクトリ、パターン) を",CR,LF>
	msgp	<"tgtにコピーします (省略時はカレントディレクトリ)。",CR,LF,CR,LF>
	msgp	<"/S: サブディレクトリもコピーします",CR,LF>
	msgp	<"/E: 空になったサブディレクトリを残します",CR,LF>
	msgp	<"/P: ファイルごとに確認します",CR,LF>
	msgp	<"/W: 開始前にキー入力を待ちます",CR,LF>
	msgp	<"/V: 書き込みを検証します",CR,LF>
	msgp	<"/H: 不可視ファイルもコピーします",CR,LF>
	msgp	<"/T: コピーに現在の日付と時刻を付けます",CR,LF>
	msgp	<"/A: アーカイブ属性のあるファイルのみコピーします",CR,LF>
	msgp	<"/M: /Aと同じ、コピー後に属性をクリアします",CR,LF>
	msgp	<"システムファイルはコピーされません。",CR,LF>
	msgj	<"詳細は TYPE XCOPY.COM で表示できます",CR,LF>	;M_USAG

	.strenc	default

;------------------------------------------------------------------------------

	if	encnt ne jacnt
	.error	The English and Japanese message tables have different message counts
	endif

; Message tables for DISKCOPY (diskcopy.c), in both languages.
;
; This file is assembled with Nestor80 in SDCC relocatable mode
; (--build-type sdcc) and linked with the C program, which sees the two
; tables as "extern const unsigned char msgs_en[] / msgs_ja[]".  Each
; table is a sequence of zero-terminated strings; the C side finds
; message N by skipping N zeros, so THE ORDER AND COUNT OF THE MESSAGES
; MUST MATCH THE MESSAGE NUMBER ENUM IN diskcopy.c EXACTLY, in both
; tables (the count parity between the two tables is checked at the
; bottom of this file; the parity with the C enum is by discipline).
;
; The file is UTF-8; the Japanese table is converted to Shift-JIS at
; assembly time by the .strenc directive (same technique as the
; CHKDSK/UNDEL/KMODE/FIXDISK message tables).  The texts come from the
; original source/command/diskcopy text.mac and jtext.mac, except the
; last two messages, which are new in this port (same wording as the
; FIXDISK/KMODE drive gate refusal).
;
; No string may contain a backslash: this keeps the generated bytes
; independent of Nestor80's string escape setting.

CR	equ	13
LF	equ	10

	area	_CODE

	public	_msgs_en
	public	_msgs_ja

encnt	defl	0
jacnt	defl	0

msge	macro	text
	db	text,0
encnt	defl	encnt+1
	endm

msgj	macro	text
	db	text,0
jacnt	defl	jacnt+1
	endm

msgp	macro	text	;A non-final line of a multi-line message
	db	text	; (no terminator: the message continues in
	endm		; the next msgp/msge/msgj line)

;------------------------------------------------------------------------------
;	The English messages.
;
_msgs_en:
	msge	<"Warning: ">					;M_WARN
	msge	<" errors were detected.  Target disk may be unusable.">  ;M_ERS
	msge	<CR,LF,"Diskcopy finished ok">			;M_FIN
	msge	<"Insert source disk in drive ">		;M_FROM
	msge	<"Insert target disk in drive ">		;M_TO
	msge	<"Press any key to continue... ">		;M_KEY
	msge	<"Error writing sector ">			;M_WER
	msge	<"Error reading sector ">			;M_RER
	msge	<"Error verifying sector ">			;M_VER
	msge	<"Error: sector not found - ">			;M_RNF
	msge	<"Error seeking sector ">			;M_SEEK
	msge	<CR,LF,"*** The two disks are incompatible with each other">  ;M_E_INCOM
	msge	<CR,LF,"*** Disks have wrong sector size">	;M_E_WR_SSIZ
	msge	<CR,LF,"*** Can't copy disk onto itself">	;M_E_SAM_DR
	msge	<CR,LF,"*** Target disk is not an MSX-DOS 2 disk">  ;M_E_NO_ID
	msge	<CR,LF,"*** Wrong version of MSX-DOS">		;M_E_VER
	msge	<"Copy more disks (Y/N)? ">			;M_MORE
	msge	<CR,LF,"*** This operation is not supported on drive ">  ;M_NSUP1
	msge	<":",CR,LF>					;M_NSUP2

	;M_USAG (one message, built from continuation lines):
	msgp	<"Usage: DISKCOPY src: [tgt:] [/X] [/S]",CR,LF,CR,LF>
	msgp	<"Copies all the sectors of a disk to another disk of the same type.",CR,LF>
	msgp	<"When the target drive is omitted, the current drive is used.",CR,LF>
	msgp	<"Source and target may be the same drive: the copy is then done in",CR,LF>
	msgp	<"passes, prompting to swap the disks.",CR,LF,CR,LF>
	msgp	<'/X: no key waits and no "copy more disks" loop (the disk swap',CR,LF>
	msgp	<"    prompts of a same-drive copy are always given)",CR,LF>
	msgp	<"/S: copy the boot sector from the source disk too (by default the",CR,LF>
	msgp	<"    target disk keeps its own boot sector)",CR,LF,CR,LF>
	msge	<"TYPE DISKCOPY.COM for more details",CR,LF>	;M_USAG

	msge	<" (pass ">					;M_PASS1
	msge	<" of ">					;M_PASS2
	msge	<")">						;M_PASS3

;------------------------------------------------------------------------------
;	The Japanese messages: one entry per entry of the English table
;	above, in the same order.
;
_msgs_ja:
	.strenc	shift_jis

	msgj	<"警告: ">					;M_WARN
	msgj	<" エラーが起きました. 複写先ディスクは使用できない可能性があります.">  ;M_ERS
	msgj	<CR,LF,"コピーが終了しました.">			;M_FIN
	msgj	<"複写元ディスクをドライブ">			;M_FROM
	msgj	<"複写先ディスクをドライブ">			;M_TO
	msgj	<"何かキーを押して下さい... ">			;M_KEY
	msgj	<"書き込みエラー, セクタ=">			;M_WER
	msgj	<"読み込みエラー, セクタ=">			;M_RER
	msgj	<"比較エラー, セクタ=">				;M_VER
	msgj	<"セクタが見つかりません, セクタ=">		;M_RNF
	msgj	<"シークエラー, セクタ=">			;M_SEEK
	msgj	<CR,LF,"*** メディアの種類が違います">		;M_E_INCOM
	msgj	<CR,LF,"*** ディスクのセクタ長が不正です">	;M_E_WR_SSIZ
	msgj	<CR,LF,"*** 自分自身にはコピーできません">	;M_E_SAM_DR
	msgj	<CR,LF,"*** 複写先ディスクがMSX-DOS2のディスクではありません">  ;M_E_NO_ID
	msgj	<CR,LF,"*** MSX-DOSのバージョンが違います">	;M_E_VER
	msgj	<"他のディスクをコピーしますか (Y/N)? ">	;M_MORE
	msgj	<CR,LF,"*** ドライブ">				;M_NSUP1
	msgj	<": ではこの操作は出来ません",CR,LF>		;M_NSUP2

	;M_USAG (one message, built from continuation lines):
	msgp	<"使い方: DISKCOPY src: [tgt:] [/X] [/S]",CR,LF,CR,LF>
	msgp	<"ディスクの全セクタを同じ種類の別のディスクにコピーします。",CR,LF>
	msgp	<"複写先ドライブを省略するとカレントドライブが使われます。",CR,LF>
	msgp	<"複写元と複写先は同じドライブでも構いません (ディスクを",CR,LF>
	msgp	<"交換しながらコピーします)。",CR,LF,CR,LF>
	msgp	<"/X: キー入力待ちも確認もなしでコピーします (同一ドライブの",CR,LF>
	msgp	<"    場合のディスク交換の確認は常に行われます)",CR,LF>
	msgp	<"/S: ブートセクタも複写元ディスクからコピーします (省略時は",CR,LF>
	msgp	<"    複写先ディスクのブートセクタが保持されます)",CR,LF,CR,LF>
	msgj	<"詳細は TYPE DISKCOPY.COM で表示できます",CR,LF>	;M_USAG

	msgj	<" (パス ">					;M_PASS1
	msgj	<"/">						;M_PASS2
	msgj	<")">						;M_PASS3

	.strenc	default

;------------------------------------------------------------------------------

	if	encnt ne jacnt
	.error	The English and Japanese message tables have different message counts
	endif

; Message tables for XDIR (xdir.c), in both languages.
;
; This file is assembled with Nestor80 in SDCC relocatable mode
; (--build-type sdcc) and linked with the C program, which sees the two
; tables as "extern const unsigned char msgs_en[] / msgs_ja[]".  Each
; table is a sequence of zero-terminated strings; the C side finds
; message N by skipping N zeros, so THE ORDER AND COUNT OF THE MESSAGES
; MUST MATCH THE MESSAGE NUMBER ENUM IN xdir.c EXACTLY, in both tables
; (the count parity between the two tables is checked at the bottom of
; this file; the parity with the C enum is by discipline).
;
; The file is UTF-8; the Japanese table is converted to Shift-JIS at
; assembly time by the .strenc directive (same technique as the other
; bilingual tools).  The texts come from the original
; source/command/xdir text.mac and jtext.mac.  Note that the two
; languages compose the final totals line differently (the Japanese
; word order needs the line break in another message), so some entries
; that look asymmetric (CR,LF here but not there) are correct: what
; must match is the count and the ordinal meaning, not the layout.
;
; No string may contain a backslash: this keeps the generated bytes
; independent of Nestor80's string escape setting.

CR	equ	13
LF	equ	10

	area	_CODE

	public	_msgs_en
	public	_msgs_ja

encnt	defl	0
jacnt	defl	0

msge	macro	text
	db	text,0
encnt	defl	encnt+1
	endm

msgj	macro	text
	db	text,0
jacnt	defl	jacnt+1
	endm

;------------------------------------------------------------------------------
;	The English messages.
;
_msgs_en:
	msge	<" byte">				;M_SIZ1
	msge	<" bytes">				;M_SIZ2
	msge	<" in ">				;M_IN
	msge	<"K in ">				;M_KIN
	msge	<" file    ">				;M_FIL1
	msge	<" files   ">				;M_FIL2
	msge	<"K free",CR,LF>			;M_KFREE
	msge	<"Volume in drive ">			;M_VOL1
	msge	<": is ">				;M_VOL2
	msge	<": has no name">			;M_VOL3
	msge	<"X-Directory of ">			;M_XDIR
	msge	<CR,LF,"*** Wrong version of MSX-DOS">	;M_WVER

;------------------------------------------------------------------------------
;	The Japanese messages: one entry per entry of the English table
;	above, in the same order.
;
_msgs_ja:
	.strenc	shift_jis

	msgj	<"バイト">				;M_SIZ1
	msgj	<"バイト">				;M_SIZ2
	msgj	<"が計">				;M_IN
	msgj	<"Kバイトが計">				;M_KIN
	msgj	<"ファイルで使用中",CR,LF>		;M_FIL1
	msgj	<"ファイルで使用中",CR,LF>		;M_FIL2
	msgj	<"Kバイトが使用可能",CR,LF>		;M_KFREE
	msgj	<"ドライブ">				;M_VOL1
	msgj	<":のボリューム名は ">			;M_VOL2
	msgj	<":のディスクにはボリューム名がありません">  ;M_VOL3
	msgj	<"拡張ディレクトリ ">			;M_XDIR
	msgj	<CR,LF,"*** MSX-DOSのバージョンが違います">	;M_WVER

	.strenc	default

;------------------------------------------------------------------------------

	if	encnt ne jacnt
	.error	The English and Japanese message tables have different message counts
	endif

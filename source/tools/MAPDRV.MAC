	.z80

FIB	equ	3000h

	;Extended partition type codes
PT_EXT: equ 5
PT_EXT_LBA: equ 15

	;Configuration file (/F) limits. The command line passed by DOS at 80h
	;starts with a space, so 126 characters is what it can actually hold.
MAX_FILE_SIZE: equ 4096
MAX_LINE_LEN: equ 126

	jp	START

      ; -------------------------------------------------------------------------------
	db	13
	db	"MAPDRV v1.5 - map a drive to a driver, device and partition,",13,10
	db      "         or mount a file on a drive"
	db	13,10
	db	"Usage:",13,10
	db	13,10
	db	"MAPDRV [/L] <drive>: <partition>|d|u|s [<device>] [<slot>[-<subslot>][:<seg>]]",13,10
	db	"MAPDRV [/L] <drive>: <partition>|d|u|s [<device>] [0]",13,10
	db  "MAPDRV <drive>: [/]<filename> [/ro]",13,10
	db	"MAPDRV /F <file> [/K]",13,10
	db	13,10
	db	"Maps the drive to the specified partition of the specified device",13,10
	db	"of the driver in the specified slot (must be a Nextor driver).",13,10
	db	13,10
	db	"/L locks the drive immediately after doing the mapping.",13,10
	db	13,10
	db	"<partition> can be any number starting at 1, or 0 to map the drive directly",13,10
	db	"to the device (needed for partitionless devices such as floppy disks).",13,10
	db	"If primary partition K is extended, partition numbers K and above refer to",13,10
	db	"extended partitions K-1, K-2..., otherwise they refer to primary partitions.",13,10
        db	13,10
	db	"<device> must be a number from 1 to 255.",13,10
	db	13,10
	db	"<slot> and <subslot> must be a number from 0 to 3. If 0 is specified instead,",13,10
	db	"the primary disk controller slot is assumed.",13,10
	db  "<seg> (segment) must be a number from 0 to 255, only used for RAM drivers.",13,10
	db	13,10
	db	"If device information is provided but slot is omitted, the drive is mapped to",13,10
	db	"the specified partition of the specified device in the driver already",13,10
	db	"controlling the drive (this works only if the drive is currently mapped",13,10
	db      "to a Nextor driver).",13,10
	db	13,10
	db	"If both device and slot information are omitted, the drive is mapped to the",13,10
	db	"specified partition of the device it is already mapped to (this works only if",13,10
	db	"the drive is currently mapped to a Nextor driver).",13,10
	db	13,10
	db	"'d' will revert the drive to its default mapping (the mapping at boot time).",13,10
	db	"'u' will leave the drive unmapped. Other parameters are ignored in both cases.",13,10
	db	"'s' will map the drive to the device but skip the partition assignment;",13,10
	db	"    a suitable partition will be searched on each access to the drive",13,10
	db	"    (useful for removable devices that are currently offline).",13,10
	db	13,10
	db	"If a valid filename is supplied after <drive>, the specified file will be",13,10
	db  "mapped to the drive. A file cannot be mapped to its own drive, or to a drive",13,10
	db  "that contains a file that has been mapped. Prepend the filename with '/'",13,10
	db	"if the first character of its name is a digit.",13,10
	db	13,10
	db	"/F runs the MAPDRV command lines contained in a text file, one per line,",13,10
	db	"in order. Blank lines and lines starting with '#' or ';' are ignored.",13,10
	db	"Processing stops at the first line that fails, unless /K is specified.",13,10
	db	"Lines can be up to 126 characters long, and the file up to 4096 bytes.",13,10
	db	1Ah

USAGE_S:
	db	"MAPDRV - map a drive to a driver, device and partition",13,10
	db  "         or mount a file on a drive",13,10
	db	13,10
	db	"MAPDRV [/L] <drive>: <partition>|d|u|s [<device>] [<slot>[-<subslot>][:<seg>]]",13,10
	db	"MAPDRV [/L] <drive>: <partition>|d|u|s [<device>] [0]",13,10
	db  "MAPDRV <drive>: [/]<filename> [/ro]",13,10
	db	"MAPDRV /F <file> [/K]",13,10
	db	13,10
	db	"TYPE MAPDRV.COM for more details.",13,10
	db	0

START:
	call	CHK_NEXTOR##

	ld	de,BUF
	ld	a,1
	call	EXTPAR##
	jr	nz,FOUND_PARAMS

	ld	de,USAGE_S
	ld	c,_ZSTROUT##
	call	5
	ld	b,a
	ld	c,_TERM##
	jp	5
FOUND_PARAMS:

	ld	hl,BUF
	ld	c,'f'
	call	IS_SWITCH
	jp	z,FILE_MODE


	;--- Process the command line. Also run once per line of a configuration
	;    file, then the line is at 80h as if it was the command line.
	;    Input: first parameter in BUF
	;    Ends by jumping to TERM.

DO_LINE:

	;* Reset the work variables, a previous line may have changed them

	ld	hl,PARTITION
	ld	de,PARTITION+1
	ld	bc,VARS_END-PARTITION-1
	ld	(hl),0
	ldir
	ld	hl,-1
	ld	(SLOT),hl	;Also SEGMENT

	;--- Get parameters

	;* Check for /L

	ld	iy,2

	ld	a,(BUF)
	cp	'/'
	jr	nz,NO_LOCK
	inc	hl
	ld	a,(BUF+1)
	or	32
	cp	'l'
	jr	nz,NO_LOCK

	ld	a,-1
	ld	(DO_LOCK),a

	ld	de,buf
	ld	a,2
	call	EXTPAR##
	ld	b,.NOPAR##
	jp	c,TERM

	inc	iy
NO_LOCK:

	;* Drive letter

	ld	hl,BUF
	call	CHKLET_NOTERM##
	cp	.IPARM##
	jp	z,IPARM_TERM
	dec	a
	ld	(DRIVE),a

	;* Partition number, or "d", "u", or file name

	call	GET_NEXT_PARAM
	ld	b,.NOPAR##
	jp	c,TERM

	ld	a,(de)
	cp	"/"
	inc	de
	jp	z,IS_FILE_DE

	ld	hl,BUF	;Try to get first parameter as a number
	call	EXT8##
	jr	nc,IS_PART

	ld	a,(BUF+1)
	or	a
	jp	nz,IS_FILE
	ld	a,(BUF)		;Check fo special values "d", "u" and "s"
	or	20h
	cp	"d"
	ld	b,1
	jp	z,DO_MAP_DU
	cp	"u"
	ld	b,0
	jp	z,DO_MAP_DU
	cp	"s"
	jr	z,IS_SKIP_PART
	jp	IS_FILE

	;* "s": skip the partition assignment,
	;  then parse device and slot as for a partition number

IS_SKIP_PART:
	ld	a,-1
	ld	(SKIP_PART),a
	jr	IS_PART2

IS_PART:
	ld	(PARTITION),a
IS_PART2:

	;* Device

	call	GET_NEXT_PARAM
	jp	c,DO_MAP

	ld hl,BUF
	call EXT8##
	jp c,IPARM_TERM
	ld	(DEVICE),a

	;* Slot, subslot, segment

	call	GET_NEXT_PARAM
	jp	c,DO_MAP

	ld	hl,BUF
	call	GETSLOT_NOTERM##
	jp	c,IPARM_TERM
	or	a
	jr	nz,NO_MAIN
	ld	a,(0F348h)
NO_MAIN:
	ld	(SLOT),a
	ld	a,b
	ld	(SEGMENT),a

	jr	DO_MAP


	;--- Do the mapping to default value, or unmap the drive
	;    Input: B=0 to unmap, B=1 to map to default value

DO_MAP_DU:
	ld	a,(DRIVE)
	ld	c,_MAPDRV##
	call	5
	ld	b,a
	jp	TERM


	;--- Do the mapping to partition and device

DO_MAP:

	;* If no slot specified, get the current drive mapping

	ld	a,(SLOT)
	inc	a
	jr	nz,OK_GETCURMAP

	ld	a,(DRIVE)
	ld	hl,BUF_LETTER
	ld	c,_GDLI##
	call	5
	ld	b,a
	jp	nz,TERM

	ld	a,(BUF_LETTER)
	cp	1
	ld	b,.IDRV##
	jp	nz,TERM		;Error if not assigned to a block device

	ld	a,(DEVICE)
	or	a
	jr	nz,OK_DEVICE
	ld	a,(BUF_LETTER+4)
	ld	(DEVICE),a
OK_DEVICE:

	xor	a
	inc	hl
	ld	d,(hl)
	inc	hl
	ld	e,(hl)
	ld	hl,BUF_DRIVER
	ld	c,_GDRVR##
	call	5
	ld	b,a
	jp	nz,TERM

	ld	a,(BUF_DRIVER+4)
	and	1
	ld	b,.IDRVR##
	jp	z,TERM		;Error if not assigned to a Nextor driver

	ld	a,(BUF_DRIVER)
	ld	(SLOT),a
	ld	a,(BUF_DRIVER+1)
	ld	(SEGMENT),a
OK_GETCURMAP:

	;* If skipping the partition assignment ("s"), use mapping sector
	;  FFFFFFFFh: the drive will be attached to the device with no
	;  partition assigned, and a suitable partition will be searched
	;  on the first access to the drive

	ld	a,(SKIP_PART)
	or	a
	jr	z,NO_SKIP_PART
	ld	hl,-1
	ld	de,-1
	jp	OK_PARTINFO

NO_SKIP_PART:

	;* Convert partition to primary or extended as appropriate

	;  If the first extended partition in the primary partition table
	;  is primary partition K, partitions K and above are its logical
	;  partitions K-1, K-2...; otherwise the partition is primary.
	;  Only primary partitions 1 to <partition> need to be examined.

	ld	a,(PARTITION)
	or	a
	jp	z,OK_ADJUST_PARTITION

	ld	b,0		;Primary partition being examined
FIND_EXT_LOOP:
	inc	b
	ld	a,b
	cp	5
	jr	nc,IS_PRIM_PART	;No extended partition in the primary partition table
	dec	a
	ld	hl,PARTITION
	cp	(hl)
	jr	nc,IS_PRIM_PART	;Partition is before the first extended partition

	push	bc
	ld	ix,DRIVE
	ld	a,(ix+3)	;Slot
	ld	h,b			;Primary partition
	ld	l,0			;Extended partition
	ld	b,(ix+4)	;Segment
	ld	d,(ix+5)	;Device
	ld	e,0
	ld	c,_GPART##
	call	5
	pop	de			;D = primary partition examined
	cp	.IPART##
	jr	z,FIND_EXT_NEXT	;Empty primary partition: keep searching
	ld	h,b
	ld	b,a
	or	a
	jp	nz,TERM

	ld	a,h
	cp	PT_EXT	;Is extended?
	jr	z,IS_EXT_PART
	cp	PT_EXT_LBA
	jr	z,IS_EXT_PART
FIND_EXT_NEXT:
	ld	b,d
	jr	FIND_EXT_LOOP

IS_PRIM_PART:
	ld	a,(PARTITION)
	cp	5
	jr	c,IS_PRIM_PART_2
	ld	a,5		;Non existing primary partition (and keep bit 7 of H clear)
IS_PRIM_PART_2:
	ld	(PRIMARY),a
	xor	a
	ld	(EXTENDED),a
	jr	OK_ADJUST_PARTITION

IS_EXT_PART:
	ld	a,d
	ld	(PRIMARY),a
	ld	a,(PARTITION)
	sub	d
	inc	a
	ld	(EXTENDED),a

OK_ADJUST_PARTITION::

	;* Obtain the partition information

	ld	hl,0
	ld	de,0
	ld	a,(PRIMARY)
	or	a
	jr	z,OK_PARTINFO
	ld	ix,DRIVE
	ld	a,(ix+3)	;Slot
	ld	b,(ix+4)	;Segment
	ld	d,(ix+5)	;Device
	ld	h,(ix+1)	;Primary partition
	ld	l,(ix+2)	;Extended partition
	ld	c,_GPART##
	call	5
	ld	b,a
	jp	nz,TERM
OK_PARTINFO:


	;* Finally, do the actual mapping and lock if necessary

	ld	(SLOT+4),de
	ld	(SLOT+6),hl
	ld	a,(DRIVE)
	ld	b,2
	ld	hl,SLOT	;Information is already in the right order for _MAPDRV
	ld	c,_MAPDRV##
	call	5
	ld	b,a
	or	a
	jr	nz,DO_LOCK_OK

	ld	a,(DO_LOCK)
	or	a
	jr	z,DO_LOCK_OK
	ld	a,(DRIVE)
	ld	e,a
	ld	a,1
	ld	b,0FFh
	ld	c,_LOCK##
	call	5
	ld	b,a
DO_LOCK_OK:

	jp	TERM

	;--- Do the mapping to a file.
	;    FIB is appropriately filled already.

IS_FILE:
	ld	de,BUF
IS_FILE_DE:
	ld	b,10110b	;Include directories, hidden and system files
	ld	c,_FFIRST##
	ld	ix,FIB
	call	5
	jp	nz,DO_TERM

	; * First, extract "/ro" parameter if present

	ld	de,FIB+64
	ld	a,3
	call	EXTPAR##
	ld	d,0
	jp	c,DO_FILE

	ld	a,(FIB+64)
	cp	'/'
	jp	nz,IPARM_TERM
	ld	a,(FIB+65)
	or	32
	cp	'r'
	jp	nz,IPARM_TERM
	ld	a,(FIB+66)
	or	32
	cp	'o'
	jp	nz,IPARM_TERM
	ld	a,(FIB+67)
	or	a
	jp	nz,IPARM_TERM
	ld	d,1

DO_FILE:
	ld	a,(DRIVE)
	ld	bc,_MAPDRV##+3*256
	ld	hl,FIB
	call	5
DO_TERM:
	ld	b,a
	jp	TERM

IPARM_TERM:
	ld	b,.IPARM##

	;--- Finish processing the command line with error code B (0 = success):
	;    terminate the program, or go on with the next line of the
	;    configuration file in /F mode.

TERM:
	ld	a,(IN_FILE_MODE)
	or	a
	jp	nz,LINE_DONE
	ld	c,_TERM##
	jp	5


	;--- /F: run the lines of a configuration file

FILE_MODE:

	;* Get the file name and the optional /K

	ld	de,BUF
	ld	a,2
	call	EXTPAR##	;Also A = number of parameters
	ld	b,.NOPAR##
	jp	c,FILE_TERM
	cp	3+1
	ld	b,.INP##
	jp	nc,FILE_TERM
	cp	3
	jr	c,OK_FILE_PARAMS

	ld	de,FIB
	ld	a,3
	call	EXTPAR##
	ld	hl,FIB
	ld	c,'k'
	call	IS_SWITCH
	ld	b,.IPARM##
	jp	nz,FILE_TERM
	ld	a,-1
	ld	(KEEP_GOING),a
OK_FILE_PARAMS:

	;* Read the whole file and close it before running any line,
	;  since a line could remap the drive that contains it.
	;  Reading one extra byte tells if it is too big.

	ld	de,BUF
	ld	a,1		;Open for reading only
	ld	c,_OPEN##
	call	5
	or	a
	jr	z,OK_OPEN
	ld	b,a
	jp	FILE_TERM
OK_OPEN:

	push	bc
	ld	de,FILE_BUF
	ld	hl,MAX_FILE_SIZE+1
	ld	c,_READ##
	call	5
	cp	.EOF##
	jr	nz,OK_READ
	xor	a		;Empty file
	ld	h,a
	ld	l,a
OK_READ:
	pop	bc
	push	af
	push	hl
	ld	c,_CLOSE##
	call	5
	pop	hl
	pop	af
	ld	b,a
	or	a
	jp	nz,FILE_TERM

	ld	de,MAX_FILE_SIZE+1
	push	hl
	sbc	hl,de
	pop	hl
	ld	b,.BFSZ##
	jp	nc,FILE_TERM
	ld	de,FILE_BUF
	add	hl,de
	ld	(hl),1Ah	;End of file mark

	;* Set up the line by line processing

	ld	hl,FILE_BUF
	ld	(LINE_PTR),hl
	ld	(SAVED_SP),sp
	ld	a,-1
	ld	(IN_FILE_MODE),a
	ld	de,ABORT_RTN
	ld	c,_DEFAB##
	call	5
	jr	NEXT_LINE

	;* A line has been processed, with error code B (0 = success).
	;  Print the line number and contents when it has failed; the error
	;  message is printed later, so that the last one can be printed
	;  by the command interpreter when terminating with its error code.

LINE_DONE:
	ld	sp,(SAVED_SP)
	ld	a,b
	or	a
	jr	z,NEXT_LINE

	push	bc
	call	FLUSH_ERROR
	ld	de,LINE_ERR_S
	ld	c,_ZSTROUT##
	call	5
	ld	hl,(LINE_NUM)
	call	PRINT_NUM
	ld	de,COLON_S
	ld	c,_ZSTROUT##
	call	5
	ld	de,81h
	ld	c,_ZSTROUT##
	call	5
	ld	de,CRLF_S
	ld	c,_ZSTROUT##
	call	5
	pop	bc

	ld	a,b
	ld	(PENDING_ERR),a
	ld	a,(KEEP_GOING)
	or	a
	jp	z,FILE_END

	;* Get the next line from the file, put it at 80h as a command line

NEXT_LINE:
	ld	hl,(LINE_NUM)
	inc	hl
	ld	(LINE_NUM),hl

	ld	hl,(LINE_PTR)
	ld	a,(hl)
	cp	1Ah
	jp	z,FILE_END

SKIP_BLANKS:
	ld	a,(hl)
	cp	' '
	jr	z,SKIP_BLANK
	cp	9
	jr	nz,SKIP_BLANKS_END
SKIP_BLANK:
	inc	hl
	jr	SKIP_BLANKS
SKIP_BLANKS_END:

	;  Copy the line converting tabs to spaces, since EXTPAR only
	;  separates parameters with spaces. B = length, C = .BUFUL if the
	;  line is too long; spaces past the maximum length are ignored.

	ld	de,81h
	ld	bc,0
COPY_LINE:
	ld	a,(hl)
	cp	13
	jr	z,COPY_LINE_END
	cp	10
	jr	z,COPY_LINE_END
	cp	1Ah
	jr	z,COPY_LINE_END
	inc	hl
	cp	9
	jr	nz,COPY_NO_TAB
	ld	a,' '
COPY_NO_TAB:
	push	af
	ld	a,b
	cp	MAX_LINE_LEN
	jr	c,COPY_CHAR
	pop	af
	cp	' '
	jr	z,COPY_LINE
	ld	c,.BUFUL##
	jr	COPY_LINE
COPY_CHAR:
	pop	af
	ld	(de),a
	inc	de
	inc	b
	jr	COPY_LINE

	;  Skip the line terminator: CR, LF or CR+LF
	;  (the end of file mark is left for the next round)

COPY_LINE_END:
	cp	1Ah
	jr	z,OK_LINE_TERM
	inc	hl
	cp	13
	jr	nz,OK_LINE_TERM
	ld	a,(hl)
	cp	10
	jr	nz,OK_LINE_TERM
	inc	hl
OK_LINE_TERM:
	ld	(LINE_PTR),hl

	xor	a
	ld	(de),a
	ld	a,b
	ld	(80h),a

	;  Skip blank lines and comments, then process the line

	or	a
	jr	z,NEXT_LINE
	ld	a,(81h)
	cp	'#'
	jr	z,NEXT_LINE
	cp	';'
	jr	z,NEXT_LINE

	ld	b,c
	ld	a,c
	or	a
	jp	nz,LINE_DONE

	ld	de,BUF
	ld	a,1
	call	EXTPAR##
	ld	hl,BUF
	ld	c,'f'
	call	IS_SWITCH
	jp	nz,DO_LINE
	jp	IPARM_TERM	;No recursion

	;* End of file, or a line failed without /K

FILE_END:
	ld	a,(PENDING_ERR)
	ld	b,a
	xor	a
	ld	(PENDING_ERR),a	;COMMAND will print it, not ABORT_RTN
FILE_TERM:
	ld	c,_TERM##
	jp	5


	;--- Abort routine for /F mode: the program can terminate early
	;    (e.g. Ctrl-STOP, or abort after a disk error), don't lose
	;    the pending error message then.

ABORT_RTN:
	push	af
	push	bc
	call	FLUSH_ERROR
	pop	bc
	pop	af
	ret


	;--- Print the message of the pending error, if any,
	;    with the same layout used by the command interpreter

FLUSH_ERROR:
	ld	a,(PENDING_ERR)
	or	a
	ret	z
	ld	b,a
	xor	a
	ld	(PENDING_ERR),a
	ld	de,BUF
	ld	c,_EXPLAIN##
	call	5
	ld	de,STARS_S
	ld	c,_ZSTROUT##
	call	5
	ld	de,BUF
	ld	c,_ZSTROUT##
	call	5
	ld	de,MSG_END_S
	ld	c,_ZSTROUT##
	jp	5


	;--- Print a number in decimal
	;    Input: HL = Number

PRINT_NUM:
	ld	d,0		;D<>0 once a digit has been printed
	ld	bc,-10000
	call	PRINT_DIGIT
	ld	bc,-1000
	call	PRINT_DIGIT
	ld	bc,-100
	call	PRINT_DIGIT
	ld	bc,-10
	call	PRINT_DIGIT
	ld	d,1
	ld	bc,-1
PRINT_DIGIT:
	ld	a,'0'-1
PRINT_DIGIT_LOOP:
	inc	a
	add	hl,bc
	jr	c,PRINT_DIGIT_LOOP
	sbc	hl,bc
	cp	'0'
	jr	nz,PRINT_DIGIT_DO
	inc	d
	dec	d
	ret	z		;Skip leading zeros
PRINT_DIGIT_DO:
	ld	d,1
	ld	e,a
	push	de
	push	hl
	ld	c,_CONOUT##
	call	5
	pop	hl
	pop	de
	ret


	;Check if a parameter is a given switch.
	;Input:   HL = Parameter address, C = Switch letter (lowercase)
	;Output:  Z if the parameter is "/<letter>" (any case)
	;Corrupts: A, HL

IS_SWITCH:
	ld	a,(hl)
	cp	'/'
	ret	nz
	inc	hl
	ld	a,(hl)
	or	32
	cp	c
	ret	nz
	inc	hl
	ld	a,(hl)
	or	a
	ret


	;Get the next command-line parameter.
	;Input:   IY = parameter index in IYl
	;Output:  same as EXTPAR##, with IY advanced past this parameter
	;Corrupts: HL (in addition to whatever EXTPAR## corrupts)

GET_NEXT_PARAM:
	ld	de,BUF
	push	iy
	pop	hl
	ld	a,l
	inc	iy
	jp	EXTPAR##


LINE_ERR_S:	db	"Error in line ",0
COLON_S:	db	": ",0
STARS_S:	db	13,10,"*** ",0
MSG_END_S:	db	13,10
CRLF_S:	db	13,10,0

	;Configuration file processing (not reset per line)
IN_FILE_MODE:	db	0
KEEP_GOING:	db	0
PENDING_ERR:	db	0
LINE_NUM:	dw	0
LINE_PTR:	dw	0
SAVED_SP:	dw	0

	;Command line processing (reset per line)
PARTITION:	db	0
SKIP_PART:	db	0
DO_LOCK:	db	0
DRIVE:	db	0
PRIMARY:	db	0
EXTENDED:	db	0
SLOT:	db	-1
SEGMENT:	db	255
DEVICE:	db	0
FILE_FLAGS:	db	0
SECTOR:	ds	4	;Written at SLOT+4 for _MAPDRV
VARS_END:

BUF: equ 2000h
BUF_DRIVER: equ BUF
BUF_LETTER: equ BUF
FILE_BUF: equ 4000h

	end

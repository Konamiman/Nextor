	jp	START

        ;        -------------------------------------------------------------------------------
	db	13
	db	"TYPEWW - Display the contents of a file with long lines wordwrapped",13,10
	db	13,10
	db	"The file is displayed up to the first end-of-file character (CTRL-Z),",13,10
	db	"wordwrapping every line that is longer than the screen is wide: a word",13,10
	db	"that does not fit on the current line continues on the next one.",13,10
	db	"Control characters other than carriage return, line feed and tab are",13,10
	db	"shown as ^ followed by the corresponding letter.",13,10
	db	13,10
	db	"Usage: TYPEWW filespec [/S] [/H] [/B]",13,10
	db	13,10
	db	"The filespec can not be ambiguous. /H allows typing hidden files and",13,10
	db	"/S allows typing system files. With /B the file is displayed as-is",13,10
	db	"(no wordwrap, no control character conversion, no stop at CTRL-Z).",13,10
	db	1Ah

USAGE_S:
	db	"TYPEWW - Display the contents of a file with long lines wordwrapped",13,10
	db	13,10
	db	"Usage: TYPEWW filespec [/S] [/H] [/B]",13,10
	db	13,10
	db	"TYPE TYPEWW.COM for more details.",13,10
	db	0

AMBIG_S:
	db	"The filespec can not be ambiguous",13,10
	db	0

	;--- Option flags (bits in OPTS)

OPT_BIN	equ	0	;/B: display as-is
OPT_HID	equ	1	;/H: allow hidden files
OPT_SYS	equ	2	;/S: allow system files

START:
	call	CHK_NEXTOR##

	;--- Parse the parameters: one filespec (which may carry attached
	;    options, as in FILE.TXT/H) plus any number of /X options.

	xor	a
	ld	(OPTS),a
	ld	(FSPEC),a
	ld	b,1	;B = parameter index
PARSE:
	push	bc
	ld	a,b
	ld	de,PARBUF
	call	EXTPAR##
	pop	bc
	jr	c,PARSE_END	;No more parameters
	call	DO_PAR
	inc	b
	jr	PARSE

PARSE_END:
	ld	a,(FSPEC)	;A filespec must have been given.
	or	a
	jr	nz,HAVE_FSPEC

SHOW_USAGE:
	ld	de,USAGE_S
	ld	c,_ZSTROUT##
	call	5
	ld	b,0
	ld	c,_TERM##
	jp	5

	;--- Process the parameter at PARBUF: split any attached options
	;    off, then store the filespec or record the option letters.

DO_PAR:
	ld	hl,PARBUF
	ld	a,(hl)
	cp	"/"
	jr	z,DO_OPTS	;The whole parameter is option(s)
	ld	a,(FSPEC)	;A second filespec is not allowed.
	or	a
	jr	nz,SHOW_USAGE
	ld	de,FSPEC
DPR10:	ld	a,(hl)	;Copy the filespec up to the first
	cp	"/"	;"/" or the end.
	jr	z,DPR20
	ld	(de),a
	or	a
	ret	z
	inc	hl
	inc	de
	jr	DPR10
DPR20:	xor	a	;Terminate the filespec and process
	ld	(de),a	;the attached options.
	;fall through into DO_OPTS

	;--- Process the options at (HL), each a "/" plus a letter

DO_OPTS:
	ld	a,(hl)
	or	a
	ret	z
	cp	"/"
	jr	nz,SHOW_USAGE
	inc	hl
	ld	a,(hl)
	inc	hl
	and	0DFh	;Upper case the option letter
	ld	c,OPT_BIN
	cp	"B"
	jr	z,DOP10
	ld	c,OPT_HID
	cp	"H"
	jr	z,DOP10
	ld	c,OPT_SYS
	cp	"S"
	jr	nz,SHOW_USAGE
DOP10:	ld	a,c	;Set bit C of OPTS (C is 0 to 2:
	or	a	;build the mask by shifting).
	ld	b,1
	jr	z,DOP30
DOP20:	sla	b
	dec	a
	jr	nz,DOP20
DOP30:	ld	a,(OPTS)
	or	b
	ld	(OPTS),a
	jr	DO_OPTS

	;--- Locate the file, honoring /H and /S, then open it

HAVE_FSPEC:
	ld	hl,FSPEC	;Reject ambiguous filespecs.
CHKAMB:	ld	a,(hl)
	inc	hl
	or	a
	jr	z,AMB_OK
	cp	"*"
	jr	z,IS_AMB
	cp	"?"
	jr	nz,CHKAMB
IS_AMB:
	ld	de,AMBIG_S
	ld	c,_ZSTROUT##
	call	5
	ld	b,0
	ld	c,_TERM##
	jp	5

AMB_OK:
	ld	a,(OPTS)	;Search attributes: hidden and/or
	and	00000110b	;system files only when asked for
	ld	b,a	;(OPT_HID/OPT_SYS are bits 1 and 2,
	xor	a	;matching the attribute bits).
	ld	de,FSPEC
	ld	ix,FIB
	ld	c,_FFIRST##
	call	5
	ld	b,a
	ld	c,_TERM##
	jp	nz,5

	xor	a	;Open the file.
	ld	de,FSPEC
	ld	c,_OPEN##
	call	5
	jr	z,OPEN_OK
	ld	b,a
	ld	c,_TERM##
	jp	5
OPEN_OK:
	ld	a,b
	ld	(HNDL),a

	;--- Get the screen width for the wordwrap

	ld	a,4	;IOCTL: get the screen size of the
	ld	bc,014Bh	;standard output; E = width.
	call	5
	jr	nz,DFLT_W
	ld	a,e
	or	a
	jr	nz,SET_W
DFLT_W:	ld	a,80	;Default if the IOCTL fails or the
SET_W:	ld	(COLS),a	;output is redirected.
	xor	a
	ld	(COLCNT),a
	ld	(WORDLEN),a

	;--- Main loop: read a chunk and process it

MAIN:
	ld	a,(HNDL)
	ld	b,a
	ld	de,IOBUF
	ld	hl,IOBUF_LEN
	ld	c,_READ##
	call	5
	jr	nz,READ_ERR
	ld	a,h
	or	l
	jr	z,DONE	;Zero bytes read: end of file
	push	hl
	pop	bc	;BC = number of bytes to process
	ld	hl,IOBUF
PRLOOP:
	ld	a,(hl)
	push	hl
	push	bc
	ld	e,a
	ld	a,(OPTS)
	bit	OPT_BIN,a
	ld	a,e
	jr	z,NOT_BIN
	call	COUT1	;/B: every byte goes out as-is
	jr	PRNEXT
NOT_BIN:
	cp	1Ah	;^Z ends the text
	jr	z,DONE_POP2
	call	TCHR
PRNEXT:
	pop	bc
	pop	hl
	inc	hl
	dec	bc
	ld	a,b
	or	c
	jr	nz,PRLOOP
	jr	MAIN

DONE_POP2:
	pop	bc
	pop	hl
	jr	DONE

READ_ERR:
	cp	.EOF##	;.EOF is the normal end of the
	jr	z,DONE	;file; anything else is reported.
	call	FLUSHW
	ld	b,a
	ld	c,_TERM##
	jp	5

DONE:
	call	FLUSHW	;Print any word still buffered.
	ld	b,0
	ld	c,_TERM##
	jp	5

	;--- Process the character in A (text mode): accumulate printable
	;    characters into the current word; a separator (space, TAB, CR
	;    or LF) first flushes the word, wordwrapping it if it does not
	;    fit on what is left of the line. Control characters other than
	;    CR, LF and TAB join the word as ^ plus the matching letter.

TCHR:
	cp	13
	jr	z,T_CR
	cp	10
	jr	z,T_LF
	cp	9
	jr	z,T_TAB
	cp	" "
	jr	z,T_SPC
	cp	32
	jr	c,T_CTL
	jp	ADDW	;Printable: part of the word

T_CTL:	push	af
	ld	a,"^"
	call	ADDW
	pop	af
	add	a,"@"	;01h becomes ^A and so on
	jp	ADDW

T_CR:	call	FLUSHW
	xor	a
	ld	(COLCNT),a
	ld	a,13
	jp	COUT1

T_LF:	call	FLUSHW
	ld	a,10
	jp	COUT1

T_SPC:	call	FLUSHW
	ld	a,(COLCNT)	;A space that would run into the
	inc	a	;right margin becomes the line
	ld	hl,COLS	;break itself.
	cp	(hl)
	jp	nc,CRLF_OUT
	ld	(COLCNT),a
	ld	a," "
	jp	COUT1

T_TAB:	call	FLUSHW
	ld	a,(COLCNT)	;A TAB advances to the next
	or	7	;multiple of 8; running off the
	inc	a	;margin breaks the line instead.
	ld	hl,COLS
	cp	(hl)
	jp	nc,CRLF_OUT
	ld	(COLCNT),a
	ld	a,9
	jp	COUT1

	;--- Add the printable character in A to the current word. A word
	;    as long as a whole line cannot be wordwrapped: it is flushed
	;    as it is and continues on the next line.

ADDW:
	push	af
	ld	a,(WORDLEN)
	ld	hl,COLS
	cp	(hl)
	call	nc,FLUSHW
	ld	a,(WORDLEN)
	ld	hl,WORDBUF
	ld	e,a
	ld	d,0
	add	hl,de
	inc	a
	ld	(WORDLEN),a
	pop	af
	ld	(hl),a
	ret

	;--- Print the buffered word, moving to the next line first when it
	;    does not fit on what is left of the current one.

FLUSHW:
	ld	a,(WORDLEN)
	or	a
	ret	z
	ld	b,a
	ld	a,(COLCNT)
	add	a,b	;Column after the word (Cy for the
	ld	hl,COLS	;paranoid case of width > 128).
	jr	c,FLW_WRAP
	cp	(hl)
	jr	c,FLW_FIT
	jr	z,FLW_FIT	;Exactly filling the line is fine.
FLW_WRAP:
	ld	a,(COLCNT)	;Nothing is gained by wrapping when
	or	a	;already at the start of the line.
	call	nz,CRLF_OUT
FLW_FIT:
	ld	a,(WORDLEN)
	ld	b,a
	ld	hl,WORDBUF
FLW10:	ld	a,(hl)
	push	bc
	push	hl
	call	COUT1
	pop	hl
	pop	bc
	inc	hl
	djnz	FLW10
	ld	a,(WORDLEN)	;Advance the column; when the word
	ld	hl,COLCNT	;ended exactly at the margin the
	add	a,(hl)	;console has wrapped already.
	ld	hl,COLS
	cp	(hl)
	jr	c,FLW20
	sub	(hl)
FLW20:	ld	(COLCNT),a
	xor	a
	ld	(WORDLEN),a
	ret

	;--- Move to the next line

CRLF_OUT:
	ld	a,13
	call	COUT1
	ld	a,10
	call	COUT1
	xor	a
	ld	(COLCNT),a
	ret

	;--- Print the character in A

COUT1:
	push	bc
	push	de
	push	hl
	ld	e,a
	ld	c,_CONOUT##
	call	5
	pop	hl
	pop	de
	pop	bc
	ret

OPTS:	db	0	;Option bits (OPT_BIN/OPT_HID/OPT_SYS)
HNDL:	db	0	;File handle
COLS:	db	0	;Screen width
COLCNT:	db	0	;Current output column
WORDLEN:	db	0	;Characters in the buffered word

IOBUF_LEN	equ	512

PARBUF:	ds	128	;One extracted command line parameter
FSPEC:	ds	128	;The filespec, options stripped
FIB:	ds	64	;FIB for the existence/attribute check
WORDBUF:	ds	256	;The word being accumulated
IOBUF:

	include	../../sdk/asm/constants/msx_bios.inc
	include	../../sdk/asm/constants/msx_workarea.inc

KILBUF	equ	0156h	;Flush the keyboard buffer (main BIOS)

	jp	START

        ;        -------------------------------------------------------------------------------
	db	13
	db	"MORE - Display piped output one screen at a time",13,10
	db	13,10
	db	"The output of the previous command in the pipeline is displayed, pausing",13,10
	db	"after each screenful with a <more> prompt on the last screen line:",13,10
	db	"press ESC or N to stop, or any other key to display the next screenful.",13,10
	db	13,10
	db	"Usage: command | MORE",13,10
	db	1Ah

USAGE_S:
	db	"MORE - Display piped output one screen at a time",13,10
	db	13,10
	db	"Usage: command | MORE",13,10
	db	13,10
	db	"TYPE MORE.COM for more details.",13,10
	db	0

START:
	call	CHK_NEXTOR##

	ld	de,IOBUF
	ld	a,1
	call	EXTPAR##
	jr	c,NO_PARAMS

	ld	de,USAGE_S	;Any parameter: just show the usage
	ld	c,_ZSTROUT##	;text (MORE only makes sense as the
	call	5	;target of a pipe).
	ld	b,0
	ld	c,_TERM##
	jp	5

NO_PARAMS:

	;--- Get the screen size: D = height, E = width
	;    (of the standard output, handle 1)

	ld	a,4
	ld	bc,014Bh
	call	5
	jr	z,SIZE_OK
	ld	de,24*256+80	;Sensible defaults if the IOCTL fails
SIZE_OK:
	ld	a,d
	or	a	;Height 0 means "infinite" (output
	jr	nz,HEIGHT_OK	;redirected): behave as 24 lines.
	ld	a,24
HEIGHT_OK:
	dec	a	;The last screen line is reserved
	ld	(ROWS),a	;for the <more> prompt.
	ld	a,e
	or	a
	jr	nz,WIDTH_OK
	ld	a,80
WIDTH_OK:
	ld	(COLS),a
	xor	a
	ld	(LINCNT),a
	ld	(COLCNT),a

	;--- Main loop: read a chunk from the standard input and print it

MAIN:
	ld	b,0	;Handle 0: standard input
	ld	de,IOBUF
	ld	hl,IOBUF_LEN
	ld	c,_READ##
	call	5
	jr	nz,READ_ERR
	ld	a,h
	or	l
	jr	z,ALL_DONE	;Zero bytes read: end of the input
	push	hl
	pop	bc	;BC = number of bytes to process
	ld	hl,IOBUF
PRLOOP:
	ld	a,(hl)
	cp	1Ah	;A ^Z ends the text
	jr	z,ALL_DONE
	push	hl
	push	bc
	call	PUTCHR
	pop	bc
	pop	hl
	inc	hl
	dec	bc
	ld	a,b
	or	c
	jr	nz,PRLOOP
	jr	MAIN

READ_ERR:
	cp	.EOF##	;.EOF is the normal end of a pipe;
	jr	z,ALL_DONE	;anything else is reported.
	ld	b,a
	ld	c,_TERM##
	jp	5

ALL_DONE:
	ld	b,0
	ld	c,_TERM##
	jp	5

	;--- Print the character in A, keeping count of the screen lines
	;    used; after a screenful, prompt with <more> and wait for a key.
	;    The line accounting follows the console rules: CR returns to
	;    column 0, TAB advances to the next multiple of 8, and a line is
	;    counted on every LF and whenever a character or TAB runs into
	;    the right margin.

PUTCHR:
	ld	e,a
	cp	13
	jr	nz,PUT2
	xor	a	;CR: back to column 0, no line
	ld	(COLCNT),a	;counted.
	jr	COUT
PUT2:
	cp	10
	jr	z,PUT_CNT	;LF: print it and count a line
	cp	9
	jr	nz,PUT3
	ld	a,(COLCNT)	;TAB: advance the column to the
	or	7	;next multiple of 8...
	inc	a
	ld	(COLCNT),a
	ld	hl,COLS
	cp	(hl)
	jr	c,COUT	;...still within the width
	sub	(hl)	;Wrapped: reduce the column modulo
	ld	(COLCNT),a	;the width and count a line.
	jr	PUT_CNT
PUT3:
	ld	a,(COLCNT)	;Ordinary character: advance the
	inc	a	;column.
	ld	(COLCNT),a
	ld	hl,COLS
	cp	(hl)
	jr	c,COUT
	xor	a	;Reached the right margin: wrap to
	ld	(COLCNT),a	;column 0 and count a line.
PUT_CNT:
	call	COUT
	ld	a,(LINCNT)	;Count the line off the screenful.
	inc	a
	ld	(LINCNT),a
	ld	hl,ROWS
	cp	(hl)
	ret	c

	;--- A whole screenful has been printed: show <more> on the last
	;    line and wait for a key. The standard input is the pipe, so the
	;    key is read from the keyboard itself through the BIOS.

	ld	de,MORE_S
	call	CPUTS
	ld	ix,KILBUF	;Flush the keyboard buffer, then
	call	CALBIOS	;wait for a fresh key press.
	ld	ix,CHGET
	call	CALBIOS
	push	af
	ld	de,ERASE_S	;Wipe the <more> prompt so the
	call	CPUTS	;output continues cleanly.
	pop	af
	cp	27	;ESC aborts,
	jr	z,QUIT
	and	0DFh	;and so does N.
	cp	"N"
	jr	z,QUIT
	xor	a	;Anything else: next screenful.
	ld	(LINCNT),a
	ret

QUIT:	jp	ALL_DONE

	;--- Print the character in E (no line accounting)

COUT:
	push	bc
	push	de
	push	hl
	ld	c,_CONOUT##
	call	5
	pop	hl
	pop	de
	pop	bc
	ret

	;--- Print the zero terminated string at DE (no line accounting)

CPUTS:
	ld	a,(de)
	or	a
	ret	z
	push	de
	ld	e,a
	ld	c,_CONOUT##
	call	5
	pop	de
	inc	de
	jr	CPUTS

	;--- Call the main BIOS routine at IX

CALBIOS:
	push	bc
	push	de
	push	hl
	ld	iy,(EXPTBL-1)	;IYh = main BIOS slot
	call	CALSLT
	ei
	pop	hl
	pop	de
	pop	bc
	ret

MORE_S:
	db	"<more>",0
ERASE_S:
	db	13,"      ",13,0

ROWS:	db	0	;Screen lines per pause (height - 1)
COLS:	db	0	;Screen width
LINCNT:	db	0	;Lines printed in the current screenful
COLCNT:	db	0	;Current output column

IOBUF_LEN	equ	512
IOBUF:

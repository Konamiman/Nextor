;******************************************************************************
;
;	VARIABLES AND DATA AREAS
;
MULT_FLAGS:
	db	0	;   b0   - set if accessing FAT sector
			;   b1   - set if FAT sector error found
			;   b2   - set to let FAT error through
			;   b3   - set if any FAT copy written
			;   b4   - set if error on this retry
			;b5...b7 - clear

OPTIONS:
	db	0	;   b0   - set if "/F" option given
			;   b1   - set if lost chains made into files
			;b2...b7 - clear

ER_FLAGS:
	db	0	;   b0   - clear
			;   b1   - set if any error found
			;   b2   - set if file list is dead
			;   b3   - set if cross linked files exist
			;   b4   - set if path error printed
			;   b5   - set while doing cross link check
			;b6...b7 - clear

VOL_FLAG:
	db	0	;   b0   - set if volume name found
			;b1...b7 - clear

DFAT_FLAG:
	db	0	;non 0 if FAT needs to be written back

KANJI_FLAG:
	db	0	;non 0 if the Kanji screen mode is active
			; (print the Japanese messages)
SAVE_SP:
	dw	0	;Saved stack pointer while the EXTBIO call
			; runs on a borrowed page-3 stack

;------------------------------------------------------------------------------

DRIVE:	db	0	;Logical drive used 1...26

FAT:	dw	0	;Address of start of expanded FAT in memory (FAT12)
RAM_START:
	dw	0	;Start of recursion stack memory
RAM_BOT:
	dw	0	;Start of free memory area
RAM_TOP:
	dw	0	;End of free memory area
TPA_TOP:
	dw	0	;End of memory (start of file list)

FILE_PTR:
	dw	0	;Pointer to current file list item

LAST_CLU:
	dw	0	;Temporary storage for cluster number
CH_SIZE:
	dw	0	;Temporary storage for chain length
FREE_FLAG:
	db	0	;Free directory entry found flag

;------------------------------------------------------------------------------
;
;	FAT access layer variables
;
FS_FAT16:
	db	0	;0 = FAT12, 1 = FAT16
EOC_MIN:
	dw	0	;Lowest end of chain value (FF8h/FFF8h)
BAD_VAL:
	dw	0	;Bad cluster value (FF7h/FFF7h)
FAT_SZ16:
	dw	0	;Sectors per FAT copy (16 bit, derived; the byte
			; sized _DPARM field reports a 256 sector FAT as 0)
BM_SIZE:
	dw	0	;Size of each flag bitmap in bytes
BM_BASE:
	dw	0	;Address of the first flag bitmap (FL_CHK)
BM_EOC:
	dw	0	;Address of the "set to end of chain" overlay
			; bitmap (FAT16 only)
FREE_MODE:
	db	0	;non 0 => lost clusters are being freed and the
			; FL_CHK bitmap is reused as the "freed" overlay
			; (FAT16 only)
CACHE_BASE:
	dw	0	;Address of the FAT16 sector cache buffers
CACHE_TAB:
	ds	CACHE_SECT*2,0	;Per slot: valid flag, FAT-relative sector
CACHE_RR:
	db	0	;Round-robin replacement counter

EOC_ANY:
	db	0	;non 0 => at least one entry has been recorded in
			; the "set to end of chain" overlay (enables the
			; overlay test in GET_FAT_RAW)

G16_OK:
	db	0	;non 0 => the GET16_PTR memo below is valid
G16_KEY:
	db	0	;FAT-relative sector of the memoized cache slot
G16_BASE:
	dw	0	;Base address of the memoized cache slot

BM_P_CHK:
	dw	0	;Base address of the FL_CHK bitmap...
BM_P_LOST:
	dw	0	;...the FL_LOST bitmap...
BM_P_XLNK:
	dw	0	;...the FL_XLINK bitmap...
BM_P_CHAIN:
	dw	0	;...and the FL_CHAIN bitmap.  These four must stay
			; together and in this order (FLAG_BASE indexes them
			; by flag number).

PROG_PCT:
	db	0	;Progress display: current percentage...
PROG_BASE:
	db	0	;...percentage at the start of the current pass...
PROG_LIM:
	db	0	;...display cap within the current pass...
PROG_CNT:
	dw	0	;...iterations left until the next update...
PROG_STEP:
	dw	0	;...and iterations per 1% within a pass.
PROG_ACT:
	db	0	;Status line currently displayed: 0 = none,
			; 1 = "Checking drive X:..." without percentage,
			; 2 = same with the percentage appended,
			; 3 = "Collecting information...".
			; Any non 0 value is erased by PROG_CLEAR.

CUR_SEC:
	db	0,0,0,0	;32 bit sector number parameter for the sector
			; I/O routines
RF_SEC:
	dw	0	;First-copy absolute sector, used by R_FSECT16

BUFFER_SECT:
	db	0FFh,0FFh,0FFh,0FFh	;Current 32 bit sector number in
					; buffer (FFFFFFFFh = none)
BUFFER_FLAG:
	db	0	;b0 - set => buffer is dirty
			;b1 - set => FAT sector
BUFFER:
	ds	512,0	;Single sector buffer

;------------------------------------------------------------------------------

DIR_COUNT:
	dw	0	;Number of directories found
DIR_CLU:
	dw	0	;Number of clusters in directories

SYS_COUNT:
	dw	0	;Number of system files found
SYS_CLU:
	dw	0	;Number of clusters in system files

HID_COUNT:
	dw	0	;Number of hidden files found
HID_CLU:
	dw	0	;Number of clusters in hidden files

FIL_COUNT:
	dw	0	;Number of user files found
FIL_CLU:
	dw	0	;Number of clusters in user files

BAD_CLU:
	dw	0	;Number of bad clusters

RES_CLU:
	dw	0	;Number of reserved clusters

LST_COUNT:
	dw	0	;Number of lost cluster chains
LST_CLU:
	dw	0	;Number of lost clusters

AVL_CLU:
	dw	0	;Number of available clusters

FRED_CLU:
	dw	0	;Number of freed clusters

REC_COUNT:
	dw	0	;Number of files recovered
REC_CLU:
	dw	0	;Clusters in recovered files

;------------------------------------------------------------------------------

	ds	256,0	;I think this will just about
STACK:			; be enough stack!

;	--------------------------------

UD_IMAGE:		;Copy of MSX-DOS's disc parameters (_DPARM).
	db	0	;+0  Physical drive (not used)
	dw	0	;+1  Sector size (not used, always 512)
SEC_CLU:
	db	0	;+3  Sectors per cluster.
FAT_START:
	dw	0	;+4  First sector of FAT
FAT_COPY:
	db	0	;+6  Number of copies of the FAT
RT_ENT:
	dw	0	;+7  Number of root directory entries.
	dw	0	;+9  Number of logical sectors (0 if >= 65536)
	db	0	;+11 Media descriptor byte.
	db	0	;+12 Size of each FAT copy in sectors (not used:
			;    unreliable, a 256 sector FAT16 FAT is
			;    reported as 0.  See FAT_SZ16.)
RT_START:
	dw	0	;+13 First sector of root directory
DATA_START:
	dw	0	;+15 First data sector (cluster 2)
TOT_CLU:
	dw	0	;+17 Maximum cluster number + 1
DIRT_FLAG:
	db	0	;+19 Dirty disk flag (non-zero => dirty)
VOL_ID:
	db	0,0,0,0	;+20 Four byte volume id (FFh in first byte =>
			;    no volume id)
	db	0,0,0,0	;+24 Number of logical sectors, 32 bits (Nextor)
FS_TYPE:
	db	0	;+28 Filesystem: 0=FAT12, 1=FAT16, 255=other
			;    (Nextor 2.1+)
	db	0,0,0	;+29 Reserved

CLU_SHIFT:
	db	0	;Worked out internally.

;	--------------------------------

SV_START:

DIR_START:
	dw	0	;First cluster of directory (FFFFh = root)
DIR_NEXT_CLU:
	dw	0	;Next directory cluster (FFFFh = none)
DIR_SECTOR:
	db	0,0,0,0	;Current directory sector (32 bits)
DIR_S_LEFT:
	db	0	;Sectors left in current dir cluster
DIR_E_LEFT:
	db	0	;Entries left in current dir sector
DIR_ENT:
	db	0	;Total entries in current sector
DIR_ODD:
	db	0	;Number entries in partial sector
DIR_PARENT:
	dw	0	;Cluster number of parent directory
DIR_ADDR:
	dw	0	;Address of parent's file record

SV_SIZE	equ	$-DIR_START	;Size of directory search variables

SV_COPY:
	ds	SV_SIZE,0	;Space for a copy of search variables

;------------------------------------------------------------------------------
;
;	This label must be the last one of the program: it defines the
; address from which general RAM usage (flag bitmaps, expanded FAT or
; sector cache, directory recursion save areas and the file list) starts.
;
PROG_END:

	end

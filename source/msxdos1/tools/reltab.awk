# Generates a relocation table include file from the output of
# "cmp -l" applied to two assemblies of the same relocatable code made at
# addresses one page apart.
#
# Each line of "cmp -l" output is: <1-based offset> <byte 1> <byte 2>,
# with the bytes in octal. Every differing byte must be the high byte of an
# address (so the second one is the first one plus one); anything else means
# that the code is not relocatable this way, and is reported as an error.

function oct(s,   v, i) {
    v = 0
    for (i = 1; i <= length(s); i++)
        v = v * 8 + substr(s, i, 1)
    return v
}

BEGIN {
    print ";"
    print ";        Relocation table, generated by the Makefile. Do not edit."
    print ";"
    count = 0
}

$1 !~ /^[0-9]+$/ {
    print "reltab.awk: unexpected cmp output: " $0 > "/dev/stderr"
    exit 1
}

{
    if ((oct($3) - oct($2) + 256) % 256 != 1) {
        printf "reltab.awk: byte at offset %04Xh differs by other than 1\n", $1 - 1 > "/dev/stderr"
        exit 1
    }
    printf "\tDEFW\t0%04XH\n", $1 - 1
    count++
}

END {
    printf ";\n; %d entries.\n", count
}

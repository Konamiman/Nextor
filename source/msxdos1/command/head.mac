	SUBTTL	Entry jump and relocation table
;******************************************************************************
;
;        COMMAND.COM is loaded at 100h and executed there, either by
; MSXDOS.SYS (when the copy in high memory is not intact) or as any other
; transient program. The first instruction jumps over the relocation table
; to the loader, which starts on the next page boundary.
;
;        The relocation table is a list of words, terminated by a zero word.
; Each word is the offset, relative to the start of the loader page, of a
; byte that holds the high byte of an address pointing inside the
; relocatable part. The table is generated by the Makefile (see
; command.mac).
;
;******************************************************************************
;
	JP	LOADER
;
	IF	$ NE RELTAB
	 .ERROR	The relocation table must start at RELTAB
	ENDIF
;
	include	"reltab.inc"
	DEFW	0		; End of table.
;
;        Padding up to the loader page.
;
	.ALIGN	100H

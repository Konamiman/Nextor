	SUBTTL	Entry jump and relocation table
;******************************************************************************
;
;        MSXDOS.SYS is loaded at 100h by the disk ROM boot code and executed
; there. The first instruction jumps over the relocation table to the
; loader, which starts on the next page boundary.
;
;        The relocation table is a list of words, terminated by a zero word.
; Each word is the offset, relative to the start of the loader page, of a
; byte that holds the high byte of an address pointing inside the
; relocatable part; the loader adds to all of these the page offset between
; the assembled address and the final address of the code. The table is
; generated by the Makefile (see msxdos.mac).
;
;******************************************************************************
;
	JP	LOADER
;
	IF	$ NE RELTAB
	 .ERROR	The relocation table must start at RELTAB
	ENDIF
;
	include	"reltab.inc"
	DEFW	0		; End of table.
;
;        Padding up to the loader page.
;
	.ALIGN	100H

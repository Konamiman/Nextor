	DEFB	0	; End of table.

;        The variable function table, scanned by the %var% expander (RPC170
; in cli.mac) when a variable name starts with "@"; the name is matched up
; to the opening "[".
;        Each entry is a length byte, the name and a DEFW with the handler
; address (see intvar.mac; the handler is called with HL -> the ASCIIZ
; argument text from between the brackets, with nested constructs already
; expanded, and returns DE -> ASCIIZ result). Terminated by a zero length
; byte.
FNTAB::	DEFB	3
	DEFB	"EXT"
	DEFW	FN_EXT##

	DEFB	3
	DEFB	"HEX"
	DEFW	FN_HEX##


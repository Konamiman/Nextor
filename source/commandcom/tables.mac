	name('tables')
	TITLE	Nextor - COMMAND3.COM
	SUBTTL	Dispatch tables
	INCLUDE	command.inc
;******************************************************************************
;
;        The dispatch tables: TABORDER values, the internal command table,
; the internal variable (%_VAR%) table and the variable function
; (%@FUN[...]%) table.
;
;        Based on COMMAND.COM 2.31, copyright (1986) IS Systems Ltd, and on
; the COMMAND2.COM 2.40/2.41 additions by Fokke Post, whose source code was
; released as freeware in 2003.
;
;******************************************************************************
;        All four tables share one format and lookup scheme: each entry
; starts with a length byte followed by the name text, and the entries are
; stored in ascending order of name length. The searchers all use COMPARE
; (cli.mac), which matches case-insensitively and stops the scan at the
; first entry whose length byte is bigger than that of the name looked up.
;
;        The TABORDER value table, tried against the value of the TABORDER
; environment item by the TAB filename completion (TAB30 in editor.mac).
;        Each entry is a length byte, the item text and one flag byte, the
; FDFLAGS value to use: b0 => complete files, b1 => complete directories,
; b2 => switch to the other kind when the first one has no more matches.
;        The table ends with an explicit zero length byte, which the
; scan takes as 'no match' (without it, an unmatched TABORDER value long
; enough would run the scan into CMDTAB). When no entry matches (or
; TABORDER is not set) the default is %00000011.
ORDTAB::	DEFB	3
	DEFB	"DIR"
	DEFB	%00000010	; Directories only.

	DEFB	4
	DEFB	"BOTH"
	DEFB	%00000011	; Files and directories mixed.

	DEFB	4
	DEFB	"FILE"
	DEFB	%00000001	; Files only.

	DEFB	8
	DEFB	"DIR,FILE"
	DEFB	%00000110	; Directories first, then files.

	DEFB	8
	DEFB	"FILE,DIR"
	DEFB	%00000101	; Files first, then directories.

	DEFB	0	; End of the table.

;        The internal command table, scanned by the command dispatcher
; (DC10 in cli.mac) against the first word of the command line.
;        Each entry is a length byte, the command name and a DEFW with the
; handler address. The zero length byte at CMDTEND terminates the table.
CMDTAB::	DEFB	2
	DEFB	"IF"
	DEFW	@IF##

	DEFB	2
	DEFB	"CD"
	DEFW	@CHDIR##

	DEFB	2
	DEFB	"RD"
	DEFW	@RMDIR##

	DEFB	2
	DEFB	"MD"
	DEFW	@MKDIR##

	DEFB	3
	DEFB	"CDD"
	DEFW	@CDD##

	DEFB	3
	DEFB	"CLS"
	DEFW	@CLS##

	DEFB	3
	DEFB	"CPU"
	DEFW	@CPU##

	DEFB	3
	DEFB	"DEL"
	DEFW	@ERASE##

	DEFB	3
	DEFB	"DIR"
	DEFW	@DIR##

	DEFB	3
	DEFB	"END"
	DEFW	@END##

	DEFB	3
	DEFB	"ERA"
	DEFW	@ERASE##

	DEFB	3
	DEFB	"IFF"
	DEFW	@IFF##

	DEFB	3
	DEFB	"MEM"

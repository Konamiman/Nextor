;        The terminating zero also doubles as the shared empty string: the
; %var% expander and the variable functions return DE -> CMDTEND for a null
; value (RPC90 in cli.mac, FND90 in intvar.mac).
CMDTEND::	DEFB	0	; End of table.

;        The internal variable table, scanned by the %var% expander (RPC80
; in cli.mac) when a variable name starts with "_"; the names are stored
; without the underscore, which the expander skips before searching.
;        Each entry is a length byte, the name and a DEFW with the handler
; address (see intvar.mac; the handler is called with no arguments and
; returns DE -> ASCIIZ value). Terminated by a zero length byte.
IVTAB::	DEFB	2
	DEFB	"BG"
	DEFW	IV_BG##

	DEFB	2
	DEFB	"FG"
	DEFW	IV_FG##

	DEFB	3
	DEFB	"CPU"
	DEFW	IV_CPU##

	DEFB	3
	DEFB	"CWD"
	DEFW	IV_CWD##

	DEFB	3
	DEFB	"CWP"
	DEFW	IV_CWP##

	DEFB	3

GetAlloc:	LD	A,(HL)
	CALL	MakeCapital
	SUB	"@"
	RET	C
	CP	9
	CCF
	RET	C
	LD	E,A
	INC	HL
	LD	A,(HL)
	CP	":"
	SCF
	RET	NZ
	INC	HL
	CALL	FndFirstChr
	SCF
	RET	Z
	CALL	MakeCapital

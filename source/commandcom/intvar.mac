	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,A
	RL	L
	OR	E
	LD	D,L
	LD	HL,BufEnvName+1
	LD	(HL),D
	DEC	HL
	LD	(HL),A
	EX	AF,AF'
	SBC	A,A
	LD	C,A
	LD	IX,BufEnvName+2
	PUSH	IX
	CALL	PrintDate
	POP	DE
	INC	DE
	RET


	RET

SetAbort:	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	DE,ErrorHand1
	LD	C,_DEFER
	CALL	BDOS
	LD	DE,AbortExit3
	LD	C,_DEFAB
	CALL	BDOS
	POP	AF
	POP	HL
	POP	DE
	POP	BC
	RET

ResetAbort:	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	DE,#00
	LD	C,_DEFER
	CALL	BDOS
	LD	DE,AbortExit2
	LD	C,_DEFAB
	CALL	BDOS
	POP	AF
	POP	HL
	POP	DE
	POP	BC
	RET


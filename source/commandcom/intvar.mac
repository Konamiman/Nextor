	RET	Z
	LD	DE,Text_R800
	RET

Text_Z80:	DEFB	"Z80",0
Text_R800:	DEFB	"R800",0

Int_Msxver:	LD	A,(MSXVersion)
	LD	DE,Text_MSX2
	DEC	A
	RET	Z
	LD	DE,Text_MSX3
	DEC	A
	RET	Z
	LD	DE,Text_MSX4
	RET

Text_MSX2:	DEFB	"MSX-2",0
Text_MSX3:	DEFB	"MSX-2+",0
Text_MSX4:	DEFB	"Turbo-R",0

Int_Cwds:	SCF
Int_Cwd:	EX	AF,AF'
	CALL	SetAbort
	LD	HL,BufEnvName
	LD	A,(CurrentDrive)
	LD	B,A
	ADD	A,"@"
	LD	(HL),A
	INC	HL
	LD	(HL),":"
	INC	HL
	LD	(HL),"\"
	INC	HL
	LD	(HL),#00
	EX	DE,HL
	LD	C,_GETCD
	CALL	BDOS
	OR	A
	LD	DE,BufEnvName
	PUSH	DE
	JR	NZ,Next_0459
	EX	AF,AF'
	JR	NC,Next_0460
	LD	BC,_PARSE
	CALL	BDOS
	DEC	DE
	LD	A,(DE)
	CP	"\"
	INC	DE
	JR	Z,Next_0460
	LD	A,"\"
	LD	(DE),A
Next_0459:	XOR	A
	INC	DE
	LD	(DE),A
Next_0460:	CALL	ResetAbort
	POP	DE
	JP	Lower

Int_Cwps:	SCF
Int_Cwp:	CALL	Int_Cwd
	INC	DE
	LD	A,(DE)

	TITLE	MSX-DOS 2 - COMMAND2.COM
	SUBTTL	Internal variables and variable functions
;******************************************************************************
;
;        Implementations of the internal variables (%_VAR%) and of the
; variable functions (%@FUN[parameters]%), both new in COMMAND2.COM 2.40.
;
;        Based on COMMAND.COM 2.31, copyright (1986) IS Systems Ltd, and on
; the COMMAND2.COM 2.40/2.41 additions by Fokke Post, whose source code was
; released as freeware in 2003.
;
;******************************************************************************
IV_DIRBUFFER:	LD	DE,DIRBUF
	JR	CHKLOW

IV_BOOT:	LD	A,(BOOTDRV)
IVB10:	LD	HL,ENVNAME+1
	LD	(HL),#00
	DEC	HL
	ADD	A,"@"
	LD	(HL),A
	EX	DE,HL
CHKLOW:	PUSH	DE
	LD	HL,LOWER$
	CALL	ON?
	POP	DE
	RET	C
	PUSH	DE
CHK10:	LD	A,(DE)
	CALL	MKLOWER
	LD	(DE),A
	INC	DE
	OR	A
	JR	NZ,CHK10
	POP	DE
	RET

IV_DISK:	LD	A,(CURDRIVE)
	JR	IVB10

IV_COLUMN:	LD	A,(CSRX)
IVC10:	LD	IX,ENVNAME
	PUSH	IX
	CALL	D8
	POP	DE
	RET

IV_COLUMNS:	LD	A,(LINLEN)
	JR	IVC10

IV_BG:	LD	A,(BAKCLR)
	JR	IVC10

IV_FG:	LD	A,(FORCLR)
	JR	IVC10

IV_ROW:	LD	A,(CSRY)
	JR	IVC10

IV_ROWS:	LD	A,(CRTCNT)
	JR	IVC10

IV_ERROR:	LD	A,(ABORTERR)
	JR	IVC10

IV_DRIVEMAP:	LD	C,_LOGIN
	CALL	BDOS
	LD	C,L
	JP	FNP10

IV_SHELL:	CALL	SETPG2
	LD	HL,#3FFF
	LD	DE,(VAREND+#8000)
	RES	7,D
	OR	A
	SBC	HL,DE
	CALL	RSTPG2
	LD	DE,BUFFER1-EXITADDR
	XOR	A
IVS10:	INC	A
	SBC	HL,DE
	JR	NC,IVS10
	DEC	A
	JR	IVC10

IV_CPU:	LD	A,(MSXVER)
	LD	DE,Z80$
	CP	3
	RET	C
	LD	IX,#0183
	CALL	CALLSLOT
	LD	A,E
	LD	DE,Z80$
	OR	A
	RET	Z
	LD	DE,R800$
	RET

Z80$:	DEFB	"Z80",0
R800$:	DEFB	"R800",0

IV_MSXVER:	LD	A,(MSXVER)
	LD	DE,MSX2$
	DEC	A
	RET	Z
	LD	DE,MSX2P$
	DEC	A
	RET	Z
	LD	DE,TURBOR$
	RET

MSX2$:	DEFB	"MSX-2",0
MSX2P$:	DEFB	"MSX-2+",0
TURBOR$:	DEFB	"Turbo-R",0

IV_CWDS:	SCF
IV_CWD:	EX	AF,AF'
	CALL	SETABT
	LD	HL,ENVNAME
	LD	A,(CURDRIVE)
	LD	B,A
	ADD	A,"@"
	LD	(HL),A
	INC	HL
	LD	(HL),":"
	INC	HL
	LD	(HL),"\"
	INC	HL
	LD	(HL),#00
	EX	DE,HL
	LD	C,_GETCD
	CALL	BDOS
	OR	A
	LD	DE,ENVNAME
	PUSH	DE
	JR	NZ,IVC20
	EX	AF,AF'
	JR	NC,IVC30
	LD	BC,_PARSE
	CALL	BDOS
	DEC	DE
	LD	A,(DE)
	CP	"\"
	INC	DE
	JR	Z,IVC30
	LD	A,"\"
	LD	(DE),A
IVC20:	XOR	A
	INC	DE
	LD	(DE),A
IVC30:	CALL	RSTABT
	POP	DE
	JP	CHKLOW

IV_CWPS:	SCF
IV_CWP:	CALL	IV_CWD
	INC	DE
	LD	A,(DE)
	OR	A
	RET	Z
	INC	DE
	RET

IV_DATEF:	SCF
IV_DATE:	EX	AF,AF'
	CALL	DFORM
	LD	C,_GDATE
	CALL	BDOS
	LD	BC,#F844
	ADD	HL,BC
	LD	A,D
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,A
	RL	L
	OR	E
	LD	D,L
	LD	HL,ENVNAME+1
	LD	(HL),D
	DEC	HL
	LD	(HL),A
	EX	AF,AF'
	SBC	A,A
	LD	C,A
	LD	IX,ENVNAME+2
	PUSH	IX
	CALL	DDATE
	POP	DE
	INC	DE
	RET

IV_DOSVER:	LD	DE,DOSVER$
	RET

DOSVER$:	DEFB	"2.41",0

IV_DOW:	LD	C,_GDATE
	CALL	BDOS
	ADD	A,#17
	CALL	GETMSG
	EX	DE,HL
	LD	DE,ENVNAME
	CALL	NCOPY
	DEC	DE
	PUSH	DE
	LD	A,#1E
	CALL	GETMSG
	EX	DE,HL
	POP	DE
	CALL	NCOPY
	LD	DE,ENVNAME
	RET

IV_TIME:	CALL	TFORM
	LD	C,_GTIME
	CALL	BDOS
	PUSH	DE
	LD	A,L
	ADD	A,A
	ADD	A,A
	LD	B,#03
IVT10:	ADD	A,A
	RL	H
	DJNZ	IVT10
	LD	C,H
	LD	HL,ENVNAME
	LD	(HL),A
	INC	HL
	LD	(HL),C
	LD	IX,ENVNAME+2
	CALL	DTIME
	POP	BC
	PUSH	AF
	LD	(IX),":"
	INC	IX
	LD	A,B
	LD	D,#FF
	CALL	PRFIG2
	POP	AF
	CP	" "
	JR	Z,IVT20
	LD	(IX),A
	INC	IX
IVT20:	LD	(IX),#00
	LD	DE,ENVNAME+3
	RET

SETABT:	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	DE,DSKERR
	LD	C,_DEFER
	CALL	BDOS
	LD	DE,ABRT
	LD	C,_DEFAB
	CALL	BDOS
	POP	AF
	POP	HL
	POP	DE
	POP	BC
	RET

RSTABT:	PUSH	BC
	PUSH	DE
	PUSH	HL
	PUSH	AF
	LD	DE,#00
	LD	C,_DEFER
	CALL	BDOS
	LD	DE,CLI_ABORT
	LD	C,_DEFAB
	CALL	BDOS
	POP	AF
	POP	HL
	POP	DE
	POP	BC
	RET

IV_FNEXT:	CALL	SETABT
	LD	IX,FIB3
	LD	C,_FNEXT
	CALL	BDOS
	CALL	RSTABT
	OR	A
	JP	NZ,FND90
	LD	HL,FIB3+#15
	LD	DE,FILETOT1
	CALL	ADD32
	LD	HL,(FILECNT)
	INC	HL
	LD	(FILECNT),HL
	LD	DE,FIB3+1
	RET

IV_FILECOUNT:	LD	HL,(FILECNT)
	LD	IX,ENVNAME
	PUSH	IX
	CALL	D16
	POP	DE
	RET

FN_ALIAS:	LD	DE,ENVNAME
	CALL	GETALIAS
	RET

FN_ASCII:	LD	A,(HL)
	LD	IX,ENVNAME
	PUSH	IX
	CALL	D8
	POP	DE
	RET

FN_ATTRIB:	EX	DE,HL
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	EX	DE,HL
	XOR	A
	LD	(HL),A
	LD	(ATTRIB1),A
FNA10:	INC	HL
	CALL	GETCH
	JR	Z,FNA40
	CALL	UC
	CP	"N"
	LD	B,A
	LD	A,#00
	JR	Z,FNA30
	LD	DE,ATTRTAB
FNA20:	LD	A,(DE)
	OR	A
	JR	Z,FNA10
	CP	B
	INC	DE
	LD	A,(DE)
	INC	DE
	JR	NZ,FNA20
	LD	B,A
	LD	A,(ATTRIB1)
	OR	B
FNA30:	LD	(ATTRIB1),A
	JR	FNA10

FNA40:	CALL	SETABT
	POP	DE
	LD	C,_ATTR
	XOR	A
	CALL	BDOS
	OR	A
	JR	Z,FNA50
	LD	L,#FF
FNA50:	CALL	RSTABT
	LD	DE,ENVNAME+1
	LD	(DE),A
	DEC	DE
	LD	A,"0"
	LD	(DE),A
	LD	A,(ATTRIB1)
	CP	L
	RET	NZ
	LD	A,"1"
	LD	(DE),A
	RET

ATTRTAB:	DEFB	"R",#01
	DEFB	"H",#02
	DEFB	"S",#04
	DEFB	"D",#10
	DEFB	"A",#20

FN_CHAR:	CALL	GET8
	JP	NZ,FND90
	LD	HL,ENVNAME+1
	LD	(HL),#00
	DEC	HL
	LD	(HL),E
	EX	DE,HL
	RET

FN_HEX:	CALL	GET16
	JP	NZ,FND90
	LD	HL,ENVNAME
	PUSH	HL
	LD	A,D
	CALL	MKBYTE
	LD	A,E
	CALL	MKBYTE
	LD	(HL),#00
	POP	DE
	RET

FN_DISKFREE:	CALL	GETALLOC
FND20:	JR	C,FND90
	DEFB	#3E
FND30:	ADD	HL,HL
FND40:	SRL	B
	JR	NZ,FND30
	LD	E,#00
	LD	D,L
	LD	L,H
	LD	H,E
	SLA	D
	ADC	HL,HL
FND50:	LD	(VALUEL),DE
	LD	(VALUEH),HL
	EX	AF,AF'
	CP	"B"
	JR	Z,FND80
	LD	B,10
FND60:	SRL	H
	RR	L
	RR	D
	RR	E
	DJNZ	FND60
	LD	(VALUEL),DE
	LD	(VALUEH),HL
	CP	"K"
	JR	Z,FND80
	LD	B,10
FND70:	SRL	H
	RR	L
	RR	D
	RR	E
	DJNZ	FND70
	LD	(VALUEL),DE
	LD	(VALUEH),HL
FND80:	LD	DE,VALUEL
	XOR	A
	LD	IX,ENVNAME
	PUSH	IX
	CALL	D32
	POP	DE
	XOR	A
	RET

FND90:	LD	DE,CMDTEND
	RET

FN_FILETOTAL:	LD	A,(HL)
	CALL	MKUPPER
	EX	AF,AF'
	LD	DE,(FILETOT1)
	LD	HL,(FILETOT2)
	JR	FND50

GETALLOC:	LD	A,(HL)
	CALL	UC
	SUB	"@"
	RET	C
	CP	9
	CCF
	RET	C
	LD	E,A
	INC	HL
	LD	A,(HL)
	CP	":"
	SCF
	RET	NZ
	INC	HL
	CALL	GETCH
	SCF
	RET	Z
	CALL	UC
	CP	"B"
	JR	Z,GET10
	CP	"K"
	JR	Z,GET10
	CP	"M"
	SCF
	RET	NZ
GET10:	EX	AF,AF'
	CALL	SETABT
	LD	C,_ALLOC
	CALL	BDOS
	CALL	RSTABT
	LD	IY,REDIRST
	LD	B,A
	INC	A
	SCF
	RET	Z
	OR	A
	RET

FN_DISKTOTAL:	CALL	GETALLOC
	EX	DE,HL
	JP	FND20

FN_DISKUSED:	CALL	GETALLOC
	JP	C,FND90
	EX	DE,HL
	OR	A
	SBC	HL,DE
	JP	FND40

FN_FILEDATE:	SCF
FN_FILETIME:	EX	AF,AF'
	EX	DE,HL
	PUSH	DE
	CALL	DFORM
	CALL	TFORM
	POP	DE
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	EX	DE,HL
	POP	DE
	PUSH	HL
	CALL	GETCH
	POP	HL
	JP	NZ,FND90
	LD	(HL),A
	CALL	SETABT
	LD	C,_FTIME
	CALL	BDOS
	CALL	RSTABT
	OR	A
	JP	NZ,FND90
	EX	AF,AF'
	JR	NC,FNF10
	EX	DE,HL
FNF10:	EX	AF,AF'
	LD	HL,ENVNAME
	LD	(HL),E
	INC	HL
	LD	(HL),D
	LD	IX,ENVNAME+2
	EX	AF,AF'
	JR	C,FNF40
	PUSH	DE
	CALL	DTIME
	POP	BC
	PUSH	AF
	LD	(IX),":"
	INC	IX
	LD	A,C
	AND	%00011111
	ADD	A,A
	LD	D,#FF
	CALL	PRFIG2
	POP	AF
	CP	" "
	JR	Z,FNF20
	LD	(IX),A
	INC	IX
FNF20:	LD	(IX),#00
FNF30:	LD	DE,ENVNAME+3
	RET

FNF40:	DEC	HL
	LD	C,#00
	CALL	DDATE
	JR	FNF30

FN_FILESIZE:	EX	DE,HL
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	EX	DE,HL
	XOR	A
	LD	(HL),A
	POP	DE
	LD	A,B
	AND	%01100000
	JP	NZ,FND90
	INC	HL
	CALL	GETCH
	JP	Z,FND90
	CALL	UC
	CP	"B"
	JR	Z,FNF50
	CP	"K"
	JR	Z,FNF50
	CP	"M"
	JP	NZ,FND90
FNF50:	EX	AF,AF'
	CALL	SETABT
	LD	C,_FFIRST
	LD	B,#16
	LD	IX,FIB1
	CALL	BDOS
	CALL	RSTABT
	OR	A
	JR	Z,FNF60
	JP	FND90

FNF60:	LD	HL,FIB1+#15
	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	INC	HL
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	JP	FND50

FN_FILEATTR:	EX	DE,HL
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	EX	DE,HL
	POP	DE
	PUSH	HL
	CALL	GETCH
	POP	HL
	JP	NZ,FND90
	LD	(HL),A
	CALL	SETABT
	LD	C,_ATTR
	CALL	BDOS
	CALL	RSTABT
	OR	A
	JP	NZ,FND90
	LD	A,L
	LD	DE,ENVNAME
	PUSH	DE
	LD	HL,ATTRLST$
	LD	B,#08
FNF70:	RLA
	JR	NC,FNF80
	PUSH	AF
	LD	A,(HL)
	LD	(DE),A
	POP	AF
	INC	DE
FNF80:	INC	HL
	DJNZ	FNF70
	XOR	A
	LD	(DE),A
	POP	DE
	RET

ATTRLST$:	DEFB	"--ADVSHR"

FN_LABEL:	EX	DE,HL
	CALL	SETABT
	LD	BC,#0840
	LD	IX,FIB1
	CALL	BDOS
	CALL	RSTABT
	CP	.IDRV
	JP	Z,FND90
	CP	.NOFIL
	JP	Z,FND90
	CP	#FF
	JP	Z,FND90
	LD	DE,FIB1+1
	RET

FN_READY:	PUSH	HL
	CALL	PARSDR
	POP	DE
	LD	B,#00
	JR	NZ,FNR10
	CALL	SETABT
	LD	BC,#0840
	LD	IX,FIB1
	CALL	BDOS
	CALL	RSTABT
	LD	B,"1"
	OR	A
	JR	Z,FNR10
	CP	.NOFIL
	JR	Z,FNR10
	LD	B,"0"
	CP	#FF
	JR	Z,FNR10
	LD	B,#00
FNR10:	LD	HL,ENVNAME
	PUSH	HL
	LD	(HL),B
	INC	HL
	LD	(HL),#00
	POP	DE
	RET

FN_EXT:	EX	DE,HL
	LD	BC,_PARSE
	CALL	BDOS
	EX	DE,HL
	LD	HL,ENVNAME
	LD	C,_PFILE
	CALL	BDOS
	LD	(ENVNAME+11),A
	LD	DE,ENVNAME+8
	RET

FN_LEN:	LD	B,#FF
FNL10:	LD	A,(HL)
	INC	B
	INC	HL
	OR	A
	JR	NZ,FNL10
	LD	A,B
	JP	IVC10

FN_INSTR:	LD	E,#00
	CALL	GETDIG
	JR	C,FNI10
	CALL	GET8
	JP	NZ,FND90
FNI10:	PUSH	DE
	CALL	GETCH
	CALL	PRSSTR
	POP	DE
	JP	Z,FND90
	CALL	STRIP
	PUSH	HL
	LD	B,E
	LD	E,#00
	LD	HL,XBUF1-1
	DEC	B
	INC	B
	JR	Z,FNI30
FNI20:	INC	HL
	INC	E
	LD	A,(HL)
	OR	A
	JR	Z,FNI60
	DJNZ	FNI20
	DEC	HL
	DEC	E
FNI30:	LD	B,H
	LD	C,L
	POP	HL
FNI40:	INC	BC
	INC	E
	LD	A,(BC)
	OR	A
	JR	Z,FNI50
	PUSH	BC
	PUSH	HL
	CALL	CHKEQ
	POP	HL
	POP	BC
	JR	NZ,FNI40
	LD	A,E
	JP	IVC10

FNI50:	XOR	A
	JP	IVC10

FNI60:	POP	HL
	JP	FND90

PRSSTR:	EX	DE,HL
	LD	HL,XBUF1
	LD	C,#00
PRS20:	CALL	RDCHAR
	JR	C,PRS30
	CP	","
	JR	Z,PRS50
	OR	A
PRS30:	JR	NC,PRS40
	CP	C
	JR	Z,PRS20
PRS40:	LD	(HL),A
	INC	HL
	OR	A
	RET	Z
	JR	PRS20

PRS50:	XOR	A
	LD	(HL),A
	EX	DE,HL
	INC	A
	RET

FN_LOWER:	EX	DE,HL
	PUSH	DE
	JP	CHK10

FN_UPPER:	EX	DE,HL
	PUSH	DE
FNU10:	LD	A,(DE)
	CALL	MKUPPER
	LD	(DE),A
	INC	DE
	OR	A
	JR	NZ,FNU10
	POP	DE
	RET

FN_NAME:	EX	DE,HL
	LD	BC,_PARSE
	CALL	BDOS
	EX	DE,HL
	LD	HL,ENVNAME
	LD	C,_PFILE
	CALL	BDOS
	LD	(ENVNAME+8),A
	LD	DE,ENVNAME
	RET

FN_FILE:	EX	DE,HL
	LD	BC,_PARSE
	CALL	BDOS
	EX	DE,HL
	RET

FN_PATH:	EX	DE,HL
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	LD	(HL),#00
	POP	DE
	RET

FN_MID:	CALL	PRSSTR
	CALL	NZ,GETCH
	JP	Z,FND90
	CALL	GET8
	JP	NZ,FND90
	LD	A,E
	PUSH	AF
	CALL	GETCH
	LD	E,A
	JR	Z,FNM10
	CALL	GET8
FNM10:	POP	BC
	LD	HL,XBUF1-1
FNM20:	INC	HL
	LD	A,(HL)
	OR	A
	JP	Z,FND90
	DJNZ	FNM20
	PUSH	HL
	LD	B,E
FNM30:	INC	HL
	LD	A,(HL)
	OR	A
	JR	Z,FNM40
	DJNZ	FNM30
FNM40:	LD	(HL),#00
	POP	DE
	RET

FN_LEFT:	CALL	PRSSTR
	CALL	NZ,GETCH
	JP	Z,FND90
	LD	A,(HL)
	CP	"-"
	JR	NZ,FNL30
	INC	HL
	PUSH	HL
	LD	HL,XBUF1
	LD	B,#FF
FNL20:	LD	A,(HL)
	INC	B
	INC	HL
	OR	A
	JR	NZ,FNL20
	POP	HL
	PUSH	BC
	CALL	GET8
	POP	BC
	JP	NZ,FND90
	LD	A,B
	SUB	E
	LD	E,A
	JR	NC,FNL40
	LD	E,#00
	JR	FNL40

FNL30:	CALL	GET8
	JP	NZ,FND90
FNL40:	LD	HL,XBUF1
	PUSH	HL
	LD	B,E
	JR	FNM30

FN_RIGHT:	CALL	PRSSTR
	CALL	NZ,GETCH
	JP	Z,FND90
	CALL	GET8
	JP	NZ,FND90
	LD	HL,XBUF1
	LD	D,#FF
FNR20:	LD	A,(HL)
	INC	HL
	INC	D
	OR	A
	JR	NZ,FNR20
	LD	A,D
	SUB	E
	LD	B,A
	LD	HL,XBUF1
	JR	NC,FNR40
FNR30:	EX	DE,HL
	RET

FNR40:	INC	B
	DEC	B
	JR	Z,FNR30
FNR50:	INC	HL
	LD	A,(HL)
	OR	A
	JR	Z,FNR30
	DJNZ	FNR50
	JR	FNR30

FN_PARSE:	EX	DE,HL
	LD	BC,_PARSE
	CALL	BDOS
	LD	C,B
FNP10:	LD	HL,XBUF1
	PUSH	HL
	LD	B,#08
	XOR	A
FNP20:	SLA	C
	ADC	A,"0"
	LD	(HL),A
	INC	HL
	XOR	A
	DJNZ	FNP20
	LD	(HL),#00
	POP	DE
	RET

FN_NEWFILE:	EX	DE,HL
	LD	BC,_PARSE
	CALL	BDOS
	LD	A,(DE)
	CALL	SEP?
	JP	NZ,FND90
	EX	DE,HL
	LD	(HL),#00
	INC	HL
	PUSH	HL
	LD	HL,XBUF1
	LD	C,_PFILE
	CALL	BDOS
	POP	HL
	CALL	GETCH
	JP	Z,FND90
	EX	DE,HL
	LD	HL,XBUF1+11
	LD	C,_PFILE
	CALL	BDOS
	LD	DE,XBUF1
	LD	B,11
FNN10:	LD	A,(DE)
	LD	C,A
	LD	A,(HL)
	CP	"?"
	JR	NZ,FNN20
	LD	(HL),C
FNN20:	INC	HL
	INC	DE
	DJNZ	FNN10
	PUSH	HL
	LD	B,8
FNN30:	LD	A,(DE)
	CP	" "
	JR	Z,FNN40
	LD	(HL),A
	INC	HL
FNN40:	INC	DE
	DJNZ	FNN30
	LD	A,(DE)
	CP	" "
	JR	Z,FNN60
	LD	(HL),"."
	INC	HL
	LD	B,3
FNN50:	LD	A,(DE)
	CP	" "
	JR	Z,FNN60
	LD	(HL),A
	INC	HL
	INC	DE
	DJNZ	FNN50
FNN60:	LD	(HL),#00
	POP	DE
	RET

FN_FFIRST:	CALL	SETABT
	EX	DE,HL
	LD	HL,#0000
	LD	(FILETOT1),HL
	LD	(FILETOT2),HL
	LD	(FILECNT),HL
	LD	C,_FFIRST
	LD	B,#16
	LD	IX,FIB3
	CALL	BDOS
	CALL	RSTABT
	OR	A
	JP	NZ,FND90
	LD	HL,FIB3+#15
	LD	DE,FILETOT1
	CALL	ADD32
	LD	HL,(FILECNT)
	INC	HL
	LD	(FILECNT),HL
	LD	DE,FIB3+1
	RET

FN_FULL:	CALL	SETABT
	EX	DE,HL
	LD	C,_FFIRST
	LD	B,#16
	LD	IX,FIB3
	CALL	BDOS
	CALL	RSTABT
	OR	A
	JP	NZ,FND90
	LD	HL,ENVNAME
	PUSH	HL
	LD	A,(FIB3+#19)
	ADD	A,"@"
	LD	(HL),A
	INC	HL
	LD	(HL),":"
	INC	HL
	LD	(HL),"\"
	INC	HL
	EX	DE,HL
	LD	C,_WPATH
	CALL	BDOS
	POP	DE
	RET

FN_DRIVE:	EX	DE,HL
	LD	BC,_PARSE
	CALL	BDOS
	LD	HL,ENVNAME
	PUSH	HL
	LD	A,C
	ADD	A,"@"
	LD	(HL),A
	INC	HL
	LD	(HL),":"
	INC	HL
	LD	(HL),#00
	POP	DE
	RET


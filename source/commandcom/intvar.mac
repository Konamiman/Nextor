	RL	H
	DJNZ	Next_0461
	LD	C,H
	LD	HL,BufEnvName
	LD	(HL),A
	INC	HL
	LD	(HL),C
	LD	IX,BufEnvName+2
	CALL	PrintTime
	POP	BC
	PUSH	AF
	LD	(IX),":"
	INC	IX
	LD	A,B
	LD	D,#FF
	CALL	PrintFigure2
	POP	AF
	CP	" "
	JR	Z,Next_0462
	LD	(IX),A
	INC	IX
Next_0462:	LD	(IX),#00

; The HELP index text lived here (~4K) until it was moved to the
; INDEX.HLP file, loaded on demand by the HELP command; the slot is
; kept empty because the messages are looked up by index.
	DEFB	0

	DEFB	"Insert COMMAND3.COM disk in drive ",0,":",0
	DEFB	"Destroy all data on RAM disk (Y/N)? ",0
	DEFB	"COMMAND3.COM: Wrong version of Nextor",0
	DEFB	"Terminate batch file (Y/N)? ",0
	DEFB	"Insert batch file disk in drive ",0,":",0

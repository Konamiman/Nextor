; Message #55: hint printed after 'File for HELP not found' when HELP
; was invoked with no subject and the index file is missing (copy.mac).
	DEFB	"The help index is in the INDEX.HLP file,",13,10
	DEFB	"in the directory given by the HELP environment item",0

; Messages #56-#84: the strings of the Nextor 3 additions (VER, FORMAT,
; MEM, LOCK, DRIVERS, DRVINFO, DEVINFO, RALLOC and the drive mapping
; notes of DIR/VOL/FREE), moved here from cmd.mac and files.mac so that
; they exist in both languages.
	DEFB	"COMMAND3.COM version ",0	; #56 (VER)
	DEFB	"TYPE COMMAND3.COM for more details",0	; #57 (VER)
	DEFB	"Drive ",0	; #58 (FORMAT refusals, DRVINFO)
	DEFB	"is not mapped",0	; #59 (FORMAT refusals)
	DEFB	"is the RAM disk",0	; #5A (FORMAT refusals)
	DEFB	"is mapped to a disk image file",0	; #5B (FORMAT refusals)
	DEFB	"WARNING: Drive ",0	; #5C (FORMAT confirmation)
	DEFB	" is NOT a floppy disk.",13,10,"Are you sure? (y/n) ",0	; #5D

; The MEM messages (#5E-#62). The 32 character wide layout: the slot in
; columns 1-4, the first number column ending at column 14 (nine
; characters wide after a slot, eight after the six character 'Total:'
; label) and two more nine character columns ending at columns 23 and
; 32. The Japanese header keeps the same column edges (kanji characters
; are two columns wide), and the Japanese totals label is six columns
; wide too.
	DEFB	"Slot     Total Reserved     Free",13,10	; #5E (MEM)
	DEFB	"----     ----- --------     ----",13,10,0
	DEFB	13,10,"Total:",0	; #5F (MEM)
	DEFB	"RAM disk size: ",0	; #60 (MEM)
	DEFB	"TPA end address: ",0	; #61 (MEM)
	DEFB	"h",13,10,"TPA size: ",0	; #62 (MEM)

	DEFB	"No drives are locked",0	; #63 (LOCK)
	DEFB	"is locked",0	; #64 (LOCK)
	DEFB	"is not locked",0	; #65 (LOCK)

	DEFB	"Legacy MSX-DOS driver",0	; #66 (DRIVERS, DRVINFO)
	DEFB	" on slot ",0	; #67 (DRIVERS, DRVINFO)
	DEFB	"No drives assigned at boot time",0	; #68 (DRIVERS)
	DEFB	"Drives assigned at boot time: ",0	; #69 (DRIVERS)
	DEFB	"from ",0	; #6A (DRIVERS)
	DEFB	" to ",0	; #6B (DRIVERS)
	DEFB	": is assigned to:",0	; #6C (DRVINFO)
	DEFB	"RAM disk",0	; #6D (DRVINFO)
	DEFB	"Ghost drive of ",0	; #6E (DRVINFO, DIR/VOL/FREE)
	DEFB	"File ",0	; #6F (DRVINFO)
	DEFB	" on drive ",0	; #70 (DRVINFO)
	DEFB	" (read only)",0	; #71 (DRVINFO, DIR/VOL/FREE)
	DEFB	"Device ",0	; #72 (DRVINFO)
	DEFB	"Relative unit ",0	; #73 (DRVINFO)

	DEFB	"Device number ",0	; #74 (DEVINFO)

	TITLE	MSX-DOS 2 - COMMAND2.COM
	SUBTTL	Command line editor
;******************************************************************************
;
;        The command line editor, new in COMMAND2.COM 2.40: line input with
; insert/overwrite modes and word movement, filename completion with TAB,
; and the command history, kept in a mapper segment.
;
;        Based on COMMAND.COM 2.31, copyright (1986) IS Systems Ltd, and on
; the COMMAND2.COM 2.40/2.41 additions by Fokke Post, whose source code was
; released as freeware in 2003.
;
;******************************************************************************
EDLINE:	PUSH	IY
	LD	A,(INSFLAG)
	AND	4
	LD	(INSFLAG),A
	XOR	A
	LD	(APPENDF),A
	LD	(INSPOS),A
	LD	(MININSPOS),A
	EX	DE,HL
	INC	HL
	LD	(HL),0
RDLINE:	CALL	RDKEY
	CP	9
	JP	Z,TABKEY
	PUSH	AF
	LD	A,(INSFLAG)
	RES	1,A
	LD	(INSFLAG),A
	POP	AF
	CP	13
	JP	Z,RETKEY
	CP	30
	JP	Z,CURUP
	CP	31
	JP	Z,CURDOWN
	CP	28
	JP	Z,CURRIGHT
	CP	29
	JP	Z,CURLEFT
	CP	11
	JP	Z,HOME
	CP	127
	JP	Z,DELCHR
	CP	8
	JP	Z,BACKSPC
	CP	18
	JP	Z,INSKEY
	CALL	RSTLINE
	CP	27
	JP	Z,SELECT
	CP	24
	JP	Z,SELECT
	CP	21
	JP	Z,SELECT
	CP	32
	JR	C,RDLINE
	CALL	PUTLINE
	CALL	PRCHAR
	JR	RDLINE

RDKEY:	PUSH	HL
	LD	C,_INNOE
	CALL	BDOS
	POP	HL
	RET

PUTLINE:	EX	AF,AF'
	LD	A,(INSFLAG)
	BIT	0,A
	JR	NZ,INSERT
	DEC	HL
	LD	A,(INSPOS)
	CP	(HL)
	INC	HL
	JR	Z,BEEP
	INC	A
	LD	(INSPOS),A
	LD	C,A
	LD	B,#00
	ADD	HL,BC
	EX	AF,AF'
	LD	(HL),A
	OR	A
	SBC	HL,BC
	LD	C,A
	LD	A,(INSPOS)
	CP	(HL)
	LD	A,C
	RET	C
	RET	Z
	INC	(HL)
	RET

INSERT:	LD	A,(HL)
	DEC	HL
	CP	(HL)
	INC	HL
	JR	Z,BEEP
	PUSH	HL
	LD	A,(INSPOS)
	CP	(HL)
	JR	Z,INS30
	LD	C,A
	LD	A,(HL)
	SUB	C
	LD	C,A
	LD	B,#00
	INC	BC
	PUSH	BC
	LD	C,(HL)
	INC	BC
	ADD	HL,BC
	LD	E,L
	LD	D,H
	INC	DE
	POP	BC
	LDDR
	INC	HL
INS20:	EX	AF,AF'
	LD	(HL),A
	POP	HL
	INC	(HL)
	INC	(HL)
	CALL	PRTLINE
	DEC	(HL)
	LD	A,(INSPOS)
	INC	A
	LD	(INSPOS),A
	LD	A,28
	RET

INS30:	LD	C,A
	LD	B,#00
	INC	BC
	ADD	HL,BC
	JR	INS20

BEEP:	LD	A,7
	RET

RDLINE2:	XOR	A
	LD	(MININSPOS),A
	JP	RDLINE

CURLEFT:	LD	A,(#FBEB)
	BIT	1,A
	JP	Z,HOME
	BIT	0,A
	JP	Z,WRDLEFT
	LD	A,(INSPOS)
	OR	A
	JP	Z,RDLINE2
	CALL	MOVLEFT
	JP	RDLINE2

MOVLEFT:	LD	A,(INSPOS)
	DEC	A
	LD	(INSPOS),A
	LD	A,29
	CALL	PRCHAR
	RET

CURRIGHT:	LD	A,(#FBEB)
	BIT	1,A
	JP	Z,ENDKEY
	BIT	0,A
	JP	Z,WRDRIGHT
	LD	A,(INSPOS)
	CP	(HL)
	JP	Z,RDLINE2
	CALL	MOVRIGHT
	JP	RDLINE2

MOVRIGHT:	LD	A,(INSPOS)
	INC	A
	LD	(INSPOS),A
	LD	A,28
	CALL	PRCHAR
	RET

BACKSPC:	LD	A,(HL)
	OR	A
	JP	Z,RDLINE2
	LD	A,(INSPOS)
	OR	A
	JR	Z,BAC10
	DEC	A
	LD	(INSPOS),A
	LD	A,29
	CALL	PRCHAR
	CALL	RSTLINE
BAC10:	PUSH	HL
	LD	A,(INSPOS)
	LD	C,A
	LD	A,(HL)
	SUB	C
	JR	Z,BAC20
	LD	C,A
	LD	B,0
	PUSH	BC
	LD	A,(INSPOS)
	LD	C,A
	LD	B,#00
	INC	BC
	ADD	HL,BC
	LD	E,L
	LD	D,H
	INC	HL
	POP	BC
	LDIR
BAC20:	POP	HL
	CALL	PRTLINE
	DEC	(HL)
	JP	RDLINE2

DELCHR:	LD	A,(#FBEB)
	BIT	1,A
	JR	Z,CTRLDEL
	BIT	0,A
	JP	Z,CTRLE
	LD	A,(HL)
	OR	A
	JP	Z,RDLINE2
	CALL	RSTLINE
	LD	B,A
	LD	A,(INSPOS)
	CP	B
	JP	Z,RDLINE2
	JR	BAC10

RSTLINE:	PUSH	AF
	LD	A,(INSFLAG)
	RES	2,A
	LD	(INSFLAG),A
	POP	AF
	RET

CTRLDEL:	PUSH	HL
	LD	HL,BUFADDR
	CALL	SETPUTADDR
	CALL	SETRDADDR
	DEC	HL
	CALL	SETENDADDR
	POP	HL
	LD	A,7
	CALL	PRCHAR
	JP	RDLINE2

PRTLINE:	PUSH	HL
	LD	A,(INSPOS)
	LD	C,A
	LD	A,(HL)
	SUB	C
	LD	B,#00
	ADD	HL,BC
	DEC	A
	LD	B,A
	PUSH	BC
	OR	A
	JR	Z,PRT20
PRT10:	INC	HL
	LD	A,(HL)
	CALL	PRCHAR
	DJNZ	PRT10
PRT20:	LD	A," "
	CALL	PRCHAR
	POP	BC
	INC	B
PRT30:	LD	A,29
	CALL	PRCHAR
	DJNZ	PRT30
	POP	HL
	RET

HOME:	LD	A,(INSPOS)
	OR	A
	JP	Z,RDLINE2
	DEC	A
	LD	(INSPOS),A
	LD	A,29
	CALL	PRCHAR
	JR	HOME

ENDKEY:	LD	A,(INSPOS)
	CP	(HL)
	JP	Z,RDLINE2
	INC	A
	LD	(INSPOS),A
	LD	A,28
	CALL	PRCHAR
	JR	ENDKEY

WRDLEFT:	CALL	WRDLEFTC
	JP	Z,RDLINE2
	CP	" "
	JR	NZ,WRDLEFT2
	CALL	MOVLEFT
	JR	WRDLEFT
WRDLEFT2:	CALL	WRDLEFTC
	JP	Z,RDLINE2
	CP	" "
	JP	Z,RDLINE2
	CALL	MOVLEFT
	JR	WRDLEFT2
WRDLEFTC:	LD	A,(INSPOS)
	OR	A
	RET	Z
	LD	C,A
	LD	B,#00
	ADD	HL,BC
	LD	A,(HL)
	SBC	HL,BC
	OR	A
	RET

WRDRIGHT:	CALL	WRDRIGHTC
	JP	Z,RDLINE2
	CP	" "
	JR	Z,WRDRIGHT2
	CALL	MOVRIGHT
	JR	WRDRIGHT
WRDRIGHT2:	CALL	WRDRIGHTC
	JP	Z,RDLINE2
	CP	" "
	JP	NZ,RDLINE2
	CALL	MOVRIGHT
	JR	WRDRIGHT2

WRDRIGHTC:	LD	A,(INSPOS)
	CP	(HL)
	RET	Z
	LD	C,A
	LD	B,#00
	INC	BC
	ADD	HL,BC
	LD	A,(HL)
	SBC	HL,BC
	OR	A
	RET

SELECT:	CALL	CLRLINE
	CALL	BLKCURS
	JP	RDLINE2

CLRLINE:	PUSH	HL
	LD	HL,MININSPOS
CLR10:	LD	A,(INSPOS)
	CP	(HL)
	JR	Z,CLR20
	DEC	A
	LD	(INSPOS),A
	LD	A,29
	CALL	PRCHAR
	JR	CLR10
CLR20:	POP	HL
	JR	SHFTDEL

INSKEY:	LD	A,(#FBEB)
	BIT	1,A
	JR	Z,CTRLINS
	LD	A,(INSFLAG)
	XOR	#01
	LD	(INSFLAG),A
	BIT	0,A
	JR	Z,INS50
	LD	A,27
	CALL	PRCHAR
	LD	A,"y"
	CALL	PRCHAR
	LD	A,"4"
	CALL	PRCHAR
	LD	A,(INSPOS)
	LD	(MININSPOS),A
INS40:	JP	RDLINE
INS50:	CALL	BLKCURS
	JR	INS40

CTRLINS:	PUSH	HL
	CALL	HISPUT
	CALL	HISPREV
	POP	HL
	CALL	CLRLINE
	CALL	RSTLINE
	JP	RDLINE2

BLKCURS:	LD	A,(INSFLAG)
	RES	0,A
	LD	(INSFLAG),A
	LD	A,27
	CALL	PRCHAR
	LD	A,"x"
	CALL	PRCHAR
	LD	A,"4"
	CALL	PRCHAR
	XOR	A
	LD	(MININSPOS),A
	RET

CTRLE:	CALL	SHFTDEL
	JP	RDLINE2

SHFTDEL:	LD	A,(INSPOS)
	CP	(HL)
	RET	Z
	CALL	RSTLINE
	LD	A,(INSPOS)
	LD	B,A
	LD	A,(HL)
	LD	(HL),B
	SUB	B
	LD	B,A
	PUSH	BC
SHF10:	LD	A," "
	CALL	PRCHAR
	DJNZ	SHF10
	POP	BC
SHF20:	LD	A,29
	CALL	PRCHAR
	DJNZ	SHF20
	RET

TABKEY:	PUSH	HL
	LD	A,(INSFLAG)
	BIT	1,A
	JP	NZ,NEXTTAB
	SET	1,A
	RES	2,A
	LD	(INSFLAG),A
	LD	HL,TABORD$
	LD	DE,XBUF2
	CALL	GENV3
	PUSH	DE
	LD	B,#00
TAB10:	LD	A,(DE)
	OR	A
	JR	Z,TAB20
	INC	B
	INC	DE
	JR	TAB10

TAB20:	POP	DE
	DEC	DE
	LD	HL,ORDTAB-1
	XOR	A
TAB30:	JR	NZ,TAB40
	INC	HL
	LD	A,(HL)
	OR	A
	JR	Z,TAB40
	CALL	COMPARE
	JR	C,TAB30
	LD	A,(HL)
	DEFB	#21
TAB40:	LD	A,%00000011
	LD	(FDFLAGS),A
	POP	HL
	PUSH	HL
	CALL	SHFTDEL
	LD	C,(HL)
	LD	B,0
	INC	BC
	ADD	HL,BC
	LD	(HL),0
	POP	HL
	PUSH	HL
	LD	A,(INSPOS)
	OR	A
	JR	Z,TAB80
	LD	C,A
	LD	B,0
	ADD	HL,BC
TAB50:	LD	DE,STOPLST$
TAB60:	LD	A,(DE)
	OR	A
	JR	Z,TAB70
	CP	(HL)
	JR	Z,TAB80
	INC	DE
	JR	TAB60
TAB70:	DEC	HL
	DEC	C
	JR	NZ,TAB50
TAB80:	EX	DE,HL
	INC	DE
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	EX	DE,HL
	BIT	4,B
	JR	NZ,TAB90
	LD	(HL),"*"
	INC	HL
	LD	(HL),"."
	INC	HL
TAB90:	LD	(HL),"*"
	INC	HL
	LD	(HL),0
	POP	BC
	POP	HL
	PUSH	HL
	PUSH	BC
	EX	DE,HL
	SBC	HL,DE
	LD	A,L
	DEC	A
	LD	(APPENDF),A
	LD	DE,DSKERR
	LD	C,_DEFER
	CALL	BDOS
	LD	DE,ABEXIT7
	LD	C,_DEFAB
	CALL	BDOS
	POP	HL
	LD	DE,XBUF1
	PUSH	DE
	CALL	NCOPY
	POP	DE
TAB100:	CALL	TABFIRST
	POP	HL
	JP	NZ,ERRBEEP
	PUSH	HL
TAB110:	LD	A,(FIB1+1)
	CP	"."
	JP	Z,NEXTTAB2
	LD	A,(INSPOS)
	LD	B,A
	LD	A,(APPENDF)
	LD	(INSPOS),A
	LD	C,A
	LD	A,B
	SUB	C
	JR	Z,TAB130
	LD	B,A
TAB120:	LD	A,29
	CALL	PRCHAR
	DJNZ	TAB120
TAB130:	POP	HL
	PUSH	HL
	CALL	SHFTDEL
	PUSH	HL
	LD	DE,FIB1+1
	CALL	CHKLOW
	POP	HL
TAB140:	LD	A,(DE)
	OR	A
	JR	Z,TAB150
	CALL	PUTLINE
	CALL	PRCHAR
	INC	DE
	JR	TAB140

TAB150:	LD	A,(FIB1+14)
	BIT	4,A
	JR	Z,TAB160
	LD	A,"\"
	CALL	PUTLINE
	CALL	PRCHAR
TAB160:	LD	DE,0
	LD	C,_DEFER
	CALL	BDOS
	LD	DE,CLI_ABORT
	LD	C,_DEFAB
	CALL	BDOS
	POP	HL
	JP	RDLINE2

STOPLST$:	DEFB	" +^<>|['",#22,0

TABFIRST:	LD	B,#06
	LD	A,(FDFLAGS)
	BIT	1,A
	JR	Z,TAB170
	SET	4,B
TAB170:	LD	IX,FIB1
	LD	C,_FFIRST
	CALL	BDOS
TAB180:	JR	Z,TAB190
	CP	.NOFIL
	CALL	Z,CHKNEXT
	RET	NZ
TAB190:	LD	A,(FDFLAGS)
	BIT	0,A
	JR	Z,TAB210
TAB200:	XOR	A
	RET

TAB210:	LD	A,(FIB1+14)
	BIT	4,A
	JR	NZ,TAB200
	LD	IX,FIB1
	LD	C,_FNEXT
	CALL	BDOS
	JR	TAB180

TABNEXT:	LD	IX,FIB1
	LD	C,_FNEXT
	CALL	BDOS
	JR	Z,TAB220
	CP	.NOFIL
	RET	NZ
	CALL	CHKNEXT
	JR	Z,TAB220
	CP	.NOFIL
	RET	NZ
	LD	DE,XBUF1
	JR	TABFIRST

TAB220:	LD	A,(FDFLAGS)
	BIT	0,A
	JR	NZ,TAB200
	LD	A,(FIB1+14)
	BIT	4,A
	JR	NZ,TAB200
	JR	TABNEXT

CHKNEXT:	LD	A,(FDFLAGS)
	BIT	2,A
	JR	NZ,CHK40
	LD	A,.NOFIL
	OR	A
	RET

CHK40:	XOR	%00000011
	LD	(FDFLAGS),A
	LD	DE,XBUF1
	LD	B,#06
	BIT	1,A
	JR	Z,CHK50
	SET	4,B
CHK50:	LD	IX,FIB1
	LD	C,_FFIRST
	CALL	BDOS
	RET

NEXTTAB:	LD	A,(#FBEB)
	BIT	1,A
	JR	NZ,NEXTTAB2
	LD	A,"+"
	CALL	PUTLINE
	CALL	PRCHAR
	LD	A,(INSPOS)
	LD	(APPENDF),A
NEXTTAB2:	LD	DE,DSKERR
	LD	C,_DEFER
	CALL	BDOS
	LD	DE,ABEXIT7
	LD	C,_DEFAB
	CALL	BDOS
	CALL	TABNEXT
	JP	Z,TAB110
	POP	HL
ERRBEEP:	LD	A,7
	CALL	PRCHAR
	LD	A,(INSFLAG)
	RES	1,A
	RES	2,A
	LD	(INSFLAG),A
	PUSH	HL
	LD	DE,#00
	LD	C,_DEFER
	CALL	BDOS
	LD	DE,CLI_ABORT
	LD	C,_DEFAB
	CALL	BDOS
	POP	HL
	JP	RDLINE2

PUTCIRC:	PUSH	HL
	PUSH	DE
	LD	A,(HL)
	EX	DE,HL
	EX	AF,AF'
	CALL	RDCHR
	OR	A
	EX	AF,AF'
	CALL	WRCHR
	POP	DE
	INC	DE
	PUSH	DE
	PUSH	HL
	CALL	GETBUFLEN
	PUSH	DE
	LD	DE,BUFADDR
	ADD	HL,DE
	POP	DE
	CALL	COMPARE4
	POP	HL
	POP	DE
	JR	NZ,PUT10
	LD	DE,BUFADDR
PUT10:	CALL	GETENDADDR
	INC	HL
	PUSH	DE
	PUSH	HL
	EX	DE,HL
	CALL	GETBUFLEN
	PUSH	DE
	LD	DE,BUFADDR
	ADD	HL,DE
	POP	DE
	CALL	COMPARE4
	POP	HL
	POP	DE
	JR	Z,PUT20
	CALL	SETENDADDR
	XOR	A
	EX	AF,AF'
PUT20:	POP	HL
	EX	AF,AF'
	RET

RETKEY:	LD	A,(INSFLAG)
	BIT	2,A
	JR	NZ,RET20
	LD	A,(#FBEB)
	BIT	1,A
	CALL	NZ,HISPUT
	JR	RET30

RET20:	CALL	HISNEXT
RET30:	CALL	BLKCURS
	POP	IY
	RET

HISPUT:	LD	A,(HL)
	OR	A
	RET	Z
	LD	B,A
	PUSH	HL
	CALL	GETPUTADDR
	INC	HL
	CALL	SETRDADDR
	DEC	HL
	EX	DE,HL
	POP	HL
HIS70:	INC	HL
	CALL	PUTCIRC
	DJNZ	HIS70
	INC	HL
	LD	(HL),0
	CALL	PUTCIRC
	JR	Z,HIS90
	PUSH	DE
HIS80:	CALL	PUTCIRC
	JR	NZ,HIS80
	POP	DE
HIS90:	EX	DE,HL
	CALL	SETPUTADDR
	RET

HISPREV:	PUSH	HL
	PUSH	DE
	CALL	GETRDADDR
	LD	DE,BUFADDR
	CALL	COMPARE4
	DEC	HL
	CALL	SETRDADDR
	JR	NZ,HIS110
	CALL	GETENDADDR
HIS100:	CALL	SETRDADDR
HIS110:	CALL	RDCHR
	OR	A
	POP	DE
	POP	HL
	RET

HISNEXT:	PUSH	HL
	PUSH	DE
	CALL	GETRDADDR
	PUSH	HL
	CALL	GETENDADDR
	EX	DE,HL
	POP	HL
	OR	A
	SBC	HL,DE
	CALL	GETRDADDR
	INC	HL
	CALL	SETRDADDR
	JR	C,HIS110
	JR	NZ,HIS110
	LD	HL,BUFADDR
	JR	HIS100

RDCHR:	LD	A,(MAPPAGE)
	CALL	RD_SEG
	RET

WRCHR:	PUSH	DE
	PUSH	AF
	LD	E,A
	LD	A,(MAPPAGE)
	CALL	WR_SEG
	POP	AF
	POP	DE
	RET

CURUP:	PUSH	HL
	CALL	GETENDADDR
	LD	DE,BUFADDR
	CALL	COMPARE4
	POP	HL
	JP	C,RDLINE
	PUSH	HL
CUR10:	CALL	HISPREV
	JR	Z,CUR10
CUR20:	CALL	HISPREV
	JR	NZ,CUR20
	CALL	HISNEXT
CUR30:	POP	HL
	CALL	CLRLINE
	PUSH	HL
	CALL	GETRDADDR
	EX	DE,HL
	POP	HL
	PUSH	DE
	CALL	HISPREV
CUR40:	CALL	HISNEXT
	OR	A
	JR	Z,CUR50
	CALL	PUTLINE
	CALL	PRCHAR
	JR	CUR40
CUR50:	POP	DE
	EX	DE,HL
	CALL	SETRDADDR
	EX	DE,HL
	LD	A,(INSFLAG)
	SET	2,A
	LD	(INSFLAG),A
	JP	RDLINE

CURDOWN:	PUSH	HL
	CALL	GETENDADDR
	LD	DE,BUFADDR
	CALL	COMPARE4
	POP	HL
	JP	C,RDLINE
	PUSH	HL
	CALL	HISPREV
CUR60:	CALL	HISNEXT
	JR	NZ,CUR60
CUR70:	CALL	HISNEXT
	JR	Z,CUR70
	JR	CUR30

ABEXIT7:	POP	DE
	OR	#01
	RET

GETALIADDR:	LD	HL,ALIADDR
	JR	GET110
GETBUFLEN:	LD	HL,BUFLEN
	JR	GET110
GETRDADDR:	LD	HL,RDADDR
	JR	GET110
GETPUTADDR:	LD	HL,PUTADDR
	JR	GET110
GETENDADDR:	LD	HL,ENDADDR
GET110:	CALL	RDCHR
	PUSH	AF
	INC	HL
	CALL	RDCHR
	LD	H,A
	POP	AF
	LD	L,A
	RET

SETALIEND:	PUSH	DE
	PUSH	HL
	LD	HL,ALIEND
	JR	SET120
SETALIADDR:	PUSH	DE
	PUSH	HL
	LD	HL,ALIADDR
	JR	SET120
SETBUFLEN:	PUSH	DE
	PUSH	HL
	LD	HL,BUFLEN
	JR	SET120
SETRDADDR:	PUSH	DE
	PUSH	HL
	LD	HL,RDADDR
	JR	SET120
SETPUTADDR:	PUSH	DE
	PUSH	HL
	LD	HL,PUTADDR
	JR	SET120
SETENDADDR:	PUSH	DE
	PUSH	HL
	LD	HL,ENDADDR
SET120:	POP	DE
	PUSH	DE
	LD	A,E
	CALL	WRCHR
	INC	HL
	LD	A,D
	CALL	WRCHR
	POP	HL
	POP	DE
	RET


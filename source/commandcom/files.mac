;
; COMMAND2.COM - CDD/CHDIR, PUSHD/POPD, FREE, DIR, MKDIR, VOL
;
; Code from COMMAND2.COM 2.41 by Fokke Post (source released as freeware
; in 2003), split mechanically; to be restyled to the conventions of this
; repository. Do not reformat or reorganize while the build is verified
; byte-identical against command241.com (see Makefile, target "verify").
;
Cmd_Cdd:	SCF
Cmd_Chdir:	EX	AF,AF'
	CALL	PRS
	CALL	Z,GCHKEOL
	RET	NZ
	LD	(HL),A
	PUSH	DE
	PUSH	BC
	LD	B,C
	LD	C,_GETCD
	LD	DE,BufEnvData
	CALL	BDOS
	POP	BC
	POP	DE
	RET	NZ
	EX	DE,HL
	LD	A,(HL)
	CP	"-"
	JR	NZ,Next_0591
	INC	HL
	CALL	GETCH
	LD	A,.IPARM
	RET	NZ
	SET	0,B
	LD	HL,DirBuffer
Next_0591:	LD	A,C
	BIT	0,B
	LD	DE,BufEnvData
	JR	Z,CD
	PUSH	HL
	LD	A,(LogiDrive)
	LD	B,A
	LD	DE,BufEnvData
	LD	C,_GETCD
	CALL	BDOS
	POP	HL
	LD	DE,BufExtra
	CALL	NCopy
	LD	DE,BufExtra
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	LD	A,C
	LD	(LogiDrive),A
	POP	DE
	LD	C,_CHDIR
	CALL	BDOS
	JR	Z,Next_0593
	CP	.NODIR
	LD	HL,Env_Cdpath
	LD	DE,BufExtra2
	CALL	Z,GetEnvData3
	RET	NZ
	EX	DE,HL
Next_0592:	CALL	GETCH
	LD	A,.NODIR
	RET	Z
	LD	BC,BufEnvName
	CALL	CPYSTR
	RET	C
	PUSH	HL
	CALL	FindDir
	POP	HL
	JR	NZ,Next_0592
	EX	AF,AF'
	SCF
	EX	AF,AF'
Next_0593:	LD	BC,#40
	LD	DE,DirBuffer+3
	LD	HL,BufEnvData
	LDIR
	LD	C,_CURDRV
	CALL	BDOS
	ADD	A,"A"
	LD	(DirBuffer),A
	EX	AF,AF'
	LD	A,0
	JR	NC,Next_0595
	LD	A,(LogiDrive)
	DEC	A
	LD	E,A
Next_0594:	LD	C,_SELDSK
	CALL	BDOS
	LD	C,_ERROR
	CALL	BDOS
	LD	A,B
Next_0595:	OR	A
	RET

CD:	ADD	A,"@"
	CALL	PrintChar
	LD	A,":"
	CALL	PrintChar
	LD	A,"\"
	CALL	PrintChar
	JP	DMSCR

FindDir:	LD	DE,BufEnvName
	LD	BC,_PARSE
	CALL	BDOS
	SCF
	RET	NZ
	LD	A,C
	LD	(LogiDrive),A
	LD	HL,BufExtra
	LD	A,B
	AND	#18
	JR	Z,Next_0596
	LD	A,"\"
	LD	(DE),A
	INC	DE
Next_0596:	CALL	NCopy
	LD	DE,BufEnvName
	LD	C,_CHDIR
	JP	BDOS

PRS:	LD	B,#00
_PRS:	LD	C,_PARSE
	EX	DE,HL
	PUSH	DE
	CALL	BDOS
	EX	DE,HL
	POP	DE
	RET	NZ
	LD	A,(HL)
	CALL	SEP?
	LD	A,.IPATH
	RET	NZ
	LD	A,B
	AND	#18
	JR	NZ,Next_0203
	SET	5,B
Next_0203:	XOR	A
	RET

Cmd_Pushd:	AND	(HL)
	JR	Z,Next_0598
	CALL	Cmd_Cdd
	RET	NZ
	LD	HL,DirBuffer
Next_0597:	LD	DE,BufEnvName
	CALL	NCopy
	DEC	DE
	LD	A,";"
	LD	(DE),A
	INC	DE
	PUSH	DE
	LD	HL,Env_Pushd
	CALL	GENV2
	EX	DE,HL
	POP	DE
	CALL	NCopy
	LD	HL,Env_Pushd
	LD	DE,BufEnvName
	LD	C,_SENV
	JP	BDOS

Next_0598:	LD	DE,BufExtra+3
	LD	A,(LogiDrive)
	LD	B,A
	LD	C,_GETCD
	CALL	BDOS
	RET	NZ
	LD	A,(LogiDrive)
	ADD	A,"@"
	LD	HL,BufExtra+2
	LD	(HL),"\"
	DEC	HL
	LD	(HL),":"
	DEC	HL
	LD	(HL),A
	JR	Next_0597

Cmd_Popd:	AND	(HL)
	JR	Z,Next_0599
	LD	A,(HL)
	CP	"/"
	LD	A,.IPARM
	RET	NZ
	INC	HL
	LD	A,(HL)
	CALL	UC
	CP	"N"
	LD	A,.IOPT
	RET	NZ
	INC	HL
	LD	A,(HL)
	CALL	SEP?
	LD	A,.IOPT
	RET	NZ
	CALL	GETCH
	LD	A,.INP
	RET	NZ
	CALL	GetPopd
	XOR	A
	RET

Next_0599:	CALL	GetPopd
	RET	Z
	PUSH	BC
	LD	C,_CHDIR
	CALL	BDOS
	POP	DE
	RET	NZ
	JP	Next_0594

GetPopd:	LD	HL,Env_Pushd
	CALL	GENV2
	LD	A,(DE)
	OR	A
	RET	Z
	EX	DE,HL
	LD	DE,BufEnvName
Next_0600:	LD	A,(HL)
	OR	A
	JR	Z,Next_0602
	CP	";"
	JR	Z,Next_0601
	LDI
	JR	Next_0600

Next_0601:	INC	HL
Next_0602:	XOR	A
	LD	(DE),A
	EX	DE,HL
	LD	HL,Env_Pushd
	LD	C,_SENV
	CALL	BDOS
	RET	NZ
	LD	DE,BufEnvName+1
	LD	A,(DE)
	DEC	DE
	CP	":"
	JR	NZ,Next_0603
	LD	A,(DE)
	CALL	UC
	SUB	"A"
	LD	C,A
	INC	A
	RET

Next_0603:	LD	A,(LogiDrive)
	DEC	A
	LD	C,A
	INC	A
	RET

Cmd_Free:	AND	(HL)
	JR	NZ,Next_0604
	LD	A,(LogiDrive)
	JR	Next_0605
Next_0604:	CALL	PARSDR
	CALL	Z,GCHKEOL
	RET	NZ
	LD	A,D
Next_0605:	ADD	A,"@"
	LD	HL,BufEnvName
	LD	E,L
	LD	D,H
	LD	(HL),A
	INC	HL
	LD	(HL),":"
	INC	HL
	LD	(HL),0
	CALL	VOL
	RET	NZ
	LD	A,(BufEnvName)
	SUB	"@"
	LD	E,A
	LD	C,_ALLOC
	CALL	BDOS
	LD	B,A
	PUSH	DE
	PUSH	HL
	EX	DE,HL
	PUSH	BC
	CALL	Compute
	LD	A,#3E
	CALL	DMESSCR
	POP	BC
	POP	DE
	POP	HL
	PUSH	DE
	SBC	HL,DE
	PUSH	BC
	CALL	Compute
	LD	A,#3F
	CALL	DMESSCR
	POP	BC
	POP	HL
	CALL	Compute
	LD	A,#40
	JP	DMESSCR

Compute:	DEFB	#3E
Next_0606:	ADD	HL,HL
	SRL	B
	JR	NZ,Next_0606
	LD	E,#00
	LD	D,L
	LD	L,H
	LD	H,E
	SLA	D
	ADC	HL,HL
	LD	(Value_L),DE
	LD	(Value_H),HL
	LD	A," "
	CALL	PrintLen2
	RET

@DIR:	PUSH	HL
	CALL	TFORM
	CALL	DFORM
	POP	HL
	LD	DE,BufEnvData
	PUSH	DE
	CALL	NCopy
	POP	HL
	LD	DE,ListOption1
	CALL	PARSE
	CALL	Z,CHKEOL
	RET	NZ
	LD	A,(LogiDrive2)
	ADD	A,"@"
	LD	HL,BufEnvName
	LD	E,L
	LD	D,H
	LD	(HL),A
	INC	HL
	LD	(HL),":"
	INC	HL
	LD	(HL),#00
	CALL	VOL
	RET	NZ
	LD	A,(OptionFlag1)
	BIT	2,A
	JR	NZ,Next_0205
	LD	HL,OptionFlag2
	SET	4,(HL)
Next_0205:	SET	1,(IY+#08)
	CALL	FIRST
	JR	Z,DIR25
	CP	.NOFIL
	RET	NZ
	XOR	A
	SCF
DIR25:	EX	AF,AF'
	LD	C,_WPATH	; Get and print whole path string.
	LD	DE,BufEnvName+1
	CALL	BDOS
	RET	NZ
	LD	(HL),A	; Take off last item.
	DEC	HL
	LD	(HL),A	; Fiddle for root directory.
	PUSH	DE
	LD	A,#02	; Print 'Directory of'.
	CALL	DMESS
	POP	DE	; DE -> whole path string.
	LD	A,(LogiDrive2)	; Get drive of first filename parsed.
	CALL	CD	; Call the CHDIR command to print drive
	CALL	LPrint	;   \ whole path string.
	LD	HL,#00	; Zero accumulated file size.
	LD	(Value_L),HL	; Low word.
	LD	(Value_H),HL	; High word.
	LD	(CountFile),HL	; Zero number of files found count.
	LD	BC,#014B	; Get the output width.
	LD	A,#04
	CALL	BDOS
	JR	NZ,WIDE	; Error => wide (shouldn't occur).
	OR	E	; 0 => very wide, so use 80 columns.
	JR	NZ,SETCOL
WIDE:	LD	A,#50
SETCOL:	LD	(ColumnMax2),A	; Save number of output columns.
	CP	#13
	JR	NC,DIR30
	LD	A,#13
DIR30:	ADD	A,#03	; Allow for trailing separators not
	RRCA	;   being printed after last filename.
	RRCA	; Divide by 16 for number of filenames
	RRCA	;   per line in /W format.
	RRCA
	AND	#0F
	LD	B,A	; B'=max. number of filenames per line.
	LD	C,#00	; C'=number on current line.
	EXX
	EX	AF,AF'
DIR_LOOP:	JP	C,DIR_DONE
	LD	HL,(CountFile)
	INC	HL
	LD	(CountFile),HL
	CALL	DFILNAM
	LD	HL,FIB1+#15
	LD	DE,Value_L
	CALL	ADD32
	BIT	0,(IY+#05)
	JP	NZ,DIRW
	LD	A,#0F
	CALL	MakeMaxLen
	LD	A,(ColumnMax2)
	CP	D
	JP	C,Next_0212
	LD	C,(IX+#0E)
	LD	A,"s"
	BIT	2,C
	CALL	SPACE?
	LD	A,"h"
	BIT	1,C
	CALL	SPACE?
	LD	A,"r"
	BIT	0,C
	CALL	SPACE?
	LD	A,#17
	CALL	MakeMaxLen
	LD	A,(ColumnMax2)
	CP	D
	JR	C,Next_0212
	BIT	4,C
	JR	NZ,Next_0211
	LD	A," "
	LD	DE,FIB1+#15
	LD	IX,BufExtra
	PUSH	IX
	CALL	D32
	POP	DE
	INC	DE
	CALL	PrintString
	XOR	A
Next_0211:	LD	A,#03
	CALL	NZ,DMESS
	LD	A,#20
	CALL	MakeMaxLen
	LD	A,(ColumnMax2)
	CP	D
	JR	C,Next_0212
	LD	HL,FIB1+#12
	LD	A,(HL)
	DEC	HL
	OR	(HL)
	LD	A,#1F
	CALL	Z,DMESS
	JR	Z,Next_0212
	LD	C,#00
	LD	IX,BufExtra+2
	PUSH	IX
	CALL	DDATE
	POP	DE
	CALL	PrintString
	LD	A,#27
	CALL	MakeMaxLen
	LD	A,(ColumnMax2)
	CP	D
	JR	C,Next_0212
	LD	HL,FIB1+#0F
	LD	A,(HL)
	INC	HL
	OR	(HL)
	LD	A,#25
	CALL	Z,DMESS
	JR	Z,Next_0212
	LD	IX,BufExtra+2
	PUSH	IX
	CALL	DTIME
	POP	DE
	PUSH	AF
	CALL	PrintString
	POP	AF
	CALL	PrintChar
Next_0212:	BIT	3,(IY+#05)
	JR	Z,Next_0607
	EXX
	LD	A,C
	OR	A
	JR	Z,Next_0608
	LD	C,#00
	EXX
Next_0607:	CALL	LPrint
	JR	DIR_NEXT

Next_0608:	LD	C,#28
	EXX
	LD	A," "
	CALL	PrintChar
	LD	A," "
	CALL	PrintChar
	JR	DIR_NEXT

DIRW:	EXX	; E=no. filenames on line, D=max. no.
	INC	C	; Another filename printed.
	LD	A,C
	CP	B	; Last one on line just printed ?
	JR	C,WSPC	; Print separating spaces if not.
	CALL	LPrint	; Else print new line.
	XOR	A	; Set current count back to 0, set NC.
	LD	C,A
WSPC:	EXX
	LD	B,#04	; Print 4 spaces.
	CALL	C,SPACES
DIR_NEXT:	CALL	NEXT
	JP	DIR_LOOP

DIR_DONE:	RET	NZ
	EXX
	OR	C
	CALL	NZ,LPrint
	LD	A,#04
	CALL	DMESS
	CALL	PrintLength
	LD	A,#05
	CALL	DMESS
	LD	HL,(CountFile)
	PUSH	HL
	LD	IX,BufExtra
	PUSH	IX
	CALL	D16
	POP	DE
	CALL	PrintString
	POP	HL
	DEC	HL
	LD	A,H
	OR	L
	LD	A,#09
	JR	Z,FILE
	LD	A,#0A
FILE:	CALL	DMESS
	LD	A,(LogiDrive2)	; Get drive of first filename parsed.
	LD	E,A
	LD	C,_ALLOC	; Get allocation information.
	CALL	BDOS
	LD	B,A	; B=sectors/cluster, HL=clusters free.
	DEFB	#3E
Next_0218:	ADD	HL,HL
	SRL	B	;   free bytes (B is always a power
	JR	NZ,Next_0218	;   of 2) so HL = no. free sectors.
	LD	E,#00	; Multiply by sectory size (512) into
	LD	D,L	;   HLDE to get the number of free
	LD	L,H	;   bytes.
	LD	H,E
	SLA	D
	ADC	HL,HL
	LD	(Value_L),DE	; Save in 32 bit number buffer.
	LD	(Value_H),HL
	CALL	PrintLength	; Print no. bytes or Ks.
	LD	A,#06	; Print 'free'.
	CALL	DMESS
	JP	LPrint

DFILNAM:	LD	HL,FIB1+1	; Point to filename to print.
	LD	B,#08	; Print 8 characters of filename.
	LD	A,(HL)	; '.' or '..' ?
	CP	"."
	JR	NZ,NODOTS	; Print filename if not.
	INC	HL
	CP	(HL)	; '..' ?
	JR	NZ,DDOT	; Print one dot & 7 spaces if not.
	DEC	B	; Else print two dots & 6 spaces,
	CALL	PrintChar	; First dot.
	LD	A,(HL)	; Second dot.
	INC	HL
DDOT:	CALL	PrintChar
	CALL	SPACES
	JR	DEXT

NODOTS:	CALL	Next_0225
	LD	A,"."
	LD	C," "
	BIT	0,(IY+#05)
	JR	Z,DEDOT
	CP	(HL)
	JR	NZ,NODOT
	LD	C,A
DEDOT:	CP	(HL)	; Skip '.' if there.
	JR	NZ,NODOT
	INC	HL
NODOT:	LD	A,C
	CALL	PrintChar	; Output character.
DEXT:	LD	B,#03
Next_0225:	LD	A,(HL)
	OR	A
	JR	Z,SPACES
	INC	HL
	PUSH	AF
	BIT	0,(IY+#05)
	JR	Z,Next_0227
	LD	A,(FIB1+14)
	BIT	4,A
	JR	Z,Next_0227
	POP	AF
	CALL	MakeLower
	PUSH	AF
Next_0227:	POP	AF
	CP	"."
	JR	NZ,Next_0226
	DEC	HL
SPACES:	CALL	SPACE
	DJNZ	SPACES
	RET

Next_0226:	CALL	PrintChar
	DJNZ	Next_0225
	RET

MakeMaxLen:	EXX
	BIT	3,(IY+#05)
	JR	Z,Next_0609
	ADD	A,C
Next_0609:	EXX
	LD	D,A
	RET

ListOption1:	DEFB	"W"
	DEFB	#01
	DEFB	"2"
	DEFB	#08
ListOption3:	DEFB	"S"
	DEFB	#04
	DEFB	"P"
	DEFB	#00
	DEFB	"H"
	DEFB	#02
	DEFB	0

		SUBTTL  MKDIR
;        This is the MD/MKDIR command routine, which simply parses a directory
; path from the command line and creates it.
@MKDIR:	AND	(HL)
	LD	A,.NOPAR	; 'Missing parameter' if no parameters
	RET	Z	;   given.
	CALL	PRS	; Parse directory path.
	CALL	Z,GCHKEOL	; Check for garbage.
	RET	NZ	; Ret if error.
	LD	(HL),A	; Make sure string is null terminated.
	LD	A,B	; Give error if last item is null or
	AND	#18	;   ambiguous (this test saves setting
	LD	A,.IPATH	;   up a template filname in a FIB).
	RET	Z
	BIT	5,B
	RET	NZ
	LD	BC,#1042	; Find new sub-directory.
	LD	IX,FIB1
	JP	BDOS

		SUBTTL  VOL
;******************************************************************************
;        Displays or sets the volume  name.   A  volume  name  is  changed  by
; creating a new one which automatically deletes any existing one.
;        The entry point DVOL is used by the DIR command to display the volume
; name on the disk.
@VOL:	LD	B,#08	; Parse a volume name.
	CALL	_PRS
	CALL	Z,GCHKEOL	; Check for garbage at end of line.
	RET	NZ
	LD	(HL),A	; Ensure string is null terminated.
	LD	IX,FIB1
	LD	C,_FNEW
	BIT	0,B
	LD	B,#08
	JP	NZ,BDOS	; Create new volume name if yes.
VOL:	LD	IX,FIB1
	LD	BC,#0840
	CALL	BDOS	; Look for volume name.
	JR	Z,DVOL	; OK if no error or file not found.
	CP	.NOFIL
	RET	NZ
DVOL:	PUSH	AF	; Save volume name found flag.
	LD	A,#10	; Print 'Volume in drive '.
	CALL	DMESS
	LD	A,(FIB1+#19)	; Get actual drive letter.
	ADD	A,"@"
	CALL	PrintChar	; Print it in ASCII.
	LD	A,#11
	CALL	DMESS	; Print stuff after drive (': ').
	POP	AF	; Get volume name flag.
	OR	A
	LD	A,#12	; Print 'has no name' if no volume
	JP	NZ,DMESSCR	;   name found.
	LD	A,#13	; Print 'is'.
	CALL	DMESS
	LD	DE,FIB1+1
	JP	DMSCR	; Print volume name from FIB.


	TITLE	MSX-DOS 2 - COMMAND2.COM
	SUBTTL	Batch file input
;******************************************************************************
;
;        Batch file input: .BAT files are read line by line, .BTM files
; (new in 2.40) are loaded whole into a mapper segment. Also the disk
; error handler used while a batch file is being read.
;
;        Based on COMMAND.COM 2.31, copyright (1986) IS Systems Ltd, and on
; the COMMAND2.COM 2.40/2.41 additions by Fokke Post, whose source code was
; released as freeware in 2003.
;
;******************************************************************************
INBAT:	LD	DE,BATERR
	LD	C,_DEFER
	CALL	BDOS
	LD	A,#3B
	LD	(STRCODE),A
	LD	HL,ENVDATA
	LD	(HL),#00
	CALL	IB10
	PUSH	AF
	PUSH	HL
	LD	DE,#00
	LD	C,_DEFER
	CALL	BDOS
	POP	HL
	POP	AF
	RET	NZ
	DEC	A
	LD	(STRCODE),A
	BIT	7,(HL)
	LD	A,.BUFUL
	RET	NZ
	LD	A,(BATHNDL)
	CP	#FE
	JR	NZ,INB10
	PUSH	HL
	LD	HL,ENVDATA+1
	CALL	GETCH
	LD	A,(HL)
	POP	HL
	CP	"~"
	SCF
	RET	Z
INB10:	XOR	A
	RET

IB10:	INC	HL
	LD	(HL),#00	; Terminate line so far with a null.
IB15:	CALL	GETBATCHR
	LD	HL,ENVDATA
	RET	NZ
	LD	D,A
	LD	A,C
	CP	#0A
	JR	Z,IB15
	CP	#1A
	JR	Z,IBB10
	SUB	#0D
	RET	Z
	BIT	7,(HL)
	JR	NZ,IB15
	INC	(HL)
	LD	E,(HL)
	ADD	HL,DE
	LD	(HL),C
	JR	IB10

IBB10:	LD	A,.EOF
	OR	A
	RET

GETBATCHR:	LD	A,(BATHNDL)
	CP	#FE
	JR	NZ,INBCHAR
	CALL	GET_P2
	LD	(TMPPAGE),A
	LD	A,(BATPAGE)
	LD	HL,(BATLINADDR)
	CALL	RD_SEG
	LD	C,A
	INC	HL
	LD	(BATLINADDR),HL
	CP	#1A
	JR	NZ,GET100
	LD	A,(BATPAGE)
	CALL	FRE_SEG
GET100:	XOR	A
	RET

INBCHAR:	LD	HL,(BATLINLEN)	; Return A=error, C=char.
	LD	A,H
	OR	L
	JR	NZ,BUFOK	; Go if some left.
	LD	HL,#0100	; No. bytes to read = size of buffer.
	LD	DE,BATBUF	; Try to read another buffer full.
	LD	(BATLINADDR),DE	; Save pointer to current character.
	LD	A,(BATHNDL)	; Get file handle for batch file.
	LD	B,A
	LD	C,_READ
	CALL	BDOS	; Leaves HL=no. bytes read into buffer.
	RET	NZ	; Return if error.
	PUSH	HL
	LD	DE,#0100	; If we read buffer full
	SBC	HL,DE	;   it may not the end of batch file.
	POP	HL
	JR	Z,BUFOK
	PUSH	HL
	LD	DE,BATBUF	; Put ^Z at the buffer end
	ADD	HL,DE	;   to avoid further reading.
	LD	(HL),#1A
	LD	A,(BATHNDL)	; Close batch file.
	LD	B,A
	LD	C,_CLOSE
	CALL	BDOS	; (error ignored)
	POP	HL
	INC	HL
BUFOK:	DEC	HL	; Dec. count after reading character.
	LD	(BATLINLEN),HL	; Save new count.
	LD	HL,(BATLINADDR)	; Get pointer to current character.
	LD	C,(HL)	; Return it in C.
	INC	HL	; Ready for next character.
	LD	(BATLINADDR),HL
	XOR	A	; No error.
	RET

BATERR:	CP	.WFILE	; Return with A=0 if .WFILE or .WDISK.
	JR	Z,WFILE
	CP	.WDISK
	LD	A,#00
	RET	NZ
WFILE:	PUSH	BC
	CALL	LPRINT
	LD	A,#37
	CALL	DMESS
	POP	AF
	ADD	A,"@"
	CALL	PRCHAR
	LD	A,#38
	CALL	DMESS
	CALL	LPRINT
	CALL	PAUSE
	LD	A,#02
	RET

OPENBTM:	LD	HL,FIB1+#18
	LD	D,(HL)
	DEC	HL
	LD	A,(HL)
	OR	D
	JR	Z,OPE20
OPE10:	LD	A,.NORAM
	CP	A
	RET

OPE20:	DEC	HL
	LD	A,(HL)
	CP	#40
	JR	NC,OPE10
	XOR	A
	LD	B,A
	INC	A
	CALL	ALL_SEG
	LD	(BATPAGE),A
	LD	A,.NORAM
	RET	C
	LD	DE,FIB1
	LD	A,#01
	LD	C,_OPEN
	CALL	BDOS
	RET	NZ
	PUSH	BC
	CALL	GET_P2
	LD	(TMPPAGE),A
	LD	A,(BATPAGE)
	CALL	PUT_P2
	LD	DE,#8000
	LD	HL,#3FFF
	POP	BC
	PUSH	BC
	PUSH	DE
	LD	C,_READ
	CALL	BDOS
	POP	DE
	PUSH	AF
	ADD	HL,DE
	LD	(HL),#1A
	LD	A,(TMPPAGE)
	CALL	PUT_P2
	POP	DE
	POP	BC
	PUSH	DE
	LD	C,_CLOSE
	CALL	BDOS
	POP	DE
	RET	NZ
	LD	H,A
	LD	L,A
	LD	(BATLINADDR),HL
	OR	D
	RET

FREEBTM:	LD	A,(BATPAGE)
	CALL	FRE_SEG
	XOR	A
	LD	(BATPAGE),A
	RET


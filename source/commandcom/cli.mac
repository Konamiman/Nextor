;
; COMMAND2.COM - Main loop, prompt, alias expansion, command separators, %-expansion, redirection, piping, command execution dispatch, transient program loading, command search
;
; Code from COMMAND2.COM 2.41 by Fokke Post (source released as freeware
; in 2003), split mechanically; to be restyled to the conventions of this
; repository. Do not reformat or reorganize while the build is verified
; byte-identical against command241.com (see Makefile, target "verify").
;
CLI:	LD	HL,#80
	LD	C,(HL)
	LD	B,#00
	ADD	HL,BC
	INC	HL
	LD	(HL),B
	SBC	HL,BC
	CALL	GETCH
	LD	(ComlinChar1),A
	LD	(ComlinChar2),A
	EXX
	LD	HL,TEMPFN
	LD	DE,PipeFileName
	LD	BC,#07
	LDIR
	LD	A,R
	AND	#07
	ADD	A,"0"
	LD	(DE),A
	INC	DE
	LD	C,#04
	LDIR
	XOR	A
	LD	(ID_Redir),A
	LD	(ID_Pipelin),A
	LD	(InputHandle),A
	LD	(OutputHandle),A
	LD	(ExtraCRLF),A
	LD	L,A
	LD	H,A
	LD	(PipeAdres),HL
	LD	(NextAdres),HL
	DEC	A
	LD	(BatchHandle),A
	LD	(StringCode),A
	LD	HL,Null
	LD	(LineAdres),HL
	LD	HL,GosubList
	LD	(GosubAdres),HL
	LD	HL,IffList
	LD	(IffAdres),HL
	LD	D,H
	LD	E,L
	INC	DE
	LD	BC,15
	LD	(HL),#00
	LDIR
	LD	DE,CLI_ABORT
	LD	C,_DEFAB
	CALL	BDOS
Next_0026:	LD	IY,RedirState
	LD	(IY+#0E),#00
	LD	(IY+#10),#00
	LD	(IY+#00),#00
	LD	(IY+#29),#00
	LD	(IY+#2A),#00
	LD	C,_CURDRV
	CALL	BDOS
	INC	A
	LD	(CurrentDrive),A
	LD	DE,(PipeAdres)
	LD	A,D
	OR	E
	JP	NZ,REPIPE
	LD	DE,(NextAdres)
	LD	A,D
	OR	E
	JP	NZ,Next_0403
	LD	HL,REDIR$
	CALL	OFF?
	CCF
	SBC	A,A
	LD	(RedirState),A
	LD	HL,Env_Alias
	CALL	OFF?
	CCF
	SBC	A,A
	LD	(AliasState),A
	LD	HL,Env_Separ
	CALL	OFF?
	CCF
	SBC	A,A
	LD	(SeparState),A
	EXX
	LD	A,(HL)
	OR	A
	JP	NZ,CMD
	LD	A,(BatchHandle)
	INC	A
	JR	Z,NOBAT
	LD	HL,ErrorCode
	LD	A,(HL)
	LD	(HL),#00
	OR	A
	JR	Z,NOTEND
	PUSH	AF
	LD	A,(ID_Redir2)
	LD	(ID_Redir),A
	LD	HL,Null
	LD	(LineAdres),HL
	LD	A,#FF
	LD	(BatchHandle),A
	LD	A,(BatchPage)
	OR	A
	CALL	NZ,ReleaseBTM
	POP	AF
	CP	.OKCMD
	JR	NZ,JERROR
	XOR	A
JERROR:	JP	ERROR

NOTEND:	CALL	ECHO?	; Batch file ECHO ON ?
	JR	C,Next_0033	; Go & read command if not.
	SCF
	JR	PROMPT	; Else print prompt & get command.

NOBAT:	LD	A,(ComlinChar2)	; If EXITF is NZ, then exit COMMAND.COM
	OR	A	;   with the error code from the last
	JR	Z,PROMPT	;   command, which is in ERR (NC).
	LD	A,(AbortError)	; If no error, then return .OKCMD,
	OR	A	;   which does not produce an error
	JR	NZ,JEXIT	;   but which is used by MSX-DOS.SYS to
	LD	A,.OKCMD	;   prevent a spurious re-load of
JEXIT:	JP	EXIT

PROMPT:	PUSH	AF
	LD	HL,ExtraCRLF
	XOR	A
	CP	(HL)
	LD	(HL),A
	CALL	NZ,LPrint
	LD	HL,PROMPT$
	CALL	GENV2
	LD	A,(DE)
	OR	A
	JR	NZ,Next_0032
	LD	HL,Data_Prompt
	LD	BC,8
	PUSH	DE
	LDIR
	POP	DE
Next_0032:	LD	HL,Buffer1
	LD	IX,BufExtra3
	LD	(IX),#00
	CALL	ParseLine
	EX	DE,HL
	INC	DE
	CALL	PrintString
	POP	AF
	JR	NC,GETCON
Next_0033:	CALL	INBAT
	JR	C,Next_0033
	JR	Z,GOTBAT
	CP	.EOF
	JR	Z,BATEOF
	PUSH	AF
	CALL	LPrint
	POP	AF
	JP	ERROR

BATEOF:	LD	A,.OKCMD	; OKCMD => return no error.
GOTBAT:	LD	(ErrorCode),A
	SCF	; Skip console read.
GETCON:	CALL	NC,INLI	; Read from console if not batch file.
	INC	HL
CMD:	EX	DE,HL
	CALL	Aliasing
	JP	NZ,ERROR
Next_0403:	CALL	MultiComm
	LD	HL,Buffer1
	LD	IX,BufExtra3
	LD	(IX),#00
	CALL	ParseLine
	JR	NZ,ERROR
	EX	DE,HL
	INC	DE
	PUSH	DE
	LD	A,(BatchHandle)
	INC	A
	SCF
	CALL	NZ,ECHO?
	CALL	NC,DMSCR
	LD	C,_FORK
	CALL	BDOS
	POP	DE
	JR	NZ,ERROR
	LD	A,B
	LD	(ID_Redir),A
	LD	HL,Buffer2
	CALL	REDIRECT
	JR	NZ,ERROR
	EX	DE,HL
	INC	DE
	XOR	A
	LD	(InputHandle),A
	LD	(OutputHandle),A
	LD	H,A
	LD	L,A
	LD	(PipeAdres),HL
REPIPE:	PUSH	DE
	CALL	PIPE
	POP	HL
	JR	NZ,ERROR
	PUSH	HL
	CALL	RemoveQuote
	POP	HL
	CALL	DO_CMD
	CP	.BADCM
	JR	NZ,ERROR
	LD	HL,Txt_Unknown
	LD	DE,BufEnvData
	CALL	GetAlias
	JR	NZ,ERROR
	LD	A,(DE)
	OR	A
	JR	NZ,Next_0403
	LD	A,.BADCM
	JR	ERROR

Txt_Unknown:	DEFB	"UNKNOWN_CMD",0

CLI_ABORT:	CP	.INERR	; Error on standard input ?
	JR	Z,Next_0039	; Go if yes.
	CP	.OUTERR	; Error on standard output ?
	JR	NZ,ERROR	; Give error if not.
	LD	A,#3D	; Error type = output error.
	DEFB	#21
Next_0039:	LD	A,#3C
	LD	(StringCode),A
	LD	A,(ID_Redir)	; If not forked, then exit with error
	OR	A	;   code since there's no way of recov-
	LD	A,B	;   ering from this situation.
	JP	Z,EXIT	; Else give error.
ERROR:	LD	SP,BootStrap	; Set up SP again in case an abort.
	LD	(AbortError),A	; Save error for terminating COMMAND2.
	LD	B,A	; B=error code.
	PUSH	BC	; Save it for later.
	LD	DE,BufEnvName	; DE -> buffer to get message into.
	CP	" "	; User error ?
	JR	C,Next_0041	; Go if yes (no message required).
	CP	.OKCMD	; Means command executed OK from
	JR	Z,Next_0041	;   COMMAND, so no msg for this either.
	CP	#80	; Means 'Y' response from 'Terminate
	JR	Z,Next_0041	;   batch file ?' so no message.
	LD	C,_EXPLAIN	; Get message to (DE) from system.
	CALL	BDOS
	DEFB	#21
Next_0041:	XOR	A
	LD	(DE),A
	LD	BC,#FF5F	; Flush buffers for all drives.
	LD	D,#00	; Flush but don't invalidate.
	CALL	BDOS	;   (error ignored)
	POP	BC	; B=error code.
	LD	C,B	; And C.
	LD	HL,ComlinChar1
	LD	A,(HL)	; Suppress error message (<>0 => yes) ?
	LD	(HL),#00	;   (reset again for next time round)
	OR	A
	JR	NZ,TSTBAT	; Test for ending batch file if yes.
	LD	A,B	; Get error code.
	CP	.BADCM	; Turn off redirection if command abort
	CALL	NZ,ABORT?	;   error or 'Unrecognized command'.
	JR	NZ,NABERR
	PUSH	BC
	LD	BC,_REDIR
	LD	A,#01	; No redirection of error messages if
	CALL	BDOS	;   command aborted prematurely.
	POP	BC
	LD	A,B
	CP	.ABORT	; Extra CR,LF if command aborted, but
	JR	Z,NABERR	;   not if .ABORT or if .BADCMD.
	CP	.BADCM
	CALL	NZ,LPrint
NABERR:	LD	A,(BufEnvName)
	OR	A	; Message given ?
	JR	Z,TSTBAT	; Go if not.
	CALL	LPrint	; CR, LF before error message.
	LD	A,#0D	; Three stars before message.
	CALL	DMESS
	LD	A,(StringCode)	; Get error type.
	ADD	A,#01	; Print type message if not FF.
	DEC	A
	PUSH	AF
	CALL	NC,DMESS
	LD	DE,BufEnvName
	CALL	PrintString	; Print actual error message.
	LD	A,#0E	; Followed by message after error.
	CALL	DMESSCR
	POP	AF
	CP	#3B	; If error from reading batch file,
	JR	Z,TBF	;   then issue 'Terminate' prompt.
	CP	#3A	; If piping error, then cancel all
	JR	Z,NOPIPE	;   piping and issue prompt.
TSTBAT:	LD	A,C	; Get error code.
	CP	#80	; If it's .BATEND, then immediately
	JR	Z,ENDBAT	;   terminate any executing batch file.
	OR	A	; If it's a command abort error, then
	JR	Z,NABORT	;   issue 'Terminate batch file' prompt
	CALL	ABORT?	;   but only if the secondary error
	JR	NZ,NABORT	;   code is non-zero.
NOPIPE:	CALL	DELPIPE
TBF:	LD	BC,_REDIR	; Turn off redirection to
	LD	A,#01	;   do 'Terminate batch file'
	CALL	BDOS	;   prompting.
	LD	A,(BatchHandle)
	INC	A
	LD	A,#36	; Prompt 'Terminate batch file (Y/N)?'
	CALL	NZ,YN	;   and get response if in batch file.
	JR	Z,NABORT	; Don't abort if response was 'N'.
ENDBAT:	LD	HL,ErrorCode	; BATEND=NZ => end batch file, if any.
	LD	(HL),#80	; Error for 'batch file terminated'.
NABORT:	LD	A,#3A	; Set error type to piping error.
	LD	(StringCode),A
	CALL	UNPIPE	; Tidy up if command was piped.
	JP	NZ,ERROR
	DEC	A	; Clear ERRTYPE.
	LD	(StringCode),A
	LD	DE,(PipeAdres)
	LD	A,D	; Another command in pipe to execute ?
	OR	E
	JR	NZ,DONE	; Execute it if yes.
	LD	HL,ID_Redir	; If forked, then do a join to cancel
	LD	B,(HL)	;   redirection.
	XOR	A
	LD	(HL),A	; 0 => not forked.
	OR	B
	LD	C,_JOIN
	CALL	NZ,BDOS	; Join, and give error if any (should
	JP	NZ,ERROR	;   not normally occur).
	LD	HL,Null	; No command to execute.
	EXX
DONE:	JP	Next_0026

ABORT?:	CP	.ABORT	; Return Z if command abort error.
	RET	Z
	CP	.STOP
	RET	Z
	CP	.CTRLC
	RET	Z
	LD	A,(StringCode)	; Get error type.
	CP	#3C	; If an input or output error then
	RET	Z	;   command was aborted.
	CP	#3D
	RET

DSKERR:	LD	A,#01	; Disk error routine for printing
	RET	;   prompt just auto-aborts.

ABRT:	POP	HL
	LD	A,#FF
	RET

Aliasing:	PUSH	DE
	XOR	A
	BIT	7,(IY+#29)
	JP	NZ,Next_0413
Next_0404:	LD	A,(DE)
	INC	DE
	CP	" "
	JR	Z,Next_0404
	CP	"^"
	JR	Z,Next_0404
	DEC	DE
	LD	HL,BufEnvName
	PUSH	DE
	LD	A,(DE)
	CP	"@"
	JR	NZ,Next_0406
	LD	L,E
	LD	H,D
Next_0405:	INC	HL
	LD	A,(HL)
	LD	(DE),A
	INC	DE
	OR	A
	JR	NZ,Next_0405
	POP	DE
	LD	C,#00
	JR	Next_0412

Next_0406:	LD	(HL),A
	INC	HL
	INC	DE
	LD	A,(DE)
	OR	A
	JR	Z,Next_0407
	CP	"^"
	JR	NZ,Next_0406
Next_0407:	LD	(HL),#00
	EX	DE,HL
	CALL	GETCH
	PUSH	HL
	LD	HL,BufEnvName
	PUSH	HL
	DEC	HL
Next_0408:	INC	HL
	LD	A,(HL)
	CALL	MakeUpper
	LD	(HL),A
	OR	A
	JR	Z,Next_0409
	CP	" "
	JR	Z,Next_0409
	CP	"/"
	JR	NZ,Next_0408
Next_0409:	LD	A,(HL)
	LD	(HL),#00
	LD	B,H
	LD	C,L
	POP	HL
	PUSH	AF
	PUSH	BC
	LD	DE,BufExtra
	CALL	GetAlias
	POP	BC
	POP	AF
	LD	(BC),A
	LD	HL,(LineAdres)
	LD	(FIB2+1),HL
	LD	HL,BufEnvName
	LD	(LineAdres),HL
	LD	HL,BufExtra2
	CALL	ParseLine
	LD	HL,(FIB2+1)
	LD	(LineAdres),HL
	POP	HL
	LD	A,(BufExtra)
	POP	DE
	LD	C,#00
	OR	A
	JR	Z,Next_0412
	PUSH	DE
	CALL	NCopy
	POP	HL
	PUSH	HL
	LD	DE,BufExtra2
	LD	A,(DE)
	OR	A
	JR	Z,Next_0411
	INC	DE
Next_0410:	LD	A,(DE)
	OR	A
	JR	Z,Next_0411
	LD	C,A
	CALL	InsertByte
	INC	HL
	INC	DE
	JR	Next_0410

Next_0411:	LD	C,_CONST
	CALL	BDOS
	POP	DE
	JP	Next_0404

Next_0412:	CALL	RDCHAR
	JR	Z,Next_0413
	JR	C,Next_0412
	CP	"^"
	JR	NZ,Next_0412
	JP	Next_0404

Next_0413:	LD	B,A
	LD	DE,LineBuffer
	POP	HL
Next_0414:	LD	A,(HL)
	LD	(DE),A
	OR	A
	JR	Z,Next_0415
	INC	HL
	INC	DE
	DEC	B
	JR	NZ,Next_0414
	LD	A,.BUFUL
	RET

Next_0415:	LD	DE,LineBuffer
	XOR	A
	RET

MultiComm:	PUSH	DE
	XOR	A
	BIT	7,(IY+#2A)
	JR	NZ,Next_0417
	LD	C,#00
Next_0416:	CALL	RDCHAR
	JR	Z,Next_0417
	JR	C,Next_0416
	CP	"^"
	JR	NZ,Next_0416
	EX	DE,HL
	DEC	HL
	LD	(HL),#00
	INC	HL
	CALL	GETCH
	JR	NZ,Next_0418
Next_0417:	LD	H,A
	LD	L,A
Next_0418:	LD	(NextAdres),HL
	POP	DE
	RET

RemoveQuote:	LD	A,(HL)
	INC	HL
	OR	A
	RET	Z
	CP	#22
	JR	Z,Next_0419
	CP	"'"
	JR	NZ,RemoveQuote
Next_0419:	LD	B,A
	LD	D,H
	LD	E,L
	DEC	DE
Next_0420:	LD	A,(HL)
	CP	B
	JR	Z,Next_0421
	LD	(DE),A
	OR	A
	RET	Z
	INC	HL
	INC	DE
	JR	Next_0420

Next_0421:	PUSH	HL
Next_0422:	INC	HL
	LD	A,(HL)
	LD	(DE),A
	INC	DE
	OR	A
	JR	NZ,Next_0422
	POP	HL
	DEC	HL
	JR	RemoveQuote

ParseLine:	XOR	A
	LD	(HL),A
	LD	C,A
	LD	(FIB2),A
Next_0050:	CALL	RDCHAR
	JP	C,RP30
	CP	"%"
	JP	NZ,RP30
	LD	A,(DE)
	INC	DE
	CP	"&"
	JR	Z,Next_0423
	CP	"0"
	JR	C,RP20
	CP	"9"+1
	JR	NC,RP20
	DEC	DE
	PUSH	BC
	PUSH	HL
	PUSH	DE
	EX	DE,HL
	CALL	GET8
	JR	Z,Next_0424
	POP	DE
	POP	HL
	POP	BC
	LD	A,(DE)
	INC	DE
	JR	RP20

Next_0423:	PUSH	BC
	PUSH	HL
	PUSH	DE
	EX	DE,HL
	LD	A,#FF
	LD	(FIB2),A
	LD	E,#01
Next_0424:	LD	A,E
	INC	A
	POP	DE
	EX	DE,HL
	POP	HL
	POP	BC
	PUSH	BC
	PUSH	AF
	LD	A,(DE)
	CP	"&"
	JR	NZ,Next_0425
	LD	A,#FF
	LD	(FIB2),A
	INC	DE
Next_0425:	POP	AF
	PUSH	DE
	CALL	EXPAND
	POP	DE
	POP	BC
	RET	NZ
	JR	Next_0050

RP20:	CP	"%"
	JP	Z,RP30
	DEC	DE
	PUSH	BC
	PUSH	HL
	XOR	A
	LD	(BufEnvName),A
	LD	L,E
	LD	H,D
	PUSH	DE
	LD	D,#00
Next_0426:	LD	A,(HL)
	INC	HL
	OR	A
	JR	Z,Next_0430
	CP	"["
	JR	NZ,Next_0427
	INC	D
Next_0427:	CP	"]"
	JR	NZ,Next_0428
	DEC	D
Next_0428:	INC	D
	DEC	D
	JR	NZ,Next_0426
	CP	"%"
	JR	NZ,Next_0426
	POP	DE
	PUSH	HL
	PUSH	DE
	DEC	HL
	LD	(HL),#00
	EX	DE,HL
	LD	DE,BufEnvName
	LD	A,(HL)
	CP	"_"
	JP	Z,Next_0431
	CP	"@"
	JP	Z,Next_0435
	LD	BC,#FF6B
	CALL	BDOS
	JR	NZ,RP28
	PUSH	IX
Next_0429:	POP	IX
	POP	HL
	POP	HL
	EX	(SP),HL
RP22:	LD	A,(DE)
	INC	DE
	CALL	WRCHAR
	JR	NZ,RP23
	JR	C,RP22
RP23:	POP	DE
	POP	BC
	RET	NZ
	JP	Next_0050

Next_0430:	POP	DE
	JR	RP29

RP28:	POP	DE
	POP	HL
	DEC	HL
	LD	(HL),"%"
RP29:	POP	HL
	POP	BC
	LD	A,(DE)
	INC	DE
RP30:	CALL	WRCHAR
	RET	NZ
	JP	C,Next_0050
	RET

Next_0431:	EX	DE,HL
	PUSH	DE
	LD	B,#FF
Next_0432:	INC	DE
	INC	B
	LD	A,(DE)
	OR	A
	JR	NZ,Next_0432
	POP	DE
	LD	HL,Internals-2
	XOR	A
Next_0433:	JR	NZ,Next_0434
	INC	HL
	INC	HL
	LD	A,(HL)
	OR	A
	JR	Z,Next_0434
	CALL	COMPARE
	JR	C,Next_0433
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	PUSH	IX
	LD	DE,Next_0429
	PUSH	DE
	PUSH	HL
	XOR	A
	RET

Next_0434:	LD	DE,Null
	PUSH	IX
	JP	Next_0429

Next_0435:	EX	DE,HL
	PUSH	DE
	LD	B,#FF
Next_0436:	INC	DE
	INC	B
	LD	A,(DE)
	OR	A
	JP	Z,Next_0441
	CP	"["
	JR	NZ,Next_0436
	EX	DE,HL
	INC	HL
	PUSH	BC
	PUSH	HL
	LD	D,#01
Next_0437:	LD	A,(HL)
	INC	HL
	OR	A
	JR	Z,Next_0439
	CP	"["
	JR	NZ,Next_0438
	INC	D
Next_0438:	CP	"]"
	JR	NZ,Next_0437
	DEC	D
	JR	NZ,Next_0437
	DEC	HL
	LD	(HL),#00
	PUSH	IX
	POP	HL
	POP	DE
	PUSH	IX
	LD	C,(HL)
	LD	B,#00
	ADD	HL,BC
	INC	HL
	INC	HL
	PUSH	HL
	POP	IX
	CALL	ParseLine
	JR	Next_0440

Next_0439:	INC	A
	POP	HL
Next_0440:	POP	IX
	JP	NZ,RP29
	POP	BC
	LD	A,B
	EX	AF,AF'
	LD	A,(HL)
	LD	B,H
	LD	C,L
	EX	AF,AF'
	LD	B,A
	LD	A,H
	EX	AF,AF'
Next_0441:	POP	DE
	OR	A
	JP	Z,Next_0434
	LD	HL,Functions-2
	XOR	A
Next_0442:	JP	NZ,Next_0434
	INC	HL
	INC	HL
	LD	A,(HL)
	OR	A
	JP	Z,Next_0434
	CALL	COMPARE
	JR	C,Next_0442
	EX	AF,AF'
	LD	B,A
	INC	BC
	PUSH	BC
	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	POP	HL
	LD	DE,Next_0429
	PUSH	IX
	PUSH	DE
	PUSH	BC
	RET

;        This routine is called during the command line parsing to expand  the
; user's batch file replacable parameters, accessed as %0 to %9.
;        When  the  batch  file  was  invoked, the command line was saved in a
; buffer and the pointer PERC0 pointed to the start of it. When not in a batch
; file,  PERC0  points  to a null (a dummy null command line) so that %0 to %9
; are replaced by a null string.
;        On entry, B is the number of the parameter, 1 to 10 for parameters %0
; to %9. The length byte of the current command line is saved, and  the  first
; parameter expanded from the command at (PERC0). Then B is decremented and if
; not 0, then the old length byte is restored which causes the  just  expanded
; parameter  to  be  ignored, and then the next parameter is expanded.  When B
; decrements to 0 the length byte is  not  restored,  thus  making  the  newly
; expanded  parameter part of the command line. This is not the most efficient
; way of doing it but it is adequate.
; On entry, B is the parameter number required (1 to 10).
;           HL points to the length byte of the new expanded command line.
; On exit,  HL is preserved and the parameter has been expanded.
;           AF = error code.
EXPAND:	LD	B,A	; Save parameter number, 1 => %0.
	LD	C,#00	; Not in quotes initially.
	LD	DE,(LineAdres)	; Point to parameter's command line.
	LD	A,(HL)	; Save current length byte.
	EX	AF,AF'
EXP10:	CALL	RDCHAR
	JR	C,EXP20
	CP	"/"
	JR	Z,GOTSEP
	CALL	SEP?
	JR	NZ,EXP20
GOTSEP:	EX	DE,HL
	DEC	HL
	PUSH	BC
	CALL	GETCH
	POP	BC
	EX	DE,HL
	DJNZ	NXTPAR
	LD	A,(FIB2)
	OR	A
	RET	Z
	DEC	DE
	LD	A,(DE)
	CALL	SEP?
	JR	Z,Next_0443
	INC	DE
Next_0443:	LD	A,(DE)
	INC	DE
	CALL	WRCHAR
	RET	NZ
	JR	C,Next_0443
	RET

NXTPAR:	EX	AF,AF'
	LD	(HL),A	; Restore old command line.
	EX	AF,AF'
	LD	A,(DE)	; Get first character of next param.
	CP	"/"	; Fiddle to make sure / options are
	JR	NZ,EXP10	;   separate parameters.
	INC	DE
EXP20:	CALL	WRCHAR	; Put character in buffer.
	RET	NZ	; return if error.
	JR	C,EXP10	; Repeat for next character if not end.
	RET	; Else return with no error.

		SUBTTL	REDIRECT
;        This routine is called after all the other  parameter  expansion  has
; been  performed when parsing a command line. It removes all re-direction and
; piping information from the command line, so that commands and  programs  do
; not know anything about them.
; On entry, DE points to the first character of the ASCIIZ command line.
;           HL points the start of a buffer for the new command line.
; On exit,  AF = error code.
;           HL is preserved, and points to the length byte of the new command.
;       The actual entry point is at REDIRECT.
BADFN:	LD	A,.IFNM
	OR	A
	RET

REDIRECT:	XOR	A
	LD	(BufEnvData),A	; No output redirection yet.
	LD	(BufEnvName),A	; No input redirection yet.
	LD	C,A	; Clear quotes flag.
	LD	(HL),A	; Initialise length byte.
RED10:	CALL	RDCHAR
	JR	C,NXTRED
	BIT	7,(IY+#00)
	JR	NZ,NXTRED
	CP	"<"
	JR	Z,RED20
	CP	">"
	JR	NZ,NXTRED
	PUSH	DE
	EXX
	LD	HL,BufEnvData
	JR	RED30

RED20:	PUSH	DE	; Save start of input filename.
	EXX	; Save other registers.
	LD	HL,BufEnvName	; Copy input filename to BUFF2.
RED30:	EX	(SP),HL	; Save buffer ptr, get filename.
	PUSH	HL	; Save it again.
	CP	(HL)	; Skip double >> and <<.
	JR	NZ,NDBL
	INC	HL
NDBL:	CALL	GETCH	; Remove spaces after > or <.
	EX	DE,HL	; DE -> filename to parse.
	LD	BC,_PARSE	; Parse redirection filename.
	LD	A,#39	; Error type = redirection.
	LD	(StringCode),A
	CALL	BDOS
	EX	AF,AF'
	LD	A,B	; Get parse flags.
	POP	BC	; Get back pointer to filename start.
	POP	HL	; Get back buffer pointer.
	EX	AF,AF'
	RET	NZ	; Return if error.
	EX	AF,AF'
	BIT	5,A
	JR	NZ,BADFN	;   no filename and no extension.
	AND	#18
	JR	Z,BADFN
	PUSH	DE	; Save pointer to terminating char.
	EX	DE,HL	; HL -> end of filename, DE -> buffer.
	SBC	HL,BC	; HL = size of filename.
	PUSH	BC	; Save start of filename.
	EX	(SP),HL	; Get start, save size.
	POP	BC	; Get size.
	JR	Z,NOFN	; Go if null filename.
	LDIR	; Copy filename to buffer.
NOFN:	XOR	A
	LD	(DE),A	; Terminate with a null.
	EXX	; Get back command line pointers.
	POP	DE	; Continue after filename.
	DEC	A
	LD	(StringCode),A	; Normal errors again.
	JR	RED10	; Continue with rest of command line.

NXTRED:	CALL	WRCHAR
	RET	NZ
	JP	C,RED10
	LD	A,#39
	LD	(StringCode),A
	EXX
	LD	HL,BufEnvData
	LD	A,(HL)
	OR	A
	JR	Z,GOTOUT
	PUSH	HL
	LD	BC,#0145
	CALL	BDOS
	POP	HL
	RET	NZ
	LD	A,(HL)
	CP	">"
	JR	NZ,CRTOUT
	INC	HL
	PUSH	HL
	CALL	GETCH
	EX	DE,HL
	LD	C,_OPEN
	LD	A,#06
	CALL	BDOS
	POP	HL
	CP	.NOFIL
	JR	Z,CRTOUT
	OR	A
	RET	NZ
	LD	BC,#014A
	LD	A,#02
	SBC	HL,HL
	LD	E,L
	LD	D,H
	CALL	BDOS
	RET	NZ
	JR	GOTOUT

CRTOUT:	CALL	GETCH	; Allow spaces etc. after '>' and '>>'.
	EX	DE,HL
	LD	BC,_CREATE
	LD	A,#06	; Inheritable, not read.
	CALL	BDOS
	RET	NZ	; Return if can't create it.
GOTOUT:	LD	HL,BufEnvName	; Point to input filename.
	LD	A,(HL)
	OR	A
	JR	Z,GOTIN	; Go if no input redirection.
	PUSH	HL
	LD	BC,_CLOSE	; Close standard input.
	CALL	BDOS
	POP	HL
	RET	NZ	; Return if error.
	LD	A,(HL)	; Double << ?
	CP	"<"
	JR	NZ,OPNIN	; Go if not.
	INC	HL	; Skip last < character.
OPNIN:	CALL	GETCH	; Allow spaces after '<'.
	EX	DE,HL
	LD	C,_OPEN	; Attempt to open file.
	LD	A,#05	; Inheritable, not write.
	CALL	BDOS
	RET	NZ
	BIT	7,B	; 'File not found' if this is
	LD	A,.NOFIL	;  sub-directory.
	RET	NZ
GOTIN:	EXX	; Restore command line pointers.
	LD	A,#FF	; Error type = normal again.
	LD	(StringCode),A
	RET	; With error code.

		SUBTTL	PIPE
;       This routine is called to set up any piping that is necessary.
; On entry, DE -> command line.
; On exit, command is terminated at |.
PIPE:	LD	A,#3A	; Set error type to piping error.
	LD	(StringCode),A
	XOR	A
	LD	C,A	; Zero quotes flag.
	LD	L,A
	LD	H,A
	LD	(PipeAdres),HL	; Assume no following command.
	LD	A,(OutputHandle)	; Save current pipe output.
	EX	AF,AF'
RDPIPE:	CALL	RDCHAR
	JR	C,NPIPE
	BIT	7,(IY+#00)
	JR	NZ,NPIPE
	CP	"|"
	JR	NZ,NPIPE
	LD	L,E
	LD	H,D
	CALL	GETCH
	LD	(PipeAdres),HL
	DEC	DE
	XOR	A
	LD	(DE),A
	CALL	TEMPFILE
	RET	NZ
	LD	A,B
	LD	(OutputHandle),A
	JR	DOPIPE

NPIPE:	OR	A	; End of command line ?
	JR	NZ,RDPIPE	; Check next character for | if not.
	LD	(OutputHandle),A	; Last in pipeline, so no output file.
DOPIPE:	EX	AF,AF'
	OR	A
	JR	Z,FIRSTP	; Go if no previous command in pipe.
	LD	(InputHandle),A	; Else make last output this input.
	LD	B,A
	XOR	A	; Position file ptr to file start.
	LD	L,A
	LD	H,A
	LD	E,A
	LD	D,A
	LD	C,_SEEK
	CALL	BDOS
	RET	NZ
FIRSTP:	LD	A,(OutputHandle)	; If no piping at all being done, then
	LD	HL,InputHandle	;   don't fork.
	OR	(HL)
	JR	Z,PIPRET
	LD	C,_FORK	; Do fork for piping.
	CALL	BDOS
	RET	NZ
	LD	A,B
	LD	(ID_Pipelin),A	; Save process id for pipe.
	LD	A,(InputHandle)	; Get input file handle.
	OR	A	; First file in pipe ?
	JR	Z,CLOSOUT	; Go if yes.
	PUSH	AF	; Else close standard input and
	LD	BC,_CLOSE	;   dup the input handle.
	CALL	BDOS
	POP	BC
	LD	C,_DUP
	CALL	Z,BDOS
	RET	NZ
CLOSOUT:	LD	A,(OutputHandle)	; Get output file handle.
	OR	A	; Last file in pipe ?
	JR	Z,PIPRET	; Go if yes.
	PUSH	AF	; Else close standard output
	LD	BC,#0145	;   and dup the output handle.
	CALL	BDOS
	POP	BC
	LD	C,_DUP
	CALL	Z,BDOS
	RET	NZ
PIPRET:	LD	A,#FF	; Reset error type.
	LD	(StringCode),A
	XOR	A	; No error.
	RET

TEMPFILE:	LD	HL,PipeFileName+7
INCDIG:	LD	A,(HL)	;   temporary piping filename.
	INC	A
	LD	(HL),A
	CP	"9"+1
	JR	C,DIGOK	; Go if digit '0' - '9'.
	LD	(HL),"0"	; If it was >='9', then set it to '0'
	DEC	HL	;   and repeat for next character.
	JR	INCDIG

DIGOK:	LD	HL,TEMP$	; Read the TEMP environment string to
	CALL	GENV2	;   find out where to create it.
	LD	BC,_PARSE
	CALL	BDOS
	RET	NZ
	LD	A,B	; A=parse flags.
	AND	#18	; If non-null filename, then add a
	JR	Z,NULLFN	;   '\'.
	LD	A,"\"
	LD	(DE),A
	INC	DE
NULLFN:	LD	HL,PipeFileName	; Copy temporary filename to end of
	LD	BC,#0C	;   TEMP pathname.
	LDIR
	XOR	A
	LD	(DE),A	; Terminate the string.
	LD	DE,BufEnvData	; Attempt to create the file,
	LD	BC,#8044	;   but don't overwrite any
	LD	A,#04	;   existing file of the
	CALL	BDOS	;   same name.
	RET	Z
	CP	.FILEX	; If the file already exists, then
	JR	Z,TEMPFILE	;   loop back and try another filename.
	RET	; Else return the error.

		SUBTTL	UNPIPE
;        This routine is called after executing a command  and  printing  it's
; error  message  if  appropriate,  and  it  deals  with  various  tidying  up
; operations which are necessary after piping the output or input of a command
; On exit, DE -> next command in pipe, or 0 if none.
UNPIPE:	LD	HL,ID_Pipelin
	LD	B,(HL)
	XOR	A
	LD	(HL),A	;   (not forked now)
	OR	B
	LD	C,_JOIN
	CALL	NZ,BDOS	; Do the join if yes.
	RET	NZ
	LD	HL,InputHandle
	LD	B,(HL)
	XOR	A
	LD	(HL),A
	OR	B
	LD	C,_HDELETE
	CALL	NZ,BDOS
	RET

DELPIPE:	LD	HL,#00	; Abandon pipe.
	LD	(PipeAdres),HL
	LD	HL,InputHandle
	LD	B,(HL)
	XOR	A
	LD	(HL),A
	OR	B
	LD	C,_HDELETE	; Delete input pipe handle, if any.
	CALL	NZ,BDOS	;   (error ignored)
	LD	HL,OutputHandle
	LD	B,(HL)
	XOR	A
	LD	(HL),A
	OR	B
	LD	C,_HDELETE	; Delete output pipe handle, if any.
	CALL	NZ,BDOS	;   (error ignored)
	LD	HL,ID_Pipelin
	LD	B,(HL)
	XOR	A
	LD	(HL),A
	OR	B
	LD	C,_JOIN
	CALL	NZ,BDOS	; Join, if forked.
	RET

RDCHAR:	LD	A,(DE)
	INC	DE
	OR	A
	RET	Z
	INC	C
	DEC	C
	JR	Z,Next_0081
	CP	C
	SCF
	RET	NZ
	LD	C,#00
	OR	A
	SCF
	RET

Next_0081:	LD	C,A
	CP	#22
	JR	Z,Next_0444
	CP	"'"
	JR	Z,Next_0444
	LD	C,#00
	OR	A
	RET

Next_0444:	OR	A
	SCF
	RET

WRCHAR:	BIT	7,(HL)
	JR	NZ,BUFUL
	PUSH	BC	; Save BC.
	LD	C,(HL)
	LD	B,#00	; BC = offset to next buffer position.
	INC	BC
	ADD	HL,BC
	LD	(HL),A	; Put character in buffer.
	SBC	HL,BC	; Restore HL.
	POP	BC	; Restore BC.
	OR	A	; Null (end of line) ?
	RET	Z	; Return with no error if yes (NC).
	INC	(HL)	; Else include character in length.
	XOR	A	; No error, NC.
	SCF	; Cy => not end of line.
	RET

BUFUL:	LD	A,.BUFUL
	RET	; NZ => error.

		SUBTTL	DO_CMD
XORET:	XOR	A
	RET

DO_CMD:	CALL	GETCH
	EX	DE,HL
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	LD	(IY+#0A),B
	LD	(IY+#0B),C
	EX	(SP),HL
	EX	DE,HL
	POP	BC
	RET	NZ
	SBC	HL,DE
	LD	A,L
	ADD	HL,DE
	LD	(PathLen),A
	DEC	HL
	LD	A,(HL)
	INC	HL
	CP	"\"
	JR	NZ,Next_0446
	PUSH	HL
	LD	HL,(IffAdres)
	BIT	0,(HL)
	POP	HL
	JR	NZ,Next_0446
Next_0445:	PUSH	DE
	LD	HL,Cmd_Chdir
	JR	Next_0447
Next_0446:	LD	A,(ParseFlags)
	BIT	6,A
	JR	NZ,Next_0445
	EXX
	BIT	2,A
	JR	Z,Next_0084
	BIT	0,A
	JR	NZ,Next_0084
	EXX
	CALL	GETCH
	JR	NZ,BADRV
	LD	HL,(IffAdres)
	BIT	0,(HL)
	RET	NZ
	LD	A,(LogiDrive)
	DEC	A
	LD	E,A
	LD	C,_SELDSK
	CALL	BDOS
	LD	C,_ERROR
	CALL	BDOS
	LD	A,B
	RET

Next_0084:	BIT	0,A
	JR	Z,XORET
	BIT	3,A
	JP	Z,BADCMDZ
	AND	#40
BADRV:	LD	A,.BADCM	;   or '..' given.
	RET	NZ
	EXX	; Get registers.
	DEC	DE	; Point to length byte of command.
	PUSH	HL	; Save pointer to start of parameters.
	PUSH	BC	; Save pointer to start of last item.
	LD	A,(PathLen)	; Get length of first word.
	LD	B,A	; B=length of command.
	LD	HL,Commands-2	; First test for an internal command.
	XOR	A	; Set Z for loop entry.
DC10:	JR	NZ,NOTINT
	INC	HL
	INC	HL
	LD	A,(HL)
	OR	A
	JR	Z,NOTINT
	CALL	COMPARE
	JR	C,DC10
	LD	A,(HL)
	INC	HL
	LD	H,(HL)
	LD	L,A
	POP	BC
Next_0447:	LD	BC,Cmd_Else
	SBC	HL,BC
	ADD	HL,BC
	JR	Z,Next_0448
	LD	BC,Cmd_Endiff
	OR	A
	SBC	HL,BC
	ADD	HL,BC
	JR	Z,Next_0448
	LD	BC,Cmd_Iff
	OR	A
	SBC	HL,BC
	ADD	HL,BC
	JR	Z,Next_0448
	PUSH	HL
	LD	HL,(IffAdres)
	BIT	0,(HL)
	POP	HL
	JR	Z,Next_0448
	POP	DE
	XOR	A
	RET

Next_0448:	LD	BC,Cmd_Echo
	OR	A
	SBC	HL,BC
	ADD	HL,BC
	JR	Z,Next_0449
	LD	BC,@ECHO
	OR	A
	SBC	HL,BC
	ADD	HL,BC
	EX	(SP),HL
	JR	NZ,Next_0087
	EX	(SP),HL
Next_0449:	EX	(SP),HL
	LD	A,(HL)
	CALL	BLANK?
	JR	NC,Next_0087
	INC	HL
	DEFB	#06
Next_0087:	OR	A
	CALL	NC,GETCH
	XOR	A
	LD	(DirFlag),A
	LD	B,A
	DEC	A
	RET

NOTINT:	POP	BC
	POP	HL
	PUSH	HL
	LD	HL,(IffAdres)
	BIT	0,(HL)
	POP	HL
	RET	NZ
	INC	DE
	PUSH	HL
	PUSH	BC
	PUSH	DE
	EXX
	POP	DE
	POP	HL
	PUSH	HL
	XOR	A
	SBC	HL,DE
	LD	C,L
	LD	B,H
	LD	HL,BufEnvName
	EX	DE,HL
	JR	Z,NDP
	LDIR
NDP:	LD	(DE),A	; Terminate with a null.
	POP	DE	; DE -> start of last item.
	POP	HL	; HL -> terminating character.
	SBC	HL,DE	; Calculate size of given filename.
	LD	C,L
	LD	B,H
	LD	HL,BufExtra	; Copy given filename to BUFF3.
	PUSH	HL
	EX	DE,HL
	JR	Z,NFN	; Go if no filename (should not occur).
	LDIR
NFN:	LD	(DE),A
	EX	DE,HL
	POP	DE
	BIT	4,(IY+#0A)
	JR	NZ,GOTEXT
	LD	(HL),"."
	INC	HL
	LD	(HL),"*"
	INC	HL
	LD	(HL),#00
GOTEXT:	CALL	FNDCMD	; Look for command.
	JR	Z,EXECMD	; Execute command if file found.
	CP	.NOFIL
	RET	NZ	; Return error if not 'file not found'.
	LD	A,(ParseFlags)	; Get parse flags for command.
	AND	#06	; If drive or path specified, then
	LD	A,.BADCM	;   don't search the current PATH.
	LD	HL,Env_Path	; Get the current PATH environment
	CALL	Z,GENV2	;   string to BUFF1.
	RET	NZ
	EX	DE,HL	; HL -> PATH string in BUFF1.
USEPTH:	CALL	GETCH
BADCMDZ:	LD	A,.BADCM
	RET	Z
	LD	BC,BufEnvName
	CALL	CPYSTR
	RET	C
	LD	(Value_L),HL
	CALL	FNDCMD
	LD	HL,(Value_L)
	JR	NZ,USEPTH
EXECMD:	JR	NC,EXECOM
	LD	HL,ID_Pipelin
	LD	B,(HL)
	XOR	A
	LD	(HL),A
	OR	B
	LD	C,_JOIN
	CALL	NZ,BDOS
	LD	A,(BatchHandle)
	INC	A
	JR	Z,OPNBAT
	INC	A
	CALL	Z,ReleaseBTM
	LD	A,(ID_Redir)
	LD	B,A
	LD	C,_JOIN
	CALL	BDOS
	LD	A,(ID_Redir2)
	LD	(ID_Redir),A
	LD	A,(BatchHandle)
	CP	#FE
	JR	Z,OPNBAT
	LD	B,A
	LD	C,_CLOSE
	CALL	BDOS
OPNBAT:	LD	A,#3B
	LD	(StringCode),A
	LD	HL,ID_Redir
	LD	A,(HL)
	LD	(ID_Redir2),A
	XOR	A
	LD	(HL),A
	LD	DE,FileBuffer+7
	LD	HL,Ext_BTM
	LD	B,(HL)
	CALL	COMPARE
	JR	C,Next_0450
	CALL	OpenBTM
	LD	B,#FE
	JR	Next_0451

Next_0450:	LD	DE,FIB1
	LD	A,#01
	LD	C,_OPEN
	CALL	BDOS
Next_0451:	LD	(ErrorCode),A
	RET	NZ
	LD	L,A
	LD	H,A
	LD	(BatLineLen),HL
	DEC	A
	LD	(StringCode),A
	LD	A,B
	LD	(BatchHandle),A
	EXX
	PUSH	DE
	EXX
	POP	HL
	LD	DE,OrigLine
	LD	(LineAdres),DE
	CALL	NCopy
	RET

		SUBTTL	EXECOM
EXECOM:	LD	HL,EXPERT$
	CALL	ON?	;   if "EXPERT" switch is ON.
	JR	NC,EXPERT
	LD	A,(FIB1+25)	; Otherwise look at the media where
	LD	L,A	;   the .COM file was found and
	LD	DE,BufEnvData	;   if it is formatted by MSX-DOS2
	LD	C,_DPARM	;   (by checking the volume_id field)
	CALL	BDOS	;   we can proceed.
	RET	NZ	; Report any errors.
	LD	A,(BufEnvData+20)	; We had better define "FIB_VOLUME_ID".
	BIT	7,A	; This is not actuall a
	LD	A,.BADVER	;   "Wrong DOS version" what the error
	RET	NZ	;   code was intended for.
EXPERT:	LD	C,_FORK
	CALL	BDOS	;   so that the corresponding join will
	RET	NZ	;   tidy up it's open files.
	LD	A,B
	LD	(ID_Execute),A	; Save id of transient program process.
	LD	DE,FIB1	; Attempt to open command file.
	LD	C,_OPEN
	LD	A,#01	; Read only.
	CALL	BDOS
	RET	NZ	; Return if error.
	LD	A,B
	EX	AF,AF'
	LD	HL,BufEnvData	; Set up whole path string in BUFF with
	LD	A,(LogiDrive)	;   a drive : \ at the start, so that
	ADD	A,"@"	;   programs can find out where they
	LD	(HL),A	;   were loaded from.
	INC	HL
	LD	(HL),":"
	INC	HL
	LD	(HL),"\"
	INC	HL
	EX	DE,HL
	LD	C,_WPATH
	CALL	BDOS
	RET	NZ
	LD	DE,FIB1+1	; Copy upper-case filename in FIB on
CPYFN:	LD	A,(DE)
	LD	(HL),A
	INC	DE
	INC	HL
	OR	A
	JR	NZ,CPYFN
	LD	DE,BufEnvData
	LD	HL,PROG$
	LD	C,_SENV
	CALL	BDOS
	EXX
	PUSH	HL
	EXX
	POP	DE
	PUSH	DE
	LD	HL,PARAM$
	LD	C,_SENV
	CALL	BDOS
	POP	HL
	CALL	LDCOME
	RET	NZ
	CALL	SetPage2
	LD	DE,(AliasEnd+#8000)
	LD	HL,(VariableEnd+#8000)
	RES	7,H
	CALL	RestorePage2
	OR	A
	SBC	HL,DE
	LD	DE,Buffer1-ExitAdres
	CALL	Compare4
	LD	A,.NORAM
	RET	C
	CALL	SetPage2
	LD	DE,(VariableEnd+#8000)
	PUSH	DE
	LD	HL,Buffer1-1
	LD	BC,Buffer1-ExitAdres
	LDDR
	EX	DE,HL
	POP	DE
	LD	(HL),D
	DEC	HL
	LD	(HL),E
	DEC	HL
	LD	(VariableEnd+#8000),HL
	CALL	RestorePage2
	LD	DE,(ExitAdres)
	LD	HL,ExitAdres-1
	LD	BC,ExitAdres-BootStrap+1
	LDDR
	LD	HL,#FFD8
	ADD	HL,DE
	EX	DE,HL
	LD	E,#08
	LD	HL,(#06)
	LD	L,E
	LD	BC,#09
	LDDR
	PUSH	DE
	INC	D
	LD	E,#06
	LD	(#06),DE
	XOR	A
	LD	(#03),A
	LD	A,(CurrentDrive)
	DEC	A
	LD	(#04),A
	LD	DE,#00
	LD	C,_DEFAB
	CALL	BDOS
	POP	DE
	DEC	D
	LD	HL,LDCOME-1
	LD	BC,#59
	LDDR
	INC	DE
	PUSH	DE
	RET

	LD	SP,(EndTPA)
	PUSH	DE
	LD	HL,Stack-1
	LD	BC,Stack-Start
	LDDR
	INC	DE
	EX	DE,HL
	EX	(SP),HL
	DEC	H
	PUSH	HL
	EX	AF,AF'
	LD	B,A
	PUSH	BC
	LD	C,_READ
	LD	DE,#0100
	CALL	BDOS
	POP	BC
	POP	DE
	JR	NZ,Next_0101
	SBC	HL,DE
	LD	A,.NORAM
	JR	Z,Next_0101
	LD	C,_CLOSE
	CALL	BDOS
	JR	NZ,Next_0101
	LD	DE,#80
	LD	C,_SETDMA
	CALL	BDOS
	LD	A,#FF
	LD	(#37),A
	LD	DE,(#01)
	DEC	DE
	DEC	DE
	DEC	DE
	DEC	DE
	LD	HL,(#06)
	LD	L,#00
	LD	SP,HL
	XOR	A
	LD	B,A
	LD	L,A
	LD	H,A
	LD	C,#FF
	PUSH	HL
	JP	#0100

Next_0101:	LD	B,A
	LD	C,_TERM
	JP	BDOS

LDCOME:	EX	DE,HL
	LD	HL,#80	; Zero FCBs.
	LD	B,#24
	XOR	A
FILFCB:	DEC	HL
	LD	(HL),A
	DJNZ	FILFCB
	PUSH	DE	; Save ptr to start of parameters.
	CALL	SETFCB	; Set up first FCB.
	JR	NZ,FCBERR
	EX	DE,HL	; Skip separators.
	CALL	GETCH
	EX	DE,HL
	LD	HL,#6C
	CALL	SETFCB	; Set up second FCB.
FCBERR:	POP	HL	; HL -> command line again.
	RET	NZ
	LD	BC,#80	; Copy & upper-case parameters to 80H.
	XOR	A
	LD	D,A	; Initialise character flags.
	DEC	A
	LD	(BC),A	; Initialise count.
	INC	BC
CPYCMD:	LD	E,(HL)	; Get character.
	PUSH	HL
	PUSH	BC
	LD	HL,#80	; Increment count in anticipation.
	INC	(HL)
	LD	C,_CHKCHR	; Get upper cased character.
	LD	HL,UPPER$	; Upper case the character only
	CALL	ON?	;  if upper casing is ON.
	CCF
	SBC	A,A
	CALL	NZ,BDOS
	POP	BC
	POP	HL
	RET	NZ
	OR	E	; Get character, test for end of line.
	LD	(BC),A
	RET	Z	; Ret with no error if done.
	INC	BC	; Else do next.
	INC	HL
	JR	CPYCMD

		SUBTTL	SETFCB
SETFCB:	EX	DE,HL
	CALL	GETCH	; Skip separators.
	EX	DE,HL
	PUSH	HL	; Save FCB pointer.
	LD	BC,_PARSE
	CALL	BDOS	; Do a parse path on parameter.
	EX	DE,HL	; DE -> start of last item.
	POP	HL	; Get pointer to CP/M FCB.
	RET	NZ
	BIT	2,B
	JR	NZ,GOTDRV	; Go if yes, else use 0.
	LD	C,#00	; 0 => use default drive.
GOTDRV:	LD	(HL),C	; Set up drive.
	INC	HL	; Then parse filename to set up FCB.
	LD	C,_PFILE
	JP	BDOS	; Leaves DE -> terminating character.

FNDCMD:	LD	DE,BufEnvName
	LD	BC,_PARSE
	CALL	BDOS
	SCF
	RET	NZ
	LD	A,C
	LD	(LogiDrive),A
	LD	HL,BufExtra
	LD	A,B
	AND	#18
	JR	Z,Next_0106
	LD	A,"\"
	LD	(DE),A
	INC	DE
Next_0106:	CALL	NCopy
	EX	AF,AF'
	LD	DE,BufEnvName
	LD	IX,FIB1
	LD	B,#06
	LD	C,_FFIRST
FCMD10:	CALL	BDOS	; Search for file.
	JR	Z,GOTFIL	; Go if file found.
	CP	.NOFIL
	SCF	; Return C and NZ if error not
	RET	NZ	;   'file not found'.
	EX	AF,AF'
	CCF
	SBC	A,A	; FF => batch file not found.
	AND	.NOFIL	; Return .NOFILE, NZ and C if batch
	SCF	;   file not found, else Z and C.
	RET

GOTFIL:	LD	DE,FIB1+1
	CALL	COMBAT
	RET	Z
	EXX
	PUSH	BC
	PUSH	DE
	PUSH	HL
	EXX
	LD	DE,Buffer1+1
	LD	HL,FileBuffer+8
	LD	B,3
Next_0997:	LD	A,(HL)
	CP	" "
	JR	Z,Next_0998
	LD	(DE),A
	INC	HL
	INC	DE
	DJNZ	Next_0997
Next_0998:	EX	DE,HL
	LD	(HL),#00
	LD	HL,Buffer1
	LD	(HL),"."
	LD	DE,BufEnvData
	CALL	GetAlias
	EXX
	POP	HL
	POP	DE
	POP	BC
	EXX
	LD	A,(DE)
	OR	A
	LD	C,_FNEXT
	JR	Z,FCMD10
	EX	DE,HL
	LD	DE,Buffer1
	CALL	NCopy
	DEC	DE
	LD	A," "
	LD	(DE),A
	INC	DE
	PUSH	DE
	LD	DE,BufEnvName
	PUSH	DE
	LD	BC,_PARSE
	CALL	BDOS
	LD	(HL),#00
	POP	HL
	POP	DE
	CALL	NCopy
	DEC	DE
	LD	B,8
	LD	HL,FileBuffer
Next_0452:	LD	A,(HL)
	CP	" "
	JR	Z,Next_0453
	LD	(DE),A
	INC	DE
	INC	HL
	DJNZ	Next_0452
Next_0453:	LD	A,"."
	LD	(DE),A
	INC	DE
	LD	HL,FileBuffer+8
	LD	B,3
Next_0454:	LD	A,(HL)
	CP	" "
	JR	Z,Next_0455
	LD	(DE),A
	INC	DE
	INC	HL
	DJNZ	Next_0454
Next_0455:	EXX
	PUSH	HL
	EXX
	POP	HL
	CALL	NCopy
	EX	DE,HL
	LD	(HL),#00
	POP	HL
	LD	HL,Buffer1
	JP	DO_CMD

COMBAT:	LD	HL,FileBuffer
	LD	C,_PFILE
	CALL	BDOS
	SCF
	RET	NZ
	LD	DE,FileBuffer+7
	LD	HL,Ext_COM
	LD	B,(HL)
	CALL	COMPARE
	DEC	A
	RET	NC
	CALL	COMPARE
	DEC	A
	CCF
	RET	Z
	CALL	COMPARE
	DEC	A
	CCF
	RET

Ext_COM:	DEFB	3
	DEFB	"COM"
Ext_BAT:	DEFB	3
	DEFB	"BAT"
Ext_BTM:	DEFB	3
	DEFB	"BTM"

		SUBTTL	COMPARE
;******************************************************************************
;       This routine is used to compare two strings, mainly to decode commands
; from the command table.
;        The command at (DE) with length in B (and at (DE)) is  compared  with
; the  string at (HL), length byte first. If the strings match, then the carry
; is returned reset (NC). Otherwise, if the Z flag is not set  (NZ)  then  the
; command had a length byte smaller than the string originally at (HL).
; On exit,  BC and DE are not corrupted, and HL points to the byte after the
;               string originally at (HL).
COMPARE:	PUSH	BC
	PUSH	DE
	LD	A,B	; Get count.
	LD	B,(HL)	; Get length from table.
	CP	B	; Compare length bytes.
	JR	C,CMP30	; Go with NZ to stop search.
	INC	B	; Compare length bytes too.
CMP10:	JR	C,CMP20	; Go if mismatch has occured.
	SUB	(HL)	; Chars match ?
	ADD	A,#FF	; NC => yes, else no.
CMP20:	INC	HL	; Point to next char pair.
	INC	DE
	LD	A,(DE)
	CALL	UC	; Upper case, carry not corrupted.
	DJNZ	CMP10	; Compare next character.
	SBC	A,A	; C & FF => no match.
	INC	A	; Set Z if Cy set, Cy preserved.
CMP30:	POP	DE
	POP	BC
	RET

UC:	BIT	7,A
	RET	NZ
	BIT	6,A
	RET	Z
	RES	5,A
	RET

MakeLower:	CP	"A"
	RET	C
	CP	"Z"+1
	RET	NC
	SET	5,A
	RET

MakeUpper:	CP	"a"
	RET	C
	CP	"z"+1
	RET	NC
	RES	5,A
	RET

DATE$:	DEFB	"DATE",0
TIME$:	DEFB	"TIME",0
ON$:	DEFB	"ON",0
OFF$:	DEFB	"OFF",0
ECHO$:	DEFB	"ECHO",0
HELP$:	DEFB	"HELP",0
Env_Path:	DEFB	"PATH",0
Env_Cdpath:	DEFB	"CDPATH",0
PROMPT$:	DEFB	"PROMPT",0
Env_TabOrder:	DEFB	"TABORDER",0
PARAM$: DEFB	"PARAMETERS",0
PROG$:	DEFB	"PROGRAM",0
TEMP$:	DEFB	"TEMP",0
UPPER$:	DEFB	"UPPER",0
Env_Lower:	DEFB	"LOWER",0
REDIR$:	DEFB	"REDIR",0
EXPERT$:	DEFB	"EXPERT",0
Env_Alias:	DEFB	"ALIAS",0
Env_Separ:	DEFB	"SEPAR",0
Env_Expand:	DEFB	"EXPAND",0
Env_Pushd:	DEFB	"PUSHD",0
TEMPFN:	DEFB	"%PIPE00.$$$"
Data_Prompt:	DEFB	"%_CWD%>",0
Data_TabOrder:	DEFB	"BOTH",0


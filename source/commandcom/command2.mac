;
; COMMAND2.COM - Master file: includes all the modules in link order.
; Assembled as a single absolute program at 0100h.
;
; While the 2.41 porting milestone is in progress the build must stay
; byte-identical to command241.com: run `make verify` after every change.
;
	org	0100h
	include	command.inc
	include	start.mac
	include	cli.mac
	include	tables.mac
	include	intvar.mac
	include	cmd.mac
	include	files.mac
	include	dirs.mac
	include	copy.mac
	include	io.mac
	include	batch.mac
	include	misc.mac
	include	editor.mac
	include	messages.mac
	include	var.mac
	end

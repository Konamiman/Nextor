	name('cmd')
	TITLE	Nextor - COMMAND3.COM
	SUBTTL	Non-disk commands
	INCLUDE	command.inc
;******************************************************************************
;
;        The internal commands that do not deal with files: batch flow
; control (GOTO/GOSUB/RETURN/END), IF and IFF/THEN/ELSE/ENDIFF, screen and
; keyboard commands, environment and alias management, HISTORY, MEMORY,
; date and time.
;
;        Based on COMMAND.COM 2.31, copyright (1986) IS Systems Ltd, and on
; the COMMAND2.COM 2.40/2.41 additions by Fokke Post, whose source code was
; released as freeware in 2003.
;
;******************************************************************************
;        The REM command does nothing, so that remark lines in batch files
; parse as valid commands.
@REM::	XOR	A	; Return with no error.
	RET

		SUBTTL	BEEP
;        The BEEP command just prints a BEL control character. Note that on
; entry to an internal command handler HL points to the parameter text and
; A=FF, so the initial AND (HL) sets Z when there are no parameters.
@BEEP::	AND	(HL)	; No parameters allowed.
	LD	A,.INP##
	RET	NZ
	LD	A,#07	; Print BEL.
	JP	PRCHAR##

		SUBTTL	BOOT
;        The BOOT command (new in 2.44) sets the drive that MSX-DOS will
; boot from the next time it starts up, for example when coming back from
; BASIC: the validated drive number is stored in the BOOTDRV variable of
; the DOS kernel. Only existing drives from A: to H: are accepted.
@BOOT::	AND	(HL)
	LD	A,.NOPAR##
	JR	Z,BOOERR	; The drive letter is mandatory.
	CALL	PARSDR	; D = drive number (1 = A:).
	CALL	Z,GCHKEOL##	; Nothing may follow it.
	RET	NZ
	LD	A,D
	CP	9
	JR	NC,BOODRV	; Only drives A: to H: can be set.
	PUSH	DE
	LD	C,_LOGIN##
	CALL	BDOS	; L = bit map of existing drives.
	POP	DE
	LD	B,D
BOO10:	RR	L	; Move the drive's bit into Cy.
	DJNZ	BOO10
	JR	NC,BOODRV	; The drive does not exist.
	LD	A,D
	LD	(BOOTDRV),A	; Set the new boot drive.
	XOR	A
	RET

BOODRV:	LD	A,.IDRV##	; 'Invalid drive'.
BOOERR:	OR	A
	RET

		SUBTTL	HERTZ
;        The HERTZ command (new in 2.44) sets the VDP interrupt frequency:
; HERTZ 50 or HERTZ 60. Bit 1 of VDP register 9 is updated through the
; WRTVDP BIOS routine, which keeps the register shadow in sync, skipping
; the call when the bit already has the wanted value. On a first
; generation MSX, whose VDP has no such register, the command does
; nothing at all.
@HERTZ::	AND	(HL)
	LD	A,.NOPAR##
	JR	Z,HRTERR	; The frequency is mandatory.
	LD	A,(MSXVER##)
	OR	A
	RET	Z	; First generation MSX: do nothing.
	CALL	GET8##	; E = the frequency.
	RET	NZ
	LD	A,E
	LD	B,#00	; Frequency bit: 0 => 60Hz,
	CP	60
	JR	Z,HRT10
	LD	B,#02	;   1 => 50Hz.
	CP	50
	JR	Z,HRT10
	LD	A,.IPARM##	; Anything else is an error.
HRTERR:	OR	A
	RET
HRT10:	LD	A,(RG9SAV)	; Nothing to do if the bit already
	LD	C,A	;   has the wanted value.
	AND	#02
	CP	B
	RET	Z
	LD	A,C	; Else update bit 1, preserving the
	AND	#FD	;   other bits.
	OR	B
	LD	B,A
	LD	C,#09
	LD	IX,WRTVDP
	JP	CALLSLOT	; WRTVDP updates the shadow too.

;        This module contains the command routines for the  assorted  commands
; which are not directly related to the disk system eg. CLS and DATE.
		SUBTTL	ASSIGN
;        This  is  the  ASSIGN  command  routine,  which  either  sets  up  an
; assignment,  clears all assignments or displays the current assignment for a
; specified drive. Note that a drive can be un-assigned without affecting  the
; other drives by assigning it to itself.
@ASSIGN::	AND	(HL)	; If no parameters, then just cancel
	LD	B,A	;   all assigns.
	LD	D,A
	LD	C,_ASSIGN##
	JP	Z,BDOS

	CALL	PARSDR	; Parse a drive letter.
	RET	NZ
	LD	B,D	; Save in B.
	CALL	GETCH##
	JR	NZ,ASN10	; Go if second drive given.
	LD	D,#FF	; Else get current assign for this
	LD	C,_ASSIGN##	;   drive.
	PUSH	BC
	CALL	BDOS
	POP	BC
	RET	NZ
	LD	HL,LPRINT##	; Print CRLF at end.
	PUSH	HL
	CALL	DDRV	; Print drive.
	LD	A,"="	; Print '=' and the other drive.
	CALL	PRCHAR##
	LD	B,D
DDRV:	LD	A,B
	ADD	A,"@"
	CALL	PRCHAR##	; Print drive letter.
	LD	A,":"
	JP	PRCHAR##

ASN10:	CALL	PARSDR	; Get second drive.
	RET	NZ
	CALL	GETCH##	; Make sure there's no garbage on the
	LD	A,.INP##	;   end of the line.
	RET	NZ
	LD	C,_ASSIGN##	; Attempt to set up new assign.
	JP	BDOS

PARSDR::	LD	A,(HL)	; Get drive letter.
	CALL	UC##
	SUB	"@"	; Attempt to convert to drive number.
	JR	C,IDRV	; Invalid drive if < 'A'.
	JR	Z,IDRV
	CP	#1B	; Invalid drive if > 'Z'.
	JR	NC,IDRV
	LD	D,A	; Return drive in D.
	INC	HL
	LD	A,(HL)	; Allow a colon afterwards.
	CP	":"
	JR	NZ,NCOL
	INC	HL
NCOL:	LD	A,(HL)	; Make sure drive is followed by a
	CALL	SEP?##	;   separator character.
	RET	Z	; OK if it is.
IDRV:	LD	A,.IDRV##
	OR	A
	RET

@BASIC::	CALL	LDCOME##
	RET	NZ
	LD	A,(SHRAMFL##)	; No segment to tidy up when SHELLRAM
	OR	A	;   is OFF.
	JR	NZ,BAS10
	LD	HL,VAREND	; Release variable memory
	LD	A,#FF	;   (reset VAREND to BFFFh, the
	CALL	WRCHR##	;   segment top: nothing swapped).
	INC	HL
	LD	A,#BF
	CALL	WRCHR##
BAS10:	LD	SP,#F51F
	CALL	#F368
	JP	#4022

@BUFFERS::	AND	(HL)
	JR	NZ,SETBUF
	LD	BC,_BUFFER##
	CALL	BDOS
	RET	NZ
	PUSH	BC
	LD	A,#27
	CALL	DMESS##
	POP	AF
	LD	IX,ENVDATA##
	PUSH	IX
	CALL	D8##
	POP	DE
	JP	DMSCR##

SETBUF:	CALL	GET8##	; Get the number specified into E.
	CALL	Z,CHKNO##
	RET	NZ
	LD	A,(HL)	; Check for garbage on the end of the
	OR	A	;   line.
	LD	A,.INP##
	RET	NZ	; Give error if too many parameters.
	LD	B,E	; Get specified number.
	LD	C,_BUFFER##
	JP	BDOS	; Attempt to set that number.

@CLS::	AND	(HL)
	LD	A,.INP##
	RET	NZ
	LD	A,#0C
	JP	PRCHAR##

		SUBTTL	CPU
;        The CPU command (new in 2.40) displays or sets the CPU mode of an
; MSX turbo R: 0 = Z80, 1 = R800 ROM, 2 = R800 DRAM. It uses the CHGCPU and
; GETCPU BIOS entries, which exist from MSX version 3 upwards; on older
; machines setting the mode is silently ignored and the mode is always
; reported as Z80.
@CPU::	AND	(HL)	; Display the mode if no parameter.
	JR	Z,CAL20
	LD	A,(HL)	; Get the mode: a digit 0..2.
	INC	HL
	SUB	"0"
	JR	C,CAL10
	CP	3
	JR	NC,CAL10
	EX	AF,AF'	; Save the mode.
	CALL	GETCH##	; No further parameters allowed.
	LD	A,.INP##
	RET	NZ
	LD	A,(MSXVER##)	; Return quietly, doing nothing, on
	CP	3	;   machines below MSX turbo R.
	LD	A,0
	RET	C
	EX	AF,AF'	; Get mode; set b7 to also update
	OR	%10000000	;   the CPU LED.
	LD	IX,#0180	; CHGCPU BIOS entry.

;        Call the main BIOS ROM routine whose address is in IX, via CALSLT.
; The stack is first moved to free RAM in page 3, where it remains visible
; whatever slots the inter-slot call switches in.
; On exit, E = A as returned by the BIOS routine, A = 0 with Z set, and IY
; is restored to the base of the IY-addressed variables (CALSLT corrupts
; it). The alternate register set is corrupted as well (by CALSLT, when the
; main ROM is in an expanded slot), which is harmless while a command runs;
; the command loop itself keeps its line pointer in HL' (see YENPAT in
; io.mac, which is called from there).
CALLSLOT::	LD	IY,(EXPTBL-1)	; IYh = main ROM slot.
	LD	HL,#00	; Switch to a stack in page 3,
	ADD	HL,SP	;   saving the current one.
	LD	SP,#F51F
	PUSH	HL
	CALL	CALSLT
	POP	HL	; Restore the original stack.
	LD	SP,HL
	LD	E,A	; Return the BIOS result in E.
	XOR	A
	LD	IY,REDIRST##	; Restore the variables base.
	RET

CAL10:	LD	A,.BADNO##	; 'Invalid number' unless 0..2.
	OR	A
	RET

CAL20:	LD	A,#43	; Print 'CPU mode is ', then 'Z80'
	CALL	DMESS##	;   if not a turbo R,
	LD	A,(MSXVER##)
	CP	3
	LD	A,#44
	JP	C,DMESSCR##
	LD	IX,#0183	;   else ask GETCPU: message #44+n
	CALL	CALLSLOT	;   = 'Z80'/'R800-ROM'/'R800-RAM'.
	LD	A,E
	ADD	A,#44
	JP	DMESSCR##

@DATE::	PUSH	HL
	CALL	DFORM##
	POP	HL
	LD	A,(HL)
	OR	A
	JR	NZ,RDAT
	LD	C,_GDATE##
	CALL	BDOS
	PUSH	HL
	PUSH	DE
	PUSH	AF
	LD	A,#16
	CALL	DMESS##
	POP	AF
	ADD	A,#17
	CALL	DMESS##
	LD	A,#1E
	CALL	DMESS##
	POP	DE
	POP	HL
	LD	BC,#F844
	ADD	HL,BC
	LD	A,D
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,A
	ADD	A,A
	RL	L
	OR	E
	LD	D,L
	LD	HL,ENVNAME##+1
	LD	(HL),D
	DEC	HL
	LD	(HL),A
	LD	C,#FF
	LD	IX,ENVNAME##+2
	PUSH	IX
	CALL	DDATE##
	POP	DE
	CALL	PRTSTR##
	LD	A,#1F
	CALL	DMESSCR##
NEWDAT:	LD	A,#20	; Print 'Enter new date'.
	CALL	DMESS##
	LD	HL,DATE$##	; Get the DATE environment string.
	CALL	GENV2##
	JR	NZ,NDFORM	; Don't print the format if error.
	LD	A,(DE)	; DATE in the environment ?
	OR	A
	JR	Z,NDFORM	; Go if not.
	PUSH	DE
	LD	A,#22	; Else print the format from the
	CALL	DMESS##	;   environment.
	POP	DE
	CALL	PRTSTR##
	LD	A,#23
	CALL	DMESS##
NDFORM:	LD	A,#21	; Print end message.
	CALL	DMESS##
	CALL	INLI##	; Input a line.
	JR	Z,DAT5	; Go if no error.
	CP	.EOF##
	RET	NZ	; Return if not end of file error.
DAT5:	INC	HL	; Point passed length byte.
	CALL	GETCH##	; Skip leading separators.
	RET	Z	; Just return if new date not given.
RDAT:	EXX	; Hide the input line pointer.
	LD	C,_GDATE##	; Get current date again for defaults.
	CALL	BDOS
	EXX	; Save current values, get input ptr.
	LD	A,(IY+#12)
	ADD	A,A	; Ignore top two bits.
	ADD	A,A
	LD	B,#03	; Read 3 numbers.
	PUSH	AF	; Save format variable.
	JR	DAT20

DAT10:	CALL	DTSKIP##	; Skip date/time separators.
	JR	C,BADAT	; Go if invalid.
DAT20:	CALL	GETNO##	; Get a number.
	EXX
	LD	B,A	; Save number.
	SBC	A,A	; FF => invalid number, 0 => OK.
	LD	C,A	; Save error flag.
	POP	AF	; Get & adjust format variable for this
	RLCA	;   iteration.
	RLCA
	PUSH	AF
	INC	C	; Error ?
	JR	Z,DAT50	; Use default value if yes.
	AND	#03	; Mask out other grotty bits.
	JR	Z,DAT50	; Go if invalid field value.
	DEC	A	; Day ?
	JR	Z,DAT40	; Go if yes.
	DEC	A	; Month ?
	JR	Z,DAT30	; Go if yes, else year.
	EXX
	CALL	GETDIG##	; See if more digits of the number.
	JR	C,NOCENT	; Go if not (century not given).
	INC	HL	; Point to next digit.
	CALL	GNO##	; Get second digit.
	JR	C,BADAT	; Error if invalid.
	EXX
	SUB	#50	; Convert 80-99 to offset from 1980.
	LD	C,A	; Save year part.
	LD	A,B	; Get century.
	CP	#13
	JR	Z,ADD1980	; Go if 19xx with offset from 1980.
	CP	#14
	LD	A,C	; Get year.
	JR	Z,CENT20	; Go if 20xx.
BADAT:	POP	AF	; Balance stack.
	LD	B,.IDATE##	; Give 'Invalid date' error.
	JR	DAT60	; Print error, re-prompt.

NOCENT:	EXX
	LD	A,B	; Get given year.
	SUB	#50	; 80-99 -> 0-19 (offset from 1980).
	JR	NC,CENT19	; Go if 1980-1999.
CENT20:	ADD	A,#64	; Convert to offset into 2000..
CENT19:	LD	C,A
ADD1980:	LD	B,#00	; BC=offset from 1980.
	LD	HL,#07BC
	ADD	HL,BC	; HL=new date.
	LD	B,D	; Skip to DAT50.
DAT30:	LD	D,B	; Save month.
	DEFB	#06
DAT40:	LD	E,B
DAT50:	EXX	; Save new date, get line ptr.
	DJNZ	DAT10	; Get separator & next digit.
	CALL	GETCH##	; Skip trailing spaces.
	JR	NZ,BADAT	; Error if end of line.
	POP	AF	; Balance stack.
	EXX	; Get the new date.
	LD	C,_SDATE##
	CALL	BDOS	; Attempt to set the new date.
	AND	.IDATE##	; .IDATE if error, else 0.
	RET	Z	; Return if no error.
	LD	B,A
DAT60:	LD	DE,ENVNAME##
	LD	C,_EXPLAIN##
	CALL	BDOS
	PUSH	DE
	CALL	LPRINT##
	LD	A,#0D
	CALL	DMESS##
	POP	DE
	CALL	PRTSTR##
	LD	A,#0E
	CALL	DMESSCR##
	JP	NEWDAT

		SUBTTL	ECHO
;        The ECHO command just prints it's arguments on the screen. It is used
; for displaying comments ans messages in batch files.
;
;        ECHOS (new in 2.40) does the same, but without the trailing CR/LF.
;
@ECHO::	EX	DE,HL	; DE -> arguments.
	JP	DMSCR##	; Print rest of command line & CR,LF.

@ECHOS::	EX	DE,HL	; DE -> arguments.
	JP	PRTSTR##	; Print rest of command line only.

		SUBTTL	EXIT
;        The EXIT command reads an optional error number as it's argument  and
; then  exits  this invokation of COMMAND with the error code. It restores the
; pointers at the bottom of page 0, the BIOS re-boot jump entry point and  the
; environment strings which COMMAND saved when it was first entered.
@EXIT::	AND	(HL)
	JR	Z,EXIT	; EXIT with no error if no parameters.
	CALL	GET8##	; Else read a number into E.
	CALL	Z,CHKNO##	; Check for garbage after number.
	CALL	Z,CHKEOL##	; Check for garbage on end of line.
	RET	NZ
	LD	A,E

EXIT::	PUSH	AF	; Save error code for returning.
	LD	HL,BOOTSTRAP##	; Restore vectors in page 0 to what
	LD	DE,#00	;   they were when COMMAND was invoked.
	LD	BC,#08
	LDIR
	CP	.OKCMD##	; Restore environment strings unless
	JR	Z,ENVDON	;   end of COMMAND <command> (eg.
;					;   AUTOEXEC.BAT).
	LD	DE,#01	; Delete first environment string.
DELENV:	PUSH	DE
	CALL	FENV##	; Get name of item.
	POP	DE
	INC	DE
	JR	NZ,DELENV	; Do next if error.
	OR	(HL)	; Name null (end of strings) ?
	JR	Z,SETENV	; All deleted if yes.
	PUSH	DE
	LD	DE,ENVDATA##
	XOR	A
	LD	(DE),A	; Set to a null string to delete.
	LD	C,_SENV##	; Else set item to null.
	CALL	BDOS
	POP	DE	; Now the 1st string's deleted, the 2nd
	DEC	DE	;   string's become the new first
	JR	DELENV	;   string so DE not incremented.

SETENV:	LD	HL,(#06)	; Find out address of saved environment
	DEC	HL	;   strings, and restore them.
	DEC	HL
	DEC	HL
	DEC	HL
	DEC	HL
	DEC	HL
	DEC	HL
CPYENV:	LD	A,(HL)	; End of environment string list ?
	OR	A
	JR	Z,ENVDON
	LD	DE,ENVNAME##	; Copy name of item to BUFF2.
CPY20:	LD	A,(HL)	; Get character.
	LD	(DE),A
	DEC	HL
	INC	DE
	OR	A
	JR	NZ,CPY20	; Copy until null at end.
	LD	DE,ENVDATA##	; Copy saved value of item to BUFF.
CPY30:	LD	A,(HL)
	LD	(DE),A
	DEC	HL
	INC	DE
	OR	A
	JR	NZ,CPY30	; Copy until null at end.
	PUSH	HL
	CALL	SENV##	; Set value.
	POP	HL	; HL -> next string.
	JR	CPYENV

ENVDON:	LD	HL,(#01)
	INC	HL
	LD	DE,(WARMBOOT##)	; Restore re-boot BIOS jump
	LD	(HL),E	;   table entry point.
	INC	HL
	LD	(HL),D
	LD	DE,#00	; Un-define abort routine.
	LD	C,_DEFAB##
	CALL	BDOS	;   (error ignored)
	POP	BC	; Restore error code in B.
	LD	C,_TERM##
	JP	BDOS	; Terminate with error code.

		SUBTTL	FORMAT
;        This is the FORMAT command routine: FORMAT [d:] [choice] [/X], or
; FORMAT [d:] /Q [/X] for a quick format (_FORMAT choice FBh: only the FAT
; and the root directory are cleared). The format choice string is obtained
; in RAM with the Nextor A=80h _FORMAT call, so drives on MSX-DOS and
; Nextor drivers can both be formatted; /X skips the warning prompt.
@FORMAT::	AND	(HL)
	LD	B,A	; Use default drive if none specified.
	JR	NZ,FMT_HAS_ARG	;
	LD	L,#00
	LD	BC,#0867
FMT_CHK_DRIVE:	ADD	HL,HL
	PUSH	HL
	PUSH	BC
	LD	HL,ENVDATA##	;See if format is supported by
	LD	DE,#0200	; drive [B]: try to get its choice
	LD	A,#80	; string (works for MSX-DOS and
	CALL	BDOS	; Nextor drivers alike).
	POP	BC
	POP	HL
	JR	NZ,FMT_NO_DRIVE	;Any error means drive does not exist
	INC	HL	;Add to the selection list.
FMT_NO_DRIVE:	DJNZ	FMT_CHK_DRIVE
	LD	A,L	;If nothing remains, no way to proceed.
	OR	A	;
	LD	A,.IDRV##	;
	RET	Z	;
	LD	A,L
	DEC	A
	AND	L
	LD	A,L	;If only one drive,
	JR	Z,FMT_1DRIVE	; no need to ask for drive name
	PUSH	HL	;Save drive list.
	LD	A,#2A
	CALL	DMESS##	;"Drive name? (".
	POP	HL
	PUSH	HL
	LD	A,"@"
FMT_ASK_LOOP:	INC	A
	SRL	L
	JR	NC,FMT_SKIPDRV
	PUSH	AF
	CALL	PRCHAR##	;Print drive name.
	POP	AF
	PUSH	AF
	LD	A,","
	CALL	NZ,PRCHAR##	;Print separator if something remain.
	POP	AF
FMT_SKIPDRV:	JR	NZ,FMT_ASK_LOOP
	LD	A,#2B
	CALL	DMESS##	;") " after drive name list.
	POP	HL	;Restore drive list
FMT_ASKAGAIN:	PUSH	HL
	LD	C,_CONST##	; Get a character, gobbling up chars
	CALL	BDOS	;   in the keyboard buffer.
	PUSH	AF
	LD	C,_INNOE##
	CALL	BDOS
	LD	C,A
	POP	AF
	POP	HL
	JR	NZ,FMT_ASKAGAIN
	LD	A,C
	CALL	UC##	;Force to upper case
	LD	C,A
	SUB	"A"
	CP	#08
	JR	NC,FMT_ASKAGAIN	;Invalid drive name.
	LD	B,A
	INC	B
	XOR	A
	SCF
FMT_GETMASK:	RLA
	DJNZ	FMT_GETMASK
	AND	L
	JR	Z,FMT_ASKAGAIN	;Drive does not exist
					; or does not support format.
	PUSH	AF
	LD	A,C
	CALL	PRCHAR##	;Echo to the console.
	CALL	LPRINT##
	POP	AF
FMT_1DRIVE:	INC	B	;Always comes here with B=0.
	RRCA	;
	JR	NC,FMT_1DRIVE
	JP	NFDRV

FMT_HAS_ARG:	INC	HL	; A drive letter plus a colon must
	LD	A,(HL)	;   have been given.
	CP	":"
	LD	A,.IPARM##
	RET	NZ
	INC	HL
	LD	A,(HL)
	CALL	SEP?##
	LD	A,.IPARM##
	RET	NZ
	LD	A,B	; Convert the letter to a drive
	CALL	UC##	;   number, 1..26.
	CP	"Z"+1
	JR	NC,NCIDRV
	SUB	"A"
	LD	B,A
	CCF
NCIDRV:	LD	A,.IDRV##
	RET	NC
	INC	B
	CALL	GETCH##	; No format choice given: use the
	JP	Z,NFDRV	;   _FORMAT prompt.
	CP	"/"	; An option here can only be /Q.
	JR	Z,NCIQ
	PUSH	BC	; Get the format choice, 1..9.
	CALL	GET8##
	POP	BC
	RET	NZ
	OR	E
	LD	A,.IPARM##
	RET	Z
	LD	A,E
	CP	#0A
	LD	A,.IPARM##
	RET	NC
NCI05:	LD	A,(HL)	; Go if anything follows the
	OR	A	;   choice.
	JR	NZ,NCI10
	LD	A,E	; The typed choice is 1-based
	EXX	;   already: skip the INC A at
	JP	NSTR1	;   NSTR.

NCI10:	CP	"/"	; Only the /X option may follow
	JR	Z,NCI20	;   the choice number.
	CALL	SEP?##
	LD	A,.IPARM##
	RET	NZ
	CALL	GETCH##
	CP	"/"
	LD	A,.INP##
	RET	NZ
NCI20:	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"X"	; /X: format at once, skipping the
	LD	A,.IOPT##	;   warning prompt.
	RET	NZ
	INC	HL
	CALL	CHKEOL##
	CALL	Z,GCHKEOL##
	RET	NZ
	LD	A,E
	JP	NST10

NCIQ:	INC	HL	; /Q: quick format. Only the FAT
	LD	A,(HL)	;   and the root directory are
	CALL	MKUPPER##	;   cleared, so the disk must
	CP	"Q"	;   already have a valid FAT12/16
	LD	A,.IOPT##	;   boot sector.
	RET	NZ
	INC	HL
	CALL	GETCH##	; The end of the line, or /X, may
	JR	Z,NCIQ2	;   follow.
	CP	"/"
	LD	A,.INP##
	RET	NZ
	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"X"	; /X: skip the 'all data will be
	LD	A,.IOPT##	;   destroyed' warning (the not a
	RET	NZ	;   floppy warning still shows).
	INC	HL
	CALL	CHKEOL##
	CALL	Z,GCHKEOL##
	RET	NZ
	CALL	QCHK	; Validate the target drive and
	RET	NZ	;   warn if it is not a floppy.
	JR	C,NCIQ3
	LD	A,#FB
	JP	NST10

NCIQ2:	CALL	QCHK	; Validate and warn as above, then
	RET	NZ	;   warn about the data loss too.
	JR	C,NCIQ3
	LD	A,#FB
	EXX
	JP	NSTR1

NCIQ3:	XOR	A	; The user declined, or the drive
	RET	;   cannot be quick formatted.

NFDRV:	LD	A,B
	EXX	; Save drive in B'.
	LD	B,A
	LD	HL,ENVDATA##	; Get the choice string into RAM:
	LD	DE,#0200	;   works for drives on MSX-DOS
	LD	A,#80	;   and Nextor drivers alike (the
	LD	C,_FORMAT##	;   old A=0 call only worked for
	CALL	BDOS	;   the former).
	RET	NZ
	LD	A,(ENVDATA##)
	OR	A	; Empty string => single choice:
	JR	Z,NSTR	;   don't ask, use choice 1.
	LD	DE,ENVDATA##	; Print the choice string.
	CALL	PRTSTR##
	LD	A,"?"
	CALL	PRCHAR##
	CALL	SPACE##
INCHAR:	LD	C,_CONST##	; Get a character, gobbling up chars
	CALL	BDOS	;   in the keyboard buffer.
	PUSH	AF
	LD	C,_INNOE##
	CALL	BDOS
	LD	C,A
	POP	AF
	JR	NZ,INCHAR
	LD	A,C
	CP	"9"+1	; If not '1' to '9' to get another.
	JR	NC,INCHAR
	SUB	"1"
	JR	C,INCHAR
	PUSH	AF	; Save choice.
	LD	A,C	; Echo it.
	CALL	PRCHAR##
	CALL	LPRINT##
	POP	AF
NSTR:	INC	A	; The keyboard choice and the "no
NSTR1:	PUSH	AF	;   choice string" case are 0-based;
	CALL	LPRINT##	;   typed choices and /Q (FBh)
			;   enter 1-based at NSTR1.
	LD	A,#2C
	CALL	DMESS##
	EXX
	LD	A,B
	EXX
	DEC	A
	LD	C,_CURDRV##
	CALL	M,BDOS
	ADD	A,"A"
	CALL	PRCHAR##
	LD	A,#2D
	CALL	DMESSCR##
	CALL	PAUSE
	POP	AF
	EXX
NST10:	LD	DE,ENVDATA##	; Format, using all memory from
	LD	HL,(EXITADDR##)	;   BUFF up to the resident code as
	OR	A	;   the work buffer.
	SBC	HL,DE
	EX	DE,HL
	LD	C,_FORMAT##
	JP	BDOS

;        Validate the target drive of a quick format with _GDLI, since
; clearing the FAT of the wrong drive is catastrophic: unmapped drives,
; the RAM disk and mounted disk image files are refused with a message,
; and a drive on a Nextor driver whose device is not a floppy disk
; (only floppy disk devices have a format choice string, so probing for
; one tells them apart) asks for an explicit confirmation first.
;        No warning is shown unless the quick format could actually run:
; the media must be accessible and hold a FAT12/16 filesystem, which is
; checked with _DPARM (so e.g. an offline removable device fails here
; with the usual disk error handling, before any warning).
; On entry, B = drive, 1 = A:.
; On exit,  NZ    => error code in A.
;           Z, Cy => abort quietly (message printed / user declined).
;           Z, NC => go ahead with the quick format.
QCHK:	LD	A,B
	DEC	A	; _GDLI counts drives from 0.
	PUSH	BC
	LD	HL,ENVDATA##	; 64 byte drive info buffer.
	LD	C,_GDLI##
	CALL	BDOS
	POP	BC
	OR	A
	RET	NZ	; (drive beyond the system maximum)
	LD	A,(ENVDATA##)	; The drive status decides:
	LD	E,#59	;   0 = unassigned and 2 = unused
	OR	A	;   => not mapped;
	JR	Z,QCK30
	CP	#02
	JR	Z,QCK30
	LD	E,#5A	;   4 = the RAM disk;
	CP	#04
	JR	Z,QCK30
	LD	E,#5B	;   3 = a mounted image file;
	CP	#03
	JR	Z,QCK30
	PUSH	AF	; Save the drive status.
	PUSH	BC
	LD	L,B	; The device must be accessible
	LD	DE,ENVDATA##+64	;   before any warning is shown:
	LD	C,_DPARM##	;   an offline removable device
	CALL	BDOS	;   fails here, with the usual
	POP	BC	;   disk error handling.
	OR	A
	JR	Z,QCK05
	POP	DE	; Discard the saved status and
	OR	A	;   return the error code.
	RET
QCK05:	LD	A,(ENVDATA##+64+28)	; The disk must hold a FAT12/16
	CP	#02	;   filesystem, or the quick
	JR	C,QCK06	;   format would refuse it
	POP	DE	;   anyway.
	LD	A,.NDOS##	; 'Not a DOS disk'.
	OR	A
	RET
QCK06:	POP	AF	; A = the drive status again.
	CP	#05	;   5 = ghost drive, a floppy for
	JR	Z,QCK10	;   sure;
	LD	A,(ENVDATA##+5)	;   1 = a device on a driver: 0
	OR	A	;   here means an MSX-DOS driver,
	JR	Z,QCK10	;   also a floppy for sure.
	PUSH	BC	; Nextor driver: probe for the
	LD	HL,ENVDATA##	;   format choice string to know
	LD	DE,#0200	;   whether the device is a
	LD	A,#80	;   floppy disk.
	LD	C,_FORMAT##
	CALL	BDOS
	POP	BC
	OR	A
	JR	NZ,QCK20	; Not a floppy: ask first.
QCK10:	XOR	A	; Go ahead: Z and NC.
	RET

QCK20:	PUSH	BC	; Print the warning with the
	LD	A,#5C	;   drive letter in it and get
	CALL	DMESS##	;   an explicit confirmation.
	POP	BC
	LD	A,B
	ADD	A,"@"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	PUSH	BC
	LD	A,#5D
	CALL	DMESS##
	CALL	INCH##	; Answer key in L, echo + CRLF.
	POP	BC
	LD	A,L
	AND	%11011111	; Upper case the answer.
	CP	"Y"
	JR	Z,QCK10	; Sure: go ahead.
	CP	"N"
	JR	NZ,QCK20	; Ask again until Y or N.
	JR	QCK40	; No: abort quietly.

QCK30:	PUSH	DE	; Refused: print 'Drive X: ' and
	PUSH	BC	;   the reason (message number in
	LD	A,#58	;   E), then abort.
	CALL	DMESS##
	POP	BC
	LD	A,B
	ADD	A,"@"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	CALL	SPACE##
	POP	DE
	LD	A,E
	CALL	DMESSCR##
QCK40:	XOR	A	; Abort quietly: Z and Cy.
	SCF
	RET

		SUBTTL	MEMORY
;        The MEMORY command (new in 2.40) displays the state of the system
; RAM: for every memory mapper the total RAM and the amounts free, in use
; by the system and in use by the user (from the mapper table provided by
; the DOS 2 mapper support routines); the TPA size available to a transient
; program; and the total and free sizes of the three areas carved out of
; COMMAND3's private mapper segment: the command history buffer, the alias
; area and the variable swap space used for running nested COMMAND3's.
;        /K prints figures of 1K and over in kilobytes, /P pages the
; output.
@MEMORY::	AND	(HL)	; Parse options first if present.
	LD	A,#00	; Default is to print byte counts.
	LD	(OPTFLAG1##),A
	JP	NZ,MEM60
MEM10:	LD	HL,(MAPTAB##)	; Walk the mapper table: per mapper
MEM20:	LD	A,(HL)	;   +0 = slot address (0 ends the
	OR	A	;   table), +1 = total segments,
	JR	Z,MEM40	;   +2 = free, +3 = used by system,
	PUSH	AF	;   +4 = used by user, +5..+7 not
	INC	HL	;   used here.
	LD	B,(HL)	; Print total segments as a byte
	CALL	MUL16	;   (or K) count, then ' total RAM
	LD	A,#49	;   in Slot '.
	CALL	DMESS##
	POP	AF
	LD	B,A
	AND	%00000011	; Print the primary slot number,
	ADD	A,"0"
	CALL	PRCHAR##
	BIT	7,B	;   plus '-' and the subslot number
	JR	Z,MEM30	;   if the slot is expanded.
	LD	A,"-"
	CALL	PRCHAR##
	LD	A,B
	RRA
	RRA
	AND	%00000011
	ADD	A,"0"
	CALL	PRCHAR##
MEM30:	CALL	LPRINT##
	INC	HL
	LD	B,(HL)	; Free segments,
	CALL	MUL16
	LD	A,#06	;   as bytes/K plus ' free'.
	CALL	DMESSCR##
	INC	HL
	LD	B,(HL)	; Segments used by the system.
	CALL	MUL16
	LD	A,#4A	; ' used by system'.
	CALL	DMESSCR##
	INC	HL
	LD	B,(HL)	; Segments used by the user.
	CALL	MUL16
	LD	A,#4B	; ' used by user'.
	CALL	DMESSCR##
	CALL	LPRINT##
	INC	HL	; Advance to the next table entry.
	INC	HL
	INC	HL
	INC	HL
	JR	MEM20

MEM40:	CALL	GETTPA	; Compute the TPA available to a
	LD	(VALUEL##),HL	;   transient program.
	LD	HL,#00	; (32-bit high word = 0.)
	LD	(VALUEH##),HL
	CALL	PRINT32
	LD	A,#4C	; ' total TPA memory'.
	CALL	DMESSCR##
	CALL	LPRINT##
	LD	A,(SHRAMFL##)	; Without the mapper segment there
	OR	A	;   is no history, alias or swap
	JP	NZ,SHROFF	;   memory to report.
	CALL	GETBUFLEN##	; Total size of the history buffer.
	PUSH	HL
	LD	(VALUEL##),HL
	CALL	PRINT32
	LD	A,#4D	; ' total history buffer'.
	CALL	DMESSCR##
	CALL	GETENDADDR##	; Free history bytes = size minus
	EX	DE,HL	;   what is in use, i.e. from the
	POP	HL	;   buffer start to the end
	SBC	HL,DE	;   pointer.

	LD	DE,BUFADDR
	ADD	HL,DE
	DEC	HL
	LD	(VALUEL##),HL
	CALL	PRINT32
	LD	A,#06	; ' free'.
	CALL	DMESSCR##
	CALL	LPRINT##
	CALL	SETPG2##	; Total alias memory: from the
	LD	HL,(ALIEND+#8000)	;   start of the alias area to its
	CALL	RSTPG2##	;   end, both kept in the mapper
	SET	7,H	;   segment. SET 7,H turns a
	PUSH	HL	;   segment offset into a page 2
	CALL	GETALIADDR##	;   address.
	SET	7,H
	EX	DE,HL
	POP	HL
	PUSH	HL
	PUSH	DE
	SBC	HL,DE
	LD	(VALUEL##),HL
	CALL	PRINT32
	LD	A,#4E	; ' total alias memory'.
	CALL	DMESSCR##
	CALL	SETPG2##
	POP	HL
MEM50:	LD	C,(HL)	; Find the end of the alias
	INC	HL	;   records: each starts with its
	LD	B,(HL)	;   total length, a zero length
	DEC	HL	;   ends the list.
	ADD	HL,BC
	LD	A,B
	OR	C
	JR	NZ,MEM50
	CALL	RSTPG2##
	EX	DE,HL	; Free alias memory = area end
	POP	HL	;   minus end of the records.
	SBC	HL,DE
	LD	(VALUEL##),HL
	CALL	PRINT32
	LD	A,#06	; ' free'.
	CALL	DMESSCR##
	CALL	LPRINT##
	CALL	SETPG2##	; Total variable swap memory: from
	LD	DE,(ALIEND+#8000)	;   the end of the alias area to
	PUSH	DE	;   the top of the 16K segment.
	LD	HL,#3FFF
	SBC	HL,DE
	LD	(VALUEL##),HL
	CALL	PRINT32
	LD	A,#4F	; ' total variable swap memory'.
	CALL	DMESSCR##
	LD	HL,(VAREND+#8000)	; Free = the bottom of the in-use
	RES	7,H	;   swap area (it grows downwards)
	POP	DE	;   minus the end of the alias
	SBC	HL,DE	;   area.
	LD	(VALUEL##),HL
	CALL	RSTPG2##
	CALL	PRINT32
	LD	A,#06	; ' free'.
	JP	DMESSCR##

MEM60:	LD	A,(HL)	; Options: /P pages the output, /K
	CP	"/"	;   prints in kilobyte units.
	LD	A,.IPARM##
	RET	NZ
	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"P"
	JR	Z,MEM70
	CP	"K"
	JR	Z,MEM90
	LD	A,.IOPT##
	RET

MEM70:	CALL	SETP##	; /P: set up the pause line count.
MEM80:	INC	HL
	CALL	GETCH##	; More options may follow.
	JR	NZ,MEM60
	JP	MEM10

MEM90:	LD	A,#01	; /K: flag kilobyte units.
	LD	(OPTFLAG1##),A
	JR	MEM80

;        MUL16 computes B (a number of 16K mapper segments) times 16384
; into the 32-bit number at VALUEL/VALUEH, then falls through into PRINT32
; to print it.
MUL16:	PUSH	HL
	PUSH	DE
	LD	HL,#00	; Zero the 32-bit accumulator,
	LD	(VALUEL##),HL
	LD	(VALUEH##),HL
	LD	DE,#4000	;   then add 16384 B times.
	INC	B	; (B may be 0.)
	DEC	B
	JR	Z,MUL60
MUL40:	LD	HL,(VALUEL##)
	ADD	HL,DE
	LD	(VALUEL##),HL
	JR	NC,MUL50	; Carry into the high word.
	LD	HL,(VALUEH##)
	INC	HL
	LD	(VALUEH##),HL
MUL50:	DJNZ	MUL40
MUL60:	POP	DE
	POP	HL
;        PRINT32 prints the 32-bit number at VALUEL/VALUEH, preserving HL
; and DE. Normally D32 renders it as eight space-padded decimal characters
; in BUFF3, two more spaces are inserted to group the digits in thousands,
; and ' bytes' is printed after the number. When /K is in effect (OPTFLAG1
; bit 0), PRLEN2 is used instead: it prints values of 1K and over as 'nK'
; and smaller ones as 'n byte(s)'.
PRINT32:	LD	A,(OPTFLAG1##)
	BIT	0,A	; /K in effect ?
	JR	NZ,PRI10
	PUSH	HL
	PUSH	DE
	LD	IX,XBUF1##	; Render the number in BUFF3 as 8
	PUSH	IX	;   space-padded decimal digits.
	LD	DE,VALUEL##
	LD	A," "	; ' ' = padding character.
	CALL	D32##
	POP	HL
	PUSH	HL
	INC	HL	; Insert two spaces to group the
	INC	HL	;   digits in thousands.
	LD	C," "
	CALL	INSBYTE##
	INC	HL
	INC	HL
	INC	HL
	INC	HL
	CALL	INSBYTE##
	POP	DE	; Print the number,
	CALL	PRTSTR##
	LD	A,#48	;   then ' bytes'.
	CALL	DMESS##
	POP	DE
	POP	HL
	RET

PRI10:	PUSH	HL	; /K: print as 'nK', or as 'n
	PUSH	DE	;   byte(s)' if less than 1K.
	LD	A," "	; ' ' = padding character.
	CALL	PRLEN2##
	POP	DE
	POP	HL
	RET

		SUBTTL	MEM
;        The MEM command (new in 3.0): a compact memory mapper listing,
; modelled on the MEM.COM tool and sized to fit a 40 column screen.
;        For every mapper in the DOS 2 mapper variable table located at
; startup (MAPTAB, entries of 8 bytes: slot, total, free, user and
; system allocated segment counts, 3 unused; a zero slot byte ends the
; table): the slot, the total memory, the reserved memory (user plus
; system allocations) and the free memory, in kilobytes. Then the
; totals over all mappers, the RAM disk size (only when one exists)
; and the TPA end address with the equivalent size in kilobytes.
@MEM::	AND	(HL)	; No parameters allowed.
	LD	A,.INP##
	RET	NZ
	LD	HL,#00
	LD	(FILECNT##),HL	; The three running totals (DIR's
	LD	(FILETOT1##),HL	;   counters borrowed as scratch:
	LD	(FILETOT2##),HL	;   total, reserved, free).
	LD	A,#5E	; The header line.
	CALL	DMESSCR##
	LD	IX,(MAPTAB##)
MMM10:	LD	A,(IX)	; A zero slot byte ends the table.
	OR	A
	JR	Z,MMM40
	PUSH	AF	; The slot, right-aligned under
	CALL	SPACE##	;   the 'Slot' label: ' p-s' for
	POP	AF	;   an expanded slot (bit 7 set),
	BIT	7,A	;   '   p' for a primary one.
	JR	NZ,MMM20
	PUSH	AF
	CALL	SPACE##
	CALL	SPACE##
	POP	AF
	AND	%00000011
	ADD	A,"0"
	JR	MMM30
MMM20:	PUSH	AF
	AND	%00000011
	ADD	A,"0"
	CALL	PRCHAR##
	LD	A,"-"
	CALL	PRCHAR##
	POP	AF
	AND	%00001100
	RRCA	; The subslot, from bits 2-3.
	RRCA
	ADD	A,"0"
MMM30:	CALL	PRCHAR##
	CALL	SPACE##	; The first column starts one
			;   character left of the others
			;   (32 column screens!).
	LD	L,(IX+1)	; Total memory.
	LD	H,#00
	LD	DE,FILECNT##
	CALL	MEMCOL
	LD	A,(IX+3)	; Reserved memory: user plus
	ADD	A,(IX+4)	;   system allocated segments.
	LD	L,A
	LD	H,#00
	LD	DE,FILETOT1##
	CALL	MEMCOL
	LD	L,(IX+2)	; Free memory.
	LD	H,#00
	LD	DE,FILETOT2##
	CALL	MEMCOL
	CALL	LPRINT##
	LD	DE,#08	; On to the next table entry.
	ADD	IX,DE
	JR	MMM10

MMM40:	LD	A,#5F	; The totals line: after the
	CALL	DMESS##	;   longer 'Total:' label the
	LD	HL,(FILECNT##)	;   first column is one character
	CALL	MEMCL3	;   narrower, so it still aligns.
	LD	HL,(FILETOT1##)
	CALL	MEMCL2
	LD	HL,(FILETOT2##)
	CALL	MEMCL2
	CALL	LPRINT##
	CALL	LPRINT##
	LD	B,#FF	; RAM disk size: B = FFh only
	LD	C,_RAMD##	;   asks, B comes back as the
	CALL	BDOS	;   size in segments.
	LD	A,B
	OR	A	; No RAM disk: no line at all.
	JR	Z,MMM50
	PUSH	BC	; 'RAM disk size: ' (DMESS eats
	LD	A,#60	;   B, which holds the size).
	CALL	DMESS##
	POP	BC
	LD	L,B
	LD	H,#00
	ADD	HL,HL	; Segments to kilobytes.
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	CALL	MEMNUM	; (Compact, no padding, here.)
	LD	A,"K"
	CALL	PRCHAR##
	CALL	LPRINT##
MMM50:	LD	A,#61	; 'TPA end address: '
	CALL	DMESS##
	CALL	GETTPA
	PUSH	HL
	LD	A,H	; Four hexadecimal digits.
	CALL	PRHEX2
	POP	HL
	PUSH	HL
	LD	A,L
	CALL	PRHEX2
	LD	A,#62	; 'h' and the 'TPA size: ' line.
	CALL	DMESS##
	POP	HL
	LD	A,H	; Kilobytes: the address divided
	RRCA	;   by 1024.
	RRCA
	AND	%00111111
	LD	L,A
	LD	H,#00
	CALL	MEMNUM
	LD	A,"K"
	CALL	PRCHAR##
	JP	LPRINT##

;        Print HL, a number of 16K segments, as a nine character
; column (the kilobyte count right-aligned in eight characters plus a
; 'K') and add the kilobytes to the 16-bit accumulator at (DE).
; Preserves IX.
MEMCOL:	ADD	HL,HL	; Segments to kilobytes.
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	LD	A,(DE)	; Add them to the accumulator.
	ADD	A,L
	LD	(DE),A
	INC	DE
	LD	A,(DE)
	ADC	A,H
	LD	(DE),A
	;fall through into MEMCL2

;        Print HL, a number of kilobytes, as a nine character column
; (MEMCL2, where MEMCOL falls in), or as an eight character one
; (MEMCL3, which drops one leading padding character - safe, a 16-bit
; kilobyte count has at most five digits).
MEMCL2:	PUSH	IX
	CALL	MEMREN
	LD	DE,XBUF1##
	JR	MEMCL9

MEMCL3:	PUSH	IX
	CALL	MEMREN
	LD	DE,XBUF1##+1
MEMCL9:	CALL	PRTSTR##
	LD	A,"K"
	CALL	PRCHAR##
	POP	IX
	RET

;        Render HL as eight space-padded decimal characters in XBUF1.
MEMREN:	LD	(VALUEL##),HL
	LD	HL,#00
	LD	(VALUEH##),HL
	LD	DE,VALUEL##
	LD	A," "	; ' ' = padding character.
	LD	IX,XBUF1##
	JP	D32##

;        Print HL as a plain decimal number, no padding.
MEMNUM:	LD	IX,XBUF1##
	PUSH	IX
	CALL	D16##
	POP	DE
	JP	PRTSTR##

;        Print A as two hexadecimal digits.
PRHEX2:	PUSH	AF
	RRCA
	RRCA
	RRCA
	RRCA
	CALL	PRHEX1
	POP	AF
PRHEX1:	AND	%00001111
	ADD	A,"0"
	CP	"9"+1
	JR	C,PRHEX0
	ADD	A,"A"-"9"-1
PRHEX0:	JP	PRCHAR##

;        Compute the TPA available to a transient program: the bottom
; of the resident code less a margin for the program loader, rounded
; down to the CP/M compatible xx06 shape of the (0006) vector that a
; child program sees. With SHELLRAM OFF the save slot for the variable
; region eats into the TPA as well (subtracted before the rounding so
; that the shape is kept).
GETTPA:	LD	HL,(EXITADDR##)
	LD	DE,#FFD8
	ADD	HL,DE
	LD	A,(SHRAMFL##)
	OR	A
	JR	Z,GTP10
	LD	DE,BUFFER1##-EXITADDR##
	SBC	HL,DE
GTP10:	LD	L,#08
	LD	DE,#09
	OR	A
	SBC	HL,DE
	LD	L,#06
	DEC	H
	RET

; The strings of the MEM command (messages #5E-#62) live in
; messages.mac/jmessages.mac, together with the description of the 32
; character wide column layout.

		SUBTTL	GOTO, GOSUB, RETURN, END
;        The batch file flow control commands (all new in 2.40). They work
; only in .BTM batch files, which are loaded whole into a mapper segment
; (batch handle FE); anywhere else they give 'Unrecognized command'.
;        GOTO searches the batch file from the start for a line equal to
; the '~label' given as its parameter and continues execution from the line
; after it. If the label is not found, the batch file is ended and 'Invalid
; parameter' given.
@GOTO::	LD	A,(BATHNDL##)	; Only allowed in a .BTM file.
	CP	#FE
	LD	A,.BADCMD##
	RET	NZ
	LD	A,(HL)	; A label must be given.
	OR	A
	LD	A,.NOPAR##
	RET	Z
	PUSH	HL	; Save pointer to the label.
GOT80:	LD	HL,#00	; Rewind the batch file to the
	LD	(BATLINADDR##),HL	;   start.
GOT90:	CALL	INBAT##	; Read the next batch line: Cy set
	JR	Z,GOT100	;   if it is a '~label' line.
	POP	HL
	CP	.EOF##	; Errors other than end of file are
	RET	NZ	;   returned as they are.
	CALL	END10	; Label not found: end the batch
	LD	A,#FF	;   file and give 'Invalid
	LD	(STRCODE##),A	;   parameter', without a 'Batch
	LD	A,.IPARM##	;   file error:' prefix.
	RET

GOT100:	JR	NC,GOT90	; Skip lines that are not labels.
	LD	HL,ENVDATA##+1	; Compare the line with the given
	CALL	GETCH##	;   label, case sensitively.
	POP	BC
	PUSH	BC
	CALL	STRCMP
	JR	NZ,GOT90	; Keep searching if no match.
	POP	HL
	RET

;        END terminates the batch file: the read pointer is rewound and an
; EOF mark is written at the very start of the batch segment, so the next
; attempt to read a line ends the batch file.
@END::	LD	A,(BATHNDL##)	; Only allowed in a .BTM file.
	CP	#FE
	LD	A,.BADCMD##
	RET	NZ
	LD	A,(HL)	; No parameters allowed.
	OR	A
	LD	A,.INP##
	RET	NZ
END10:	LD	HL,#00	; Rewind to the start of the file
	LD	(BATLINADDR##),HL	;   and write a ^Z there.
	LD	A,(BATPAGE##)
	LD	E,#1A
	JP	WR_SEG##

;        GOSUB pushes the current batch file position onto the GOSUB list
; (up to 8 levels) and then does a GOTO to the given label.
@GOSUB::	LD	A,(BATHNDL##)	; Only allowed in a .BTM file.
	CP	#FE
	LD	A,.BADCMD##
	RET	NZ
	LD	A,(HL)	; A label must be given.
	OR	A
	LD	A,.NOPAR##
	RET	Z
	PUSH	HL
	LD	HL,(GOSUBADDR##)	; 'Too many parameters' when eight
	LD	DE,GOSUBLIST##+16	;   GOSUBs are already active.
	OR	A
	SBC	HL,DE
	POP	HL
	LD	A,.INP##
	RET	Z
	PUSH	HL
	LD	HL,(GOSUBADDR##)	; Push the current batch position
	LD	DE,(BATLINADDR##)	;   onto the GOSUB list,
	LD	(HL),E
	INC	HL
	LD	(HL),D
	INC	HL
	LD	(GOSUBADDR##),HL
	JR	GOT80	;   and do the GOTO.

;        RETURN pops the position saved by GOSUB and continues the batch
; file there; if a '~label' parameter is given, it continues at that label
; instead.
@RETURN::	LD	A,(BATHNDL##)	; Only allowed in a .BTM file.
	CP	#FE
	LD	A,.BADCMD##
	RET	NZ
	PUSH	HL
	LD	HL,(GOSUBADDR##)	; Nothing to pop if the GOSUB list
	LD	DE,GOSUBLIST##	;   is empty.
	PUSH	HL
	SBC	HL,DE
	POP	HL
	JR	Z,RET10
	DEC	HL	; Pop the saved batch position into
	LD	D,(HL)	;   BATLINADDR.
	DEC	HL
	LD	E,(HL)
	LD	(GOSUBADDR##),HL
	EX	DE,HL
	LD	(BATLINADDR##),HL
RET10:	POP	HL
	LD	A,(HL)	; If a label was given, then GOTO
	OR	A	;   it rather than just returning.
	RET	Z
	PUSH	HL
	JP	GOT80

		SUBTTL	SHIFT
;        The SHIFT command (new in 2.44) shifts the batch file parameters
; one position to the left: %1 becomes %0, %2 becomes %1 and so on. With
; SHIFT /n the shift starts at parameter n instead, leaving the parameters
; below n untouched. Nothing happens when there is nothing to shift. Only
; useful inside batch files, where the parameter line at (LINEADDR) is the
; line that invoked the batch file.
@SHIFT::	AND	(HL)
	LD	E,#00	; Default: start the shift at %0.
	JR	Z,SHF10
	LD	A,(HL)
	INC	HL
	CP	"/"	; Only a /n option may be given.
	LD	A,.NOPAR##
	JR	NZ,SHFERR
	CALL	GET8##	; E = first parameter to shift.
	RET	NZ
SHF10:	LD	HL,(LINEADDR##)
SHF20:	LD	A,E	; Advance to the parameter where the
	OR	A	;   shift starts.
	JR	Z,SHF30
	DEC	E
	CALL	SHFSKP
	JR	NZ,SHF20
	RET	; End of line first: nothing to do.
SHF30:	PUSH	HL	; Destination: the parameter to be
	CALL	SHFSKP	;   replaced. The source is the next
	JR	Z,SHF50	;   one; if there is none, there is
	PUSH	HL	;   nothing to shift.
	LD	BC,#00
SHF40:	INC	BC	; Measure the rest of the line,
	LD	A,(HL)	;   terminator included.
	INC	HL
	OR	A
	JR	NZ,SHF40
	POP	HL	; Move it one parameter down.
	POP	DE
	LDIR
	RET
SHF50:	POP	HL
	RET

;        Skip one parameter word and the separator that follows it.
; On exit, HL points past the separator and Z is set if the end of the
; line was reached instead.
SHFSKP:	LD	A,(HL)
	INC	HL
	CALL	SEP?##
	JR	NZ,SHFSKP
	OR	A
	RET

SHFERR:	OR	A	; NZ and the error code in A.
	RET

		SUBTTL	IF
;        The IF command, much extended in 2.40: the condition is evaluated
; by COND2 and, when it is true, the rest of the line is executed as a
; command. An optional THEN needs no handling here, because THEN is itself
; an internal command which just executes the rest of its own line.
@IF::	CALL	COND2	; Evaluate the condition.
	RET	NZ
	JR	C,EXEC2	; Execute the command if true.
	XOR	A
	RET

;        Execute the command line at (HL) as a new command: it is copied to
; BUFF, alias expanded, split at a '^' separator (unless a following
; command is already pending), stripped of quotes and handed back to the
; dispatcher. Used by IF, IFF, THEN, ELSE and ENDIFF.
EXEC2:	LD	DE,ENVDATA##	; Copy the command to BUFF.
	PUSH	DE
	CALL	NCOPY##
	POP	DE
	CALL	ALIASING##	; Expand aliases in it.
	RET	NZ
	LD	HL,(NEXTADDR##)	; Split at '^', unless a next
	LD	A,H	;   command is already pending.
	OR	L
	CALL	Z,MULTICMD##
	EX	DE,HL
	PUSH	HL
	CALL	UNQUOTE##	; Remove quote characters.
	POP	HL
	JP	DO_CMD##	; Dispatch it.

;        COND2 evaluates a complete IF/IFF condition, including AND, OR and
; XOR combinations of elementary conditions. After the first condition is
; evaluated by COND, the following word is examined: if it is AND, OR or
; XOR then the rest of the line is evaluated by a recursive call - which is
; why chained conditions combine last-to-first - and the two truth values
; are combined. A truth value is kept as a mask in A (bit 0 set => true) so
; that the combining operation works directly on it.
;        The line pointer is duplicated into the other register set before
; the look-ahead word is consumed; when that word turns out not to be a
; combining operator, CON30 switches register sets, so the caller sees HL
; still pointing at the word: the command to be executed.
; On entry, HL points to the condition text.
; On exit,  Z & Cy => condition true.
;           Z & NC => condition false.
;           NZ     => error, code in A.
;           HL points to the rest of the line (the command).
COND2:	CALL	COND	; Evaluate one condition: COND
	RET	NZ	;   returns NC for true; turn that
	CCF	;   into the mask FF (true) / 00
	SBC	A,A	;   (false) and save it in AF'.
	EX	AF,AF'
	PUSH	HL	; Duplicate the line pointer into
	EXX	;   the other register set.
	POP	HL
	CALL	STRIP##
	LD	BC,ENVDATA##	; Fetch the next word.
	PUSH	BC
	CALL	CPYSTR
	POP	BC
	RET	NZ
	PUSH	HL	; Is it AND ?
	PUSH	BC
	LD	HL,$AND
	CALL	COMPARE3
	POP	BC
	POP	HL
	JR	NZ,CON10
	CALL	STRIP##	; Evaluate the rest of the line,
	EX	AF,AF'	;   then AND the two truth masks.
	PUSH	AF
	CALL	COND2
	POP	BC
	RET	NZ
	AND	B
	CP	A	; Z, and Cy = bit 0 of the result.
	RRA
	RET

CON10:	PUSH	HL	; Is it OR ?
	PUSH	BC
	LD	HL,$OR
	CALL	COMPARE3
	POP	BC
	POP	HL
	JR	NZ,CON20
	CALL	STRIP##	; Evaluate the rest of the line,
	EX	AF,AF'	;   then OR the two truth masks.
	PUSH	AF
	CALL	COND2
	POP	BC
	RET	NZ
	OR	B
	CP	A	; Z, and Cy = bit 0 of the result.
	RRA
	RET

CON20:	PUSH	HL	; Is it XOR ?
	PUSH	BC
	LD	HL,$XOR
	CALL	COMPARE3
	POP	BC
	POP	HL
	JR	NZ,CON30
	CALL	STRIP##	; Evaluate the rest of the line,
	EX	AF,AF'	;   then XOR the two truth masks.
	PUSH	AF
	CALL	COND2
	POP	BC
	RET	NZ
	XOR	B
	CP	A	; Z, and Cy = bit 0 of the result.
	RRA
	RET

CON30:	EXX	; No combining word: restore the
	EX	AF,AF'	;   pointer to it, get the truth
	CP	A	;   mask and return Z with Cy =
	RRA	;   bit 0.
	RET

		SUBTTL	IFF, THEN, ELSE, ENDIFF
;        The IFF command (new in 2.40) turns "command mode" on or off
; depending on its condition. Command mode is a stack of state bytes in
; IFFLIST, with IFFADDR pointing at the current level: 00 => commands are
; executed, FF => commands are skipped, and 9F marks a level opened while
; the enclosing level was already skipping, so that ELSE must leave it off.
; While the current state is odd, the dispatcher executes only IFF, ELSE
; and ENDIFF (see DO_CMD).
;        IFF opens a new level (16 maximum), ELSE toggles the current level
; and ENDIFF closes it. All three execute the rest of their command line,
; so for example 'ENDIFF command' works.
@IFF::	PUSH	HL
	LD	HL,(IFFADDR##)	; 'Too many parameters' when 16
	LD	DE,IFFLIST##+16	;   levels are already open.
	CALL	COMPARE4
	JR	Z,IFF20
	LD	A,(HL)	; Get the enclosing state and open
	INC	HL	;   a new level.
	LD	(IFFADDR##),HL
	LD	(HL),A
	EX	DE,HL	; DE -> the new state byte.
	POP	HL
	LD	B,A	; B = enclosing state.
	PUSH	BC
	PUSH	DE
	CALL	COND2	; Evaluate the condition;
	CCF	;   Cy now set => false.
	POP	DE
	POP	BC
	RET	NZ
	BIT	0,B	; New state: if the enclosing level
	JR	Z,IFF10	;   is skipping, A = 9F ('LD A,n'
	DEFB	#3E
IFF10:	SBC	A,A	;   eats this opcode); else FF/00.
	LD	(DE),A
	LD	A,(HL)	; Execute the rest of the line, if
	OR	A	;   any.
	RET	Z
	JP	EXEC2

IFF20:	POP	HL
	LD	A,.INP##
	RET

;        THEN executes the rest of its line as a command: after 'IF cond
; THEN cmd' the IF executes 'THEN cmd', which in turn executes 'cmd'. When
; command mode is off, a THEN is simply never dispatched.
@THEN::	AND	(HL)	; Nothing to do for THEN alone.
	RET	Z
	JP	EXEC2

;        ELSE inverts the command mode of the current IFF level.
@ELSE::	PUSH	HL
	LD	HL,(IFFADDR##)	; Nothing to toggle when not within
	LD	DE,IFFLIST##	;   an IFF.
	CALL	COMPARE4
	JR	Z,ELS10
	LD	A,(HL)	; Don't toggle a level that was
	CP	#9F	;   opened while skipping.
	JR	Z,ELS10
	CPL	; Toggle 00 <-> FF.
	LD	(HL),A
ELS10:	POP	HL
	LD	A,(HL)	; Execute the rest of the line, if
	OR	A	;   any.
	RET	Z
	JP	EXEC2

;        ENDIFF closes the current IFF level.
@ENDIFF::	PUSH	HL
	LD	HL,(IFFADDR##)	; Close the current level, unless
	LD	DE,IFFLIST##	;   already at the outermost one.
	CALL	COMPARE4
	JR	Z,END20
	DEC	HL
	LD	(IFFADDR##),HL
END20:	POP	HL
	LD	A,(HL)	; Execute the rest of the line, if
	OR	A	;   any.
	RET	Z
	JP	EXEC2

		SUBTTL	COND
;        COND evaluates one elementary condition:
;            [NOT] EXIST filespec
;            [NOT] expr1 ==|EQ|GT|LT expr2
; The words are fetched with MKPATH2, so an expression containing spaces or
; other separator characters can be enclosed in { and }. NOT evaluates the
; rest of the condition and inverts its result.
; On entry, HL points to the condition text.
; On exit,  Z & NC => condition true    (note that this is the opposite
;           Z & Cy => condition false    convention to COND2's exit!)
;           NZ     => error, code in A.
COND:	LD	BC,ENVDATA##	; Fetch the first word to BUFF.
	PUSH	BC
	CALL	MKPATH2
	POP	BC
	RET	NZ	; Return if error
	EX	DE,HL	; NOT prefix: evaluate the rest of
	LD	HL,$NOT	;   the condition and invert it.
	CALL	COMPARE3
	EX	DE,HL
	JR	NZ,EXIST?
	CALL	COND10
	CCF	; Reverse GO condition
	RET

COND10:	CALL	GETCH##	; Fetch the word after NOT.
	LD	BC,ENVDATA##
	CALL	MKPATH2
	RET	NZ
EXIST?:	LD	BC,ENVDATA##	; EXIST keyword: the condition is
	EX	DE,HL	;   whether the given file exists.
	LD	HL,$EXIST
	CALL	COMPARE3
	EX	DE,HL
	JR	NZ,EQUAL?	; Else it must be a comparison.
	CALL	GETCH##
	CALL	PRS##	; Get path string.
	RET	NZ	; Return if error.
	BIT	3,B	; 'Not found' at once if no
	LD	A,.NOFIL##	;   filename was given.
	JR	Z,EX10
	LD	C,(HL)	; Save terminating char.
	LD	(HL),#00	; Terminate path.
	PUSH	HL
	PUSH	BC
	LD	IX,FIB1##	; Search the first matching file,
	LD	BC,#0640	;   hidden and system ones too.
	CALL	BDOS
	POP	BC	; Restore terminating char.
	POP	HL	;   in case this was the end of line.
	LD	(HL),C
EX10:	OR	A
	RET	Z	; Z & NC => if no error
	CP	.NODIR##
	SCF
	RET	Z	; Z & C => if directory not found
	CP	.NOFIL##
	SCF	; Z & C => if file not found,
	RET	; NZ otherwise.

;        Comparison condition: expr1 ==|EQ|GT|LT expr2. The relational
; operator is decoded into a code (1 = equal, 2 = greater than, 3 = less
; than) which is kept in AF' while the second expression is fetched to
; BUFF+128; then the expressions are compared as strings, strictly and
; case sensitively.
EQUAL?:	CALL	STRIP##
	LD	A,(HL)	; '==' ?
	CALL	MKUPPER##
	CP	"="
	JR	NZ,EQU10
	INC	HL
	LD	A,(HL)
	CP	"="
	JP	NZ,EQU80
	LD	A,#01
	JR	EQU40

EQU10:	CP	"E"	; 'EQ' ?
	JR	NZ,EQU20
	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"Q"
	JR	NZ,EQU80
	LD	A,#01
	JR	EQU40

EQU20:	CP	"G"	; 'GT' ?
	JR	NZ,EQU30
	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"T"
	JR	NZ,EQU80
	LD	A,#02
	JR	EQU40

EQU30:	CP	"L"	; 'LT' ?
	JR	NZ,EQU80
	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"T"
	JR	NZ,EQU80
	LD	A,#03
EQU40:	EX	AF,AF'	; Save the operator code.
	INC	HL
	CALL	STRIP##
	LD	BC,ENVDATA##+#80	; Fetch the second expression to
	PUSH	BC	;   BUFF+128.
	CALL	MKPATH2
	POP	BC
	RET	NZ
	EX	DE,HL
	LD	HL,ENVDATA##	; Compare the strings: Z => equal,
	CALL	STRCMP	;   Cy => expr1 > expr2.
	EX	DE,HL
	EX	AF,AF'	; Dispatch on the operator, with
	DEC	A	;   the string comparison flags
	JR	Z,EQU70	;   saved in AF'.
	DEC	A
	JR	Z,EQU60
	DEC	A	; LT: equal strings => false (Cy);
	EX	AF,AF'	;   else Cy (=> false) exactly
	JR	NZ,EQU50	;   when expr1 > expr2.
	SCF
	RET

EQU50:	LD	A,#00	; Force Z, keeping the carry: NC
	BIT	0,A	;   means condition true here.
	RET

EQU60:	EX	AF,AF'	; GT: true (NC) exactly when
	LD	A,#00	;   expr1 > expr2; equal strings
	BIT	0,A	;   give false. Force Z, keep the
	CCF	;   carry, invert it.
	RET

EQU70:	EX	AF,AF'	; ==: equal => Z & NC (true), else
	RET	Z	;   force Z and Cy (false).
	CP	A
	SCF
	RET

EQU80:	POP	HL	; Invalid operator: drop one return
	LD	A,.IPARM##	;   level (skips NOT's inversion)
	OR	A	;   and give 'Invalid parameter'.
	RET

;        Compare the ASCIIZ strings at (BC) and (HL): Z => they are equal.
; Otherwise Cy set => the (BC) string is the lower one; this ordering is
; what the GT/LT conditions use.
STRCMP::	LD	A,(BC)
	CP	(HL)
	RET	NZ
	INC	BC
	INC	HL
	OR	A
	JR	NZ,STRCMP
	RET

;        Like STRCMP, but returns Z as soon as the (HL) string ends, i.e.
; Z => the string at (HL) is a leading substring of the one at (BC). Used
; by the @INSTR function (intvar.mac).
CHKEQ::	LD	A,(HL)
	OR	A
	RET	Z
	LD	A,(BC)
	CP	(HL)
	RET	NZ
	INC	BC
	INC	HL
	OR	A
	JR	NZ,CHKEQ
	RET

;        Compare the string at (BC), upper-cased, against the upper case
; keyword at (HL): Z => equal.
COMPARE3:	LD	A,(BC)
	CALL	MKUPPER##
	CP	(HL)
	RET	NZ
	INC	BC
	INC	HL
	OR	A
	JR	NZ,COMPARE3
	RET

;        16-bit compare of HL against DE: Z => equal, Cy => HL < DE. Only
; AF is corrupted.
COMPARE4::	LD	A,H
	SUB	D
	RET	NZ
	LD	A,L
	SUB	E
	RET

; The condition keywords.
$NOT:	DEFB	"NOT",0
$EXIST:	DEFB	"EXIST",0
$AND:	DEFB	"AND",0
$OR:	DEFB	"OR",0
$XOR:	DEFB	"XOR",0

		SUBTTL	COLOR
;        The COLOR command (new in 2.40) sets the foreground and optionally
; the background and border colours (each 0..15). They are stored in the
; BIOS variables FORCLR/BAKCLR/BDRCLR and made effective with the CHGCLR
; BIOS routine.
@COLOR::	AND	(HL)	; At least one colour is required.
	LD	A,.NOPAR##
	RET	Z
	CALL	GET8##	; Get the foreground colour, 0..15.
	RET	NZ
	LD	A,E
	CP	#10
	JR	NC,GOT120
	LD	(FORCLR),A
	CALL	GETCH##
	JR	Z,COL10
	CALL	GET8##	; Get the background colour, 0..15.
	RET	NZ
	LD	A,E
	CP	#10
	JR	NC,GOT120
	LD	(BAKCLR),A
	CALL	GETCH##
	JR	Z,COL10
	CALL	GET8##	; Get the border colour, 0..15;
	CALL	Z,CHKNO##	;   nothing may follow it.
	CALL	Z,CHKEOL##
	RET	NZ
	LD	A,E
	CP	#10
	JR	NC,GOT120
	LD	(BDRCLR),A
COL10:	LD	IX,#62	; Set the new colours with the
	JR	GOT110	;   CHGCLR BIOS routine.

		SUBTTL	MODE
;        The MODE command sets the number of columns (1..80) and, new in
; 2.40, optionally the number of rows (1..26) on the screen. With 33 or
; more columns the text screen is selected via LINL40 and the INITXT BIOS
; routine, with fewer the 32-column screen via LINL32 and INIT32; the
; screen is cleared by the re-initialisation.
@MODE::	AND	(HL)	; At least the columns required.
	LD	A,.NOPAR##
	RET	Z
	LD	A,(CRTCNT)	; Default rows = current rows.
	LD	(XBUF1##),A
	CALL	GET8##	; Get the number of columns.
	RET	NZ
	CALL	GETCH##
	JR	Z,MOD10
	PUSH	DE	; Get the number of rows; nothing
	CALL	GET8##	;   may follow it.
	LD	C,E
	POP	DE
	CALL	Z,CHKNO##
	CALL	Z,CHKEOL##
	RET	NZ
	LD	A,C
	LD	(XBUF1##),A
	XOR	A
MOD10:	OR	E	; Columns must be 1..80.
	JR	Z,GOT120
	CP	#51
	JR	NC,GOT120
	LD	IX,#6C	; 33..80 columns: text screen via
	LD	HL,LINL40	;   LINL40 and INITXT;
	CP	#21
	JR	NC,GOTCOLS
	LD	IX,#6F	;   1..32 columns: via LINL32 and
	INC	HL	;   INIT32.
GOTCOLS:	LD	(HL),A
	LD	A,(XBUF1##)	; Rows must be 1..26.
	OR	A
	JR	Z,GOT120
	CP	#1B
	JR	NC,GOT120
	LD	(CRTCNT),A
GOT110:	JP	CALLSLOT	; Re-init (and clear) the screen.

GOT120:	LD	A,.IPARM##	; Parameter out of range.
	RET

		SUBTTL	INKEY, INPUT
;        INKEY and INPUT (new in 2.40) read a keystroke or a line of input
; into an environment item:
;            INKEY [prompt text] %name [flags]     INPUT [prompt text] %name
; (the name is typed as %%name; parameter expansion reduces it to %name).
; The prompt text, if present, is printed first. INKEY reads a single key,
; INPUT a line with all the editing facilities that _BUFIN provides. The
; two entries share their code: the carry kept in AF' tells them apart.
;        The optional flags number of INKEY (new in 3.0) is the sum of:
;   1 => don't wait for a key: if none is waiting in the keyboard buffer,
;        the item is set to the empty string (which deletes it) at once,
;        and nothing is printed. Otherwise the key is read, echoed and
;        followed by a CR/LF as usual.
;   2 => empty the keyboard buffer after reading the key (or after finding
;        no key with 1). Without 1 the buffer is always emptied before
;        waiting for the key too (as INCH does).
;   4 => store the code of the key as two hexadecimal digits instead of
;        the key itself (so that keys like space, ESC, TAB or BS can be
;        tested). The key is then read without echo and nothing at all
;        is printed (an echoed control key would mess up the screen).
@INKEY::	SCF	; Cy => INKEY.
@INPUT::	EX	AF,AF'	; Save the INKEY/INPUT flag.
	XOR	A
	LD	(ENVNAME##),A	; No name seen yet.
	LD	(ENVDATA##),A	; No prompt text yet.
	OR	(HL)	; A parameter must be given.
	LD	A,.NOPAR##
	RET	Z
	CALL	PRSENV	; A '%name' first => no prompt text.
	JR	Z,INP40
	LD	DE,ENVDATA##	; Else copy the prompt text to BUFF,
INP20:	LD	A,(HL)	;   up to a '%' or the end of the
	OR	A	;   line.
	JR	Z,INP30
	CP	"%"
	JR	Z,INP30
	LD	(DE),A
	INC	DE
	INC	HL
	JR	INP20
INP30:	XOR	A	; Terminate the prompt text.
	LD	(DE),A
	OR	(HL)	; Parse the '%name' if the text ended
	CALL	NZ,PRSENV	;   with one (else .NOPAR below).
INP40:	CALL	GETCH##	; Anything after the name ?
	LD	E,#00	;   (the flags default to 0)
	JR	Z,INP50
	EX	AF,AF'	; INPUT: 'too many parameters'.
	JP	NC,INP45
	EX	AF,AF'
	CALL	GET8##	; INKEY: read the flags number into E;
	CALL	Z,CHKNO##	;   nothing may follow it, and it
	CALL	Z,CHKEOL##	;   must be 0 to 7.
	RET	NZ
	LD	A,E
	CP	#08
	LD	A,.IPARM##
	RET	NC
INP50:	LD	A,(ENVNAME##)	; A '%name' must have been given.
	OR	A
	LD	A,.NOPAR##
	RET	Z
	PUSH	DE	; E = the flags.
	LD	DE,ENVDATA##	; Print the prompt text.
	CALL	PRTSTR##
	POP	DE
	EX	AF,AF'
	JR	NC,INP70	; Go if INPUT.
	PUSH	DE	; INKEY: keep the flags (BDOS calls
	LD	A,E	;   may corrupt DE).
	RRA	; Flags bit 0 => don't wait.
	JR	C,INP55
	CALL	FLUSHKB##	; Else empty the keyboard buffer first,
	JR	INP57	;   as INCH does, and wait for a key.
INP55:	LD	C,_CONST##	; A key waiting in the buffer ?
	CALL	BDOS
	LD	L,A	; No (A=0): the item gets the empty
	JR	Z,INP60	;   string, and nothing is printed.
INP57:	POP	DE	; Flags bit 2 => read the key without
	PUSH	DE	;   echo, and no CR/LF either.
	BIT	2,E
	JR	NZ,INP58
	LD	C,_CONIN##	; Else read and echo it, then CR/LF,
	CALL	BDOS	;   as INCH does.
	LD	L,A
	CALL	LPRINT##
	JR	INP60
INP58:	LD	C,_INNOE##
	CALL	BDOS
	LD	L,A
INP60:	POP	DE	; E = the flags again.
	LD	A,L	; A = the key, or 0 if none.
	LD	HL,ENVDATA##
	OR	A	; None: the item gets the empty string.
	JR	Z,INP65
	BIT	2,E	; Flags bit 2 => the code of the key as
	JR	Z,INP65	;   two hexadecimal digits in BUFF
	CALL	MKBYTE##	;   (then A = 0, the terminator).
	XOR	A
INP65:	LD	(HL),A	; Else a one-character string of the
	INC	HL	;   key (or the empty string).
	LD	(HL),#00
INP67:	BIT	1,E	; Flags bit 1 => empty the keyboard
	CALL	NZ,FLUSHKB##	;   buffer now.
	LD	DE,ENVDATA##
	JR	INP80
INP70:	LD	HL,ENVDATA##	; INPUT: read a line of up to 127
	LD	(HL),#7F	;   characters into BUFF,
	EX	DE,HL
	LD	C,_BUFIN##
	CALL	BDOS
	CALL	LPRINT##
	LD	HL,ENVDATA##+1	;   null-terminate it and point DE
	PUSH	HL	;   at the typed text.
	LD	C,(HL)
	LD	B,0
	INC	HL
	ADD	HL,BC
	LD	(HL),0
	POP	DE
	INC	DE
INP80:	LD	HL,ENVNAME##	; Set the environment item named at
	LD	C,_SENV##	;   BUFF2 to the value at (DE).
	JP	BDOS

INP45:	LD	A,.INP##	; Garbage after the name of INPUT.
	OR	A
	RET

;        Parse a '%name' argument: if (HL) does not point at a '%' then NZ
; is returned with nothing done. Otherwise the name after the '%' is copied
; to BUFF2, terminated at a space or the end of the line, and Z is returned
; with HL on the terminating character and DE pointing at the null after
; the name.
PRSENV:	LD	A,(HL)
	CP	"%"
	RET	NZ
	LD	DE,ENVNAME##
PRS60:	INC	HL
	LD	A,(HL)
	OR	A
	JR	Z,PRS70
	CP	" "
	JR	Z,PRS70
	LD	(DE),A
	INC	DE
	JR	PRS60
PRS70:	XOR	A
	LD	(DE),A
	RET

		SUBTTL	RESET
;        The RESET command (new in 2.40) resets the machine by calling
; address 0 of the main BIOS ROM. The stack is moved to page 3 first, as in
; CALLSLOT; there is no return.
@RESET::	AND	(HL)	; No parameters allowed.
	LD	A,.INP##
	RET	NZ
	LD	IY,(EXPTBL-1)	; IYh = main ROM slot.
	LD	SP,#F51F
	LD	IX,#00	; Call the reset entry point.
	JP	CALSLT

		SUBTTL	PATH, CDPATH
;        PATH displays or sets the command search path, and CDPATH (new in
; 2.40) the directory search path used by CHDIR and friends. Both are kept
; as environment items and share all of this code; only the item name
; differs, and it is kept in HL' throughout.
;        With no parameters the current value is printed. A parameter list
; starting with '-' deletes each given item from the path ('Invalid path'
; if one of them is not there), one starting with '+' appends each item
; (deleting it first if already present, so items can be re-ordered), and
; a plain list replaces the whole path.
@CDPATH::	PUSH	HL	; CDPATH works on the CDPATH item,
	LD	HL,CDPATH$##
	JR	PAT10

@PATH::	PUSH	HL	;   PATH on the PATH item.
	LD	HL,PATH$##
PAT10:	PUSH	HL	; Keep the item name pointer in
	EXX	;   HL'.
	POP	HL
	EXX
	CALL	GENV2##	; Get the current value into BUFF.
	POP	HL
	RET	NZ
	OR	(HL)	; If no parameters, then just print
	JP	Z,?DMSCR	;   the current value.
	INC	HL
	CP	"-"	; '-' => delete items;
	JR	Z,DELP
	CP	"+"	; '+' => append items;
	JR	Z,ADDP
	XOR	A	;   else replace: clear the current
	LD	(DE),A	;   value, then append to that.
	DEC	HL
ADDP:	EX	DE,HL	; HL -> current PATH string.
	PUSH	HL	; If only separators there, then set
	CALL	GETCH##	;   the PATH string to a null string.
	POP	HL	;   This fiddle is done because the
	JR	NZ,PTH10	;   PATH string is initialised to '; '.
	LD	(HL),A
PTH10:	EX	DE,HL
AP10:	CALL	GETCH##	; Skip separators.
	JR	Z,APC10	; Set new path if end of user's items.
	LD	BC,XBUF1##
	PUSH	BC
	CALL	CPYSTR	; Copy & uppercase item, HL -> next.
	PUSH	HL	; Save ptr to next item in user string.
	CALL	NC,DELSTR	; Delete item if it exists.
	POP	HL
	POP	BC	; BC -> item copied to BUFF3.
	RET	C	; Return if error.
	LD	DE,ENVDATA##-1	; Find end of current PATH string,
AP20:	INC	DE	;   then append separator and the new
	LD	A,(DE)	;   item.
	OR	A
	JR	NZ,AP20
	LD	A,";"	; Add separator to PATH string.
	LD	(DE),A
	INC	DE
	LD	A," "
	LD	(DE),A
AP30:	INC	DE
	LD	A,(BC)
	INC	BC
	LD	(DE),A
	OR	A
	JR	NZ,AP30
	JR	AP10

APC10:	EXX	; Set the new path: recover the
	PUSH	HL	;   item name pointer from HL' and
	EXX	;   set the value built in BUFF.
	POP	HL
	JP	SENV2##

DELP:	CALL	GETCH##	; Skip separators.
	JR	Z,APC10	; Attempt to set PATH if end of items.
	LD	BC,XBUF1##	; Else copy to BUFF3 & upper case.
	CALL	CPYSTR	; HL -> start of next item.
	PUSH	HL	; Save pointer to next item.
	CALL	NC,DELSTR	; Attempt to delete item from string.
	POP	HL
	RET	C	; Return if error.
	LD	A,.IPATH##	; Return .IPATH if item not found.
	RET	Z
	JR	DELP	; Repeat for next item.

;        Delete the item at BUFF3 from the path string in BUFF. Each item
; of the path in turn is copied to BUFF3+128 and compared with it; when a
; match is found, the rest of the path string is copied down over the item.
; On exit, Cy => error, Z => item not found, NZ => item deleted.
DELSTR:	LD	HL,ENVDATA##
DS5:	PUSH	HL	; Save start of this item.
	POP	IX
	CALL	GETCH##	; Skip leading separators.
	RET	Z	; Return with Z if user item not found.
	LD	BC,XBUF1##+#80	; Copy item to BUFF3+128 & upper case.
	PUSH	BC
	CALL	CPYSTR	; Leaves HL -> next item.
	POP	BC
	RET	C
	LD	DE,XBUF1##	; Compare with string at BUFF3.
DS10:	LD	A,(BC)
	EX	DE,HL
	CP	(HL)
	EX	DE,HL
	JR	NZ,DS5
	INC	DE
	INC	BC
	OR	A
	JR	NZ,DS10
	PUSH	IX	; Found: copy the rest of the path
	POP	DE	;   down over this item,
	CALL	NCOPY##
	INC	A	;   and return NZ.
	RET

;        Copy one item from the command line at (HL) to the buffer at (BC),
; stopping at a separator or the end of the line and null-terminating the
; copy. Every character is passed through the DOS check character function
; so that double byte (Kanji) characters are handled properly.
; On exit, HL points to the terminating character; Cy set => error.
CPYSTR::	LD	D,#00	; Zero character flags.
CS10:	LD	E,(HL)	; Check the character.
	PUSH	BC
	PUSH	HL
	LD	C,_CHKCHR##
	CALL	BDOS
	POP	HL
	POP	BC
	SCF	; Cy => error from the check.
	RET	NZ
	LD	(BC),A	; Terminate the copy (A is 0):
	OR	E	;   done if at the end of the line
	RET	Z	;   or at a separator,
	CALL	SEP?##
	RET	Z
	LD	A,E	;   else overwrite the null with
	LD	(BC),A	;   the character and carry on.
	INC	BC
	INC	HL
	JR	CS10

;        MKPATH2 is CPYSTR's brace-aware variant, used to fetch IF/IFF
; condition words: between { and } separator characters lose their special
; meaning, and the braces themselves are not copied. VALUEL holds the
; "inside braces" state.
MKPATH2:	LD	D,#01	; Initialise character flags.
	XOR	A	; Not inside braces.
	LD	(VALUEL##),A
MKP10:	LD	A,(HL)	; '{' : set the brace flag and
	CP	"{"	;   skip the character.
	JR	NZ,MKP20
	LD	(VALUEL##),A
	INC	HL
	JR	MKP10
MKP20:	CP	"}"	; '}' : clear the brace flag and
	JR	NZ,MKP30	;   skip the character.
	XOR	A
	LD	(VALUEL##),A
	INC	HL
	JR	MKP10
MKP30:	LD	E,(HL)	; The rest is as CPYSTR,
	PUSH	BC
	PUSH	HL
	LD	C,_CHKCHR##
	CALL	BDOS
	POP	HL
	POP	BC
	SCF
	RET	NZ
	LD	(BC),A
	OR	E
	RET	Z
	LD	A,(VALUEL##)	;   except that separators end the
	OR	A	;   item only outside braces.
	LD	A,E
	CALL	Z,SEP?##
	RET	Z
	LD	A,E
	LD	(BC),A
	INC	BC
	INC	HL
	JR	MKP10

		SUBTTL	PAUSE
;        The  PAUSE  command is similar to the ECHO command, except that after
; printing the message on the reast of the command line, it prompts for a  key
; to be pressed.  This is used in batch file processing  to  prompt  for,  for
; example,  the user to change disks. The entry point PAUSE is called from the
; character output routine OUTCH at the end of a screenful ot text if /P is in
; effect.
@PAUSE::	EX	DE,HL	; DE -> command arguments.
	CALL	?DMSCR	; Print arguments & CR,LF if non-null.
PAUSE::	LD	A,#0F
	CALL	DMESS##
	JP	INCH##

@RAMDISK::	AND	(HL)
	JR	NZ,SETRAM
	LD	BC,#FF68
	CALL	BDOS
	RET	NZ
	LD	H,A
	OR	B
	LD	A,.NRAMD##
	RET	Z
	LD	L,B
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	ADD	HL,HL
	LD	A,#29
	CALL	DMESS##
	LD	IX,ENVDATA##
	PUSH	IX
	CALL	D16##
	POP	DE
	CALL	PRTSTR##
	LD	A,"K"
	CALL	PRCHAR##
	JP	LPRINT##

SETRAM:	EX	AF,AF'
	CALL	CHKD	; Check for /D.
	RET	NZ	; Ret if error.
	EX	AF,AF'
	JR	NZ,ND	; Go if not.
	OR	(HL)	; Any number given ?
	LD	B,A
	JR	Z,NRAM	; Just delete RAM disk if not.
	XOR	A	; Else AF' = Z again, get number.
ND:	EX	AF,AF'
	CALL	GET16##	; Get size of RAM disk required.
	RET	NZ
	LD	A,(HL)	; Allow 'K' to be given after number.
	CALL	UC##
	CP	"K"
	JR	NZ,NK
	INC	HL	; Skip passed K if given.
NK:	LD	A,(HL)	; Get character after number.
	CP	"/"	; Start of /D ?
	CALL	NZ,CHKNO##	; Check for garbage if not.
	CALL	Z,CHKD	; Check for /D if no error.
	RET	NZ	;   if not.
	CALL	GETCH##	; Check for garbage on end of line.
	LD	A,.INP##	; 'Too many parameters' if not eol.
	RET	NZ
	LD	B,#04
	LD	HL,#0F	; Round up to next 16K boundary.
	ADD	HL,DE
DIV16:	SRL	H	; Divide by 16 for no. segments.
	RR	L
	DJNZ	DIV16
	LD	A,.IPARM##	; If > 254 16K segments, then give
	INC	H	;   error.
	DEC	H
	RET	NZ
	LD	B,L	; B=no. segments in new RAM disk.
	INC	L
	RET	Z	; Ret if 255 segments specified.
	EXX	; Save new size in B'.
	EX	AF,AF'
	JR	Z,DELRAM	; Destroy existing RAM disk if yes.
	LD	BC,#FF68
	CALL	BDOS	; See if RAM disk already exists.
	RET	NZ	; Return any errors.
	OR	B	; NZ => RAM disk currently exists.
	JR	Z,NEWRAM	; Create one if one doesn't exist.
	LD	A,#34
	CALL	YN##	; Prompt with 'Delete RAM disk (Y/N) ?'
	LD	A,#00
	RET	Z	; Ret with no error if 'N' pressed.
DELRAM:	LD	BC,_RAMD##	; Delete current RAM disk.
	CALL	BDOS
	RET	NZ
NEWRAM:	EXX	; B=size of new RAM disk.
NRAM:	LD	C,_RAMD##	; Create new RAM disk.
	JP	BDOS

CHKD:	LD	A,(HL)	; Start of option ?
	CP	"/"
	JR	NZ,OKRET	; Return no error if not.
	INC	HL
	LD	A,(HL)	; Else get option character.
	CALL	UC##
	CP	"D"	; /D ?
	LD	A,.IOPT##
	RET	NZ	; Return 'invalid option' error if not.
	INC	HL
	XOR	A
	EX	AF,AF'
	CALL	GETCH##	; Skip following separators.
	JR	CHKD	; Repeat so invalid /s give .IOPT.

OKRET:	XOR	A
	RET

		SUBTTL	SET
;        This is the SET command routine.  SET  alone  prints  out  the  whole
; environment,  SET followed by a name prints out the string for that name and
; SET followed by a name, separator and string sets that environment  name  to
; the string.
@SET::	AND	(HL)	; Any name given ?
	JR	NZ,DST10	; Go if yes, else print environment.
SET10:	LD	HL,#01	; Initialise item number.
DENV:	PUSH	HL	; Save item number.
	EX	DE,HL
	CALL	FENV##	; Get name of item.
	JR	NZ,NXTENV	; Ignore this item if error.
	POP	BC
	OR	(HL)	; Null name ?
	RET	Z	; Done if yes.
	PUSH	BC
	CALL	GENV##	; Get string value of this name.
	JR	NZ,NXTENV	; Ignore this item if error.
	EX	DE,HL	; DE -> name.
	CALL	PRTSTR##	; Print name of string.
	LD	A,#41
	CALL	DMESS##	; Print '='.
	EX	DE,HL	; DE -> value of name.
	CALL	DMSCR##	; Followed by the string & CR,LF.
NXTENV:	POP	HL	; Get back current item number.
	INC	HL	; Next item.
	JR	DENV

SETNAME:	PUSH	HL	; HL -> start of name.
	LD	D,#00	; Zero character flags.
	DEC	HL
NXTCHR:	INC	HL
	LD	E,(HL)
	PUSH	HL
	LD	C,_CHKCHR##
	CALL	BDOS
	POP	HL
	POP	BC
	RET	NZ
	PUSH	BC
	OR	E
	JR	Z,DSTR
	CALL	SEP?##
	JR	NZ,NXTCHR
	PUSH	HL
	CALL	STRIP##
	POP	HL
	LD	(HL),#00
	JR	Z,DSTR
	INC	HL
	CALL	GETCH##
	EX	DE,HL
	POP	HL
	LD	C,_SENV##
	CALL	BDOS
	RET	NZ	; Error setting the item.
	JP	GETBUFI##	; Refresh the cached BUFINSERT state, in
			;   case that was the item (see io.mac).

DSTR:	POP	HL	; HL -> start of name.
	CALL	GENV2##
	RET	NZ
?DMSCR:	LD	A,(DE)	; Print the string at (DE) plus a
	OR	A	;   CRLF, unless it is null.
	RET	Z
	JP	DMSCR##

DST10:	LD	A,(HL)	; An option must be /P, which pages
	CP	"/"	;   the environment listing;
	JR	NZ,SETNAME	;   anything else is a name.
	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"P"
	LD	A,.IOPT##
	RET	NZ
	CALL	SETP##
	INC	HL
	CALL	GETCH##	; List all if nothing follows /P.
	JR	NZ,SETNAME
	JR	SET10

		SUBTTL	ALIAS
;        The ALIAS command (new in 2.40) maintains the alias list, which
; lives in the private mapper segment between the command history buffer
; and the variable swap area (see FNDALIAS and friends in io.mac). It is
; structured like SET: no parameters lists all aliases as 'name = value', a
; name alone prints that alias's value, and 'name value' defines an alias
; ('Not enough memory' when the alias space is full) while a name with an
; empty value deletes it. In addition, /P pages the listing, /R clears the
; whole list, /S file saves the alias area to a file and /L file loads such
; a file back, replacing all current aliases. An alias file starts with the
; 12-byte signature 'Alias File'+^Z, which /L checks.
@ALIAS::	LD	E,A	; Aliases live in the mapper
	LD	A,(SHRAMFL##)	;   segment: 'Shell RAM is
	OR	A	;   off' when there is none.
	JP	NZ,SHROFF
	LD	A,E
	AND	(HL)	; No parameters => list all.
	JR	NZ,ALI180
ALI130:	LD	BC,#00	; Start with the first alias.
ALI140:	LD	HL,ENVNAME##	; Get the name and value of the
	LD	DE,ENVDATA##	;   next alias; BC advances through
	CALL	FNDALIAS##	;   the list.
	LD	A,(HL)	; A null name ends the list.
	OR	A
	RET	Z
	PUSH	BC
	EX	DE,HL	; Print 'name = value'.
	CALL	PRTSTR##
	LD	A,#41
	CALL	DMESS##
	EX	DE,HL
	CALL	DMSCR##
	POP	BC
	JR	ALI140

ALI150:	PUSH	HL	; HL -> start of the alias name.
	LD	D,#00	; Zero character flags.
	DEC	HL
ALI160:	INC	HL	; Scan the name for a separator or
	LD	E,(HL)	;   the end of the line, checking
	PUSH	HL
	LD	C,_CHKCHR##
	CALL	BDOS
	POP	HL
	LD	(HL),E	;   each character and storing it
	POP	BC
	RET	NZ
	PUSH	BC
	OR	E
	JR	Z,ALI170	;   back. End of line: query it.
	CALL	SEP?##
	JR	NZ,ALI160
	PUSH	HL	; Separator: if only blanks follow,
	CALL	STRIP##	;   query the alias, else define it
	POP	HL
	LD	(HL),#00	;   with the rest of the line as
	JR	Z,ALI170	;   its value.
	INC	HL
	CALL	GETCH##
	EX	DE,HL	; DE -> value.
	POP	HL	; HL -> name.
	JP	SETALIAS##

ALI170:	POP	HL	; Print the value of the alias, if
	LD	DE,ENVDATA##	;   it is defined.
	CALL	GETALIAS##
	JP	?DMSCR

ALI180:	LD	A,(HL)	; Check for an option:
	CP	"/"
	JR	NZ,ALI150
	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"S"	;   /S file = save the aliases,
	JR	Z,ALI200
	CP	"L"	;   /L file = load an alias file,
	JR	Z,ALI250
	CP	"R"	;   /R = remove all aliases,
	JP	Z,ALI260
	CP	"P"	;   /P = page the listing,
	JR	Z,ALI190
	DEC	HL	;   anything else is a name.
	JR	ALI150

ALI190:	CALL	SETP##	; /P: set up the pause line count;
	INC	HL
	CALL	GETCH##	;   list all if nothing follows.
	JR	NZ,ALI150
	JR	ALI130

ALI200:	CALL	PRSPATH	; /S: parse the file name and
	OR	A	;   create the file.
	RET	NZ
	LD	BC,_CREATE##
	CALL	BDOS
	RET	NZ
	PUSH	BC	; B = file handle.
	LD	C,_WRITE##	; Write the 12-byte 'Alias File'
	LD	DE,TALIAS$	;   signature.
	LD	HL,#0C
	CALL	BDOS
	POP	BC
	RET	NZ
	PUSH	BC
	CALL	SETPG2##	; Find the end of the alias records
	CALL	GETALIADDR##	;   in the mapper segment.
	SET	7,H
ALI210:	LD	E,(HL)
	INC	HL
	LD	D,(HL)
	DEC	HL
	LD	A,D
	OR	E
	JR	Z,ALI220
	ADD	HL,DE
	JR	ALI210

ALI220:	PUSH	HL	; Compute the used length of the
	CALL	GETALIADDR##	;   alias area, including the zero
	SET	7,H	;   terminator record, and write
	DEC	HL	;   the whole area to the file.
	DEC	HL
	EX	DE,HL
	POP	HL
	SBC	HL,DE
	INC	DE
	INC	DE
	POP	BC
	PUSH	BC
	LD	C,_WRITE##
ALI230:	CALL	BDOS	; Read or write the alias area,
	LD	E,A	;   then close the file, restore
	POP	BC	;   page 2 and return any error.
ALI240:	PUSH	DE
	LD	C,_CLOSE##
	CALL	BDOS
	PUSH	AF
	CALL	RSTPG2##
	POP	AF
	POP	DE
	RET	NZ
	LD	A,E
	RET

ALI250:	CALL	PRSPATH	; /L: parse the file name and open
	OR	A	;   the file.
	RET	NZ
	LD	C,_OPEN##
	CALL	BDOS
	RET	NZ
	PUSH	BC
	LD	C,_READ##	; Read the 12-byte signature and
	LD	DE,ENVNAME##	;   check that this really is an
	LD	HL,#0C	;   alias file.
	CALL	BDOS
	POP	BC
	RET	NZ
	PUSH	BC
	LD	HL,ENVNAME##
	LD	BC,TALIAS$
	CALL	STRCMP
	POP	BC
	LD	E,.IFNM##	; 'Invalid filename' if it is not.
	JR	NZ,ALI240
	PUSH	BC
	CALL	SETPG2##	; Read the file straight into the
	POP	BC	;   alias area (at most its full
	PUSH	BC	;   size), replacing all aliases.
	LD	HL,(ALIADDR+#8000)
	SET	7,H
	EX	DE,HL
	LD	HL,(ALIEND+#8000)
	SET	7,H
	OR	A
	SBC	HL,DE
	LD	C,_READ##
	JR	ALI230

ALI260:	INC	HL	; /R: no more parameters allowed;
	CALL	GETCH##	;   empty the list by writing a
	LD	A,.INP##	;   zero length record at the start
	RET	NZ	;   of the alias area.
	CALL	GETALIADDR##
	XOR	A
	CALL	WRCHR##
	INC	HL
	CALL	WRCHR##
	RET

; The signature written at the start of an alias file.
TALIAS$:	DEFB	"Alias File",26,0

;        Parse a single file name given after an option letter, for the
; ALIAS /S and /L options. On entry HL points at the option letter.
; On exit,  Z & A=0 => OK, DE -> null-terminated file name.
;           NZ => error: .NOPAR if no name given, .IPATH if it does not
;           end cleanly, .INP if anything follows it.
PRSPATH:	INC	HL	; Skip the option letter and any
	CALL	GETCH##	;   separators; a name must follow.
	LD	A,.NOPAR##
	RET	Z
	LD	BC,_PARSE##	; Parse the file name.
	EX	DE,HL
	PUSH	DE
	CALL	BDOS
	POP	HL
	RET	NZ
	EX	DE,HL	; HL -> terminating character,
	LD	A,(HL)	;   DE -> start of the name.
	OR	A
	JR	Z,PRS80
	CP	" "	; The name must end at a space or
	LD	A,.IPATH##	;   at the end of the line.
	RET	NZ
	LD	(HL),#00	; Null-terminate the name; nothing
	INC	HL	;   may follow it.
	CALL	GETCH##
	LD	A,.INP##
	RET	NZ
PRS80:	XOR	A
	RET

		SUBTTL	HISTORY
;        The HISTORY command (new in 2.40) handles the command history that
; the line editor keeps in a circular buffer at the start of the private
; mapper segment. With no parameters the whole history is printed, oldest
; command first; /P pages the output and /D clears the history.
;        A number (128..4095) sets a new size for the history buffer. The
; alias area, which follows the history buffer in the segment, is moved up
; or down to make this possible, and the history itself is cleared.
@HISTORY::	LD	E,A	; The history lives in the mapper
	LD	A,(SHRAMFL##)	;   segment: 'Shell RAM is
	OR	A	;   off' when there is none.
	JP	NZ,SHROFF
	LD	A,E
	AND	(HL)	; Print the history if no
	JP	Z,HIS30	;   parameters.
	LD	A,(HL)	; Check for /D or /P.
	CP	"/"
	JP	Z,CHECKP
	CALL	GET16##	; Else it is a new history buffer
	CALL	Z,GCHKEOL##	;   size, 128..4095 bytes.
	RET	NZ
	EX	DE,HL
	LD	DE,(MAXBUFLEN##)	; 'Invalid number' unless below
	CALL	COMPARE4	;   4096...
	LD	A,.BADNO##
	RET	NC
	LD	DE,128	;   ...and at least 128.
	CALL	COMPARE4
	LD	A,.BADNO##
	RET	C
	CALL	SETBUFLEN##	; Set the new buffer length.
	LD	DE,BUFADDR	; Start of the history buffer.
	ADD	HL,DE	; Add the new length to it:
	PUSH	HL	;   this is the new alias area start.
	CALL	GETALIADDR##	; Get the current alias area start.
	POP	DE	; New start address.
	CALL	COMPARE4	; Are they equal?
	RET	Z	; Yes, then we are done.
	EX	AF,AF'                  ; Save the comparison for later.
	SET	7,H	; Real address in memory (page 2).
	PUSH	HL	; Save it.
	CALL	SETPG2##	; Page 2 switched for the duration.
HIS10:	LD	C,(HL)	; Length of this alias record.
	INC	HL
	LD	B,(HL)
	DEC	HL
	ADD	HL,BC	; Add it to the address.
	LD	A,B	; Is the length zero?
	OR	C
	JR	NZ,HIS10	; No, then the next record.
	INC	HL
	INC	HL	; End address of the alias area.
	PUSH	HL	; Save it in HL'.
	EXX
	POP	HL
	EXX
	POP	DE	; Get the alias area start address
	PUSH	DE	;   and save it again.
	SBC	HL,DE	; Subtract it from the end address:
	LD	B,H	;   so this is the length.
	LD	C,L
	PUSH	BC	; Save the length.
	EXX
	PUSH	HL
	EXX
	CALL	GETBUFLEN##	; Get the new history buffer length.
	LD	DE,BUFADDR	; Start address of the buffer.
	ADD	HL,DE	; Add them: the new alias start.
	EX	DE,HL	; To DE.
	PUSH	DE
	EXX
	POP	HL	; And back into HL'.
	POP	DE	; DE' restored too.
	POP	BC	; And BC'.
	ADD	HL,BC	; Add the length to the alias start.
	EX	DE,HL
	EXX
	POP	HL	; Old alias area start back.
	EX	AF,AF'                  ; Result of the comparison:
	JR	C,HIS20	;   Cy means copy backwards.
	PUSH	DE	; Save the new start address.
	SET	7,D	; Make the real (page 2) address.
	LDIR		; Copy (forwards).
	CALL	RSTPG2##	; Restore page 2.
	POP	HL	; Get the new start address back
	CALL	SETALIADDR##	;   and set it.
	JR	CHE10	; Clear the history buffer.

HIS20:	EXX		; Get the alternate registers.
	DEC	HL
	DEC	DE
	SET	7,D	; Make the real (page 2) address.
	LDDR		; And copy backwards.
	CALL	GETBUFLEN##	; New buffer length.
	LD	DE,BUFADDR	; Buffer start.
	ADD	HL,DE	; Add them: the new alias start.
	PUSH	HL	; Save the alias area start.
	CALL	RSTPG2##	; Restore page 2.
	POP	HL	; Get it back
	CALL	SETALIADDR##	;   and set the new alias start.
	JR	CHE10	; Clear the history buffer.

HIS30:	CALL	GETRDADDR##	; Save the editor's read pointer.
	LD	(VALUEL##),HL
	CALL	GETPUTADDR##	; Nothing to print if the buffer is
	LD	DE,BUFADDR	;   still empty.
	CALL	COMPARE4
	RET	Z
	CALL	SETRDADDR##	; Start at the write pointer and
	CALL	HISPREV##	;   step back one character: that
	CALL	GETRDADDR##	;   is where the dump must stop.
	LD	D,H
	LD	E,L
HIS40:	CALL	HISNEXT##	; Get the next character, moving
	JR	NZ,HIS60	;   circularly through the buffer.
HIS50:	CALL	GETRDADDR##	; At the end of a command: done
	CALL	COMPARE4	;   when the whole buffer has been
	JR	NZ,HIS40	;   walked.
	LD	HL,(VALUEL##)	; Restore the editor's read
	CALL	SETRDADDR##	;   pointer.
	XOR	A
	RET

HIS60:	CALL	Z,LPRINT##	; CRLF at the end of each command,
	JR	Z,HIS50
	CALL	PRCHAR##	;   else print the character.
	CALL	HISNEXT##
	JR	HIS60

CHECKP:	INC	HL	; Get the option letter:
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"D"	;   /D clears the history,
	JR	Z,CHECKD
	CP	"P"	;   /P pages the listing.
	LD	A,.IOPT##
	RET	NZ
	INC	HL
	CALL	SETP##
	CALL	GETCH##	; Nothing may follow /P.
	JR	Z,HIS30
	LD	A,.INP##
	RET

CHECKD:	INC	HL	; Nothing may follow /D.
	CALL	GETCH##
	LD	A,.INP##
	RET	NZ
CHE10:	LD	HL,BUFADDR	; Empty the history: read and write
	CALL	SETPUTADDR##	;   pointers to the buffer start,
	CALL	SETRDADDR##	;   end pointer just before it.
	DEC	HL
	CALL	SETENDADDR##
	XOR	A
	RET

		SUBTTL	TIME
;        This is the TIME command routine. The time is  printed  using  DTIME,
; which  prints  the  time  as  printed  by DIR ie. excluding seconds, so this
; routine prints seconds afterwards. DTIME  prints  the  time  in  the  format
; defined  by  the  TIME environment string, but this routine does not need to
; know about this since the time can be input in either format  unambiguously.
; Although  100ths  of  a  second  are  not  printed,  they  are accepted when
; inputting the time.
@TIME::	PUSH	HL	; Save pointer to command line.
	CALL	TFORM##	; Set up TM_FORM, the time format var.
	POP	HL
	LD	A,(HL)
	OR	A	; New time given on command line ?
	JR	NZ,RTIM	; Attempt to set new time if yes.
	LD	A,#24	; Print 'Current time is'
	CALL	DMESS##
	LD	C,_GTIME##	; Get current time for printing.
	CALL	BDOS
	PUSH	DE	; Save seconds in D.
	LD	A,L	; Convert hours & mins to FIB format.
	ADD	A,A
	ADD	A,A
	LD	B,#03
TIM2:	ADD	A,A
	RL	H
	DJNZ	TIM2
	LD	C,H
	LD	HL,ENVNAME##
	LD	(HL),A
	INC	HL
	LD	(HL),C
	LD	IX,ENVNAME##+2
	PUSH	IX
	CALL	DTIME##
	POP	DE
	POP	BC
	PUSH	AF
	CALL	PRTSTR##
	LD	A,":"
	CALL	PRCHAR##
	LD	A,B
	LD	D,#FF
	CALL	DDT##
	POP	AF
	CP	" "
	CALL	NZ,PRCHAR##
	LD	A,#0E
	CALL	DMESSCR##
NEWTIM:	LD	A,#26	; Print 'Enter new time:'.
	CALL	DMESS##
	CALL	INLI##	; Input a line.
	JR	Z,TIM5	; Go if no error.
	CP	.EOF##
	RET	NZ	; Return if not end of file error.
TIM5:	INC	HL	; Point passed length byte.
	CALL	GETCH##	; Skip leading separators.
	RET	Z	; Just return if new time not given.
RTIM:	EXX	; Hide the input line pointer.
	LD	C,_GTIME##	; Get current values for defaults.
	CALL	BDOS
	EXX	; Save current values, get input ptr.
	CALL	GETNO##	; Get hours.
	JR	C,TIM10	; Go if invalid number.
	EXX
	LD	H,A	; Else save new hours.
	EXX
TIM10:	CALL	DTSKIP##	; Skip separators.
	CALL	NC,GETNO##	; Get minutes.
	JR	C,TIM20	; Go if invalid number.
	EXX
	LD	L,A	; Else save new minutes.
	EXX
TIM20:	CALL	DTSKIP##	; Skip separators.
	CALL	NC,GETNO##	; Get seconds.
	JR	C,TIM30	; Go if invalid number.
	EXX
	LD	D,A	; Else save new number.
	EXX
TIM30:	CALL	DTSKIP##	; Skip separators.
	CALL	NC,GETNO##	; Get 100ths.
	JR	C,TIM35	; Go if invalid number.
	EXX
	LD	E,A	; Else save new 100ths second.
	EXX
TIM35:	CALL	GETCH##	; Strip spaces etc.
	CALL	UC##	; Upper case next character.
	CP	"A"	; am. indicator ?
	JR	Z,TIM40	; Go if yes, NC => am.
	CP	"P"	; pm. indicator ?
	SCF
	JR	Z,TIM40	; Go if yes, C => pm.
	OR	A	; Else end of line ?
	EXX
	JR	Z,SETIME	; Set new time if yes.
	DEFB	#3E	; Else give error.
TIM70:	POP	AF
BADTIM:	LD	B,.ITIME##
	JR	TIM60	; Print error & re-prompt.

TIM40:	PUSH	AF
	INC	HL
	CALL	GETCH##
	JR	NZ,TIM70
	POP	AF
	EXX
	LD	B,#0C
	LD	A,H
	JR	C,TIM50
	CP	B
	JR	Z,TIM45
	JR	NC,BADTIM
	DEFB	#D2
TIM45:	LD	H,#00
	JR	SETIME

TIM50:	OR	A	; Hour=0 pm is invalid.
	JR	Z,BADTIM
	CP	B	; Convert to 24 hour hours.
	JR	NC,TIM55	;   (no change if >12)
	ADD	A,B
TIM55:	LD	H,A	; H=new hours.
SETIME:	LD	C,_STIME##
	CALL	BDOS	; Attempt to set the new time.
	AND	.ITIME##	; 0 => OK, else .ITIME => invalid time.
	RET	Z	; Return if no error.
	LD	B,A	; B=error code.
TIM60:	LD	DE,ENVNAME##	; Get message into BUFF2.
	LD	C,_EXPLAIN##
	CALL	BDOS
	PUSH	DE	; Save message ptr.
	CALL	LPRINT##	; New line & '***'.
	LD	A,#0D
	CALL	DMESS##
	POP	DE
	CALL	PRTSTR##	; Print actual message.
	LD	A,#0E	; Followed by message after error.
	CALL	DMESSCR##
	JP	NEWTIM	; Prompt & input for another date.

		SUBTTL	VER
;       The VER command simply prints the version number.
@VER::	AND	(HL)
	LD	A,.INP##	; Error if any parameters.
	RET	NZ
	LD	HL,#4039	; Read address of KBDOS's version
	CALL	_RDSLT	;   message.
	PUSH	AF
	DEC	HL
	CALL	_RDSLT
	POP	HL
	LD	L,A	; HL -> message in KBDOS ROM.
	SCF	; Skip printing first time round.
VER10:	CALL	NC,PRCHAR##	; Print character from message.
	CALL	_RDSLT	; Read a character from the message.
	INC	HL
	OR	A
	JR	NZ,VER10	; Go with character and NC if not end.
	CALL	LPRINT##
	LD	HL,(#01)	; Get pointer to MSXDOS.SYS's message.
	LD	DE,#30
	ADD	HL,DE
	LD	E,(HL)
	INC	HL
	LD	D,(HL)	; DE -> message.
	CALL	DMSCR##	; Print message and CRLF.
	LD	A,#56	; Finally print COMMAND.COM's message:
	CALL	DMESS##	;   'COMMAND3.COM version ' and the
	LD	DE,VERNUM$	;   version number, a blank line, and
	CALL	PRTSTR##	;   'TYPE COMMAND3.COM for more
	CALL	LPRINT##	;   details'.
	CALL	LPRINT##
	LD	A,#57
	CALL	DMESSCR##
	JP	LPRINT##

;        Read the byte at address (HL) from the master disk ROM (entry
; _RDSLT) or from the slot given in A (entry RDSLOT), with the RDSLT BIOS
; routine. As in CALLSLOT, the stack is moved to page 3 around the
; inter-slot call.
; On exit, A = the byte read; HL is preserved.
_RDSLT:	LD	A,(#F348)	; A = slot of the master DiskROM.
RDSLOT:	EX	DE,HL
	PUSH	DE	; Save the address to read.
	LD	HL,#00	; Switch to a stack in page 3,
	ADD	HL,SP	;   saving the current one.
	LD	SP,#F51F
	PUSH	HL
	EX	DE,HL	; HL = address to read.
	CALL	RDSLT
	POP	HL	; Restore the original stack
	LD	SP,HL	;   and the address in HL.
	POP	HL
	RET

VERNUM$:
	INCLUDE	version.inc
	DEFB	0

		SUBTTL	VERIFY
;******************************************************************************
;        This  is  the  VERIFY  command   routine.   It   simply   sets   disk
; verify-after-write ON or OFF.
@VERIFY::	AND	(HL)
	JR	NZ,SETVFY	; Go & set verify if parameters given.
	LD	C,_GETVFY##	; Else get & print verify state.
	CALL	BDOS
	LD	HL,OFFWORD$##+1	; Assume disabled.
	INC	B
	DEC	B	; 0 => disabled, else enabled.
	JR	Z,GOTVFY
	LD	HL,ONWORD$##+1
GOTVFY:	LD	A,#28	; Print 'VERIFY='.
	CALL	DMESS##
	EX	DE,HL	; DE -> ON/OFF string.
	JP	DMSCR##	; Print verify state.

SETVFY:	EX	DE,HL	; DE -> parameter.
	DEC	DE	; Pretend DE -> length byte.
	LD	HL,ONWORD$##	; Check for ON.
	LD	B,(HL)	; Length of 'ON'.
	LD	C,#FF	; NZ => ON.
	CALL	COMPARE##
	JR	NC,VFY10
	INC	B	; Ready for OFF check.
	INC	C	; 0 => OFF.
	INC	HL	; Point passed null at end of ON.
	CALL	C,COMPARE##	; Check for OFF if not ON.
	LD	A,.IPARM##	; 'Invalid parameter' if not ON or OFF.
	RET	C
VFY10:	INC	DE	; Skip DE past the matched word.
	DJNZ	VFY10
	INC	DE
	EX	DE,HL
	LD	A,(HL)	; A separator and nothing else may
	CALL	SEP?##	;   follow it.
	LD	A,.IPARM##
	RET	NZ
	CALL	GETCH##
	LD	A,.INP##
	RET	NZ
	LD	E,C	; Set the new verify state.
	LD	C,_VERIFY##
	JP	BDOS

		SUBTTL	DSKCHK
;        The DSKCHK command (new in 2.40) displays or sets the disk check
; state, using the DSKCHK function that MSX-DOS 2 always had but COMMAND
; 2.31 never exposed. The code mirrors VERIFY, except that for the DSKCHK
; function B=0 means checking enabled.
@DSKCHK::	AND	(HL)	; Go & set the state if parameters.
	JR	NZ,DSK20
	LD	C,_DSKCHK##	; Else get the current state:
	XOR	A	;   B = 0 => checking is on.
	CALL	BDOS
	LD	HL,ONWORD$##+1	; Assume enabled.
	INC	B
	DEC	B
	JR	Z,DSK10
	LD	HL,OFFWORD$##+1
DSK10:	LD	A,#47	; Print 'DiskCheck is ' and the
	CALL	DMESS##	;   state.
	EX	DE,HL
	JP	DMSCR##

DSK20:	EX	DE,HL	; DE -> parameter.
	DEC	DE	; Pretend DE -> length byte.
	LD	HL,ONWORD$##	; Check for ON.
	LD	B,(HL)	; Length of 'ON'.
	LD	C,#00	; 0 => ON.
	CALL	COMPARE##
	JR	NC,DSK30
	INC	B	; Ready for OFF check.
	DEC	C	; FF => OFF.
	INC	HL	; Point passed null at end of ON.
	CALL	C,COMPARE##	; Check for OFF if not ON.
	LD	A,.IPARM##	; 'Invalid parameter' if neither.
	RET	C
DSK30:	INC	DE	; Skip DE past the matched word.
	DJNZ	DSK30
	INC	DE
	EX	DE,HL
	LD	A,(HL)	; A separator and nothing else may
	CALL	SEP?##	;   follow it.
	LD	A,.IPARM##
	RET	NZ
	CALL	GETCH##
	LD	A,.INP##
	RET	NZ
	LD	B,C	; Set the new state.
	LD	A,#01	; A = 1 => set.
	LD	C,_DSKCHK##
	JP	BDOS

		SUBTTL	SHELLRAM
;        The SHELLRAM command (new in 3.0): SHELLRAM [ON|OFF].
;        COMMAND3 normally allocates one 16K mapper segment and keeps the
; command history, the alias list and the variable swap stack in it (see
; command.inc). SHELLRAM OFF gives that segment back to the system, for users
; who need every mapper segment they can get for some other program:
; history, aliases and %_SHELL% stop working and the TPA shrinks by the
; size of the variable region, whose save slot moves below the resident
; code, as in COMMAND 2.31. SHELLRAM ON (the default state, unless no free
; segment was left at boot) re-enables everything, with an empty history
; and alias list unless a marked segment could be re-adopted. With no
; arguments the current state is displayed.
;        SHELLRAM OFF is refused in a nested shell when outer shells share
; the segment: their saved variable images live on its swap stack and
; would be lost. (The stack pointer sits at its top, BFFFh, only when no
; image is stored, which is exactly the safe case.)
;        With the /T (temporary) option the state is changed but not
; recorded in the environment item, so the next start of the interpreter
; goes back to whatever the item says.
@SHELLRAM::	AND	(HL)
	JR	NZ,SHR20
	LD	A,(SHRAMFL##)	; No arguments: display the state.
	OR	A
	LD	HL,ONWORD$##+1
	JR	Z,SHR10
	LD	HL,OFFWORD$##+1
SHR10:	LD	A,#53	; Print 'Shell RAM is ' and
	CALL	DMESS##	;   the state.
	EX	DE,HL
	JP	DMSCR##

SHR20:	CALL	ONOFF	; C = 0 for ON, FF for OFF; B = FF
	RET	NZ	;   when /T was given.
	PUSH	BC	; Keep the /T flag for SHRENV.
	LD	A,(SHRAMFL##)	; Already in the requested state ?
	OR	A	;   Then there is nothing to do.
	JR	Z,SHR40	;   (SHRAMFL is 0/1, C is 0/FF:
	LD	A,#FF	;   normalise before comparing.)
SHR40:	CP	C
	JP	Z,SHRENV	; (Still record the state: a SET
			;   may have left the item saying
			;   otherwise.)
	INC	C	; C was FF => switch OFF.
	JR	Z,SHR50
	CALL	FINDSEG##	; Switch ON: re-adopt the marked
	JR	NC,SHR45	;   segment, or allocate and
	POP	BC	;   initialise a fresh one; 'Not
	LD	A,.NORAM##	;   enough memory' if none is
	RET		;   free.
SHR45:	XOR	A
	LD	(SHRAMFL##),A
	CALL	SETSHR##	; Sync the stub and the ceiling.
	JR	SHRENV	; Record the state.

SHR50:	CALL	SETPG2##	; Switch OFF: refused when saved
	LD	HL,(VAREND+#8000)	;   variable images of outer
	CALL	RSTPG2##	;   shells are on the swap stack.
	LD	DE,#BFFF
	OR	A
	SBC	HL,DE
	JR	Z,SHR60
	POP	BC
	LD	A,#54	; 'Cannot be changed from a
	CALL	DMESSCR##	;   nested shell'.
	XOR	A
	RET

SHR60:	LD	A,(MAPPAGE##)	; Give the segment back and forget
	CALL	FRE_SEG##	;   it (RTYCNT = 0: nothing left
	XOR	A	;   to re-adopt).
	LD	(RTYCNT),A
	INC	A
	LD	(SHRAMFL##),A
	CALL	SETSHR##	; Sync the stub and the ceiling.
	;fall through into SHRENV

;        Record the current state in the 'SHELLRAM' environment item,
; unless /T was given (B = FF on the stack). The item is read at
; startup, which is what makes the state survive a BASIC + CALL SYSTEM
; round trip (environment strings live in the kernel, not in the TPA).
; Any error is ignored.
SHRENV:	POP	BC
	INC	B	; /T: leave the item alone.
	JR	Z,SHRE20
	LD	A,(SHRAMFL##)
	OR	A
	LD	DE,ONWORD$##+1
	JR	Z,SHRE10
	LD	DE,OFFWORD$##+1
SHRE10:	LD	HL,SHRAM$##
	LD	C,_SENV##
	CALL	BDOS
SHRE20:	XOR	A
	RET

;        Parse the "ON|OFF [/T]" arguments of the state switching commands
; (SHELLRAM, YENSLASH) at (HL). On exit, Z with A = 0, C = 0 for ON or
; FF for OFF and B = FF when the /T (temporary) option was given, 0 if
; not; or NZ with the error in A: 'Invalid parameter' for a word that is
; neither, 'Invalid option' for an option other than /T, 'Too many
; parameters' for anything else.
ONOFF:	EX	DE,HL	; DE -> parameter.
	DEC	DE	; Pretend DE -> length byte.
	LD	HL,ONWORD$##	; Check for ON.
	LD	B,(HL)	; Length of 'ON'.
	LD	C,#00	; 0 => ON.
	CALL	COMPARE##
	JR	NC,ONO10
	INC	B	; Ready for OFF check.
	DEC	C	; FF => OFF.
	INC	HL	; Point passed null at end of ON.
	CALL	C,COMPARE##	; Check for OFF if not ON.
	LD	A,.IPARM##	; 'Invalid parameter' if neither.
	RET	C
ONO10:	INC	DE	; Skip DE past the matched word.
	DJNZ	ONO10
	INC	DE
	EX	DE,HL
	LD	B,#00	; No /T so far.
	LD	A,(HL)	; The option may follow the word
	CP	"/"	;   directly...
	JR	Z,ONO20
	CALL	SEP?##	; ...else a separator must, and
	LD	A,.IPARM##	;   then the option or nothing.
	RET	NZ
	CALL	GETCH##
	RET	Z
	CP	"/"
	LD	A,.INP##
	RET	NZ
ONO20:	INC	HL
	LD	A,(HL)
	CALL	MKUPPER##
	CP	"T"	; Only /T exists.
	LD	A,.IOPT##
	RET	NZ
	INC	HL
	DEC	B	; B = FF: temporary.
	CALL	GETCH##	; Nothing may follow it.
	LD	A,.INP##
	RET	NZ
	XOR	A
	RET

;        Report that a feature is unavailable because the mapper segment
; has been given back: print 'Shell RAM is off' and return no
; error.
SHROFF:	LD	A,#53
	CALL	DMESS##
	LD	DE,OFFWORD$##+1
	CALL	DMSCR##
	XOR	A
	RET

		SUBTTL	YENSLASH
;        The YENSLASH command (new in 3.0): YENSLASH [ON|OFF].
;        On Japanese (and Korean) computers character 92 of the ROM
; character set is the yen (won) sign, so paths are displayed with that
; sign as the directory separator. YENSLASH ON redefines the character
; as a regular backslash in the VRAM pattern generator table, in SCREEN
; 0 (40 and 80 columns) and SCREEN 1; YENSLASH OFF puts the ROM glyph
; back. With no arguments the current state is displayed.
;        The state lives in the YENFLAG variable: the command loop (SETYEN
; in io.mac) re-applies the redefinition before every prompt while the
; flag is set, since any screen initialisation (MODE, a transient
; program) restores the ROM character set. The flag is recorded in the
; YENSLASH environment item, which ON creates with the value ON and OFF
; removes, purely for persistence: the item lives in the kernel, so it
; survives a BASIC + CALL SYSTEM round trip, and GETYEN loads the flag
; from it when the interpreter starts. Changing the item with SET has no
; effect until then. With the /T (temporary) option the state is changed
; but the item is left alone. Nothing is visible while the Kanji driver
; is installed (it draws the characters itself, on a bitmap screen; see
; SETYEN).
@YENSLASH::	AND	(HL)
	JR	NZ,YEN20
	LD	A,(YENFLAG##)	; No arguments: display the state.
	OR	A
	LD	HL,ONWORD$##+1
	JR	NZ,YEN10
	LD	HL,OFFWORD$##+1
YEN10:	LD	A,#86	; Print 'Backslash instead of yen sign
	CALL	DMESS##	;   is ' and the state.
	EX	DE,HL
	JP	DMSCR##

YEN20:	CALL	ONOFF	; C = 0 for ON, FF for OFF; B = FF
	RET	NZ	;   when /T was given.
	LD	A,C	; A = FF for ON, 0 for OFF: the
	CPL	;   value YENFLAG gets.
	LD	C,A
	INC	B	; /T: leave the item alone.
	JR	Z,YEN50
	LD	DE,ON$##	; ON: create the item with the value
	OR	A	;   'ON'; OFF: remove it (a null
	JR	NZ,YEN40	;   value deletes an item).
	LD	DE,CMDTEND##
YEN40:	PUSH	BC
	LD	HL,YENSL$##
	LD	C,_SENV##
	CALL	BDOS
	POP	BC
	RET	NZ	; 'Not enough memory' and the like.
YEN50:	LD	A,C	; Record the state in the flag and
	LD	(YENFLAG##),A	;   redefine the character now
	CALL	YENPAT##	;   (nonzero => the backslash, 0 =>
	XOR	A	;   the ROM glyph).
	RET

		SUBTTL	LOCK
;        The LOCK command (new in 3.0): LOCK [d: [ON|OFF]].
;        Locks or unlocks a drive with the _LOCK function: while a drive
; is locked Nextor never checks its media change status (the inserted
; media is assumed to never change), which speeds up access to removable
; devices used as fixed storage. Any aborted disk error unlocks the
; drive again.
;        With no arguments the locked drives are listed; with only a
; drive letter, the lock state of that drive is shown.
@LOCK::	AND	(HL)
	JR	NZ,LCK20
	LD	D,#00	; No arguments: list the locked
	LD	E,D	;   drives. D counts them, E is
LCK10:	PUSH	DE	;   the drive number (0 = A:).
	CALL	GETLCK
	POP	DE
	JR	Z,LCK15	; Not locked (or not lockable).
	INC	D	; Locked: count it and print
	LD	A,E	;   'X: '.
	ADD	A,"A"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	CALL	SPACE##
LCK15:	INC	E
	LD	A,E
	CP	#08
	JR	C,LCK10
	LD	A,D	; End the list, or say that no
	OR	A	;   drive is locked at all.
	JP	NZ,LPRINT##
	LD	A,#63
	JP	DMESSCR##

LCK20:	CALL	PARSDR	; Parse 'd:' into D (1 = A:).
	RET	NZ
	LD	A,D
	CP	#08+1	; Only drives A: to H: exist.
	LD	A,.IDRV##
	RET	NC
	CALL	GETCH##	; Anything after the drive ?
	JR	NZ,LCK30
	DEC	D	; No: show the drive's lock state
	LD	E,D	;   as 'X: is (not) locked'.
	PUSH	DE
	CALL	GETLCK
	POP	DE
	LD	B,#64
	JR	NZ,LCK25
	LD	B,#65
LCK25:	LD	A,E
	ADD	A,"A"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	CALL	SPACE##
	LD	A,B
	JP	DMESSCR##

LCK30:	PUSH	DE	; Save the drive (in D).
	EX	DE,HL	; DE -> parameter.
	DEC	DE	; Pretend DE -> length byte.
	LD	HL,ONWORD$##	; Check for ON.
	LD	B,(HL)	; Length of 'ON'.
	LD	C,#FF	; FF => lock.
	CALL	COMPARE##
	JR	NC,LCK40
	INC	B	; Ready for OFF check.
	INC	C	; 0 => unlock.
	INC	HL	; Point passed null at end of ON.
	CALL	C,COMPARE##	; Check for OFF if not ON.
	LD	A,.IPARM##	; 'Invalid parameter' if neither.
	JR	C,LCKERR
LCK40:	INC	DE	; Skip DE past the matched word.
	DJNZ	LCK40
	INC	DE
	EX	DE,HL
	LD	A,(HL)	; A separator and nothing else may
	CALL	SEP?##	;   follow it.
	LD	A,.IPARM##
	JR	NZ,LCKERR
	CALL	GETCH##
	LD	A,.INP##
	JR	NZ,LCKERR
	POP	DE	; D = drive again.
	DEC	D
	LD	E,D	; E = drive, 0 = A:.
	LD	B,C	; B = FF => lock, 0 => unlock.
	LD	A,#01	; Set the new lock state.
	LD	C,_LOCK##
	JP	BDOS

LCKERR:	POP	DE	; Drop the saved drive and return
	OR	A	;   the error code in A with NZ.
	RET

;        Get the lock state of drive E (0 = A:).
; On exit,  NZ => the drive is locked. Errors (the drive is not mapped or
; not accessible) count as not locked.
GETLCK:	XOR	A
	LD	B,A	; Preset 'not locked' for the
	LD	C,_LOCK##	;   error case.
	CALL	BDOS
	OR	A
	LD	A,B
	JR	Z,GLK10
	XOR	A	; Error => not locked.
GLK10:	OR	A	; NZ => locked.
	RET


		SUBTTL	MAPDRV
;        The MAPDRV command (new as an internal command in 3.0; it has
; existed as the MAPDRV.COM tool since Nextor 2.0):
;
;          MAPDRV [/L] d: partition|d|u|s [device] [slot[-sub][:seg]]
;          MAPDRV d: [/]filename [/RO]
;
;        Maps a drive to a partition of a device of a Nextor driver, or
; mounts a disk image file on a drive. 'd' reverts the drive to its
; boot time mapping and 'u' unmaps it (further arguments are ignored);
; 's' attaches the drive to the device without a partition, so that a
; suitable one is searched on each access. Partition 0 maps the drive
; directly to the device; partitions 2 to 4 mean the extended
; partitions 2-1 to 2-3 when partition 2 of the device is extended.
; When the slot (0 = the master disk ROM slot) is omitted, the driver
; currently controlling the drive is kept; when the device is omitted
; or 0, the device the drive is mapped to is kept (both require the
; drive to be on a Nextor driver). The segment (default FFh = ROM) is
; only meaningful for RAM loaded drivers. /L locks the drive after a
; successful partition mapping. A file name starting with a digit must
; be prefixed with '/' to distinguish it from a partition number, and
; /RO mounts the file in read only mode.
;        The work variables live in the ENVNAME scratch area, laid out
; exactly like the tool's block so that _GPART and _MAPDRV get the
; same structures: +0 drive, +1 primary, +2 extended, +3 slot,
; +4 segment, +5 device, +6 LUN (always 0), +7-10 start sector (the
; 8 bytes from +3 up are the _MAPDRV B=2 mapping table), +11
; partition, +12 skip-partition flag, +13 /L (or /RO) flag. The GDLI/
; GDRVR calls use ENVDATA as their buffer, and a mounted file's FIB is
; built in XBUF1.
;
PT_EXT	EQU	#05	; Extended partition type codes.
PT_EXTL	EQU	#0F	;   (CHS and LBA variants.)
;
@MAPDRV::	AND	(HL)
	LD	A,.NOPAR##
	RET	Z
	XOR	A	; Initialise the work variables:
	LD	(ENVNAME##+6),A	;   LUN,
	LD	(ENVNAME##+11),A	;   partition,
	LD	(ENVNAME##+12),A	;   skip-partition flag,
	LD	(ENVNAME##+13),A	;   /L flag.
	LD	A,#FF
	LD	(ENVNAME##+3),A	; Slot: FF = not specified.
	LD	(ENVNAME##+4),A	; Segment: FF = ROM driver.
	LD	A,(HL)	; /L before the drive ?
	CP	"/"
	JR	NZ,MDR10
	INC	HL
	LD	A,(HL)
	OR	#20
	CP	"l"
	LD	A,.IPARM##
	RET	NZ
	INC	HL
	LD	A,(HL)	; A separator must follow it.
	CALL	SEP?##
	LD	A,.IPARM##
	RET	NZ
	LD	A,#FF
	LD	(ENVNAME##+13),A
	CALL	GETCH##
	LD	A,.NOPAR##
	RET	Z
MDR10:	CALL	PARSDR	; Parse 'd:' into D (1 = A:).
	RET	NZ
	LD	A,D
	CP	#08+1	; Only drives A: to H: exist.
	LD	A,.IDRV##
	RET	NC
	DEC	D
	LD	A,D
	LD	(ENVNAME##+0),A	; The drive, counted from 0.
	CALL	GETCH##
	LD	A,.NOPAR##
	RET	Z
	LD	A,(HL)	; A leading '/' forces the rest to
	CP	"/"	;   be taken as a file name.
	JR	NZ,MDR20
	INC	HL
	JP	MDRFIL
MDR20:	PUSH	HL	; A number is a partition, when a
	CALL	GET8##	;   separator follows it (else it
	JR	NZ,MDR30	;   is a file name like 2GAMES.DSK).
	LD	A,(HL)
	CALL	SEP?##
	JR	NZ,MDR30
	POP	AF	; Drop the saved pointer.
	LD	A,E
	LD	(ENVNAME##+11),A	; The partition number.
	JR	MDRDEV
MDR30:	POP	HL	; Not a partition: 'd', 'u', 's'
	INC	HL	;   (one letter and a separator)
	LD	A,(HL)	;   or a file name.
	DEC	HL
	CALL	SEP?##
	JP	NZ,MDRFIL
	LD	A,(HL)
	OR	#20
	CP	"u"
	LD	B,#00	; B = 0: unmap the drive.
	JR	Z,MDRDU
	CP	"d"
	LD	B,#01	; B = 1: boot time mapping.
	JR	Z,MDRDU
	CP	"s"
	JP	NZ,MDRFIL
	LD	A,#FF	; 's': attach to the device with
	LD	(ENVNAME##+12),A	;   no partition assigned.
	INC	HL
	JR	MDRDEV
;
MDRDU:	LD	A,(ENVNAME##+0)	; Unmap / map to the default;
	LD	C,_MAPDRV##	;   any further arguments are
	JP	BDOS	;   ignored, as in the tool.
;
MDRDEV:	CALL	GETCH##	; Optional device number.
	JR	Z,MDMAP
	CALL	GET8##
	RET	NZ
	LD	A,E
	LD	(ENVNAME##+5),A
	CALL	GETCH##	; Optional slot[-subslot][:segment]
	JR	Z,MDMAP	;   (see PARSLT further down).
	CALL	PARSLT
	RET	NZ
	LD	A,D	; The driver slot...
	LD	(ENVNAME##+3),A
	LD	A,E	; ...and segment (FFh when not
	LD	(ENVNAME##+4),A	;   given: a driver in ROM).
	CALL	GETCH##	; Nothing else may follow.
	LD	A,.INP##
	RET	NZ
	;fall through into MDMAP
;
;        Map to a partition and device. First resolve the current
; mapping when no slot was specified, as the tool does.
MDMAP:	LD	A,(ENVNAME##+3)
	INC	A	; FF => no slot was given.
	JR	NZ,MDM20
	LD	A,(ENVNAME##+0)	; Get the current mapping of the
	LD	HL,ENVDATA##	;   drive.
	LD	C,_GDLI##
	CALL	BDOS
	OR	A
	RET	NZ
	LD	A,(ENVDATA##)	; It must be mapped to a block
	CP	#01	;   device.
	LD	A,.IDRV##
	RET	NZ
	LD	A,(ENVNAME##+5)	; Device not given or 0: keep the
	OR	A	;   one the drive is mapped to.
	JR	NZ,MDM10
	LD	A,(ENVDATA##+4)
	LD	(ENVNAME##+5),A
MDM10:	LD	HL,ENVDATA##+1	; Get the information of the
	LD	D,(HL)	;   driver controlling the drive
	INC	HL	;   (D = slot, E = segment).
	LD	E,(HL)
	XOR	A
	LD	HL,ENVDATA##
	LD	C,_GDRVR##
	CALL	BDOS
	OR	A
	RET	NZ
	LD	A,(ENVDATA##+4)	; It must be a Nextor driver.
	AND	#01
	LD	A,.IDRVR##
	RET	Z
	LD	A,(ENVDATA##)	; Keep its slot and segment.
	LD	(ENVNAME##+3),A
	LD	A,(ENVDATA##+1)
	LD	(ENVNAME##+4),A
MDM20:	LD	A,(ENVNAME##+12)	; 's': mapping sector FFFFFFFFh
	OR	A	;   attaches the drive to the
	JR	Z,MDM30	;   device with no partition
	LD	HL,#FFFF	;   assigned.
	LD	DE,#FFFF
	JR	MDM60
MDM30:	LD	A,(ENVNAME##+11)	; Adjust the partition number:
	OR	A	;   0 = direct mapping (sector 0),
	JR	Z,MDM55
	CP	#01	;   1 = primary partition 1,
	JR	Z,MDM40
	CP	#05	;   5 on = always extended,
	JR	NC,MDM45
	LD	IX,ENVNAME##	;   2 to 4 = extended 2-1 to 2-3
	LD	A,(IX+3)	;   when partition 2 of the device
	LD	B,(IX+4)	;   is extended, else primary.
	LD	D,(IX+5)
	LD	E,#00
	LD	H,#02
	LD	L,#00
	LD	C,_GPART##
	CALL	BDOS
	OR	A
	RET	NZ
	LD	A,B	; B = the partition type.
	CP	PT_EXT
	JR	Z,MDM45
	CP	PT_EXTL
	JR	Z,MDM45
MDM40:	LD	A,(ENVNAME##+11)	; Primary partition, as given.
	LD	(ENVNAME##+1),A
	XOR	A
	LD	(ENVNAME##+2),A
	JR	MDM50
MDM45:	LD	A,#02	; Extended partition 2-(n-1).
	LD	(ENVNAME##+1),A
	LD	A,(ENVNAME##+11)
	DEC	A
	LD	(ENVNAME##+2),A
MDM50:	LD	IX,ENVNAME##	; Get the partition's starting
	LD	A,(IX+3)	;   sector.
	LD	B,(IX+4)
	LD	D,(IX+5)
	LD	E,#00
	LD	H,(IX+1)
	LD	L,(IX+2)
	LD	C,_GPART##
	CALL	BDOS
	OR	A
	RET	NZ
	JR	MDM60	; DE:HL = the starting sector.
MDM55:	LD	HL,#00
	LD	DE,#00
MDM60:	LD	(ENVNAME##+7),DE	; Store the sector and do the
	LD	(ENVNAME##+9),HL	;   mapping with the 8 byte table
	LD	A,(ENVNAME##+0)	;   at ENVNAME+3 (slot, segment,
	LD	B,#02	;   device, LUN, sector).
	LD	HL,ENVNAME##+3
	LD	C,_MAPDRV##
	CALL	BDOS
	OR	A
	RET	NZ
	LD	A,(ENVNAME##+13)	; /L: lock the drive now that it
	OR	A	;   is mapped.
	RET	Z
	LD	A,(ENVNAME##+0)
	LD	E,A
	LD	A,#01
	LD	B,#FF
	LD	C,_LOCK##
	JP	BDOS
;
;        Mount a file: copy the file spec to ENVDATA, take an optional
; /RO, locate the file and map it with _MAPDRV B=3.
MDRFIL:	LD	DE,ENVDATA##
MDF10:	LD	A,(HL)	; Copy up to a space, a control
	CP	" "+1	;   character, the end of the line
	JR	C,MDF20	;   or a '/' (which may start the
	CP	"/"	;   /RO option; file names cannot
	JR	Z,MDF20	;   contain slashes).
	LD	(DE),A
	INC	HL
	INC	DE
	JR	MDF10
MDF20:	XOR	A
	LD	(DE),A
	LD	(ENVNAME##+13),A	; No /RO so far.
	CALL	GETCH##
	JR	Z,MDF40
	CP	"/"	; Only /RO may follow.
	LD	A,.IPARM##
	RET	NZ
	INC	HL
	LD	A,(HL)
	OR	#20
	CP	"r"
	LD	A,.IPARM##
	RET	NZ
	INC	HL
	LD	A,(HL)
	OR	#20
	CP	"o"
	LD	A,.IPARM##
	RET	NZ
	INC	HL
	CALL	GETCH##
	LD	A,.INP##
	RET	NZ
	LD	A,#01
	LD	(ENVNAME##+13),A
MDF40:	XOR	A	; Locate the file; directories,
	LD	B,%10110	;   hidden and system files are
	LD	DE,ENVDATA##	;   included, as in the tool.
	LD	IX,XBUF1##
	LD	C,_FFIRST##
	CALL	BDOS
	OR	A
	RET	NZ
	LD	A,(ENVNAME##+13)	; D = 1 => mount read only.
	LD	D,A
	LD	A,(ENVNAME##+0)
	LD	B,#03	; Mount the file whose FIB is at
	LD	HL,XBUF1##	;   XBUF1 on the drive.
	LD	C,_MAPDRV##
	JP	BDOS

		SUBTTL	DRIVERS
;        The DRIVERS command (new as an internal command in 3.0; it has
; existed as the DRIVERS.COM tool since Nextor 2.0): lists the disk
; drivers present in the system, one _GDRVR index at a time until the
; first error. For each driver: its description (see PRDRV below) and
; the drives assigned to it at boot time.
@DRIVERS::	AND	(HL)	; No parameters allowed.
	LD	A,.INP##
	RET	NZ
	LD	B,#01	; Driver index, counted from 1.
DLS10:	PUSH	BC
	LD	A,B
	LD	HL,ENVDATA##
	LD	C,_GDRVR##
	CALL	BDOS
	POP	BC
	OR	A
	JR	NZ,DLS90	; First error: end of the list.
	PUSH	BC
	LD	IX,ENVDATA##
	CALL	PRDRV
	LD	A,(ENVDATA##+2)	; Number of drives assigned at
	OR	A	;   boot time.
	JR	NZ,DLS20
	LD	A,#68	; None at all.
	CALL	DMESSCR##
	JR	DLS40
DLS20:	LD	A,#69	; 'Drives assigned at boot
	CALL	DMESS##	;   time: n'...
	LD	A,(ENVDATA##+2)
	ADD	A,"0"
	CALL	PRCHAR##
	LD	A,","
	CALL	PRCHAR##
	CALL	SPACE##
	LD	A,(ENVDATA##+2)
	CP	#01	; ...then 'X:' for a single
	JR	NZ,DLS30	;   drive...
	LD	A,(ENVDATA##+3)
	ADD	A,"A"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	CALL	LPRINT##
	JR	DLS40
DLS30:	LD	A,#6A	; ...or 'from X: to Y:'
	CALL	DMESS##	;   ('X: ~ Y:' in Japanese).
	LD	A,(ENVDATA##+3)
	ADD	A,"A"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	LD	A,#6B
	CALL	DMESS##
	LD	A,(ENVDATA##+2)
	LD	C,A
	LD	A,(ENVDATA##+3)
	ADD	A,C
	DEC	A
	ADD	A,"A"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	CALL	LPRINT##
DLS40:	CALL	LPRINT##	; A blank line between drivers.
	POP	BC
	INC	B
	JP	DLS10
DLS90:	XOR	A	; The first _GDRVR error just ends
	RET	;   the listing.

		SUBTTL	DRVINFO
;        The DRVINFO command (new as an internal command in 3.0; it has
; existed as the DRVINFO.COM tool since Nextor 2.0): for every drive
; letter (A: to H:) that is assigned, displays what it is assigned to:
; the RAM disk, another drive (ghost drives), a mounted file (with its
; read only state), or a driver (see PRDRV) plus the device number
; (Nextor drivers) or the relative unit (legacy drivers).
;        The _GDLI letter buffer lives at ENVDATA and the _GDRVR
; driver buffer at ENVDATA+64; as in the tool, the driver info is not
; requested again when the drive is on the same slot and segment as
; the previous one (the mounted file case invalidates that cache,
; since it reuses the letter buffer).
@DRVINFO::	AND	(HL)	; No parameters allowed.
	LD	A,.INP##
	RET	NZ
	LD	A,#FF	; Invalidate the driver cache.
	LD	(ENVDATA##+64),A
	LD	(ENVDATA##+65),A
	LD	B,#00	; Drive, counted from 0.
DIN10:	PUSH	BC
	LD	A,B
	LD	HL,ENVDATA##
	LD	C,_GDLI##
	CALL	BDOS
	POP	BC
	OR	A
	RET	NZ
	LD	A,(ENVDATA##)	; Unassigned drives are skipped
	OR	A	;   silently.
	JP	Z,DIN80
	PUSH	BC
	LD	A,B	; 'Drive X: is assigned to:'
	ADD	A,"A"	;   (the letter waits in C while
	LD	C,A	;   DMESS eats the registers).
	LD	A,#58
	CALL	DMESS##
	LD	A,C
	CALL	PRCHAR##
	LD	A,#6C
	CALL	DMESSCR##
	LD	A,(ENVDATA##)
	CP	#04	; The RAM disk.
	JR	NZ,DIN20
	LD	A,#6D
	CALL	DMESSCR##
	JP	DIN70
DIN20:	CP	#05	; A ghost drive.
	JR	NZ,DIN30
	LD	A,#6E
	CALL	DMESS##
	LD	A,(ENVDATA##+1)
	ADD	A,"A"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	CALL	LPRINT##
	JP	DIN70
DIN30:	CP	#03	; A mounted file.
	JR	NZ,DIN40
	LD	A,#6F	; 'File <path> on drive X:'
	CALL	DMESS##	;   (' (read only)').
	LD	DE,ENVDATA##+4
	CALL	PRTSTR##
	LD	A,#70
	CALL	DMESS##
	LD	A,(ENVDATA##+1)
	ADD	A,"A"
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	LD	A,(ENVDATA##+2)	; Bit 0 = mounted read only.
	AND	#01
	JR	Z,DIN35
	LD	A,#71
	CALL	DMESS##
DIN35:	CALL	LPRINT##
	LD	A,#FF	; The letter buffer was reused:
	LD	(ENVDATA##+64),A	;   invalidate the driver cache.
	LD	(ENVDATA##+65),A
	JR	DIN70
DIN40:	LD	A,(ENVDATA##+1)	; A device or a relative unit:
	LD	D,A	;   get the controlling driver's
	LD	A,(ENVDATA##+2)	;   information (D = slot,
	LD	E,A	;   E = segment), unless it is
	LD	A,(ENVDATA##+64)	;   the same driver as for the
	CP	D	;   previous drive.
	JR	NZ,DIN45
	LD	A,(ENVDATA##+65)
	CP	E
	JR	Z,DIN50
DIN45:	XOR	A
	LD	HL,ENVDATA##+64
	LD	C,_GDRVR##
	CALL	BDOS
	OR	A
	JR	NZ,DIN90
DIN50:	LD	IX,ENVDATA##+64
	CALL	PRDRV
	LD	A,(ENVDATA##+64+4)	; Nextor driver (bit 0): device
	AND	#01	;   number; legacy: relative unit.
	JR	Z,DIN60
	LD	A,#72	; 'Device n'
	CALL	DMESS##
	LD	A,(ENVDATA##+4)
	LD	L,A
	LD	H,#00
	CALL	MEMNUM
	CALL	LPRINT##
	JR	DIN70
DIN60:	LD	A,#73	; 'Relative unit n'
	CALL	DMESS##
	LD	A,(ENVDATA##+3)
	ADD	A,"0"
	CALL	PRCHAR##
	CALL	LPRINT##
DIN70:	CALL	LPRINT##	; A blank line between drives.
	POP	BC
DIN80:	INC	B
	LD	A,B
	CP	#08
	JP	C,DIN10
	XOR	A
	RET

DIN90:	LD	E,A	; Error from _GDRVR: report it.
	POP	BC
	LD	A,E
	OR	A
	RET

		SUBTTL	DEVINFO
;        The DEVINFO command (new as an internal command in 3.0; it
; has existed as the DEVINFO.COM tool since Nextor 2.0):
;
;          DEVINFO slot[-subslot][:segment]|0
;
;        Displays the devices handled by the Nextor driver in the
; given slot, by calling its DEVICE_QUERY routine directly with
; _CDRVR (with the Nextor 3 awareness flag set in the slot byte). For
; every device number from 1 up that the driver recognises: the
; manufacturer, device and medium names and the serial number (each
; one only when the driver provides it), the device type, the
; capacity (for block devices with 512 byte sectors that are online
; and report their sector count) and the flags (removable or fixed,
; read only, floppy).
;        Scratch layout: ENVNAME +0/+1 = driver slot/segment, +2 to
; +9 = the _CDRVR register block (F,A,B,C,D,E,L,H), +19 = the device
; number. The buffer that the DRIVER itself writes the query results
; to (strings are ASCIIZ; GET_PARAMS uses the first 12 bytes: type,
; sector size, sector count, flags at +7) must NOT be in page 1:
; while the driver runs, page 1 holds the driver itself, and the
; kernel maps the TPA segment in page 2 (always) and page 0 (when it
; can) for exactly this purpose. ENVDATA lives in page 1, so a page 2
; TPA scratch address is used instead.
CDBUF	EQU	#9000	; Page 2 TPA scratch for _CDRVR.
@DEVINFO::	AND	(HL)	; The slot argument is mandatory.
	LD	A,.NOPAR##
	RET	Z
	CALL	PARSLT
	RET	NZ
	CALL	GETCH##	; Nothing else may follow.
	LD	A,.INP##
	RET	NZ
	LD	A,D	; The slot...
	LD	(ENVNAME##+0),A
	LD	A,E	; ...and segment of the driver.
	LD	(ENVNAME##+1),A
	PUSH	DE
	XOR	A	; The driver must exist...
	LD	HL,ENVDATA##
	LD	C,_GDRVR##
	CALL	BDOS
	POP	DE
	OR	A
	RET	NZ
	LD	A,(ENVDATA##+4)	; ...and be a Nextor driver.
	AND	%10000000
	LD	A,.IDRVR##
	RET	Z
	LD	A,#01	; The first device number.
	LD	(ENVNAME##+19),A
DVI10:	LD	A,DEVICE_QUERY.STR_MANUFACTURER##
	CALL	DVQSTR
	RET	C	; (error from _CDRVR itself)
	CP	DRIVER.RESULT_INVALID_DEVICE##
	JP	Z,DVI90	; No such device: try the next.
	PUSH	AF	; 'Device number n' (the result
	LD	A,#74	;   of the manufacturer query is
	CALL	DMESS##	;   used after the header line).
	LD	A,(ENVNAME##+19)
	LD	L,A
	LD	H,#00
	CALL	MEMNUM
	CALL	LPRINT##
	POP	AF
	LD	E,#75	; 'Device manufacturer: '
	CALL	DVPSTR
	LD	A,DEVICE_QUERY.STR_DEVICE_NAME##
	CALL	DVQSTR
	RET	C
	LD	E,#76	; 'Device name: '
	CALL	DVPSTR
	LD	A,DEVICE_QUERY.STR_MEDIUM_NAME##
	CALL	DVQSTR
	RET	C
	LD	E,#77	; 'Medium name: '
	CALL	DVPSTR
	LD	A,DEVICE_QUERY.STR_SERIAL_NUMBER##
	CALL	DVQSTR
	RET	C
	LD	E,#78	; 'Device serial number: '
	CALL	DVPSTR
	LD	C,#00	; The device parameters.
	LD	A,DEVICE_QUERY.GET_PARAMS##
	CALL	DVQRY
	RET	C
	OR	A
	JR	Z,DVI20
	CP	DRIVER.RESULT_NOT_IMPLEMENTED##
	JP	NZ,DVI80	; Other error: skip the details.
	LD	HL,CDBUF	; Not implemented: all-zero
	LD	DE,CDBUF+1	;   default parameters.
	LD	BC,#0B
	LD	(HL),#00
	LDIR
DVI20:	LD	C,#00	; Is the device available ?
	LD	A,DEVICE_QUERY.GET_AVAILABILITY##
	CALL	DVQRY
	RET	C
	OR	A
	JR	Z,DVI30	; B = the availability.
	CP	DRIVER.RESULT_NOT_IMPLEMENTED##
	JP	NZ,DVI80
	LD	B,#01	; Not implemented: assume online.
DVI30:	LD	A,B
	PUSH	AF	; The device type.
	LD	A,(CDBUF)
	LD	E,#79	; 'Block device'
	OR	A
	JR	Z,DVI40
	LD	E,#7A	; 'CD-ROM'
	DEC	A
	JR	Z,DVI40
	LD	E,#7B	; 'Unknown type'
DVI40:	LD	A,E
	CALL	DMESS##
	POP	AF	; Offline: say so, no capacity.
	OR	A
	JR	NZ,DVI50
	LD	A,#7C
	CALL	DMESS##
	JR	DVI70
DVI50:	LD	A,(CDBUF)	; The capacity, for online block
	OR	A	;   devices with 512 byte sectors
	JR	NZ,DVI70	;   and a known sector count.
	LD	HL,(CDBUF+1)
	LD	DE,#0200
	OR	A
	SBC	HL,DE
	JR	NZ,DVI70
	LD	DE,(CDBUF+3)	; HL:DE = the sector count
	LD	HL,(CDBUF+5)	;   (zero: unknown, e.g. floppy
	LD	A,H	;   drives - print nothing).
	OR	L
	OR	D
	OR	E
	JR	Z,DVI70
	SRL	H	; Halve: kilobytes.
	RR	L
	RR	D
	RR	E
	LD	C,"K"	; Show at most 4 digits: go to
	LD	A,H	;   the next unit at 10240 or
	OR	L	;   more (as the tool does).
	JR	NZ,DVI55
	LD	A,D
	CP	#28	; 10240 = 2800h.
	JR	C,DVI60
DVI55:	LD	E,D	; Divide by 1024: megabytes.
	LD	D,L
	LD	L,H
	LD	H,#00
	SRL	L
	RR	D
	RR	E
	SRL	L
	RR	D
	RR	E
	LD	C,"M"
	LD	A,L
	OR	A
	JR	NZ,DVI57
	LD	A,D
	CP	#28
	JR	C,DVI60
DVI57:	LD	E,D	; Divide by 1024: gigabytes.
	LD	D,L
	SRL	D
	RR	E
	SRL	D
	RR	E
	LD	C,"G"
DVI60:	PUSH	BC	; ', n' and the unit and 'B'.
	LD	A,","
	CALL	PRCHAR##
	CALL	SPACE##
	LD	L,E
	LD	H,D
	CALL	MEMNUM
	POP	BC
	LD	A,C
	CALL	PRCHAR##
	LD	A,"B"
	CALL	PRCHAR##
DVI70:	LD	A,(CDBUF+7)	; The flags: removable/fixed,
	LD	C,A	;   read only, floppy. (DMESS
	LD	E,#7E	;   preserves C.)
	BIT	0,C
	JR	Z,DVI72
	LD	E,#7D
DVI72:	LD	A,E
	CALL	DMESS##
	BIT	1,C
	JR	Z,DVI74
	LD	A,#7F
	CALL	DMESS##
DVI74:	BIT	2,C
	JR	Z,DVI76
	LD	A,#80
	CALL	DMESS##
DVI76:	CALL	LPRINT##	; End the type/flags line.
DVI80:	CALL	LPRINT##	; A blank line between devices.
DVI90:	LD	A,(ENVNAME##+19)	; On to the next device number.
	INC	A
	LD	(ENVNAME##+19),A
	CP	#FF
	JP	C,DVI10
	XOR	A
	RET

;        Query a string of the current device: A = the sub-string
; code. DVQRY is the generic entry: A = the query code, C = the value
; for the C register of the call. On exit, Cy => error from _CDRVR
; itself, A = the error code; NC => A = the driver's result (which
; comes back in the high byte of IX), and B = the returned B (the
; availability, for GET_AVAILABILITY).
DVQSTR:	LD	C,A	; C = the sub-string code.
	LD	A,DEVICE_QUERY.GET_STRING##
DVQRY:	LD	HL,ENVNAME##+2	; Build the register block:
	LD	(HL),#00	;   F = 0,
	INC	HL
	LD	(HL),A	;   A = the query code,
	INC	HL
	LD	A,(ENVNAME##+19)	;   B = the device number,
	LD	(HL),A
	INC	HL
	LD	(HL),C	;   C = the sub-string code,
	INC	HL
	LD	(HL),#00	;   D = 0,
	INC	HL
	LD	(HL),#FF	;   E = the buffer size,
	INC	HL
	LD	DE,CDBUF	;   HL = the results buffer (in
	LD	(HL),E	;   page 2, see above).
	INC	HL
	LD	(HL),D
	LD	DE,DRIVER.DEVICE_QUERY_ENTRY##
	LD	HL,ENVNAME##+2
	LD	A,(ENVNAME##+1)	; B = the driver segment,
	LD	B,A
	LD	A,(ENVNAME##+0)	; A = the slot, with the Nextor 3
	OR	%00010000	;   awareness flag.
	LD	C,_CDRVR##
	CALL	BDOS
	OR	A
	JR	Z,DVQ10
	SCF	; _CDRVR itself failed.
	RET
DVQ10:	PUSH	IX	; The driver's result, with Cy
	POP	AF	;   clear.
	OR	A
	RET

;        Print the label whose message number is in E and then the
; string that a device query left in ENVDATA, when its result in A
; says it is there (also
; accepting a truncated string, which the tool meant to do but did
; not). No output at all otherwise.
DVPSTR:	OR	A
	JR	Z,DVP10
	CP	DRIVER.RESULT_TRUNCATED_STRING##
	RET	NZ
DVP10:	LD	A,E
	CALL	DMESS##
	LD	DE,CDBUF
	CALL	PRTRIM
	JP	LPRINT##

;        Print the ASCIIZ string at (DE), with its trailing spaces
; removed (cut off in place: the buffer is scratch).
PRTRIM:	LD	H,D
	LD	L,E
PRT10:	LD	A,(HL)	; Find the terminating zero.
	OR	A
	INC	HL
	JR	NZ,PRT10
	DEC	HL
PRT20:	LD	A,H	; Walk back over the trailing
	CP	D	;   spaces, never moving before
	JR	NZ,PRT30	;   the start of the string.
	LD	A,L
	CP	E
	JR	Z,PRT35
PRT30:	DEC	HL
	LD	A,(HL)
	CP	" "
	JR	Z,PRT20
	INC	HL
PRT35:	LD	(HL),#00
	JP	PRTSTR##

;        Parse a slot specification at (HL): slot[-subslot][:segment],
; where a plain 0 with no subslot means the master disk ROM slot.
; Used by MAPDRV and DEVINFO.
; On exit, NZ => error, A = the error code; Z => D = the slot byte,
; E = the segment (FFh when not given), HL past the specification.
PARSLT:	CALL	GET8##	; Primary slot, 0 to 3.
	RET	NZ
	LD	A,E
	CP	#04
	LD	A,.IPARM##
	RET	NC
	LD	A,(HL)	; A subslot may follow.
	CP	"-"
	JR	NZ,PSL10
	INC	HL
	PUSH	DE	; (GET8 zeroes DE while parsing.)
	CALL	GET8##
	POP	BC	; C = the primary slot.
	RET	NZ
	LD	A,E
	CP	#04
	LD	A,.IPARM##
	RET	NC
	LD	A,E	; Slot byte = expanded flag +
	ADD	A,A	;   subslot + primary slot.
	ADD	A,A
	OR	C
	OR	#80
	JR	PSL20
PSL10:	LD	A,E	; With no subslot, a plain 0
	OR	A	;   means the master disk ROM
	JR	NZ,PSL20	;   slot.
	LD	A,(#F348)
PSL20:	LD	D,A
	LD	E,#FF	; Segment FFh = in ROM, unless
	LD	A,(HL)	;   one is given after a colon.
	CP	":"
	JR	NZ,PSL30
	INC	HL
	PUSH	DE	; (GET8 corrupts both DE and B
	CALL	GET8##	;   while parsing.)
	POP	BC	; B = the slot byte.
	RET	NZ
	LD	D,B
PSL30:	XOR	A	; Z: parsed fine.
	RET

;        Print the description of the driver whose _GDRVR buffer is at
; (IX): the name (32 characters at +8, padded with spaces - trimmed in
; place, the buffer is scratch) and the version at +5/+6/+7 (the
; revision only when not zero) for a Nextor driver (bit 7 of the flags
; at +4 set), or 'Legacy MSX-DOS driver'; then ' on slot ' and the
; slot from +0 (as p or p-s), with ':segment' from +1 appended when it
; is not FFh (drivers loaded in RAM); then a CRLF.
PRDRV:	BIT	7,(IX+4)
	JR	Z,PRD30
	PUSH	IX
	POP	HL
	LD	DE,#08
	ADD	HL,DE
	PUSH	HL	; The start of the name.
	LD	DE,#20
	ADD	HL,DE	; One past its end.
	LD	B,#20
PRD10:	DEC	HL	; Find the last character that is
	LD	A,(HL)	;   not a space.
	CP	" "
	JR	NZ,PRD20
	DJNZ	PRD10
PRD20:	INC	HL	; Cut the padding off and print
	LD	(HL),#00	;   what remains.
	POP	DE
	CALL	PRTSTR##
	CALL	SPACE##
	LD	A,"v"
	CALL	PRCHAR##
	LD	A,(IX+5)	; Main version number.
	ADD	A,"0"
	CALL	PRCHAR##
	LD	A,"."
	CALL	PRCHAR##
	LD	A,(IX+6)	; Secondary version number.
	ADD	A,"0"
	CALL	PRCHAR##
	LD	A,(IX+7)	; Revision number, only when it
	OR	A	;   is not zero.
	JR	Z,PRD40
	PUSH	AF
	LD	A,"."
	CALL	PRCHAR##
	POP	AF
	ADD	A,"0"
	CALL	PRCHAR##
	JR	PRD40
PRD30:	LD	A,#66	; 'Legacy MSX-DOS driver'.
	CALL	DMESS##
PRD40:	LD	A,#67	; ' on slot ' and the slot, as
	CALL	DMESS##	;   PRSLOT of the SDK prints it.
	LD	B,(IX+1)	; B = the segment.
	LD	A,(IX)
	PUSH	BC
	PUSH	AF
	AND	%00000011
	ADD	A,"0"
	CALL	PRCHAR##
	POP	AF
	BIT	7,A	; Expanded: '-' and the subslot.
	JR	Z,PRD50
	RRCA
	RRCA
	AND	%00000011
	PUSH	AF
	LD	A,"-"
	CALL	PRCHAR##
	POP	AF
	ADD	A,"0"
	CALL	PRCHAR##
PRD50:	POP	BC
	LD	A,B	; Segment FFh = in ROM: nothing;
	CP	#FF	;   else ':' and the number.
	JR	Z,PRD60
	LD	A,":"
	CALL	PRCHAR##
	LD	L,B
	LD	H,#00
	CALL	MEMNUM
PRD60:	JP	LPRINT##

; The strings of the DRIVERS, DRVINFO and DEVINFO commands are
; messages #66-#80 in messages.mac/jmessages.mac.

		SUBTTL	RALLOC
;        The RALLOC command (new in 3.0): RALLOC [d: [ON|OFF]].
;        Displays or sets the reduced allocation information mode for a
; drive: while enabled, _ALLOC reports at most 32MB of total/free space
; for the drive so that the computed sector count fits in 16 bits; and if
; the ZALLOC environment item is "ON", the free space is reported as 0
; instead, without scanning the FAT (the zero allocation information
; mode, which FREE, DIR and _DSPACE honour).
;        With no arguments the drives with the mode enabled are listed;
; with only a drive letter, the state for that drive is shown.
@RALLOC::	AND	(HL)
	JR	NZ,RAL30
	CALL	GETRAL	; No arguments: list the drives
	LD	B,#08	;   with the mode enabled from the
	LD	C,#00	;   vector in L. C counts them,
	LD	A,"A"	;   A = the drive letter.
RAL10:	SRL	L
	JR	NC,RAL15
	INC	C	; Mode enabled: count the drive
	PUSH	AF	;   and print 'X: '.
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	CALL	SPACE##
	POP	AF
RAL15:	INC	A
	DJNZ	RAL10
	LD	A,C	; End the list, or say that the
	OR	A	;   mode is off everywhere.
	JP	NZ,LPRINT##
	LD	A,#84
	JP	DMESSCR##

RAL30:	CALL	PARSDR	; Parse 'd:' into D (1 = A:).
	RET	NZ
	LD	A,D
	CP	#08+1	; Only drives A: to H: exist.
	LD	A,.IDRV##
	RET	NC
	CALL	GETCH##	; Anything after the drive ?
	JR	NZ,RAL40
	PUSH	DE	; No: show the state for the
	CALL	GETRAL	;   drive as 'X: ON|OFF'.
	POP	DE
	LD	A,L
	LD	B,D	; Rotate the drive's bit (number
RAL35:	RRA	;   D-1) into the carry.
	DJNZ	RAL35
	LD	HL,ONWORD$##+1
	JR	C,RAL37
	LD	HL,OFFWORD$##+1
RAL37:	LD	A,D
	ADD	A,"@"	; Drive 1 => 'A'.
	CALL	PRCHAR##
	LD	A,":"
	CALL	PRCHAR##
	CALL	SPACE##
	EX	DE,HL
	JP	DMSCR##

RAL40:	PUSH	DE	; Save the drive (in D).
	EX	DE,HL	; DE -> parameter.
	DEC	DE	; Pretend DE -> length byte.
	LD	HL,ONWORD$##	; Check for ON.
	LD	B,(HL)	; Length of 'ON'.
	LD	C,#FF	; FF => enable.
	CALL	COMPARE##
	JR	NC,RAL50
	INC	B	; Ready for OFF check.
	INC	C	; 0 => disable.
	INC	HL	; Point passed null at end of ON.
	CALL	C,COMPARE##	; Check for OFF if not ON.
	LD	A,.IPARM##	; 'Invalid parameter' if neither.
	JP	C,LCKERR
RAL50:	INC	DE	; Skip DE past the matched word.
	DJNZ	RAL50
	INC	DE
	EX	DE,HL
	LD	A,(HL)	; A separator and nothing else may
	CALL	SEP?##	;   follow it.
	LD	A,.IPARM##
	JP	NZ,LCKERR
	CALL	GETCH##
	LD	A,.INP##
	JP	NZ,LCKERR
	POP	DE	; D = drive again.
	PUSH	DE
	PUSH	BC	; (C = FF => enable, 0 => disable)
	CALL	GETRAL	; HL = the current vector.
	POP	BC
	POP	DE
	LD	A,#01	; Build the mask for bit D-1 of L.
	LD	B,D
	DEC	B
	JR	Z,RAL60
RAL55:	ADD	A,A
	DJNZ	RAL55
RAL60:	LD	E,A	; E = the drive's bit mask.
	LD	A,C
	OR	A	; Enabling or disabling ?
	LD	A,E
	JR	Z,RAL65
	OR	L	; Set the drive's bit...
	LD	L,A
	JR	RAL70
RAL65:	CPL
	AND	L	;   ...or clear it.
	LD	L,A
RAL70:	LD	A,#01	; Set the new vector.
	LD	C,_RALLOC##
	JP	BDOS

;        Get the reduced allocation information mode vector into HL
; (bit 0 of L = drive A:). DE is preserved.
GETRAL:	PUSH	DE
	XOR	A
	LD	C,_RALLOC##
	CALL	BDOS
	POP	DE
	RET

		SUBTTL	Z80MODE
;        The Z80MODE command (new in 3.0): Z80MODE slot[-subslot]|0
; [ON|OFF]. Displays or sets the Z80 access mode of the MSX-DOS driver
; in the given slot (a plain 0 means the master disk ROM slot): while
; the mode is enabled, Nextor switches to the Z80 CPU before every
; access to the driver. The _Z80MODE function works on MSX Turbo-R and
; on MSX-DOS drivers only; anything else returns the kernel's 'Invalid
; device driver' error.
@Z80MODE::	AND	(HL)
	LD	A,.IPARM##	; The slot argument is mandatory.
	RET	Z
	CALL	GET8##	; Get the primary slot number,
	RET	NZ	;   0 to 3.
	LD	A,E
	CP	#04
	LD	A,.IPARM##
	RET	NC
	LD	A,(HL)	; A subslot may follow.
	CP	"-"
	JR	NZ,Z8M20
	INC	HL
	PUSH	DE	; Save the primary slot (GET8
	CALL	GET8##	;   zeroes DE while parsing).
	POP	BC	; C = primary slot.
	RET	NZ	; Get the subslot number, 0 to 3.
	LD	A,E
	CP	#04
	LD	A,.IPARM##
	RET	NC
	LD	A,E
	ADD	A,A	; Slot byte = expanded flag +
	ADD	A,A	;   subslot + primary slot.
	OR	C
	OR	#80
	JR	Z8M30
Z8M20:	LD	A,E	; With no subslot, a plain '0'
	OR	A	;   means the master disk ROM
	JR	NZ,Z8M30	;   slot.
	LD	A,(#F348)
Z8M30:	LD	E,A	; E = the driver slot byte.
	CALL	GETCH##	; Anything else on the line ?
	JR	NZ,Z8M40
	LD	A,E	; No: display the current mode.
	LD	B,#00
	LD	C,_Z80MODE##
	CALL	BDOS
	OR	A
	RET	NZ	; (not Turbo-R / no legacy driver)
	LD	HL,ONWORD$##+1
	LD	A,D	; D = FF => the mode is enabled.
	OR	A
	JR	NZ,Z8M35
	LD	HL,OFFWORD$##+1
Z8M35:	EX	DE,HL
	JP	DMSCR##

Z8M40:	PUSH	DE	; Save the slot byte (in E).
	EX	DE,HL	; DE -> parameter.
	DEC	DE	; Pretend DE -> length byte.
	LD	HL,ONWORD$##	; Check for ON.
	LD	B,(HL)	; Length of 'ON'.
	LD	C,#FF	; FF => enable.
	CALL	COMPARE##
	JR	NC,Z8M50
	INC	B	; Ready for OFF check.
	INC	C	; 0 => disable.
	INC	HL	; Point passed null at end of ON.
	CALL	C,COMPARE##	; Check for OFF if not ON.
	LD	A,.IPARM##	; 'Invalid parameter' if neither.
	JP	C,LCKERR
Z8M50:	INC	DE	; Skip DE past the matched word.
	DJNZ	Z8M50
	INC	DE
	EX	DE,HL
	LD	A,(HL)	; A separator and nothing else may
	CALL	SEP?##	;   follow it.
	LD	A,.IPARM##
	JP	NZ,LCKERR
	CALL	GETCH##
	LD	A,.INP##
	JP	NZ,LCKERR
	POP	DE	; E = the slot byte.
	LD	D,C	; D = FF => enable, 0 => disable.
	LD	A,E
	LD	B,#01	; Set the new mode.
	LD	C,_Z80MODE##
	JP	BDOS


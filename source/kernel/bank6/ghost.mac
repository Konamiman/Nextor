	.z80
	name('ghost')
	title	Ghost drive setup routines
;******************************************************************************
;
	INCLUDE ../macros.inc
	INCLUDE	../const.inc
	INCLUDE ../../../sdk/asm/constants/msx_bios.inc
	INCLUDE ../../../sdk/asm/constants/msx_workarea.inc
;

CALBNK_ADDR	equ	4042h	;doshead CALBNK routine (same address in all banks)
DPBSIZE	equ	21
GHO_DRVTBL_PTR	equ	0FD8Eh	;PROCNM+5: scratch area for DRVTBL pointer


;-----------------------------------------------------------------------------
;
;    SETUP_GHOST_DOS2
;
;    Post-process UNIT_TAB after AUTODRV_DOS2 to set up a ghost drive
;    for a single floppy disk drive.
;
;    Scans UNIT_TAB for an FDD drive. If exactly one is found,c4pbk sets up
;    a ghost drive in the next UNIT_TAB slot. If the slot has a
;    pre-allocated UD (same slot, not device-based), uses it. If the
;    slot is null (UD was freed by AUTODRV), allocates a new UD.
;
;    Modifies: AF, BC, DE, HL, IX, IY

	public	?SETUP_GHOST_DOS2

?SETUP_GHOST_DOS2:
	;Check CTRL key first (cheapest check)
	ld	a,(BOOTKEYS##+4)
	bit	5,a
	ret	nz		;CTRL pressed: no ghost

	;First pass: count FDD drives. If != 1, no ghost.
	ld	hl,UNIT_TAB##+2	;Skip entry 0 (unused)
	ld	b,MAX_UNITS
	ld	c,0		;C = FDD count
	ld	de,0		;DE will store pointer to FDD unit entry in UNIT_TAB

SGD2_COUNT:
	ld	a,(hl)
	inc	hl
	or	(hl)
	dec	hl
	jr	z,SGD2_CNT_NX	;Null pointer: skip

	push	hl
	ld	a,(hl)
	inc	hl
	ld	h,(hl)
	ld	l,a		;HL = unit descriptor address
	push	hl
	pop	ix

	bit	UF_DBD,(ix+UD_DFLAGS##)
	jr	z,SGD2_CNT_POP	;Not device-based: skip

	bit	UF_FDD,(ix+UD_DFLAGS##)
	jr	z,SGD2_CNT_POP	;Not FDD: skip

	inc	c		;Count FDD drive
	pop	de		;DE = UNIT_TAB pointer to this FDD entry
	push	de

SGD2_CNT_POP:
	pop	hl
SGD2_CNT_NX:
	inc	hl
	inc	hl
	djnz	SGD2_COUNT

	;C = FDD count, DE = UNIT_TAB pointer to the FDD entry (if any)
	ld	a,c
	cp	1
	ret	nz		;Not exactly 1 FDD: no ghost

	;--- Found exactly 1 FDD drive. Check ghost UD candidate.
	;DE points to the UNIT_TAB entry for the FDD drive.

	ex	de,hl		;HL = UNIT_TAB pointer to FDD entry
	ld	e,(hl)
	inc	hl
	ld	d,(hl)		;DE = FDD unit descriptor address
	inc	hl
	;HL now points to next UNIT_TAB entry

	push	de
	pop	ix		;IX = FDD unit descriptor

	;Check that we haven't reached the max drive count
	ld	a,(ix+UD_PHYSICAL_UNIT##)
	cp	MAX_UNITS
	ret	z		;Already at drive H:, no room for ghost

	;C = ghost physical unit (P+1, may change if shift needed)
	ld	c,(ix+UD_PHYSICAL_UNIT##)
	inc	c

	;Check if next UNIT_TAB entry is non-null
	ld	a,(hl)
	inc	hl
	or	(hl)
	dec	hl
	jp	z,SGD2_ALLOC	;Null: need to allocate a new UD

	;--- Non-null: check if it's a pre-allocated ghost candidate
	push	hl
	ld	e,(hl)
	inc	hl
	ld	d,(hl)		;DE = next unit descriptor address
	push	de
	pop	iy		;IY = ghost unit descriptor candidate

	;Verify same driver slot (must belong to same driver)
	ld	a,(ix+UD_SLOT##)
	cp	(iy+UD_SLOT##)
	jr	nz,SGD2_NONNULL_FAIL

	;Verify ghost UD is not already device-based (still unassigned)
	bit	UF_DBD,(iy+UD_DFLAGS##)
	jp	z,SGD2_NONNULL_OK

SGD2_NONNULL_FAIL:
	pop	hl		;HL = UNIT_TAB ptr to entry P+1 (non-null)

	;The next slot belongs to a different driver (e.g. MSX-DOS FDD).
	;Shift UNIT_TAB and $DPBLIST entries [P+1..MAX_UNITS-1] forward
	;by one position to make room for the ghost right after the FDD.

	;Check room: last UNIT_TAB entry must be null
	push	hl
	ld	hl,UNIT_TAB##+MAX_UNITS*2
	ld	a,(hl)
	inc	hl
	or	(hl)
	pop	hl
	call	nz,SGD2_DROP_LAST ;All slots occupied: drop last entry
	ret	nz		;Drop failed (shouldn't happen)

	;Calculate entries to shift = MAX_UNITS - P - 1
	ld	a,MAX_UNITS
	sub	(ix+UD_PHYSICAL_UNIT##)
	dec	a
	jp	z,SGD2_NO_SHIFT	;No entries to shift: ghost goes in last slot
	ld	(BUF+3),a	;Save entry count

	;--- Shift UNIT_TAB entries forward by 2 bytes (LDDR)

	push	hl		;Save UNIT_TAB[P+1] for later
	add	a,a		;A = byte count
	ld	c,a
	ld	b,0
	add	hl,bc
	dec	hl		;HL = source end
	ld	d,h
	ld	e,l
	inc	de
	inc	de		;DE = dest end
	lddr
	pop	hl		;HL = UNIT_TAB[P+1]
	push	hl		;Save again
	xor	a
	ld	(hl),a
	inc	hl
	ld	(hl),a		;Clear entry P+1 for ghost

	;--- Shift $DPBLIST entries forward by 2 bytes

	;$DPBLIST[P] (0-based) = position P+1's DPB.
	;Shift $DPBLIST[P..MAX_UNITS-2] -> [P+1..MAX_UNITS-1]
	ld	a,(ix+UD_PHYSICAL_UNIT##)
	add	a,a		;A = P*2
	ld	c,a
	ld	b,0
	ld	hl,$DPBLIST##
	add	hl,bc		;HL = $DPBLIST[P]
	ld	a,(BUF+3)
	add	a,a		;A = byte count
	ld	c,a
	ld	b,0
	push	hl		;Save $DPBLIST[P]
	add	hl,bc
	dec	hl		;HL = source end
	ld	d,h
	ld	e,l
	inc	de
	inc	de		;DE = dest end
	lddr
	pop	hl		;HL = $DPBLIST[P]
	xor	a
	ld	(hl),a
	inc	hl
	ld	(hl),a		;Clear $DPBLIST[P]

	;--- Update shifted entries: UD_PHYSICAL_UNIT and ASG_TAB

	;Loop from position P+1 (ghost, null) to MAX_UNITS,
	;setting ASG_TAB[i]=i for each, and for non-null entries
	;also incrementing UD_PHYSICAL_UNIT.
	pop	hl		;HL = UNIT_TAB[P+1]
	ld	a,(BUF+3)
	inc	a		;Include ghost position
	ld	b,a		;B = loop count (P+1 to MAX_UNITS)
	ld	c,(ix+UD_PHYSICAL_UNIT##)
	inc	c		;C = P+1 (starting physical unit)

SGD2_FIX_LOOP:
	;Set ASG_TAB[C] = C
	push	hl
	push	bc
	ld	b,0
	ld	hl,ASG_TAB##
	add	hl,bc
	ld	(hl),c
	pop	bc
	pop	hl

	;Update UD_PHYSICAL_UNIT if entry is non-null
	ld	e,(hl)
	inc	hl
	ld	d,(hl)
	dec	hl
	ld	a,d
	or	e
	jr	z,SGD2_FIX_NEXT
	push	hl
	ex	de,hl		;HL = UD address
	ld	de,UD_PHYSICAL_UNIT##
	add	hl,de
	ld	(hl),c		;Set UD_PHYSICAL_UNIT = new position
	pop	hl

SGD2_FIX_NEXT:
	inc	hl
	inc	hl		;Next UNIT_TAB entry
	inc	c		;Next physical unit
	djnz	SGD2_FIX_LOOP

	;--- Recover HL and C for SGD2_ALLOC

	ld	c,(ix+UD_PHYSICAL_UNIT##)
	inc	c		;C = P+1
	ld	a,c
	add	a,a		;A = (P+1)*2
	ld	l,a
	ld	h,0
	ld	de,UNIT_TAB##
	add	hl,de		;HL = UNIT_TAB[P+1]
	jr	SGD2_ALLOC

SGD2_NONNULL_OK:
	pop	hl		;Discard UNIT_TAB pointer (UD already in place)
	jp	SGD2_SETUP_GHOST

	;--- Null entry: allocate a new UD for the ghost drive
	;C = ghost physical unit (P+1 for adjacent, or shifted position)
SGD2_ALLOC:
	push	hl		;Save UNIT_TAB pointer for ghost entry
	push	ix		;Save FDD unit descriptor

	ld	hl,UD_SIZE##
	pcall	ALL_P2		;Allocate UD_SIZE bytes of page 2 RAM
	pop	ix		;Restore IX = FDD unit descriptor
	jp	nz,SGD2_ALLOC_FAIL

	;HL = address of new UD (zeroed by ALL_P2)
	;Copy entire FDD UD to new ghost UD
	push	hl		;Save new UD address
	push	bc		;Save C = ghost physical unit
	ex	de,hl		;DE = new UD (destination)
	push	ix
	pop	hl		;HL = FDD UD (source)
	ld	bc,UD_SIZE##
	ldir
	pop	bc		;Restore C = ghost physical unit

	pop	iy		;IY = new ghost UD

	;Set UD_PHYSICAL_UNIT from pre-computed C
	ld	(iy+UD_PHYSICAL_UNIT##),c

	;Allocate a new DPB for the ghost drive
	push	iy		;Save ghost UD
	push	ix		;Save FDD UD
	ld	hl,DPBSIZE
	pcall	ALL_P2		;Allocate DPB from page 2
	pop	ix		;Restore FDD UD
	jr	nz,SGD2_DPB_FALLBACK

	;HL = new DPB. Copy master DPB to it.
	ex	de,hl		;DE = new DPB (dest)
	push	de		;Save new DPB address
	ld	l,(ix+UD_DPB_ADDRESS##)
	ld	h,(ix+UD_DPB_ADDRESS##+1)	;HL = master DPB
	ld	bc,DPBSIZE
	ldir

	;Set ghost DPB address and update $DPBLIST
	pop	de		;DE = new DPB address
	pop	iy		;IY = ghost UD
	ld	(iy+UD_DPB_ADDRESS##),e
	ld	(iy+UD_DPB_ADDRESS##+1),d

	;Update $DPBLIST[ghost_position]
	ld	a,(iy+UD_PHYSICAL_UNIT##)
	dec	a		;0-based index
	add	a,a		;byte offset
	ld	c,a
	ld	b,0
	ld	hl,$DPBLIST##
	add	hl,bc
	ld	(hl),e
	inc	hl
	ld	(hl),d
	jr	SGD2_DPB_DONE

SGD2_DPB_FALLBACK:
	;DPB allocation failed. Share master's DPB as fallback.
	pop	iy		;Restore ghost UD
	ld	a,(ix+UD_DPB_ADDRESS##)
	ld	(iy+UD_DPB_ADDRESS##),a
	ld	a,(ix+UD_DPB_ADDRESS##+1)
	ld	(iy+UD_DPB_ADDRESS##+1),a

SGD2_DPB_DONE:

	;Reset current directory to root
	ld	a,0FFh
	ld	(iy+UD_CURRENT_DIR_FIRST_CLUSTER##),a
	ld	(iy+UD_CURRENT_DIR_FIRST_CLUSTER##+1),a

	;Store new UD pointer in UNIT_TAB
	pop	hl		;HL = UNIT_TAB pointer for ghost entry
	push	iy
	pop	de		;DE = new UD address
	ld	(hl),e
	inc	hl
	ld	(hl),d

	;Set ASG_TAB for ghost drive
	ld	a,(iy+UD_PHYSICAL_UNIT##)
	ld	e,a
	ld	d,0
	ld	hl,ASG_TAB##
	add	hl,de
	ld	(hl),a

	;Increment NUMDRV since SETNUMDRV ran before this UD existed
	ld	hl,$NUMDRV##
	inc	(hl)

	;Update DRVTBL: find FDD driver's entry and increment its count.
	;Walk entries (2 bytes: count, slot) summing counts until
	;the sum covers the FDD's 1-based drive number.
	ld	b,(ix+UD_PHYSICAL_UNIT##)
	ld	hl,DRVTBL##
SGD2_FIND_DRV:
	ld	a,b
	sub	(hl)
	jr	c,SGD2_FOUND_DRV
	jr	z,SGD2_FOUND_DRV
	ld	b,a
	inc	hl
	inc	hl
	jr	SGD2_FIND_DRV
SGD2_FOUND_DRV:
	inc	(hl)

	;Save DRVTBL pointer for DOS 1 undo, then mark bit 6
	;in GHO_PAIR so undo knows DRVTBL was incremented.
	ld	(GHO_DRVTBL_PTR),hl
	call	SGD2_SETUP_GHOST
	ld	hl,GHO_PAIR##
	set	6,(hl)
	ret

SGD2_ALLOC_FAIL:
	pop	hl		;Discard UNIT_TAB pointer
	ret

SGD2_NO_SHIFT:
	ld	c,(ix+UD_PHYSICAL_UNIT##)
	inc	c		;C = P+1 = ghost physical unit
	jp	SGD2_ALLOC	;HL = UNIT_TAB[P+1] already

	;--- Common ghost setup (IX = FDD UD, IY = ghost UD)

SGD2_SETUP_GHOST:
	ld	a,(ix+UD_DEVICE_NUMBER##)
	ld	(iy+UD_DEVICE_NUMBER##),a
	ld	a,UFM_DB+UFM_FD+UFM_RM+UFM_FO+UFM_GH
	ld	(iy+UD_DFLAGS##),a

	;Set "last accessed" flag on the real drive
	set	UF_GLA,(ix+UD_DFLAGS##)

	;Store ghost pair info (bit 5 = 0 → real drive last accessed)
	ld	a,(ix+UD_PHYSICAL_UNIT##)
	ld	(GHO_PAIR##),a

	ret


;-----------------------------------------------------------------------------
;
;    SETUP_GHOST_DOS1
;
;    Post-process KERNEX_DOS1 table (at BOOT_TMP) after AUTODRV_DOS1
;    to insert a ghost drive entry for a single floppy disk drive.
;
;    The table is at (KERNEX_DOS1) = BOOT_TMP.
;    Format: 1-byte count, then count * UD1_SIZE entries.
;    Each entry: UD1_SLOT (1), UD1_RELATIVE_DRIVE (1), + UD1_SIZE-2 more bytes.
;    UD1_RELATIVE_DRIVE bit 6 = FDD flag.
;
;    If exactly one FDD entry is found and CTRL is not pressed,
;    inserts a ghost entry right after it.
;
;    Modifies: AF, BC, DE, HL, IX, IY

	public	?SETUP_GHOST_DOS1

?SETUP_GHOST_DOS1:
	;Check CTRL key first (cheapest check)
	ld	a,(BOOTKEYS##+4)
	bit	5,a
	ret	nz		;CTRL pressed: no ghost

	ld	hl,(KERNEX_DOS1##)	;HL = table start (BOOT_TMP)
	ld	a,(hl)
	or	a
	ret	z		;No entries: nothing to do

	;First pass: count FDD entries and record pointer + index.
	;Use BUF to store FDD entry pointer and index.
	ld	b,a		;B = entry count
	ld	c,0		;C = FDD count
	ld	d,0		;D = 1-based index counter
	push	hl		;Save table start
	inc	hl		;HL = first entry

SGD1_COUNT:
	inc	d		;D = 1-based index of current entry
	push	hl
	inc	hl		;Point to UD1_RELATIVE_DRIVE
	bit	6,(hl)		;FDD flag?
	jr	z,SGD1_CNT_NX

	inc	c		;Count FDD
	;Save FDD entry pointer and index in BUF
	pop	hl		;HL = FDD entry pointer
	push	hl
	ld	(BUF),hl	;Save pointer
	ld	a,d
	ld	(BUF+2),a	;Save 1-based index

SGD1_CNT_NX:
	pop	hl
	push	de		;Save D (index counter)
	ld	de,UD1_SIZE##
	add	hl,de
	pop	de		;Restore D
	djnz	SGD1_COUNT

	;C = FDD count
	pop	hl		;HL = table start (count byte)
	ld	a,c
	cp	1
	ret	nz		;Not exactly 1 FDD: no ghost

	;Check that we haven't reached the max drive count
	ld	a,(hl)		;A = current entry count
	cp	MAX_UNITS
	ret	z		;Already at 8 drives, no room for ghost

	;--- Found exactly 1 FDD. Insert ghost entry after it.
	;(BUF) = pointer to the FDD entry
	;(BUF+2) = 1-based index of the FDD entry

	push	hl		;Save table start

	;Calculate end of table data
	ld	a,(hl)		;A = current entry count
	ld	b,a
	inc	hl		;HL = first entry
SGD1_SKIP:
	ld	de,UD1_SIZE##
	add	hl,de
	djnz	SGD1_SKIP	;HL = byte past last entry = end of data

	;Shift entries after FDD entry forward by UD1_SIZE to make room.
	;Source: FDD_entry + UD1_SIZE (the entry after FDD)
	;Dest:   FDD_entry + 2*UD1_SIZE
	;Count:  end_of_data - source
	;Use LDDR (copy from end backwards to avoid overlap)

	push	hl		;Save end of data
	ld	ix,(BUF)	;IX = FDD entry

	push	ix
	pop	de
	ld	hl,UD1_SIZE##
	add	hl,de		;HL = source start (entry after FDD)

	pop	de		;DE = end of data
	push	de		;Keep it for later

	;BC = bytes to shift = end_of_data - source_start
	ld	a,e
	sub	l
	ld	c,a
	ld	a,d
	sbc	a,h
	ld	b,a		;BC = bytes to move

	ld	a,b
	or	c
	jr	z,SGD1_NO_SHIFT	;Nothing to shift (FDD was last entry)

	;LDDR: copy BC bytes from source_end to dest_end
	pop	hl		;HL = end of data
	push	hl
	dec	hl		;HL = last source byte
	push	hl
	ld	de,UD1_SIZE##
	add	hl,de		;HL = last destination byte
	ex	de,hl		;DE = last dest byte
	pop	hl		;HL = last source byte
	lddr

SGD1_NO_SHIFT:
	pop	hl		;Discard end of data

	;--- Create ghost entry: copy FDD entry to position IX + UD1_SIZE

	push	ix
	pop	hl		;HL = FDD entry (source)
	ld	de,UD1_SIZE##
	add	hl,de
	ex	de,hl		;DE = ghost entry destination
	push	de		;Save ghost entry address
	push	ix
	pop	hl		;HL = source
	ld	bc,UD1_SIZE##
	ldir			;Copy FDD entry to ghost position

	;Modify ghost entry: increment relative drive, set FDD flag
	pop	iy		;IY = ghost entry
	ld	a,(ix+UD1_RELATIVE_DRIVE##)
	and	00011111b	;Mask to relative drive number
	inc	a		;Next relative drive
	or	01000000b	;Set bit 6 (FDD flag)
	ld	(iy+UD1_RELATIVE_DRIVE##),a

	;Set ghost state in UD1_FIRST_ABSOLUTE_SECTOR byte 0:
	;  Master = 81h (01=master, bit 7=last accessed)
	;  Ghost  = 02h (10=ghost, bit 7=not last accessed)
	ld	(ix+UD1_FIRST_ABSOLUTE_SECTOR##),81h
	ld	(iy+UD1_FIRST_ABSOLUTE_SECTOR##),02h

	;Increment DRVTBL and $NUMDRV for the ghost drive.
	;Find the DRVTBL entry matching the FDD's slot.
	ld	a,(ix+UD1_SLOT##)
	ld	hl,DRVTBL##
SGD1_FIND_DRV:
	inc	hl		;Skip count byte → slot byte
	cp	(hl)		;Match slot?
	dec	hl		;Back to count byte
	jr	z,SGD1_FOUND_DRV
	inc	hl
	inc	hl		;Next entry
	jr	SGD1_FIND_DRV
SGD1_FOUND_DRV:
	inc	(hl)		;Increment drive count in DRVTBL
	ld	hl,$NUMDRV##
	inc	(hl)		;Increment total drive count
	ld	a,(BUF+2)	;Restore A = 1-based FDD drive index

	;--- Allocate a separate DPB for the ghost drive.
	;A = 1-based master index = 0-based ghost index.
	;Call ALLOC in bank 0 via CALBNK to allocate DPBSIZE bytes.

	push	af		;Save ghost 0-based drive number

	;Get master's DPB pointer from $DPBLIST
	dec	a		;0-based master drive
	add	a,a		;byte offset into $DPBLIST
	ld	e,a
	ld	d,0
	ld	hl,$DPBLIST##
	add	hl,de		;HL = &$DPBLIST[master]
	ld	e,(hl)
	inc	hl
	ld	d,(hl)		;DE = master DPB pointer
	push	de		;Save master DPB pointer

	;Allocate DPBSIZE bytes from page 3
	ld	hl,DPBSIZE
	ld	ix,ALLOC##
	ex	af,af'
	xor	a		;Bank 0
	call	CALBNK_ADDR

	pop	de		;DE = master DPB pointer
	;Z flag here reflects ALLOC result (pop de doesn't affect flags).
	;Must test BEFORE pop af, which would overwrite flags.
	jr	nz,SGD1_DPB_FAIL ;Allocation failed: skip

	;HL = new DPB. Copy master DPB content to it.
	pop	af		;A = ghost 0-based drive number
	push	af		;Save ghost drive number
	push	hl		;Save new DPB address
	ex	de,hl		;HL = master DPB (source), DE = new DPB (dest)
	ld	bc,DPBSIZE
	ldir

	;Update $DPBLIST[ghost] = new DPB
	pop	de		;DE = new DPB address
	pop	af		;A = ghost 0-based drive number
	add	a,a		;byte offset
	ld	l,a
	ld	h,0
	ld	bc,$DPBLIST##
	add	hl,bc		;HL = &$DPBLIST[ghost]
	ld	(hl),e
	inc	hl
	ld	(hl),d
	jr	SGD1_DPB_DONE

SGD1_DPB_FAIL:
	pop	af		;Discard ghost drive number

SGD1_DPB_DONE:

	;Increment table count
	pop	hl		;HL = table start (count byte)
	inc	(hl)

	ret


;-----------------------------------------------------------------------------
;
;    GHOST_PROMPT_DOS2
;
;    Display "Insert disk for drive X:" prompt and wait for keypress.
;    Called via CALBNK from bank 2 (val.mac rdwr_devcmd) during BDOS calls,
;    when page 0 = kernel RAM.  Uses P0_CALL (page 3 vector) for BIOS I/O
;    since CALROM's direct CALSLT at 001Ch doesn't work with kernel RAM
;    in page 0.
;
;    Input:  TARGET## = 0-based drive number
;    Modifies: AF, BC, DE, HL, IX

KILBUF	equ	0156h

	public	?GHOST_PROMPT_DOS2

?GHOST_PROMPT_DOS2:
	ld	hl,gp_msg
gp_print:
	ld	a,(hl)
	or	a
	jr	z,gp_getkey
	inc	hl
	cp	1		;Drive letter placeholder?
	jr	nz,gp_out
	ld	a,(TARGET##)
	add	a,'A'
gp_out:
	push	hl
	ld	ix,CHPUT
	call	P0_CALL##
	ei
	pop	hl
	jr	gp_print

gp_getkey:
	ld	ix,KILBUF	;Flush keyboard buffer
	call	P0_CALL##
	ei
gp_keywait:
	ld	ix,CHGET	;Wait for keypress
	call	P0_CALL##
	ei
	cp	3
	jr	z,gp_keywait	;Ignore Ctrl-C

	ld	a,13		;Final CR/LF
	ld	ix,CHPUT
	call	P0_CALL##
	ei
	ld	a,10
	ld	ix,CHPUT
	call	P0_CALL##
	ei
	ret

gp_msg:
	db	13,10,"Insert disk for drive "
	db	1		;Placeholder: replaced by drive letter
	db	":",13,10
	db	"and strike a key when ready",0


;-----------------------------------------------------------------------------
;
;    UNDO_GHOST_DRVTBL
;
;    If DOSINIT ran and SETUP_GHOST_DOS2 allocated a ghost UD
;    (bit 6 of GHO_PAIR set), undo the DRVTBL/$NUMDRV increment
;    and clear GHO_PAIR so SETUP_GHOST_DOS1 starts fresh.
;
;    Called from init.mac before AUTODRV_DOS1, so that AUTODRV_DOS1
;    sees the original (un-inflated) driver drive counts.
;
;    Modifies: AF, HL

	public	?UNDO_GHOST_DRVTBL

?UNDO_GHOST_DRVTBL:
	;Check if DOSINIT ran by testing if drive A: has a UD.
	;Caller must switch page 2 to kernel data segment.
	ld	hl,UNIT_TAB##+2
	ld	a,(hl)
	inc	hl
	or	(hl)
	ret	z		;DOSINIT didn't run

	;DOSINIT ran: clear GHO_PAIR so DOS 2 ghost check
	;starts fresh if we end up in DOS 2 mode later.
	ld	hl,GHO_PAIR##
	ld	a,(hl)
	ld	(hl),0		;Clear GHO_PAIR
	bit	6,a
	ret	z		;DRVTBL not incremented (NONNULL_OK case)

	;ALLOC case: undo DRVTBL/$NUMDRV increment
	ld	hl,$NUMDRV##
	dec	(hl)
	ld	hl,(GHO_DRVTBL_PTR)
	dec	(hl)
	ret


;-----------------------------------------------------------------------------
;
;    SGD2_DROP_LAST
;
;    Drop the last UNIT_TAB entry to make room for ghost shift.
;    Frees the UD, clears UNIT_TAB[MAX_UNITS] and $DPBLIST[MAX_UNITS-1],
;    decrements $NUMDRV, and decrements the corresponding DRVTBL entry.
;
;    Input:  None (operates on last UNIT_TAB slot)
;    Output: Z = success, NZ = failure
;    Preserves: HL, IX

SGD2_DROP_LAST:
	push	hl
	push	ix

	;Free the UD at UNIT_TAB[MAX_UNITS]
	ld	hl,UNIT_TAB##+MAX_UNITS*2
	ld	a,(hl)
	inc	hl
	ld	h,(hl)
	ld	l,a		;HL = UD address
	pcall	FR_P2		;Free it

	;Clear UNIT_TAB[MAX_UNITS]
	ld	hl,UNIT_TAB##+MAX_UNITS*2
	xor	a
	ld	(hl),a
	inc	hl
	ld	(hl),a

	;Clear $DPBLIST[MAX_UNITS-1] (0-based)
	ld	hl,$DPBLIST##+(MAX_UNITS-1)*2
	ld	(hl),a
	inc	hl
	ld	(hl),a

	;Decrement $NUMDRV
	ld	hl,$NUMDRV##
	dec	(hl)

	;Find and decrement DRVTBL entry for drive MAX_UNITS.
	;Walk DRVTBL summing counts until sum >= MAX_UNITS.
	ld	b,MAX_UNITS
	ld	hl,DRVTBL##
SGD2_DL_FIND:
	ld	a,b
	sub	(hl)
	jr	c,SGD2_DL_FOUND
	jr	z,SGD2_DL_FOUND
	ld	b,a
	inc	hl
	inc	hl
	jr	SGD2_DL_FIND
SGD2_DL_FOUND:
	dec	(hl)		;Decrement driver's drive count

	pop	ix
	pop	hl
	xor	a		;Z = success
	ret


;-----------------------------------------------------------------------------

	end

	.z80
	name('pch')
;
; PRINT_CALL_HELP — Print a zero-terminated string with the BIOS CHPUT
; (via RST 18h), for the CALL commands in banks 4 and 6.
; The help texts of the commands are in bank 1 (bank1/callhelp.mac).
;
; Input: HL = pointer to string.
; Modifies: AF, HL

PRINT_CALL_HELP::
	ld	a,(hl)
	or	a
	ret	z
	rst	18h
	inc	hl
	jr	PRINT_CALL_HELP

	end

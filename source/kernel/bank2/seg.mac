	.z80
	name('seg')
	title	MSX-DOS 2 ROM   Copyright (1986)  IS Systems Ltd.
	subttl	Allocate or Free Mapper Segment
;-----------------------------------------------------------------------------
;
	INCLUDE	../macros.inc
	INCLUDE	../const.inc
	INCLUDE ../../../sdk/asm/constants/msx_bios.inc
	RAMMOD
;
;-----------------------------------------------------------------------------
;
; This module has been moved to bank 4.
; Here we just keep the entry points that call the real code.
;

	PROC	ALL_SEG
		push	ix
		ld	ix,ALLSEG##
		jr	DO_CALL

	PROC	FRE_SEG
		push	ix
		ld	ix,FRESEG##
		jr	DO_CALL

	PROC	FRE_USER_SEG
		push	ix
		ld	ix,FREUSEG##

DO_CALL:
	ld	(A_SAVE##),a
	pcall	CALL4_PRESERVE_ALT
	pop	ix
	ret

;-----------------------------------------------------------------------------
;
	finish	<SEG>
	end
;

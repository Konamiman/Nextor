# The COMMAND2.COM help files are MSX text files: CRLF line endings
# and a trailing CTRL-Z, all to be preserved verbatim (no end of line
# normalization - core.autocrlf would strip the CRs on commit).
source/commandcom/helpfiles/*.HLP -text

# The categorized releases page is generated by .github/categorized-releases/generate.sh:
# keep it out of the language statistics and collapsed in pull request diffs.
docs/releases/** linguist-generated=true
